[Unit]
Description=SN118 manual Backroom request consumer (no recurring transfer ticks)
After=network-online.target sn118-collector@transfer.service sn118-collector@transfer.timer
Wants=network-online.target
Conflicts=sn118-collector@transfer.service sn118-collector@transfer.timer
ConditionPathExists=/etc/sn118-collector/manual/activation.env

[Service]
Type=simple
User=sn118-collector-transfer
Group=sn118-collector-transfer
EnvironmentFile=/etc/sn118-collector/manual/activation.env
ExecStart=/opt/sn118-collector/.venv/bin/python /opt/sn118-collector/scripts/treasury_manual_worker.py --enabled --policy /etc/sn118-collector/transfer/policy.json --policy-sha256 ${POLICY_SHA256} --journal /var/lib/sn118-collector-transfer/journal.db --project sn118-gamma-custody --request-subscription sn118-manual-requests --report-topic sn118-manual-reports
Restart=on-failure
RestartSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sn118-collector-transfer
ReadOnlyPaths=/etc/sn118-collector
CapabilityBoundingSet=
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
