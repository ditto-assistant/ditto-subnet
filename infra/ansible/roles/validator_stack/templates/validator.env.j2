# Managed by Ansible (validator_stack role). Contains host-local bearer tokens
# and the W&B API key, but never a mnemonic, seed, coldkey, or cloud credential.
{% set coding_executor_profile_enabled = validator_stack_coding_executor_remote_enabled or validator_stack_coding_executor_connectivity_canary_enabled %}
SUBTENSOR_NETWORK={{ validator_stack_subtensor_network }}
VALIDATOR_PLATFORM_API_URL={{ validator_stack_platform_api_url }}
VALIDATOR_HOTKEY={{ validator_stack_hotkey }}
VALIDATOR_WALLET_NAME={{ validator_stack_wallet_name }}
VALIDATOR_WALLET_HOTKEY={{ validator_stack_hotkey_name }}
DITTO_BITTENSOR_WALLETS_DIR={{ validator_stack_wallets_dir }}

PYLON_TOKEN={{ validator_stack_pylon_token }}
DITTOBENCH_BROKER_CONTROL_TOKEN={{ validator_stack_broker_token }}

WANDB_MODE=online
WANDB_API_KEY={{ validator_stack_wandb_api_key }}

VALIDATOR_BENCHMARK_CAPACITY={{ validator_stack_benchmark_capacity }}
VALIDATOR_LONGMEM_CAPACITY={{ validator_stack_longmem_capacity }}
VALIDATOR_DISK_PERCENT_CEILING={{ validator_stack_disk_percent_ceiling }}
VALIDATOR_MEMORY_PERCENT_CEILING={{ validator_stack_memory_percent_ceiling }}
VALIDATOR_CPU_PERCENT_CEILING={{ validator_stack_cpu_percent_ceiling }}

VALIDATOR_CODING_SHADOW_ENABLED={{ 'true' if validator_stack_coding_shadow_enabled else 'false' }}
VALIDATOR_CODING_SHADOW_INSTANCE_ID={{ validator_stack_coding_shadow_instance_id }}
VALIDATOR_CODING_SHADOW_RUN_ID={{ validator_stack_coding_shadow_run_id }}
VALIDATOR_CODING_SHADOW_POLL_SECONDS={{ validator_stack_coding_shadow_poll_seconds }}
VALIDATOR_CODING_EXECUTOR_REMOTE_ENABLED={{ 'true' if validator_stack_coding_executor_remote_enabled else 'false' }}
VALIDATOR_CODING_EXECUTOR_CONNECTIVITY_CANARY_ENABLED={{ 'true' if validator_stack_coding_executor_connectivity_canary_enabled else 'false' }}
VALIDATOR_CODING_EXECUTOR_BASE_URL={{ validator_stack_coding_executor_base_url if coding_executor_profile_enabled else '' }}
VALIDATOR_CODING_EXECUTOR_CA_PATH={{ '/run/secrets/coding-executor-validator-ca.pem' if coding_executor_profile_enabled else '' }}
VALIDATOR_CODING_EXECUTOR_CLIENT_CERT_PATH={{ '/run/secrets/coding-executor-validator-client.pem' if coding_executor_profile_enabled else '' }}
VALIDATOR_CODING_EXECUTOR_CLIENT_KEY_PATH={{ '/run/secrets/coding-executor-validator-client-key.pem' if coding_executor_profile_enabled else '' }}
VALIDATOR_CODING_EXECUTOR_TIMEOUT_SECONDS={{ validator_stack_coding_executor_timeout_seconds if coding_executor_profile_enabled else '' }}
VALIDATOR_CODING_EXECUTOR_CA_HOST_PATH={{ validator_stack_coding_executor_ca_path if validator_stack_coding_executor_identity_enabled else '/dev/null' }}
VALIDATOR_CODING_EXECUTOR_CLIENT_CERT_HOST_PATH={{ validator_stack_coding_executor_client_cert_path if validator_stack_coding_executor_identity_enabled else '/dev/null' }}
VALIDATOR_CODING_EXECUTOR_CLIENT_KEY_HOST_PATH={{ validator_stack_coding_executor_client_key_path if validator_stack_coding_executor_identity_enabled else '/dev/null' }}

DITTOBENCH_REQUIRE_TICKET_INFERENCE=true
VALIDATOR_INFERENCE_PROXY_REQUIRED=true
VALIDATOR_STACK_AUTO_UPDATE=true
