#!/usr/bin/env python3
# Managed by Ansible (screening_queue_metric role) — do not edit by hand.
#
# Read the screening backlog from the platform's local activity endpoint and
# publish it to Cloud Monitoring as {{ screening_queue_metric_type }}
# (env="{{ screening_queue_metric_env }}"). The prod screener fleet autoscaler
# divides this gauge by its per-instance assignment to pick the fleet size.
#
# stdlib only; auth = the VM's attached service account via the metadata server
# (needs roles/monitoring.metricWriter).
import datetime
import json
import sys
import urllib.request

ACTIVITY_URL = "http://127.0.0.1:{{ screening_queue_metric_api_port }}/api/v1/public/activity?limit=1"
METADATA_TOKEN_URL = (
    "http://169.254.169.254/computeMetadata/v1/instance/service-accounts/default/token"
)
PROJECT_URL = "http://169.254.169.254/computeMetadata/v1/project/project-id"
METRIC_TYPE = "{{ screening_queue_metric_type }}"
METRIC_ENV = "{{ screening_queue_metric_env }}"


def _get(url: str, headers: dict | None = None) -> bytes:
    req = urllib.request.Request(url, headers=headers or {})
    with urllib.request.urlopen(req, timeout=10) as resp:
        return resp.read()


def main() -> int:
    counts = json.loads(_get(ACTIVITY_URL)).get("status_counts", {})
    # In-flight (`screening`) is included on purpose: it keeps the autoscaler
    # from scaling in under workers that are mid-build.
    depth = int(counts.get("waiting_screening", 0)) + int(counts.get("screening", 0))

    project = _get(PROJECT_URL, {"Metadata-Flavor": "Google"}).decode()
    token = json.loads(_get(METADATA_TOKEN_URL, {"Metadata-Flavor": "Google"}))[
        "access_token"
    ]

    now = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    body = {
        "timeSeries": [
            {
                "metric": {"type": METRIC_TYPE, "labels": {"env": METRIC_ENV}},
                "resource": {"type": "global", "labels": {"project_id": project}},
                "points": [
                    {
                        "interval": {"endTime": now},
                        "value": {"int64Value": str(depth)},
                    }
                ],
            }
        ]
    }
    req = urllib.request.Request(
        f"https://monitoring.googleapis.com/v3/projects/{project}/timeSeries",
        data=json.dumps(body).encode(),
        headers={
            "Authorization": f"Bearer {token}",
            "Content-Type": "application/json",
        },
        method="POST",
    )
    with urllib.request.urlopen(req, timeout=10) as resp:
        resp.read()
    print(f"published {METRIC_TYPE} env={METRIC_ENV} depth={depth}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
