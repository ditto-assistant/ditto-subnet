# Managed by Ansible (platform_app role) — do not edit by hand.
# Read by ditto-platform-pylon.service (root) as its systemd environment. The
# network and token are the values docker compose interpolated from update.sh's
# exported .env; the other pylon variables keep their compose defaults, as they
# did then. The wallet mount is a root-owned empty directory, never a path in
# the deploy user's home: dockerd resolves the bind source as root, so a
# deploy-controlled symlink there would mount any host path into the container.
# The Platform's Pylon serves reads only and signs nothing
# (tasks/pylon_root_unit.yml refuses a non-empty deploy wallet directory).
SUBTENSOR_NETWORK={{ platform_subtensor_network }}
PYLON_OPEN_ACCESS_TOKEN={{ platform_secrets.pylon_token }}
BITTENSOR_WALLET_PATH=/etc/ditto-platform/pylon/wallets
