# Managed by Ansible (platform_app role) — do not edit by hand.
# Mirrors ditto-platform/.env.example. Secrets come from GCP Secret Manager;
# infra-derived values (PG host, bucket, HMAC access id) from Terraform outputs.

# --- Deploy ---
# Only the Pylon sidecar runs on this host (Postgres = ditto-pg-platform VM,
# blobs = GCS). Consumed by scripts/start.sh + scripts/update.sh.
DITTO_COMPOSE_SERVICES=pylon

# Compose derives its project name from the directory when this is unset, so the
# SAME sidecar is `ditto-platform-pylon-1` under /opt/ditto-platform and
# `platform-pylon-1` under /opt/ditto-subnet/apps/platform. Two projects, one
# host port 8001: during the 2026-08-07 monorepo cutover the new stack could not
# bind while the old one held it, and the deploy died at
# `==> DEPLOY FAILED at stage 'infra'`. Pinning the name makes a checkout at a
# new path ADOPT the running container instead of contending with it -- the
# compose files are identical, so there is nothing to recreate and no gap in
# chain reads. It also means the project identity no longer depends on where the
# repo happens to be checked out.
COMPOSE_PROJECT_NAME={{ platform_compose_project_name }}

# --- API server ---
API_HOST=0.0.0.0
API_PORT={{ platform_api_port }}
API_LOG_LEVEL=INFO
DITTO_ADMIN_API_TOKEN={{ platform_secrets.admin_api_token }}

# --- Ticket-scoped platform inference (dark by default) ---
DITTO_INFERENCE_PROXY_ENABLED={{ 'true' if platform_inference_proxy_enabled else 'false' }}
DITTO_INFERENCE_PROXY_REQUIRED={{ 'true' if platform_inference_proxy_required else 'false' }}
{# Origin the platform mints into every v7 grant's proxy_url. Decoupled from
   platform_domain because the validator-side broker byte-compares this against
   its DITTOBENCH_PLATFORM_INFERENCE_PROXY_URL, so it must be changeable
   without moving the Caddy primary vhost. Intentionally has no `default()`:
   an undefined value must fail the play loudly rather than render a broken
   origin that 401s every activation fleet-wide. No trailing slash — the API
   appends /api/v1/inference/chat/completions and `//api/...` fails the
   broker's exact-path check. #}
DITTO_INFERENCE_PUBLIC_BASE_URL={{ platform_inference_public_base_url }}
DITTO_INFERENCE_ALLOWED_MODELS={{ platform_inference_allowed_models }}
DITTO_INFERENCE_PROVIDER={{ platform_inference_provider }}
DITTO_INFERENCE_ROUTING_MODE={{ platform_inference_routing_mode }}
DITTO_INFERENCE_DISCOVERY_INTERVAL_SECONDS={{ platform_inference_discovery_interval_seconds }}
DITTO_INFERENCE_ROUTE_SPEED_WEIGHT={{ platform_inference_route_speed_weight }}
DITTO_INFERENCE_ROUTE_COST_WEIGHT={{ platform_inference_route_cost_weight }}
DITTO_INFERENCE_ROUTE_EXPLORATION_WEIGHT={{ platform_inference_route_exploration_weight }}
DITTO_INFERENCE_ROUTE_EWMA_ALPHA={{ platform_inference_route_ewma_alpha }}
DITTO_INFERENCE_ROUTE_MIN_TOOL_ACCURACY={{ platform_inference_route_min_tool_accuracy }}
DITTO_INFERENCE_ROUTE_MIN_COMPOSITE={{ platform_inference_route_min_composite }}
DITTO_INFERENCE_ROUTE_MIN_CALIBRATION_SAMPLES={{ platform_inference_route_min_calibration_samples }}
DITTO_INFERENCE_ROUTE_EXPLORATION_TICKETS={{ platform_inference_route_exploration_tickets }}
DITTO_INFERENCE_ROUTE_MAX_ERROR_RATE={{ platform_inference_route_max_error_rate }}
DITTO_INFERENCE_ROUTE_MAX_TIMEOUT_RATE={{ platform_inference_route_max_timeout_rate }}
DITTO_INFERENCE_ROUTE_COOLDOWN_SECONDS={{ platform_inference_route_cooldown_seconds }}
DITTO_INFERENCE_REQUEST_BUDGET={{ platform_inference_request_budget }}
DITTO_INFERENCE_TOKEN_BUDGET={{ platform_inference_token_budget }}
DITTO_INFERENCE_TICKET_CONCURRENCY={{ platform_inference_ticket_concurrency }}
DITTO_INFERENCE_VALIDATOR_CONCURRENCY={{ platform_inference_validator_concurrency }}
DITTO_INFERENCE_GLOBAL_CONCURRENCY={{ platform_inference_global_concurrency }}
DITTO_INFERENCE_TICKET_RPM={{ platform_inference_ticket_rpm }}
DITTO_INFERENCE_VALIDATOR_RPM={{ platform_inference_validator_rpm }}
DITTO_INFERENCE_GLOBAL_RPM={{ platform_inference_global_rpm }}
{% if platform_inference_reviewed_calibration_manifest_sha256 | length > 0 %}
DITTO_INFERENCE_REVIEWED_CALIBRATION_MANIFEST_SHA256={{ platform_inference_reviewed_calibration_manifest_sha256 }}
{% endif %}
{% if platform_inference_proxy_enabled %}
OPENROUTER_API_KEY={{ platform_secrets.openrouter_api_key }}
{% endif %}

# --- Pylon (Docker sidecar; host 8001 -> container 8000) ---
PYLON_URL=http://localhost:8001
PYLON_OPEN_ACCESS_TOKEN={{ platform_secrets.pylon_token }}
PYLON_IDENTITY_NAME=
PYLON_IDENTITY_TOKEN=

# --- Subnet ---
NETUID={{ platform_netuid }}
SUBTENSOR_NETWORK={{ platform_subtensor_network }}

{% if platform_screener_hotkey | default('') | length > 0 %}
# --- Platform-operated screener auth (dedicated no-funds hotkey + bearer token) ---
# Allowlisted screener hotkey + shared token; replaces the validator-permit gate.
SCREENER_HOTKEY={{ platform_screener_hotkey }}
SCREENER_API_TOKEN={{ platform_secrets.screener_api_token }}
{% endif %}
{% if secret_screener_controller_api_token | default('') | length > 0 %}
SCREENER_CONTROLLER_API_TOKEN={{ platform_secrets.screener_controller_api_token }}
{% endif %}

# --- Postgres (dedicated ditto-pg-platform VM, private IP) ---
POSTGRES_HOST={{ platform_pg_host }}
POSTGRES_PORT={{ platform_pg_port }}
POSTGRES_USER={{ platform_pg_user }}
POSTGRES_PASSWORD={{ platform_secrets.db_password }}
POSTGRES_DB={{ platform_db_name }}
POSTGRES_POOL_MIN_SIZE={{ platform_pg_pool_min_size }}
POSTGRES_POOL_MAX_SIZE={{ platform_pg_pool_max_size }}
POSTGRES_COMMAND_TIMEOUT=30.0

# --- Upload + pricing ---
# Deploy-owned values, including DITTO_UPLOAD_PAYMENT_ADDRESS, live in the
# separate mode-0600 .env.deploy file. This template never reads or writes it.
DITTO_UPLOAD_FEE_USD={{ platform_upload_fee_usd }}
DITTO_UPLOAD_FEE_BUFFER={{ platform_upload_fee_buffer }}
PRICING_CACHE_TTL_SECONDS=3600
PRICING_MAX_STALE_SECONDS=86400
PRICING_COINGECKO_TIMEOUT_SECONDS=5.0

# --- Object storage (GCS via S3-compatible XML API / HMAC) ---
STORAGE_ENDPOINT_URL={{ platform_storage_endpoint }}
STORAGE_BUCKET={{ platform_bucket }}
STORAGE_ACCESS_KEY={{ platform_storage_access_key }}
STORAGE_SECRET_KEY={{ platform_secrets.hmac_secret }}
STORAGE_REGION={{ platform_storage_region }}
STORAGE_USE_TLS=true

# --- Per-submission dataset generation (on-chain seed provenance) ---
{% if platform_datapipeline_url | default('') %}
DATA_PIPELINE_URL={{ platform_datapipeline_url }}
DATA_PIPELINE_AUTH={{ platform_datapipeline_auth }}
DATA_PIPELINE_RUN_SIZE={{ platform_datapipeline_run_size }}
DATA_PIPELINE_TIMEOUT_SECONDS={{ platform_datapipeline_timeout_seconds }}
{% else %}
# Dataset generation disabled (platform_datapipeline_url unset) — no dataset is
# pinned at screening pass, so scores carry no on-chain seed provenance.
{% endif %}

# --- Code-embedding (anti-copy semantic tier) ---
{% if platform_embedder_url | default('') %}
CODE_EMBEDDER_URL={{ platform_embedder_url }}
CODE_EMBEDDER_MODEL={{ platform_embedder_model }}
CODE_EMBEDDER_AUTH={{ platform_embedder_auth }}
CODE_EMBEDDER_TIMEOUT_SECONDS={{ platform_embedder_timeout_seconds }}
{% if platform_embedder_dim | default('') %}
CODE_EMBEDDER_DIM={{ platform_embedder_dim }}
{% endif %}
{% else %}
# Embedder disabled (platform_embedder_url unset) — no vectors computed.
{% endif %}
