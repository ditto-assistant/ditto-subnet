# Managed by Ansible (platform_app role). Single-vhost reverse proxy for the
# ditto-platform API and its public aliases. Caddy manages certificates for the
# primary domain and every explicitly configured alias.
{
    email {{ platform_caddy_email }}
}

{{ ([platform_domain] + platform_alias_domains) | join(', ') }} {
    encode zstd gzip
{% if platform_inference_relay_ports %}
    # --- Go request plane -> the relay pool (platform_inference_relay_ports) ---
    #
    # `ditto-api` is a single fork-mode uvicorn process on ONE core. Inference is
    # ~71.7% of requests and ~81.7% of in-flight request-time on that event loop,
    # which is what delays validator heartbeat ingest, lets `seen_at` go stale,
    # and makes the platform force-expire live leases. ditto-platform#444 added
    # the DITTO_ROLE=relay processes; this block is what actually sends them
    # inference and upload-admission traffic.
    #
    # Mutually exclusive `handle` blocks make routing independent of Caddy's
    # directive-ordering rules. The two cheap upload admission
    # endpoints move to Go; multipart /upload/agent and all other platform
    # routes remain on Python. Finalized-payment /upload/check recovery is
    # forwarded by Go to Python until the historical proof verifier is ported.
    #
    # The matcher covers all three inference routes (/chat/completions,
    # /embeddings, /exchange). There is no bare /api/v1/inference route, so
    # nothing is left behind by the trailing /*.
    #
    # Health checking is PASSIVE on purpose: a relay that is restarting is
    # skipped for fail_duration rather than 502'ing the caller. Caddy only
    # retries a different upstream on a DIAL failure -- never once bytes have
    # gone downstream -- so streaming completions are never replayed.
{% if platform_upload_admission_relay_enabled | bool %}
    @goUploadAdmission path /api/v1/upload/eval-pricing /api/v1/upload/check
    handle @goUploadAdmission {
        reverse_proxy {% for port in platform_inference_relay_ports %}localhost:{{ port }} {% endfor %}{
            lb_policy least_conn
            fail_duration 10s
            max_fails 1
            lb_try_duration 5s
        }
    }
{% endif %}

    handle /api/v1/inference/* {
        reverse_proxy {% for port in platform_inference_relay_ports %}localhost:{{ port }} {% endfor %}{
            lb_policy least_conn
            fail_duration 10s
            max_fails 1
            lb_try_duration 5s
        }
    }

    handle {
        reverse_proxy localhost:{{ platform_api_port }}
    }
{% else %}
    reverse_proxy localhost:{{ platform_api_port }}
{% endif %}

    log {
        output file /opt/ditto/logs/caddy/platform.log {
            roll_size 50MiB
            roll_keep 10
        }
    }
}
