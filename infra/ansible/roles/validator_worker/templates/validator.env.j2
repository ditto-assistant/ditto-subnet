# Managed by Ansible (validator_worker role) — do not edit by hand.
# Stateless SN118 validator worker: pulls the platform queue, scores via the
# co-located dittobench-api, sets weights on chain. See ditto/validator/config.py.

VALIDATOR_PLATFORM_API_URL={{ validator_platform_api_url }}
VALIDATOR_DITTOBENCH_API_URL={{ validator_dittobench_api_url }}
VALIDATOR_DITTOBENCH_MOCK={{ 'true' if validator_dittobench_mock else 'false' }}
VALIDATOR_RUN_SIZE={{ validator_run_size }}
VALIDATOR_USE_SDK_WEIGHTS={{ 'true' if validator_use_sdk_weights else 'false' }}
NETUID={{ validator_netuid }}
SUBTENSOR_NETWORK={{ validator_subtensor_network }}
VALIDATOR_HOTKEY={{ validator_hotkey }}
VALIDATOR_EPOCH_SECONDS={{ validator_epoch_seconds }}
VALIDATOR_QUEUE_LIMIT={{ validator_queue_limit }}
VALIDATOR_BENCHMARK_CAPACITY={{ validator_benchmark_capacity }}
VALIDATOR_LONGMEM_CAPACITY={{ validator_longmem_capacity }}
VALIDATOR_INFERENCE_PROXY_REQUIRED={{ 'true' if validator_platform_inference_enforced else 'false' }}

{% if validator_wandb_enabled %}
# --- Public telemetry (opt-in aggregate stats to wandb) ---
WANDB_MODE={{ validator_wandb_mode }}
WANDB_PROJECT={{ validator_wandb_project }}
WANDB_ENTITY={{ validator_wandb_entity }}
{% endif %}

# --- Secrets (from Secret Manager; never commit these values) ---
VALIDATOR_MNEMONIC={{ validator_mnemonic }}
{% if validator_wandb_enabled %}
WANDB_API_KEY={{ validator_wandb_api_key }}
{% endif %}
{% if validator_pylon_identity_enabled | default(false) %}

# --- Pylon identity (write) path: put_weights via the co-located Pylon sidecar
# (validator_pylon role). Active when VALIDATOR_USE_SDK_WEIGHTS=false. Pylon
# holds the mounted hotkey and signs set_weights; these tokens authorize the
# worker. The ChainClient's permit/neuron reads also go through PYLON_URL.
PYLON_URL={{ validator_pylon_url }}
PYLON_IDENTITY_NAME={{ validator_pylon_identity_name }}
PYLON_IDENTITY_TOKEN={{ validator_pylon_identity_token }}
PYLON_OPEN_ACCESS_TOKEN={{ validator_pylon_open_access_token }}
{% endif %}
