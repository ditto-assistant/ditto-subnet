# Managed by Ansible (dittobench role) — do not edit by hand.
# Loopback DittoBench scoring engine for the SN118 validator: builds + runs
# untrusted miner harnesses in Docker, scores them, returns a ScoreReport.

# SSRF guard relaxed — REQUIRED on the validator (loopback sandbox containers,
# trusted presigned tarball URLs, and a single trusted local caller). See the
# role defaults for the full rationale. The VM firewall (IAP-SSH only) is what
# keeps :{{ dittobench_port }} off the public internet.
DITTOBENCH_ALLOW_PRIVATE_HARNESS={{ 'true' if dittobench_allow_private else 'false' }}
{% if dittobench_private_harness_dep %}

# Miner-harness Docker builds fetch the PRIVATE ditto-harness crate through this
# BuildKit gh_token secret file (mounted by internal/sandbox at build time).
GITHUB_TOKEN_FILE={{ dittobench_gh_token_file }}
{% endif %}

# OpenRouter models for the generator (paraphrase) + judge. The KEY is BYOK: the
# validator worker forwards it per request; it is NOT stored on disk here.
GENERATOR_MODEL={{ dittobench_generator_model }}
SCORER_MODEL={{ dittobench_scorer_model }}
DITTOBENCH_BROKER_PORT={{ dittobench_sandbox_host_broker_port }}
DITTOBENCH_MAX_CONCURRENT_RUNS={{ dittobench_max_concurrent_runs }}
DITTOBENCH_REQUIRE_TICKET_INFERENCE={{ 'true' if dittobench_ticket_inference_enforced else 'false' }}
DITTOBENCH_PLATFORM_INFERENCE_PROXY_URL={{ dittobench_platform_inference_proxy_url }}
DITTOBENCH_EMBEDDING_UPSTREAM_URL=http://127.0.0.1:11434/api/embed
{% if dittobench_relay_enabled | bool %}
HARNESS_GATEWAY_URL=http://127.0.0.1:{{ dittobench_relay_port }}
{% endif %}
{% if dittobench_sandbox_egress_enabled %}

# --- C-ISO: confine untrusted miner containers (see the dittobench role) -------
# internal/sandbox attaches each untrusted build to this isolated network and
# forces its outbound through the allowlisting proxy; a DOCKER-USER firewall
# drops any direct egress (fail-closed). HARDEN drops all Linux caps.
DITTOBENCH_SANDBOX_EGRESS_NETWORK={{ dittobench_sandbox_network }}
DITTOBENCH_SANDBOX_EGRESS_PROXY=http://{{ dittobench_egress_proxy_ip }}:{{ dittobench_egress_proxy_port }}
DITTOBENCH_SANDBOX_HARDEN={{ 'true' if dittobench_sandbox_harden else 'false' }}
{% endif %}
