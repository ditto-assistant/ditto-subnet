# Managed by Ansible. Never commit rendered values.
SCREENER_PLATFORM_API_URL={{ screener_fleet_platform_url }}
SCREENER_NODE_ENVIRONMENT={{ screener_fleet_environment }}
SCREENER_NODE_ID={{ screener_fleet_node_id }}
SCREENER_NODE_PROVIDER=hetzner
SCREENER_NODE_PROVIDER_RESOURCE_ID={{ screener_fleet_provider_resource_id }}
SCREENER_NODE_CREDENTIAL_FILE={{ screener_fleet_credential_file }}
SCREENER_REGISTRATION_TOKEN_FILE={{ screener_fleet_registration_token_file }}
SCREENER_SOURCE_REVIEW_API_KEY_FILE={{ screener_fleet_source_review_key_file }}
SCREENER_INSTANCE_ID={{ screener_fleet_node_id }}
NETUID={{ screener_fleet_netuid }}
# The persistent Hetzner worker owns the complete untrusted build/runtime path.
# It must never turn a lease into a remote Targon/Cloud Run dependency.
SCREENER_REMOTE_BUILD_MODE=off
SCREENER_REMOTE_BUILD_TIMEOUT_SECONDS={{ screener_fleet_build_timeout_seconds }}
SCREENER_SOURCE_REVIEW_TIMEOUT_SECONDS={{ screener_fleet_source_review_timeout_seconds }}
SCREENER_POLL_SECONDS=2
SCREENER_QUEUE_LIMIT=1
SCREENER_DOCKER_HOST={{ screener_fleet_rootless_docker_host }}
SCREENER_REQUIRE_ROOTLESS_DOCKER=1
SCREENER_EXECUTOR_USER={{ screener_fleet_executor_user }}
SCREENER_EXECUTOR_GROUP={{ screener_fleet_executor_group }}
SCREENER_EXECUTOR_HOME={{ screener_fleet_executor_home }}
