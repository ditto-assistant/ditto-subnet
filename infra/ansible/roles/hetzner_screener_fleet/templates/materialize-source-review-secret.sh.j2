#!/usr/bin/env bash
set -euo pipefail

certificate={{ screener_fleet_x509_certificate_file | quote }}
credential={{ screener_fleet_x509_credential_file | quote }}
secret_dir={{ screener_fleet_secrets_dir | quote }}
secret_file={{ screener_fleet_source_review_key_file | quote }}
temporary="$(mktemp "$secret_dir/.source-review-api-key.XXXXXX")"
trap 'rm -f "$temporary"' EXIT
umask 077

# Fail well before expiry instead of silently pinning the last materialized key.
openssl x509 -checkend 1209600 -noout -in "$certificate"
gcloud auth login --cred-file="$credential" --quiet >/dev/null
gcloud secrets versions access latest \
  --project={{ screener_fleet_gcp_project | quote }} \
  --secret={{ screener_fleet_source_review_secret_id | quote }} \
  >"$temporary"
test -s "$temporary"
# L2 and L4 deliberately reject any group/other permission bits.  The
# materializer owns the temporary file; the unit transfers ownership to the
# worker only after this atomic replacement completes.
chmod 0400 "$temporary"
mv -f "$temporary" "$secret_file"
trap - EXIT
