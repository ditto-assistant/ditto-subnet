[Unit]
Description=Authenticate and transactionally update the Ditto screener fleet
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
# Keep systemd's default root identity. An explicit User=root combined with
# NoNewPrivileges strips CAP_SETUID before the updater can drop privileges.
Environment=SCREENER_FLEET_ROOT={{ screener_fleet_root }}
Environment=SCREENER_FLEET_RELEASES_DIR={{ screener_fleet_releases_dir }}
Environment=SCREENER_FLEET_CURRENT_LINK={{ screener_fleet_current }}
Environment=SCREENER_FLEET_UPDATE_STATE_DIR={{ screener_fleet_update_state_dir }}
Environment=SCREENER_FLEET_CONFIG_DIR={{ screener_fleet_config_dir }}
Environment=SCREENER_FLEET_RELEASE_ENV={{ screener_fleet_release_env_file }}
Environment=SCREENER_FLEET_RELEASE_CHANNEL={{ screener_fleet_release_channel }}
Environment=SCREENER_FLEET_USER={{ screener_fleet_user }}
Environment=SCREENER_FLEET_GROUP={{ screener_fleet_group }}
Environment=SCREENER_FLEET_WORKER_PROCESSES={{ screener_fleet_worker_processes }}
Environment=HOME={{ screener_fleet_update_state_dir }}
ExecStart=/usr/local/sbin/ditto-screener-fleet-auto-update
TimeoutStartSec=70min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths={{ screener_fleet_root }} {{ screener_fleet_config_dir }} {{ screener_fleet_state_dir }} /usr/local/sbin/ditto-screener-fleet-auto-update
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077
