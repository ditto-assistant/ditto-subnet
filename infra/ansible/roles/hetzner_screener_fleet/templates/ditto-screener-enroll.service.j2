[Unit]
Description=Enroll {{ screener_fleet_node_id }} with Ditto Platform
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User={{ screener_fleet_user }}
Group={{ screener_fleet_group }}
WorkingDirectory={{ screener_fleet_worker_dir }}
EnvironmentFile={{ screener_fleet_env_file }}
ExecStart={{ screener_fleet_worker_venv }}/bin/ditto-screener-enroll
RemainAfterExit=yes
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ screener_fleet_config_dir }}
UMask=0077

[Install]
WantedBy=multi-user.target
