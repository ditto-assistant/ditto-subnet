[Unit]
Description=Materialize the review-only key through subnet-screener-1 X.509 federation
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User={{ screener_fleet_secret_agent_user }}
Group={{ screener_fleet_group }}
Environment=HOME={{ screener_fleet_x509_identity_dir }}
Environment=CLOUDSDK_CONFIG={{ screener_fleet_x509_cloudsdk_config }}
Environment=GOOGLE_APPLICATION_CREDENTIALS={{ screener_fleet_x509_credential_file }}
Environment=GOOGLE_API_CERTIFICATE_CONFIG={{ screener_fleet_x509_cloudsdk_config }}/certificate_config.json
ExecStart=/usr/local/sbin/ditto-screener-source-review-secret
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ screener_fleet_x509_cloudsdk_config }} {{ screener_fleet_secrets_dir }}
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
UMask=0077
