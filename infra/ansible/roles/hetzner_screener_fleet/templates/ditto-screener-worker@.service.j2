[Unit]
Description=Ditto screener worker %i on {{ screener_fleet_node_id }}
After=network-online.target ditto-screener-enroll.service ditto-screener-fleet-agent.service
Wants=network-online.target
Requires=ditto-screener-enroll.service

[Service]
Type=simple
User={{ screener_fleet_user }}
Group={{ screener_fleet_group }}
WorkingDirectory={{ screener_fleet_active_worker_dir }}
EnvironmentFile={{ screener_fleet_env_file }}
# The node credential is intentionally shared by its local workers, but their
# signed heartbeat identities must remain distinct so concurrent jobs do not
# overwrite each other in Platform telemetry.
Environment=SCREENER_INSTANCE_ID={{ screener_fleet_node_id }}-worker-%i
Environment=SCREENER_REVIEW_JOURNAL_FILE={{ screener_fleet_state_dir }}/workers/%i/review.jsonl
Environment=SCREENER_REVIEW_SETTINGS_CACHE_FILE={{ screener_fleet_state_dir }}/workers/%i/review-settings.json
Environment=SCREENER_L2_CACHE_DIR={{ screener_fleet_state_dir }}/workers/%i/l2-cache
Environment=SCREENER_L2_AUDIT_JOURNAL_FILE={{ screener_fleet_state_dir }}/workers/%i/l2-audit.jsonl
Environment=SCREENER_L2_WORKSPACE_ROOT={{ screener_fleet_l2_workspace_root }}/%i
# BuildKit persists its CLI state under DOCKER_CONFIG. Keep that state inside
# the worker's allowed directory rather than the immutable release root.
Environment=DOCKER_CONFIG={{ screener_fleet_state_dir }}/workers/%i/docker
# Rootless Docker cannot bind-mount a service's PrivateTmp. Keep the ephemeral
# fake-gateway counter in the same host-visible per-worker state directory.
Environment=SCREENER_GATEWAY_STATE_ROOT={{ screener_fleet_state_dir }}/workers/%i/gateway-state
ExecStart={{ screener_fleet_active_worker_venv }}/bin/ditto-screener
Restart=always
RestartSec=10
TimeoutStopSec=35min
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ screener_fleet_state_dir }}/workers/%i {{ screener_fleet_l2_workspace_root }}/%i {{ screener_fleet_config_dir }} {{ screener_fleet_bittensor_dir }}
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
DevicePolicy=closed
UMask=0077

[Install]
WantedBy=multi-user.target
