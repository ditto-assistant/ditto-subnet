[Unit]
Description=Approved private shadow Coding {{ 'cohort' if coding_hosted_worker_mode == 'rollout' else 'attempt' }}
Requires=ditto-coding-hosted-egress.service user@{{ coding_hosted_uid }}.service
After=ditto-coding-hosted-egress.service user@{{ coding_hosted_uid }}.service
BindsTo=ditto-coding-hosted-egress.service user@{{ coding_hosted_uid }}.service

[Service]
Type=exec
User=ditto-coding-hosted
Group=ditto-coding-hosted
Slice=system.slice
Delegate=no
UMask=0077
WorkingDirectory=/var/lib/ditto-coding-hosted
{% if coding_hosted_worker_mode == 'rollout' %}
ExecStartPre=+/usr/bin/python3 -I /usr/local/lib/ditto-coding-hosted/connectivity-policy.py install-rollout {{ coding_hosted_rollout_connectivity_sha256 }}
ExecStart=/usr/bin/env -i PATH=/usr/bin:/bin LANG=C.UTF-8 LC_ALL=C.UTF-8 {{ coding_hosted_worker_python }} -B -I -m ditto.coding_bounded_rollout --bounded-shadow-once --config {{ coding_hosted_worker_config }} --approval-sha256 {{ coding_hosted_rollout_approval_sha256 }} --connectivity-sha256 {{ coding_hosted_rollout_connectivity_sha256 }}
{% else %}
ExecStartPre=+/usr/bin/python3 -I /usr/local/lib/ditto-coding-hosted/connectivity-policy.py install
ExecStart=/usr/bin/env -i PATH=/usr/bin:/bin LANG=C.UTF-8 LC_ALL=C.UTF-8 {{ coding_hosted_worker_python }} -I -m ditto.coding_hosted_worker --private-shadow-once --config {{ coding_hosted_worker_config }}
{% endif %}
ExecStopPost=+/usr/bin/python3 -I /usr/local/lib/ditto-coding-hosted/connectivity-policy.py revoke
Restart=no
KillMode={{ 'mixed' if coding_hosted_worker_mode == 'rollout' else 'control-group' }}
TimeoutStartSec=60
TimeoutStopSec=35min
NoNewPrivileges=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
{% if coding_hosted_router_namespace == 'rootless-netns' %}
# The in-namespace router listener needs RootlessKit's child pid, which is
# written below the daemon user's runtime directory. Expose only that file.
# systemd creates the bind's missing parents as root 0755 with the umask blocked
# during namespace setup, so UMask=0077 cannot hide them from the worker
# (verified under systemd 255 and 257).
ProtectHome=tmpfs
BindReadOnlyPaths=/run/user/{{ coding_hosted_uid }}/dockerd-rootless/child_pid
{% else %}
ProtectHome=yes
{% endif %}
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_NETLINK
StandardOutput=null
StandardError=null
# No Install section: operator start only, never boot or automatic restart.
