# Managed by infra/ansible/roles/river_worker. Loaded by systemd EnvironmentFile.
# Secrets (API keys) come from GCP Secret Manager via the VM's attached service
# account (ADC) — no credentials file needed, unlike the Hetzner box.
# The worker is on the VM, so it reaches Postgres directly on localhost:5432.
DITTO_ENV={{ river_worker_env }}
BARE_METAL=true
GCLOUD_PROJECT={{ gcp_project | default('ditto-app-dev') }}
GCLOUD_LOCATION={{ gcp_region | default('us-central1') }}
SUPABASE_DIRECT_URI=postgresql://{{ postgres_app_user }}:{{ worker_pg_password }}@localhost:5432/{{ river_worker_db_name }}
SUPABASE_SESSION_POOLER_URI=postgresql://{{ postgres_app_user }}:{{ worker_pg_password }}@localhost:5432/{{ river_worker_db_name }}
DITTO_CONTENT_ENDPOINT=https://s3.us-east-005.backblazeb2.com
DITTO_CONTENT_REGION=us-east-005
DITTO_CONTENT_BUCKET=ditto-content
DITTO_CONTENT_PREFIX=https://ditto-content.s3.us-east-005.backblazeb2.com/
