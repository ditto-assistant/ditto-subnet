[Unit]
Description=Restrict inbound dedicated coding-executor scorer capabilities
After=network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=CODING_EXECUTOR_CAPABILITY_GATEWAY={{ coding_executor_capability_gateway if (coding_executor_capability_ingress_enabled | bool) else '' }}
Environment=CODING_EXECUTOR_CAPABILITY_SOURCE_CIDR={{ coding_executor_capability_source_cidr if (coding_executor_capability_ingress_enabled | bool) else '' }}
Environment=CODING_EXECUTOR_CAPABILITY_PORT={{ coding_executor_capability_port }}
ExecStart=/usr/local/lib/ditto-coding-executor/executor-capability-ingress-guard.sh

[Install]
WantedBy=multi-user.target
