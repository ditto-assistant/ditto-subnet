# Managed by Ansible (validator_pylon role) — do not edit by hand.
# Pylon identity (write) sidecar for the SN118 validator. Mirrors the validated
# platform docker-compose `pylon` service. Pylon loads the mounted hotkey and
# signs set_weights itself; PYLON_ID_VALIDATOR_TOKEN must equal the worker's
# PYLON_IDENTITY_TOKEN.

# Open-access (read) token — shared with the worker's PYLON_OPEN_ACCESS_TOKEN.
PYLON_OPEN_ACCESS_TOKEN={{ pylon_open_access_token }}
PYLON_RECENT_OBJECTS_NETUIDS=[{{ validator_pylon_netuid }}]

# Target chain (mirror the worker's SUBTENSOR_NETWORK).
PYLON_BITTENSOR_NETWORK={{ validator_pylon_bittensor_network }}
PYLON_BITTENSOR_ARCHIVE_NETWORK={{ validator_pylon_bittensor_network }}

# --- Write identity (put_weights) ---
PYLON_IDENTITIES=["{{ validator_pylon_identity_name }}"]
PYLON_ID_VALIDATOR_NETUID={{ validator_pylon_netuid }}
PYLON_ID_VALIDATOR_WALLET_NAME={{ validator_pylon_wallet_name }}
PYLON_ID_VALIDATOR_HOTKEY_NAME={{ validator_pylon_hotkey_name }}
PYLON_ID_VALIDATOR_TOKEN={{ pylon_identity_token }}

# The RO-mounted wallet dir inside the container.
PYLON_BITTENSOR_WALLET_PATH=/root/.bittensor/wallets
