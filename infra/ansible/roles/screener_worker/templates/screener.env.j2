# Managed by Ansible (screener_worker role) — do not edit by hand.
# Stateless SN118 screener worker: drains the platform's `uploaded` queue,
# reuses the Targon Kaniko archive and runtime smoke, and posts a signed
# verdict. Local Docker is residual fallback only.

SCREENER_PLATFORM_API_URL={{ screener_platform_api_url }}
NETUID={{ screener_netuid }}
SCREENER_HOTKEY={{ screener_hotkey }}
SCREENER_POLL_SECONDS={{ screener_poll_seconds }}
SCREENER_QUEUE_LIMIT={{ screener_queue_limit }}
SCREENER_BUILD_TIMEOUT_SECONDS={{ screener_build_timeout_seconds }}
SCREENER_REMOTE_BUILD_TIMEOUT_SECONDS={{ screener_remote_build_timeout_seconds }}
SCREENER_REMOTE_BUILD_MODE={{ screener_remote_build_mode }}
SCREENER_RUN_TIMEOUT_SECONDS={{ screener_run_timeout_seconds }}
SCREENER_BUILD_MEMORY={{ screener_build_memory }}
SCREENER_IMAGE_BUILD_MEMORY={{ screener_image_build_memory }}
SCREENER_PIDS_LIMIT={{ screener_pids_limit }}
SCREENER_MAX_TARBALL_BYTES={{ screener_max_tarball_bytes }}
SCREENER_DOCKER_HOST={{ screener_docker_host }}
DOCKER_HOST={{ screener_docker_host }}
SCREENER_REQUIRE_ROOTLESS_DOCKER=1
SCREENER_EXECUTOR_USER={{ screener_executor_user }}
SCREENER_EXECUTOR_GROUP={{ screener_executor_group }}
SCREENER_EXECUTOR_HOME={{ screener_executor_home }}

# --- Secrets (from Secret Manager; never commit these values) ---
SCREENER_MNEMONIC={{ screener_mnemonic }}
{% if screener_api_token | default('') | length > 0 %}
SCREENER_API_TOKEN={{ screener_api_token }}
{% endif %}
