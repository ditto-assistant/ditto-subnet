{
  "schema": "ditto-coding-hosted-guarded-run/v1",
  "operation": "postgres-environment-materialize",
  "playbook": "playbooks/gcp-coding-hosted-postgres-environment.yml",
  "limit": "ditto-coding-hosted-v2",
  "enabled_var": "coding_hosted_postgres_environment_enabled",
  "confirmation_var": "coding_hosted_postgres_environment_confirmation",
  "confirmation": "MATERIALIZE NATIVE CODING POSTGRES ENVIRONMENT",
  "revision_var": "coding_hosted_postgres_environment_source_revision",
  "nonsecret_env_vars": [
    {
      "env": "DITTO_CODING_PG_HOST",
      "var": "coding_hosted_postgres_environment_host",
      "pattern": "10[.]30[.]0[.](?:[2-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-3])",
      "max_length": 15
    }
  ],
  "secret_env": [
    {
      "name": "DITTO_CODING_PG_PASSWORD",
      "charset": "single_line",
      "prefix": "",
      "min_length": 1,
      "max_length": 1024
    }
  ],
  "distinct_secret_values": false,
  "forbidden_env": [],
  "forbidden_env_prefixes": []
}
