# Copy to .env and paste your OpenRouter key. Then:
#   ollama serve && ollama pull embeddinggemma   # embeddings for memory
#   cargo run -- seed-user                        # load the dummy seed user
#   cargo run -- playground                       # open http://127.0.0.1:8088
OPENROUTER_API_KEY=sk-or-v1-your-key-here
# Provider for the CHAT model (embeddings always use Ollama embeddinggemma):
DITTOBENCH_PROVIDER=openrouter
# Chat model for LOCAL practice. Benchmark v7 scoring locks this same model
# through the platform-owned OpenRouter relay and overrides this local value.
DITTOBENCH_MODEL=openai/gpt-oss-20b
# For fully local development, use these values instead (no provider key):
# DITTOBENCH_PROVIDER=ollama
# DITTOBENCH_MODEL=gpt-oss:20b
OLLAMA_BASE_URL=http://localhost:11434
DITTOBENCH_DB=./dittobench.db

# Playground "Submit" tab: hosted practice (see README "Hosted practice").
DITTOBENCH_API_URL=https://dittobench-api-22790208601.us-central1.run.app
# Public URL of your `serve` harness; the hosted validator must be able to
# reach it (e.g. `ngrok http 8080`):
DITTOBENCH_HARNESS_URL=http://localhost:8080
# Legacy/local source-build target for this reference (not used by V7/V8 validators):
DITTOBENCH_CRATE_GIT=https://github.com/ditto-assistant/ditto-subnet
DITTOBENCH_CRATE_REF=main
DITTOBENCH_CRATE_SUBDIR=miners/dittobench-starter-kit
