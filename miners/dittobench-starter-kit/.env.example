# Copy to .env and choose one LOCAL chat configuration below. Then:
#   ollama serve && ollama pull embeddinggemma
#   cd ../.. && uv run ditto practice --run-size small
# The practice command starts this harness plus the monorepo's local v9 scorer,
# supplies a validator-visible tool_endpoint, prints the report, and tears down.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# LOCAL chat model. Canonical v9 scoring ignores these values and injects the
# locked GPT-OSS-20B model through a ticket-bound platform relay.
DITTOBENCH_PROVIDER=openrouter
DITTOBENCH_MODEL=openai/gpt-oss-20b

# Fully local chat (no provider key):
# DITTOBENCH_PROVIDER=ollama
# DITTOBENCH_MODEL=gpt-oss:20b

# LOCAL memory embeddings. The reference kit reads only OLLAMA_BASE_URL and
# uses embeddinggemma at 768 dimensions; DITTOBENCH_EMBED_PROVIDER,
# DITTOBENCH_EMBED_MODEL, and DITTOBENCH_EMBED_BASE_URL are not kit settings.
# Canonical v9 validators replace OLLAMA_BASE_URL with their ticket-bound,
# Ollama-compatible gateway. That gateway locks the reviewed OpenRouter profile
# `dittobench-v7-openrouter-pplx-embed-v1-0.6b-768-v1`, backed only by
# `perplexity/pplx-embed-v1-0.6b`; miners do not configure or receive its key.
OLLAMA_BASE_URL=http://localhost:11434
DITTOBENCH_DB=./dittobench.db

# Playground "Submit" tab: HOSTED REHEARSAL (see README "Hosted rehearsal").
# A public harness_url cannot reach the hosted scorer's loopback tool endpoint,
# so observable tool cases are capped there. Use `uv run ditto practice` for observed
# tool scoring; neither path is screening/submission certification.
DITTOBENCH_API_URL=https://dittobench-api-22790208601.us-central1.run.app
# Public URL of your `serve` harness; the hosted validator must be able to
# reach it (e.g. `ngrok http 8080`). localhost will not work remotely:
DITTOBENCH_HARNESS_URL=https://replace-with-your-public-tunnel.example
# Optional source-build target for local practice (not used by v9 validators):
DITTOBENCH_CRATE_GIT=https://github.com/ditto-assistant/ditto-subnet
DITTOBENCH_CRATE_REF=main
DITTOBENCH_CRATE_SUBDIR=miners/dittobench-starter-kit
