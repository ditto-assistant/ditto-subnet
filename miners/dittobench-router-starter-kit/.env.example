# The scored router reaches exactly one upstream: the validator's locked,
# ticket-scoped relay. Both values are injected by the validator at run time
# and must never be committed. No provider credential belongs here or anywhere
# in the image; the relay holds the real provider keys.
DITTOBENCH_RELAY_BASE_URL=
DITTOBENCH_RELAY_TICKET=

# Optional reference lever (off by default). When enabled, small "aside"
# Anthropic Messages requests (title/probe shapes) are rerouted to a cheaper
# catalog route id. Set the target to a route id that exists in the frozen
# task catalog; leaving it unset keeps the router a faithful pass-through.
DITTOBENCH_ROUTER_REROUTE_ASIDES=
DITTOBENCH_ROUTER_ASIDE_MODEL=
