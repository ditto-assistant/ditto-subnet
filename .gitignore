context-docs/

# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
dist/
build/
*.egg-info/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
**/.tmp/pprof/

# Env files. Every variant is ignored; the tracked templates are re-included.
.env
.env.*
!.env.example
.envrc
.validator-update/

# Private keys and certificate bundles (never commit)
*.pem
*.key
*.p12
*.pfx

# Local docker-compose overrides for dev / smoke testing. Tracked
# baseline is docker-compose.yml; this pattern is for per-developer
# overrides (chain endpoints, port mappings, etc.) that should never
# be committed.
docker-compose.override.yml
docker-compose.*.override.yml

# IDE
.idea/

# Local credential drops (never commit)
docs/wandb-keys.yml

# Local validator env (holds OpenRouter key + Pylon tokens)
validator.env

# Weights & Biases local run artifacts
wandb/

# Local agent worktrees and night-shift scratch
worktrees/
.worktrees/
.claude/night-shift/
infra/ansible/inventory/hetzner-screener.yml
