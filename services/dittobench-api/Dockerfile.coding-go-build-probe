# Public development fixture only, not a selectable grader runtime.
FROM golang:1.27.1-bookworm@sha256:648f440f42a0958804efb24df176f806f9d353b41f1c0627f666428e40310f6b AS build
WORKDIR /src/services/dittobench-api
COPY services/dittobench-api/go.mod services/dittobench-api/go.sum ./
COPY research/dittobench-datagen/go.mod /src/research/dittobench-datagen/go.mod
RUN go mod download
COPY services/dittobench-api/internal/ ./internal/
COPY services/dittobench-api/coding_runtime/go/build-probe.go ./coding_runtime/go/build-probe.go
COPY services/dittobench-api/coding_runtime/go/private-probe.go ./coding_runtime/go/private-probe.go
COPY services/dittobench-api/coding_runtime/compiled/bootstrap.c /src/bootstrap.c
RUN mkdir /out && cc -O2 -Wall -Wextra -Werror /src/bootstrap.c -o /out/bootstrap \
    && CGO_ENABLED=0 go build -trimpath -o /out/probe ./coding_runtime/go/build-probe.go \
    && CGO_ENABLED=0 go build -trimpath -o /out/private-probe ./coding_runtime/go/private-probe.go

FROM golang:1.27.1-bookworm@sha256:648f440f42a0958804efb24df176f806f9d353b41f1c0627f666428e40310f6b
LABEL io.heyditto.dittobench.coding-supervisor-fixture="true"
COPY --from=build --chmod=0555 /out/bootstrap /usr/local/libexec/dittobench-compiled-bootstrap
COPY --from=build --chmod=0555 /out/probe /opt/go-build-probe
COPY --from=build --chmod=0555 /out/private-probe /opt/go-private-probe
WORKDIR /workspace
ENTRYPOINT ["/opt/go-build-probe"]
