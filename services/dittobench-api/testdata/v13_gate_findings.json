    "catalog_gate_zeroed": {"gate": "catalog", "zeroing": true},
    "memory_only_catalog": {"gate": "catalog", "zeroing": false},
    "offer_inferred_from_execution": {"gate": "catalog", "zeroing": false},
    "catalog_present_lower_bound": {"gate": "catalog", "zeroing": false},
    "claim_attribution_uncorroborated": {"gate": "catalog", "zeroing": false},
    "no_model_completion": {"gate": "shared", "zeroing": false},
    "served_text_not_model_emitted": {"gate": "claim_provenance", "zeroing": true},
    "answer_in_prompt": {"gate": "claim_provenance", "zeroing": true},
    "claim_provenance_unavailable": {"gate": "claim_provenance", "zeroing": false},
    "claim_provenance_incomplete": {"gate": "claim_provenance", "zeroing": false},
