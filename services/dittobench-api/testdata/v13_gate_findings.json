    "swallowed_model_call": {"gate": "catalog", "zeroing": true},
    "semantic_preloading_safe_harbor": {"gate": "catalog", "zeroing": false},
    "catalog_evidence_unavailable": {"gate": "catalog", "zeroing": false},
