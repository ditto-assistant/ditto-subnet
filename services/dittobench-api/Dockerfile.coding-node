FROM golang:1.27.1-alpine@sha256:cf6fca6641884b8433441b2b0652976f975e1d0fdd26d177eaaf8596087f3125 AS supervisor
WORKDIR /src/services/dittobench-api
COPY services/dittobench-api/go.mod services/dittobench-api/go.sum ./
COPY research/dittobench-datagen/go.mod /src/research/dittobench-datagen/go.mod
RUN go mod download
COPY services/dittobench-api/internal/ /src/services/dittobench-api/internal/
COPY services/dittobench-api/cmd/dittobench-coding-supervisor/ /src/services/dittobench-api/cmd/dittobench-coding-supervisor/
COPY research/dittobench-datagen/ /src/research/dittobench-datagen/
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags="-s -w" \
    -o /out/supervisor ./cmd/dittobench-coding-supervisor

FROM node:24.22.1-bookworm@sha256:6449e19d8184d84062525b6a7524def03146c2cb04a7f08b076680d0e8e4240a AS build
COPY services/dittobench-api/coding_runtime/node/confinement.c /src/confinement.c
RUN cc -shared -fPIC -O2 -Wall -Wextra -Werror -I/usr/local/include/node \
    /src/confinement.c -o /confinement.node
WORKDIR /opt/coding-node
COPY services/dittobench-api/coding_runtime/node/package.json services/dittobench-api/coding_runtime/node/package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund

FROM node:24.22.1-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205 AS node
FROM scratch AS runtime-base
COPY --from=node / /
ENV PATH=/usr/local/bin:/usr/bin:/bin
LABEL io.heyditto.dittobench.coding-supervisor-contract="1"
LABEL io.heyditto.dittobench.coding-test-driver-profile="node-call-ast-v2"
COPY --from=supervisor --chmod=0555 /out/supervisor /usr/local/bin/dittobench-coding-supervisor
COPY --from=build --chmod=0555 /confinement.node /opt/coding-node/confinement.node
COPY --from=build /opt/coding-node/node_modules /opt/coding-node/node_modules
COPY --chmod=0444 services/dittobench-api/coding_runtime/node/child.cjs services/dittobench-api/coding_runtime/node/wire.cjs services/dittobench-api/coding_runtime/node/suite.cjs services/dittobench-api/coding_runtime/node/channel.cjs services/dittobench-api/coding_runtime/node/driver.cjs /opt/coding-node/
COPY --chmod=0555 services/dittobench-api/coding_runtime/node/entrypoint.cjs /usr/local/bin/dittobench-test-driver
ENTRYPOINT ["/usr/local/bin/dittobench-coding-supervisor"]

FROM runtime-base AS test
LABEL io.heyditto.dittobench.coding-supervisor-fixture="true"
COPY --chmod=0400 services/dittobench-api/coding_runtime/node/supervisor-probe.cjs /opt/probe.cjs

FROM runtime-base AS runtime
ARG DITTOBENCH_SOURCE_SHA=unknown
LABEL org.opencontainers.image.revision="${DITTOBENCH_SOURCE_SHA}"
