# Public development qualification fixture; NOT an approved executor runtime.
FROM node:26.8-bookworm@sha256:e7bc1a4cd2419953c91f9a6f7bb6efb3737773093fb4ded0b1c77a0a5831fac4 AS build
COPY services/dittobench-api/coding_runtime/node/confinement.c /src/confinement.c
RUN cc -shared -fPIC -O2 -Wall -Wextra -Werror -I/usr/local/include/node \
    /src/confinement.c -o /confinement.node
WORKDIR /opt/coding-node
COPY services/dittobench-api/coding_runtime/node/package.json services/dittobench-api/coding_runtime/node/package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund

FROM node:26.8-bookworm-slim@sha256:cd9f682fa2885cd1056e830424764158570061c59736a1da836bc3d73df095ae
LABEL io.heyditto.dittobench.coding-supervisor-fixture="true"
COPY --from=build --chmod=0555 /confinement.node /opt/coding-node/confinement.node
COPY --from=build /opt/coding-node/node_modules /opt/coding-node/node_modules
COPY --chmod=0444 services/dittobench-api/coding_runtime/node/confinement-probe.cjs /opt/coding-node/probe.cjs
COPY --chmod=0444 services/dittobench-api/coding_runtime/node/child.cjs services/dittobench-api/coding_runtime/node/wire.cjs services/dittobench-api/coding_runtime/node/bridge-probe.cjs /opt/coding-node/
ENTRYPOINT ["/usr/local/bin/node", "/opt/coding-node/probe.cjs"]
