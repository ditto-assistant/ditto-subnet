FROM python:3.12-slim

WORKDIR /longmemeval
COPY requirements-lite.txt ./
RUN pip install --no-cache-dir -r requirements-lite.txt
# openai 1.35.1 predates httpx 0.28's removal of the `proxies` argument.
RUN pip install --no-cache-dir httpx==0.27.2
COPY src/evaluation ./src/evaluation

ENTRYPOINT ["python3", "src/evaluation/evaluate_qa.py"]
