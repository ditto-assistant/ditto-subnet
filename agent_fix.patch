def check_cla_before_upload(platform_url: str, hotkey: str) -> None:
    """Pre-flight check preventing upload packaging/payment if CLA signature is missing."""
    import requests
    import typer

    url = f"{platform_url.rstrip('/')}/api/v1/cla/status/{hotkey}"
    try:
        resp = requests.get(url, timeout=10)
        if resp.status_code == 200:
            data = resp.json()
            if data.get("gate_mode") == "enforce" and not data.get("is_current"):
                typer.secho(
                    f"\n[ERROR] Hotkey {hotkey} has not signed the current CLA "
                    f"({data.get('effective_version')}).\n"
                    f"Please run 'uv run ditto cla sign' before uploading.\n",
                    fg=typer.colors.RED,
                    bold=True,
                )
                raise typer.Exit(code=1)
    except requests.RequestException as e:
        typer.secho(f"Warning: Could not verify CLA status prior to upload: {e}", fg=typer.colors.YELLOW)
