### 6. Public CLA Endpoints: `apps/platform/ditto/api_server/endpoints/cla.py`

```python
"""API endpoints for CLA retrieval, status inspection, and signature ingestion."""

from __future__ import annotations

from typing import Any
from fastapi import APIRouter, Depends, HTTPException, status
from pydantic import BaseModel, Field
from sqlalchemy.orm import Session

try:
    from apps.platform.ditto.api_server.deps import get_db  # type: ignore
except ImportError:
    def get_db():
        raise NotImplementedError

from apps.platform.ditto.api_server.cla_service import (
    get_current_cla_version,
    get_hotkey_cla_signature,
    record_cla_signature,
)

router = APIRouter(prefix="/api/v1/cla", tags=["cla"])


class CLACurrentResponse(BaseModel):
    version: str
    sha256: str
    text: str
    published_at: str
    effective_at: str


class CLAStatusResponse(BaseModel):
    hotkey: str
    signed: bool
    version: str | None = None
    digest: str | None = None
    sha256: str | None = None
    signed_at: str | None = None
    signature: str | None = None
    is_current: bool = False


class CLASignRequest(BaseModel):
    netuid: int = Field(..., description="Bittensor Subnet NetUID")
    hotkey: str = Field(..., description="SS58 Hotkey Address")
    cla_version: str = Field(..., description="Version of the CLA being signed")
    cla_sha256: str = Field(..., description="SHA-256 digest of the CLA text")
    signature: str = Field(..., description="sr25519 signature")
    nonce: str = Field(..., description="Unique nonce")
    issued_at: int = Field(..., description="Unix epoch timestamp when signed")


@router.get("/current", response_model=CLACurrentResponse)
def get_current_cla(db: Session = Depends(get_db)) -> Any:
    current = get_current_cla_version(db)
    if not current:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail="No active CLA version configured.")
    return CLACurrentResponse(
        version=current.version,
        sha256=current.sha256,
        text=current.text,
        published_at=current.published_at.isoformat(),
        effective_at=current.effective_at.isoformat(),
    )


@router.get("/status/{hotkey}", response_model=CLAStatusResponse)
def get_cla_status(hotkey: str, db: Session = Depends(get_db)) -> Any:
    current = get_current_cla_version(db)
    sig = get_hotkey_cla_signature(db, hotkey)
    if not sig:
        return CLAStatusResponse(hotkey=hotkey, signed=False, is_current=False)

    is_current = bool(current and sig.cla_version == current.version and sig.cla_sha256 == current.sha256)
    return CLAStatusResponse(
        hotkey=hotkey,
        signed=True,
        version=sig.cla_version,
        digest=sig.cla_sha256,
        sha256=sig.cla_sha256,
        signed_at=sig.signed_at.isoformat(),
        signature=sig.signature,
        is_current=is_current,
    )


@router.post("/sign")
def sign_cla(payload: CLASignRequest, db: Session = Depends(get_db)) -> Any:
    try:
        record = record_cla_signature(
            db=db,
            netuid=payload.netuid,
            hotkey=payload.hotkey,
            cla_version=payload.cla_version,
            cla_sha256=payload.cla_sha256,
            signature=payload.signature,
            nonce=payload.nonce,
            issued_at=payload.issued_at,
        )
        return {
            "status": "success",
            "hotkey": record.hotkey,
            "coldkey": record.coldkey,
            "cla_version": record.cla_version,
            "signed_at": record.signed_at.isoformat(),
        }
    except ValueError as exc:
        raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail=str(exc))
