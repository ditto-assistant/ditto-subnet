+"""CLI command for signing and checking the Contributor License Agreement (CLA)."""
+
+from __future__ import annotations
+
+import uuid
+from datetime import datetime, timezone
+import httpx
+import typer
+from rich.console import Console
+from rich.panel import Panel
+
+from ditto.cla import build_cla_message, compute_cla_sha256
+from ditto.miner_cli.config import get_settings
+from ditto.miner_cli.subtensor import (
+    get_hotkey_keypair,
+    resolve_wallet,
+)
+
+console = Console()
+cla_app = typer.Typer(help="Manage Contributor License Agreement (CLA) signatures.")
+
+
+@cla_app.command(name="status")
+def status_command(
+    wallet_name: str | None = typer.Option(
+        None, "--wallet-name", "-w", help="Bittensor wallet name."
+    ),
+    hotkey_name: str | None = typer.Option(
+        None, "--hotkey-name", "-k", help="Bittensor hotkey name."
+    ),
+    hotkey_ss58: str | None = typer.Option(
+        None, "--hotkey", help="Explicit SS58 hotkey address to check."
+    ),
+) -> None:
+    """Check whether a hotkey has signed the current CLA."""
+    settings = get_settings()
+    target_hotkey = hotkey_ss58
+    if not target_hotkey:
+        _, resolved_hotkey = resolve_wallet(wallet_name, hotkey_name)
+        keypair = get_hotkey_keypair(resolved_hotkey)
+        target_hotkey = keypair.ss58_address
+
+    platform_url = settings.PLATFORM_API_URL.rstrip("/")
+    url = f"{platform_url}/api/v1/cla/status/{target_hotkey}"
+
+    try:
+        with httpx.Client(timeout=10.0) as client:
+            resp = client.get(url)
+            if resp.status_code != 200:
+                console.print(f"[red]Error fetching CLA status: {resp.text}[/red]")
+                raise typer.Exit(code=1)
+            data = resp.json()
+    except Exception as e:
+        console.print(f"[red]Failed to connect to Platform: {e}[/red]")
+        raise typer.Exit(code=1)
+
+    signed = data.get("signed", False)
+    is_current = data.get("is_current", False)
+    version = data.get("cla_version")
+    current_version = data.get("current_effective_version")
+    signed_at = data.get("signed_at")
+
+    console.print(Panel(
+        f"[bold]Hotkey:[/bold] {target_hotkey}\n"
+        f"[bold]Signed:[/bold] {'[green]Yes[/green]' if signed else '[red]No[/red]'}\n"
+        f"[bold]Is Current:[/bold] {'[green]Yes[/green]' if is_current else '[yellow]No (Requires Re-signing)[/yellow]'}\n"
+        f"[bold]Signed Version:[/bold] {version or 'None'}\n"
+        f"[bold]Effective Version:[/bold] {current_version or 'Unknown'}\n"
+        f"[bold]Signed At:[/bold] {signed_at or 'Never'}",
+        title="SN118 Contributor License Agreement (CLA) Status",
+    ))
+
+
+@cla_app.command(name="sign")
+def sign_command(
+    wallet_name: str | None = typer.Option(
+        None, "--wallet-name", "-w", help="Bittensor wallet name."
+    ),
+    hotkey_name: str | None = typer.Option(
+        None, "--hotkey-name", "-k", help="Bittensor hotkey name."
+    ),
+    yes: bool = typer.Option(
+        False, "--yes", "-y", help="Skip confirmation prompt (requires typed agreement if false)."
+    ),
+) -> None:
+    """Download current CLA, display digest, and sign it with your hotkey."""
+    settings = get_settings()
+    _, resolved_hotkey = resolve_wallet(wallet_name, hotkey_name)
+    keypair = get_hotkey_keypair(resolved_hotkey)
+    hotkey_ss58 = keypair.ss58_address
+
+    platform_url = settings.PLATFORM_API_URL.rstrip("/")
+
+    # 1. Fetch current CLA
+    current_url = f"{platform_url}/api/v1/cla/current"
+    try:
+        with httpx.Client(timeout=10.0) as client:
+            resp = client.get(current_url)
+            if resp.status_code != 200:
+                console.print(f"[red]Error fetching current CLA from platform: {resp.text}[/red]")
+                raise typer.Exit(code=1)
+            cla_data = resp.json()
+    except Exception as e:
+        console.print(f"[red]Failed to connect to Platform: {e}[/red]")
+        raise typer.Exit(code=1)
+
+    version = cla_data["version"]
+    expected_sha256 = cla_data["sha256"]
+    content = cla_data["content"]
+
+    # 2. Recompute SHA-256
+    actual_sha256 = compute_cla_sha256(content)
+    if actual_sha256 != expected_sha256:
+        console.print(
+            f"[bold red]Digest mismatch error![/bold red]\n"
+            f"Server reported SHA-256: {expected_sha256}\n"
+            f"Recomputed SHA-256:     {actual_sha256}\n"
+            "Refusing to sign compromised or inconsistent CLA text."
+        )
+        raise typer.Exit(code=1)
+
+    # 3. Show CLA text / digest
+    console.print(Panel(content, title=f"Ditto SN118 Contributor License Agreement ({version})", expand=False))
+    console.print(f"[cyan]CLA Version:[/cyan] {version}")
+    console.print(f"[cyan]SHA-256 Digest:[/cyan] {actual_sha256}")
+    console.print(f"[cyan]Signer Hotkey:[/cyan] {hotkey_ss58}")
+
+    # 4. Confirmation
+    if not yes:
+        confirm_prompt = typer.prompt("To accept the CLA, please type 'I AGREE'")
+        if confirm_prompt.strip() != "I AGREE":
+            console.print("[yellow]CLA signature cancelled. Uploads may be blocked until signed.[/yellow]")
+            raise typer.Exit(code=1)
+
+    # 5. Build signed message
+    nonce = str(uuid.uuid4())
+    issued_at = datetime.now(timezone.utc)
+    message = build_cla_message(
+        netuid=settings.NETUID,
+        cla_version=version,
+        cla_sha256=actual_sha256,
+        hotkey=hotkey_ss58,
+        nonce=nonce,
+        issued_at=issued_at,
+    )
+
+    # Sign with sr25519
+    signature_bytes = keypair.sign(message.encode("utf-8"))
+    signature_hex = f"0x{signature_bytes.hex()}"
+
+    # 6. Submit to Platform
+    sign_url = f"{platform_url}/api/v1/cla/sign"
+    payload = {
+        "hotkey": hotkey_ss58,
+        "cla_version": version,
+        "cla_sha256": actual_sha256,
+        "nonce": nonce,
+        "issued_at": issued_at.isoformat(),
+        "signature": signature_hex,
+    }
+
+    try:
+        with httpx.Client(timeout=10.0) as client:
+            sign_resp = client.post(sign_url, json=payload)
+            if sign_resp.status_code != 200:
+                console.print(f"[red]Error submitting CLA signature: {sign_resp.text}[/red]")
+                raise typer.Exit(code=1)
+            resp_data = sign_resp.json()
+    except Exception as e:
+        console.print(f"[red]Failed to submit signature: {e}[/red]")
+        raise typer.Exit(code=1)
+
+    console.print(
+        f"[bold green]Successfully signed CLA {version} for hotkey {hotkey_ss58}![/bold green]"
+    )
+    console.print(f"[green]Signed at: {resp_data.get('signed_at')}[/green]")
