def test_signature_verification_edge_cases(db_session):
    from apps.platform.ditto.api_server.cla_service import verify_and_store_signature

    keypair = Keypair.create_from_mnemonic(Keypair.generate_mnemonic())
    hotkey = keypair.ss58_address
    v1 = db_session.query(ClaVersion).filter(ClaVersion.version == "v1").first()

    nonce = "replay-nonce-test"
    now_ts = int(time.time())
    payload = build_cla_sign_payload(118, "v1", v1.sha256, hotkey, nonce, now_ts)
    valid_sig = "0x" + keypair.sign(payload.encode("utf-8")).hex()

    # Success case
    sig_row = verify_and_store_signature(
        db=db_session,
        netuid=118,
        hotkey=hotkey,
        cla_version="v1",
        cla_sha256=v1.sha256,
        nonce=nonce,
        issued_at=now_ts,
        signature=valid_sig,
    )
    assert sig_row.id is not None

    # Replayed nonce
    with pytest.raises(Exception, match="already been used"):
        verify_and_store_signature(
            db=db_session,
            netuid=118,
            hotkey=hotkey,
            cla_version="v1",
            cla_sha256=v1.sha256,
            nonce=nonce,
            issued_at=now_ts,
            signature=valid_sig,
        )

    # Stale issued_at
    with pytest.raises(Exception, match="stale or skewed"):
        verify_and_store_signature(
            db=db_session,
            netuid=118,
            hotkey=hotkey,
            cla_version="v1",
            cla_sha256=v1.sha256,
            nonce="nonce-stale",
            issued_at=now_ts - 500,
            signature=valid_sig,
        )

    # Wrong signer
    wrong_keypair = Keypair.create_from_mnemonic(Keypair.generate_mnemonic())
    wrong_sig = "0x" + wrong_keypair.sign(payload.encode("utf-8")).hex()
    with pytest.raises(Exception, match="verification failed"):
        verify_and_store_signature(
            db=db_session,
            netuid=118,
            hotkey=hotkey,
            cla_version="v1",
            cla_sha256=v1.sha256,
            nonce="nonce-wrong-signer",
            issued_at=now_ts,
            signature=wrong_sig,
        )


def test_backroom_adoption_tool(db_session):
    report = get_cla_gate_status_report(db_session, active_hotkeys=["hotkey-1", "hotkey-2"])
    assert report["gate_mode"] in {"off", "shadow", "enforce"}
    assert report["adoption"]["total_active_hotkeys"] == 2
    assert report["adoption"]["signed_hotkeys"] == 0
    assert len(report["history"]) >= 1
