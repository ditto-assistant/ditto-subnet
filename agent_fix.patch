### 5. API Endpoints

`apps/platform/ditto/api_server/endpoints/cla.py`:
```python
from fastapi import APIRouter, Depends, HTTPException, status
from pydantic import BaseModel
from sqlalchemy.orm import Session
from apps.platform.ditto.api_server.database import get_db
from apps.platform.ditto.api_server.cla import (
    get_current_effective_cla,
    get_hotkey_cla_status,
    verify_and_record_cla_signature,
)

router = APIRouter(prefix="/api/v1/cla", tags=["cla"])


class CLASignRequest(BaseModel):
    netuid: int
    cla_version: str
    cla_sha256: str
    hotkey: str
    nonce: str
    issued_at: int
    signature: str


@router.get("/current")
def get_current_cla(db: Session = Depends(get_db)):
    cla = get_current_effective_cla(db)
    if not cla:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail="No effective CLA version found.",
        )
    return {
        "version": cla.version,
        "sha256": cla.sha256,
        "text": cla.text,
        "published_at": cla.published_at.isoformat(),
        "effective_at": cla.effective_at.isoformat(),
    }


@router.get("/status/{hotkey}")
def get_cla_status(hotkey: str, db: Session = Depends(get_db)):
    return get_hotkey_cla_status(db=db, hotkey=hotkey)


@router.post("/sign")
def sign_cla(payload: CLASignRequest, db: Session = Depends(get_db)):
    try:
        sig = verify_and_record_cla_signature(
            db=db,
            netuid=payload.netuid,
            cla_version=payload.cla_version,
            cla_sha256=payload.cla_sha256,
            hotkey=payload.hotkey,
            nonce=payload.nonce,
            issued_at=payload.issued_at,
            signature=payload.signature,
        )
        return {
            "success": True,
            "hotkey": sig.hotkey,
            "coldkey": sig.coldkey,
            "cla_version": sig.cla_version,
            "signed_at": sig.signed_at.isoformat(),
        }
    except ValueError as exc:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail=str(exc),
        )
