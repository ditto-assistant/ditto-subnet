```python
"""Shared protocol for Contributor License Agreement (CLA) signature payloads."""

from __future__ import annotations

import hashlib
from datetime import datetime, timezone
from typing import Any


def compute_sha256(content: str | bytes) -> str:
    """Compute hex SHA-256 digest of text or bytes."""
    if isinstance(content, str):
        content = content.encode("utf-8")
    return hashlib.sha256(content).hexdigest()


def build_cla_message(
    netuid: int,
    cla_version: str,
    cla_sha256: str,
    hotkey: str,
    nonce: str,
    issued_at: int | str | datetime,
) -> str:
    """
    Format byte-for-byte CLA signature message:
    ditto-cla:v1:<netuid>:<cla_version>:<cla_sha256>:<hotkey>:<nonce>:<issued_at>
    """
    if isinstance(issued_at, datetime):
        if issued_at.tzinfo is None:
            issued_at = issued_at.replace(tzinfo=timezone.utc)
        issued_at_str = str(int(issued_at.timestamp()))
    else:
        issued_at_str = str(issued_at)

    return (
        f"ditto-cla:v1:{netuid}:{cla_version}:{cla_sha256}:{hotkey}:{nonce}:{issued_at_str}"
    )


def build_cla_message_bytes(
    netuid: int,
    cla_version: str,
    cla_sha256: str,
    hotkey: str,
    nonce: str,
    issued_at: int | str | datetime,
) -> bytes:
    return build_cla_message(
        netuid=netuid,
        cla_version=cla_version,
        cla_sha256=cla_sha256,
        hotkey=hotkey,
        nonce=nonce,
        issued_at=issued_at,
    ).encode("utf-8")
