+"""Tests for CLA database append-only guarantees, submission gating, and CLI."""
+import hashlib
+import time
+import uuid
+import pytest
+import pytest_asyncio
+from datetime import datetime, timezone
+from sqlalchemy.ext.asyncio import create_async_engine, AsyncSession, async_sessionmaker
+from substrateinterface import Keypair
+
+from ditto.api_server.models import (
+    Base,
+    CLAVersion,
+    CLASignature,
+    CLAGateSettingsHistory,
+    AppendOnlyViolationError,
+)
+from ditto.api_server.cla import (
+    compute_cla_sha256,
+    build_cla_signature_message,
+    record_cla_signature,
+    get_cla_gate_mode,
+)
+from ditto.api_server.endpoints.upload import verify_cla_submission_gate
+from ditto.api_server.backroom.cla_gate import get_cla_gate_status
+from fastapi import HTTPException
+
+
+@pytest_asyncio.fixture
+async def db_session():
+    engine = create_async_engine("sqlite+aiosqlite:///:memory:", echo=False)
+    async with engine.begin() as conn:
+        await conn.run_sync(Base.metadata.create_all)
+    session_factory = async_sessionmaker(engine, expire_on_commit=False, class_=AsyncSession)
+    async with session_factory() as session:
+        yield session
+    await engine.dispose()
+
+
+@pytest.mark.asyncio
+async def test_cla_signature_append_only(db_session: AsyncSession):
+    """Test that rows in cla_signatures cannot be updated or deleted."""
+    cla_text = "Test CLA v1 content"
+    digest = hashlib.sha256(cla_text.encode("utf-8")).hexdigest()
+    cla_v = CLAVersion(
+        version="v1",
+        sha256=digest,
+        content=cla_text,
+        published_at=datetime.now(timezone.utc),
+        effective_at=datetime.now(timezone.utc),
+    )
+    db_session.add(cla_v)
+    await db_session.commit()
+
+    keypair = Keypair.create_from_uri("//Alice")
+    sig = CLASignature(
+        hotkey=keypair.ss58_address,
+        coldkey="//AliceCold",
+        cla_version="v1",
+        cla_sha256=digest,
+        signature="0x1234",
+        nonce=str(uuid.uuid4()),
+        issued_at=int(time.time()),
+    )
+    db_session.add(sig)
+    await db_session.commit()
+
+    # Attempting to update must raise AppendOnlyViolationError
+    sig.coldkey = "modified_coldkey"
+    with pytest.raises(AppendOnlyViolationError):
+        await db_session.commit()
+    await db_session.rollback()
+
+    # Attempting to delete must raise AppendOnlyViolationError
+    with pytest.raises(AppendOnlyViolationError):
+        await db_session.delete(sig)
+        await db_session.commit()
+    await db_session.rollback()
+
+
+@pytest.mark.asyncio
+async def test_signature_verification_and_replay_protection(db_session: AsyncSession):
+    """Test signing with valid signature, replayed nonce, stale issued_at, and wrong signer."""
+    cla_text = "Test CLA v1 content"
+    digest = hashlib.sha256(cla_text.encode("utf-8")).hexdigest()
+    cla_v = CLAVersion(
+        version="v1",
+        sha256=digest,
+        content=cla_text,
+        published_at=datetime.now(timezone.utc),
+        effective_at=datetime.now(timezone.utc),
+    )
+    db_session.add(cla_v)
+    await db_session.commit()
+
+    netuid = 118
+    alice = Keypair.create_from_uri("//Alice")
+    bob = Keypair.create_from_uri("//Bob")
+    nonce = str(uuid.uuid4())
+    issued_at = int(time.time())
+
+    # 1. Valid signature
+    msg = build_cla_signature_message(netuid, "v1", digest, alice.ss58_address, nonce, issued_at)
+    sig_hex = f"0x{alice.sign(msg.encode('utf-8')).hex()}"
+    rec = await record_cla_signature(
+        session=db_session,
+        netuid=netuid,
+        hotkey=alice.ss58_address,
+        coldkey=None,
+        cla_version="v1",
+        cla_sha256=digest,
+        signature=sig_hex,
+        nonce=nonce,
+        issued_at=issued_at,
+    )
+    assert rec.hotkey == alice.ss58_address
+
+    # 2. Replay nonce
+    with pytest.raises(ValueError, match="already been used"):
+        await record_cla_signature(
+            session=db_session,
+            netuid=netuid,
+            hotkey=alice.ss58_address,
+            coldkey=None,
+            cla_version="v1",
+            cla_sha256=digest,
+            signature=sig_hex,
