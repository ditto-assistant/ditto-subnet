### 6. Platform API Endpoints

In `apps/platform/ditto/api_server/endpoints/cla.py`:
```python
"""CLA API endpoints."""

from fastapi import APIRouter, Depends, HTTPException, Query, status
from pydantic import BaseModel, Field
from sqlalchemy.ext.asyncio import AsyncSession

from ditto.api_server.dependencies import get_db_session, get_substrate_client
from ditto.services.cla_service import CLAService

router = APIRouter(prefix="/cla", tags=["cla"])


class CLAVersionResponse(BaseModel):
    version: str
    sha256: str
    content: str
    published_at: str
    effective_at: str


class CLASignRequest(BaseModel):
    hotkey: str
    cla_version: str
    cla_sha256: str
    nonce: str
    issued_at: int
    signature: str


class CLASignResponse(BaseModel):
    status: str
    hotkey: str
    cla_version: str
    signed_at: str


class CLAStatusResponse(BaseModel):
    hotkey: str
    current_effective_version: str | None
    has_signed_current: bool
    signed_version: str | None = None
    cla_sha256: str | None = None
    signed_at: str | None = None
    signature: str | None = None


@router.get("/current", response_model=CLAVersionResponse)
async def get_current_cla(session: AsyncSession = Depends(get_db_session)):
    """Fetch the currently effective CLA text and metadata."""
    cla = await CLAService.get_effective_cla_version(session)
    if not cla:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail="No effective CLA version found.",
        )
    return CLAVersionResponse(
        version=cla.version,
        sha256=cla.sha256,
        content=cla.content,
        published_at=cla.published_at.isoformat(),
        effective_at=cla.effective_at.isoformat(),
    )


@router.post("/sign", response_model=CLASignResponse)
async def sign_cla(
    request: CLASignRequest,
    session: AsyncSession = Depends(get_db_session),
    sub_client=Depends(get_substrate_client),
):
    """Submit a signature for a CLA version."""
    async def coldkey_resolver(hk: str) -> str:
        try:
            return sub_client.get_hotkey_owner(hk) or hk
        except Exception:
            return hk

    try:
        record = await CLAService.register_signature(
            session=session,
            hotkey=request.hotkey,
            cla_version=request.cla_version,
            cla_sha256=request.cla_sha256,
            nonce=request.nonce,
            issued_at=request.issued_at,
            signature=request.signature,
            coldkey_resolver=coldkey_resolver,
        )
        await session.commit()
    except ValueError as e:
        await session.rollback()
        raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail=str(e))
    except Exception as e:
        await session.rollback()
        raise HTTPException(status_code=status.HTTP_500_INTERNAL_SERVER_ERROR, detail=str(e))

    return CLASignResponse(
        status="ok",
        hotkey=record.hotkey,
        cla_version=record.cla_version,
        signed_at=record.signed_at.isoformat(),
    )


@router.get("/status", response_model=CLAStatusResponse)
async def get_cla_status(
    hotkey: str = Query(..., description="SS58 hotkey address"),
    session: AsyncSession = Depends(get_db_session),
):
    """Public read endpoint returning a hotkey's CLA status."""
    effective = await CLAService.get_effective_cla_version(session)
    effective_version = effective.version if effective else None

    # Retrieve most recent signature
    sig = await CLAService.get_latest_hotkey_signature(session, hotkey=hotkey)

    has_signed_current = False
    if effective and sig:
        if sig.cla_version == effective.version and sig.cla_sha256.lower() == effective.sha256.lower():
            has_signed_current = True

    return CLAStatusResponse(
        hotkey=hotkey,
        current_effective_version=effective_version,
        has_signed_current=has_signed_current,
        signed_version=sig.cla_version if sig else None,
        cla_sha256=sig.cla_sha256 if sig else None,
        signed_at=sig.signed_at.isoformat() if sig else None,
        signature=sig.signature if sig else None,
    )
```

