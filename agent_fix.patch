+"""CLA gate enforcement and status checking."""
+
+from __future__ import annotations
+
+import logging
+from datetime import datetime, timezone
+from typing import Optional, Tuple
+from sqlalchemy import select
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from ditto.api_server.state import ServerState
+from ditto.core.config import settings
+from ditto.db.models import CLASignature, CLAVersionRegistry
+
+logger = logging.getLogger(__name__)
+
+# In-memory override for testing and Backroom control
+_cla_gate_mode_override: Optional[str] = None
+
+
+def get_cla_gate_mode() -> str:
+    if _cla_gate_mode_override is not None:
+        return _cla_gate_mode_override
+    return settings.CLA_GATE_MODE
+
+
+def set_cla_gate_mode(mode: str) -> None:
+    global _cla_gate_mode_override
+    if mode not in ("off", "shadow", "enforce"):
+        raise ValueError(f"Invalid CLA gate mode: {mode}")
+    _cla_gate_mode_override = mode
+
+
+async def get_effective_cla_version(session: AsyncSession) -> Optional[CLAVersionRegistry]:
+    """Get the currently effective CLA version (latest effective_at <= now)."""
+    now = datetime.now(timezone.utc)
+    stmt = (
+        select(CLAVersionRegistry)
+        .where(CLAVersionRegistry.effective_at <= now)
+        .order_by(CLAVersionRegistry.effective_at.desc(), CLAVersionRegistry.published_at.desc())
+        .limit(1)
+    )
+    result = await session.execute(stmt)
+    return result.scalars().first()
+
+
+async def get_hotkey_cla_signature(
+    session: AsyncSession, hotkey: str, cla_version: Optional[str] = None
+) -> Optional[CLASignature]:
+    """Get latest signature for hotkey (optionally matching a specific version)."""
+    stmt = select(CLASignature).where(CLASignature.hotkey == hotkey)
+    if cla_version:
+        stmt = stmt.where(CLASignature.cla_version == cla_version)
+    stmt = stmt.order_by(CLASignature.signed_at.desc(), CLASignature.id.desc()).limit(1)
+    result = await session.execute(stmt)
+    return result.scalars().first()
+
+
+async def verify_hotkey_cla_gate(
+    session: AsyncSession, hotkey: str
+) -> Tuple[bool, Optional[str]]:
+    """
+    Checks if hotkey satisfies the CLA gate based on the current mode.
+    Returns (allowed, error_message).
+    """
+    mode = get_cla_gate_mode()
+    if mode == "off":
+        return True, None
+
+    effective_cla = await get_effective_cla_version(session)
+    if not effective_cla:
+        # If no CLA version is registered yet, let submissions pass unless in enforce
+        if mode == "enforce":
+            return False, "No active CLA version configured on Platform. Please contact support."
+        return True, None
+
+    sig = await get_hotkey_cla_signature(session, hotkey, cla_version=effective_cla.version)
+    has_valid_sig = sig is not None and sig.cla_sha256 == effective_cla.sha256
+
+    if has_valid_sig:
+        return True, None
+
+    # Not signed or outdated version
+    reason = (
+        f"Hotkey {hotkey} has not signed the current CLA ({effective_cla.version}). "
+        "Please run 'uv run ditto cla sign' to agree to the Contributor License Agreement before uploading."
+    )
+
+    if mode == "shadow":
+        logger.warning(
+            "CLA shadow mode: allowing unsigned upload for hotkey %s (required version: %s)",
+            hotkey,
+            effective_cla.version,
+        )
+        return True, None
+
+    if mode == "enforce":
+        logger.error(
+            "CLA enforce mode: rejecting upload for hotkey %s (required version: %s)",
+            hotkey,
+            effective_cla.version,
+        )
+        return False, reason
+
+    return True, None
