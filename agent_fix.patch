def get_current_cla_gate_mode(db: Session) -> str:
    setting = db.query(ClaGateSetting).order_by(ClaGateSetting.id.desc()).first()
    if setting:
        return setting.mode
    return "off"

def set_cla_gate_mode(db: Session, mode: str, changed_by: str = "operator", reason: str = "") -> ClaGateSetting:
    if mode not in ("off", "shadow", "enforce"):
        raise ValueError(f"Invalid mode: {mode}. Must be 'off', 'shadow', or 'enforce'.")
    setting = ClaGateSetting(mode=mode, changed_by=changed_by, reason=reason)
    db.add(setting)
    db.commit()
    db.refresh(setting)
    return setting
```

