    changed_at = Column(DateTime(timezone=True), nullable=False, default=datetime.datetime.utcnow)
    changed_by = Column(String(128), nullable=True, default="system")
    reason = Column(Text, nullable=True)


# Append-only enforcement: Prevent updates and deletes on CLASignature
@event.listens_for(CLASignature, "before_update")
def _prevent_cla_signature_update(mapper, connection, target):
    raise PermissionError("CLASignature is append-only and cannot be updated.")


@event.listens_for(CLASignature, "before_delete")
def _prevent_cla_signature_delete(mapper, connection, target):
    raise PermissionError("CLASignature is append-only and cannot be deleted.")
