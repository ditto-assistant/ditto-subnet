```python
"""Interface sketch for GitHub Bounty PR checks (#2871)."""

from __future__ import annotations

from typing import Optional
from pydantic import BaseModel


class PRCLACheckResult(BaseModel):
    github_user: str
    hotkey: Optional[str]
    cla_signed: bool
    status: str  # "success" | "failure"
    description: str


def check_pr_cla_status(
    github_user: str,
    resolve_hotkey_func,
    check_hotkey_cla_func,
) -> PRCLACheckResult:
    """Interface to resolve PR Author -> Linked Hotkey -> Effective CLA signature."""
    linked_hotkey = resolve_hotkey_func(github_user)
    if not linked_hotkey:
        return PRCLACheckResult(
            github_user=github_user,
            hotkey=None,
            cla_signed=False,
            status="failure",
            description=f"GitHub user @{github_user} has no linked hotkey. Link your hotkey first.",
        )

    is_signed = check_hotkey_cla_func(linked_hotkey)
    if not is_signed:
        return PRCLACheckResult(
            github_user=github_user,
            hotkey=linked_hotkey,
            cla_signed=False,
            status="failure",
            description=f"Hotkey {linked_hotkey} has not signed the current CLA. Run 'uv run ditto cla sign'.",
        )

    return PRCLACheckResult(
        github_user=github_user,
        hotkey=linked_hotkey,
        cla_signed=True,
        status="success",
        description="CLA signature verified for linked hotkey.",
    )
