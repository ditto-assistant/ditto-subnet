            "issued_at": now_ts,
            "netuid": 118,
        },
    )
    assert res_bad_sig.status_code == 400
    assert "Invalid signature" in res_bad_sig.json()["detail"]

    # 3. Replayed nonce
    valid_sig = f"0x{signer_keypair.sign(payload.encode('utf-8')).hex()}"
    res_ok = client.post(
        "/api/v1/cla/sign",
        json={
            "hotkey": signer_keypair.ss58_address,
