### 8. Miner CLI: `ditto/miner_cli/cla.py`

```python
"""CLI commands for checking and signing the Contributor License Agreement (CLA)."""

from __future__ import annotations

import hashlib
import sys
import time
import uuid
import httpx
import typer

from ditto.miner_cli.cla_builder import build_cla_sign_payload

cla_cli = typer.Typer(help="Manage Contributor License Agreement (CLA)")


def _compute_digest(text: str) -> str:
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


@cla_cli.command("sign")
def sign_cla(
    platform_url: str = typer.Option("http://localhost:8000", help="Platform base URL"),
    netuid: int = typer.Option(118, help="Subnet UID"),
    wallet_name: str = typer.Option("default", help="Bittensor wallet name"),
    hotkey_name: str = typer.Option("default", help="Bittensor hotkey name"),
    yes: bool = typer.Option(False, "--yes", "-y", help="Skip explicit confirmation prompt"),
    keypair: typer.Context = None,  # Optional test injection
):
    """View, verify, and sign the current CLA with the miner hotkey."""
    # 1. Fetch current CLA metadata and text from Platform
    try:
        resp = httpx.get(f"{platform_url.rstrip('/')}/api/v1/cla/current", timeout=10.0)
        resp.raise_for_status()
        cla_data = resp.json()
    except Exception as exc:
        typer.secho(f"Failed to fetch current CLA from platform: {exc}", fg=typer.colors.RED)
        raise typer.Exit(code=1)

    cla_version = cla_data["version"]
    expected_sha256 = cla_data["sha256"].lower()
    cla_text = cla_data.get("text", "")

    # 2. Recompute digest and refuse to sign on mismatch
    computed_sha256 = _compute_digest(cla_text).lower()
    if computed_sha256 != expected_sha256:
        typer.secho("FATAL: CLA digest mismatch!", fg=typer.colors.RED, bold=True)
        typer.echo(f"  Platform registry digest: {expected_sha256}")
        typer.echo(f"  Downloaded text digest:   {computed_sha256}")
        typer.secho("Refusing to sign untrusted or corrupted text.", fg=typer.colors.RED)
        raise typer.Exit(code=1)

    # 3. Present CLA to contributor
    typer.echo("==================================================================")
    typer.echo(f"  Ditto Contributor License Agreement (CLA) - {cla_version}")
    typer.echo(f"  SHA-256 Digest: {computed_sha256}")
    typer.echo("==================================================================\n")
    typer.echo(cla_text.strip()[:600] + ("\n..." if len(cla_text) > 600 else ""))
    typer.echo("\n==================================================================")

    # 4. Explicit typed confirmation
    if not yes:
        prompt_val = typer.prompt("Type 'I AGREE' to confirm and execute the CLA")
        if prompt_val.strip() != "I AGREE":
            typer.secho("Confirmation declined. Aborting.", fg=typer.colors.YELLOW)
            raise typer.Exit(code=1)

    # 5. Resolve wallet keypair
    if keypair is not None and hasattr(keypair, "obj") and keypair.obj:
        active_keypair = keypair.obj
        hotkey_ss58 = active_keypair.ss58_address
    else:
        try:
            import bittensor as bt

            wallet = bt.wallet(name=wallet_name, hotkey=hotkey_name)
            active_keypair = wallet.hotkey
            hotkey_ss58 = active_keypair.ss58_address
        except Exception as exc:
            typer.secho(f"Could not load hotkey {hotkey_name}: {exc}", fg=typer.colors.RED)
            raise typer.Exit(code=1)

    # 6. Build payload and sign (sr25519)
    nonce = uuid.uuid4().hex
    issued_at = int(time.time())
    payload = build_cla_sign_payload(
        netuid=netuid,
        cla_version=cla_version,
        cla_sha256=computed_sha256,
        hotkey=hotkey_ss58,
        nonce=nonce,
        issued_at=issued_at,
    )

    sig_bytes = active_keypair.sign(payload.encode("utf-8"))
    signature = f"0x{sig_bytes.hex()}" if isinstance(sig_bytes, bytes) else str(sig_bytes)

    # 7. Post signature to platform
    submit_req = {
        "netuid": netuid,
        "hotkey": hotkey_ss58,
        "cla_version": cla_version,
        "cla_sha256": computed_sha256,
        "nonce": nonce,
        "issued_at": issued_at,
        "signature": signature,
    }

    try:
        post_resp = httpx.post(
            f"{platform_url.rstrip('/')}/api/v1/cla/sign",
            json=submit_req,
            timeout=10.0,
        )
        post_resp.raise_for_status()
        res_data = post_resp.json()
    except httpx.HTTPStatusError as exc:
        typer.secho(f"Signature submission rejected: {exc.response.text}", fg=typer.colors.RED)
        raise typer.Exit(code=1)
    except Exception as exc:
        typer.secho(f"Failed to submit signature: {exc}", fg=typer.colors.RED)
        raise typer.Exit(code=1)

    typer.secho(f"Successfully signed CLA {cla_version} for hotkey {hotkey_ss58}!", fg=typer.colors.GREEN, bold=True)
    typer.echo(f"Signed at: {res_data.get('signed_at')}")


@cla_cli.command("status")
def status_cla(
    hotkey: str = typer.Option(..., "--hotkey", "-k", help="Hotkey SS58 address to check"),
    platform_url: str = typer.Option("http://localhost:8000", help="Platform base URL"),
):
    """Show the signed CLA version, currentness, and signed_at time for a hotkey."""
    try:
        resp = httpx.get(
            f"{platform_url.rstrip('/')}/api/v1/cla/status/{hotkey}",
            timeout=10.0,
        )
        resp.raise_for_status()
        data = resp.json()
    except Exception as exc:
        typer.secho(f"Failed to query CLA status: {exc}", fg=typer.colors.RED)
        raise typer.Exit(code=1)

    typer.echo(f"Hotkey:        {data['hotkey']}")
    typer.echo(f"Signed:        {'Yes' if data['signed'] else 'No'}")
    if data["signed"]:
        typer.echo(f"Version:       {data.get('version')}")
        typer.echo(f"SHA-256:       {data.get('digest')}")
        typer.echo(f"Signed At:     {data.get('signed_at')}")
        status_text = (
            typer.style("CURRENT", fg=typer.colors.GREEN, bold=True)
            if data.get("is_current")
            else typer.style("OUTDATED - Re-signing required", fg=typer.colors.YELLOW, bold=True)
        )
        typer.echo(f"Current:       {status_text}")
    else:
        typer.secho("Status:        NOT SIGNED (Run 'uv run ditto cla sign')", fg=typer.colors.RED)
