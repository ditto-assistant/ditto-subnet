```python
import hashlib
import json
import time
import uuid
import click
import requests
from pathlib import Path
from rich.console import Console
from rich.markdown import Markdown

from ditto.miner_cli.cla_payload import build_cla_sign_payload
from ditto.miner_cli.wallet import get_wallet

console = Console()


@click.group(name="cla")
def cla():
    """Manage Contributor License Agreement signatures."""
    pass


@cla.command(name="sign")
@click.option("--wallet-name", default="default", help="Bittensor wallet name")
@click.option("--hotkey-name", default="default", help="Bittensor hotkey name")
@click.option("--netuid", default=118, type=int, help="Subnet netuid")
@click.option("--platform-url", default="http://localhost:8000", help="Platform API URL")
def sign(wallet_name: str, hotkey_name: str, netuid: int, platform_url: str):
    """Download, inspect, confirm, and sign the current CLA with your hotkey."""
    platform_url = platform_url.rstrip("/")
    wallet = get_wallet(wallet_name=wallet_name, hotkey_name=hotkey_name)
    hotkey = wallet.hotkey.ss58_address

    # 1. Fetch current CLA registry entry from platform
    resp = requests.get(f"{platform_url}/api/v1/cla/current")
    if resp.status_code != 200:
        console.print(f"[red]Failed to fetch active CLA: {resp.text}[/red]")
        raise click.Abort()

    data = resp.json()
    version = data["version"]
    expected_sha256 = data["sha256"].lower()
    cla_text = data["text"]

    # 2. Verify SHA-256 digest locally
    computed_sha256 = hashlib.sha256(cla_text.encode("utf-8")).hexdigest().lower()
    if computed_sha256 != expected_sha256:
        console.print(
            f"[bold red]Digest mismatch! Refusing to sign.[/bold red]\n"
            f"Expected: {expected_sha256}\n"
            f"Computed: {computed_sha256}"
        )
        raise click.Abort()

    # 3. Present CLA and require typed confirmation
    console.print(f"\n[bold green]=== Contributor License Agreement ({version}) ===[/bold green]\n")
    console.print(Markdown(cla_text))
    console.print(f"\n[cyan]Digest (SHA-256):[/cyan] {computed_sha256}")
    console.print(f"[cyan]Hotkey Signer:[/cyan] {hotkey}\n")

    confirmation = click.prompt("Type 'I AGREE' to confirm and sign the CLA", type=str)
    if confirmation.strip() != "I AGREE":
        console.print("[yellow]Signature aborted.[/yellow]")
        raise click.Abort()

    # 4. Construct payload and sign
    nonce = uuid.uuid4().hex
    issued_at = int(time.time())
    payload = build_cla_sign_payload(
        netuid=netuid,
        cla_version=version,
        cla_sha256=computed_sha256,
        hotkey=hotkey,
        nonce=nonce,
        issued_at=issued_at,
    )

    signature_bytes = wallet.hotkey.sign(payload)
    signature_hex = f"0x{signature_bytes.hex()}"

    # 5. Submit signature to Platform
    sign_payload = {
        "netuid": netuid,
        "cla_version": version,
        "cla_sha256": computed_sha256,
        "hotkey": hotkey,
        "nonce": nonce,
        "issued_at": issued_at,
        "signature": signature_hex,
    }

    sub_resp = requests.post(f"{platform_url}/api/v1/cla/sign", json=sign_payload)
    if sub_resp.status_code != 200:
        console.print(f"[red]Platform rejected signature: {sub_resp.text}[/red]")
        raise click.Abort()

    console.print(f"[bold green]Successfully signed CLA {version} for hotkey {hotkey}![/bold green]")


@cla.command(name="status")
@click.option("--wallet-name", default="default", help="Bittensor wallet name")
@click.option("--hotkey-name", default="default", help="Bittensor hotkey name")
@click.option("--platform-url", default="http://localhost:8000", help="Platform API URL")
def status(wallet_name: str, hotkey_name: str, platform_url: str):
    """Check the CLA signature status for the current hotkey."""
    platform_url = platform_url.rstrip("/")
    wallet = get_wallet(wallet_name=wallet_name, hotkey_name=hotkey_name)
    hotkey = wallet.hotkey.ss58_address

    resp = requests.get(f"{platform_url}/api/v1/cla/status/{hotkey}")
    if resp.status_code != 200:
        console.print(f"[red]Error fetching status: {resp.text}[/red]")
        raise click.Abort()

    st = resp.json()
    console.print(f"[bold]Hotkey:[/bold] {hotkey}")
    if not st.get("has_signed"):
        console.print("[yellow]Status: No CLA signed. Run 'uv run ditto cla sign' to execute.[/yellow]")
        return

    console.print(f"[bold]Signed Version:[/bold] {st.get('version')}")
    console.print(f"[bold]Digest:[/bold] {st.get('digest')}")
    console.print(f"[bold]Current Version:[/bold] {'[green]Yes[/green]' if st.get('is_current') else '[red]Outdated (Resign required)[/red]'}")
    console.print(f"[bold]Signed At:[/bold] {st.get('signed_at')}")
