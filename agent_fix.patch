    try:
        from apps.platform.ditto.models.base import Base  # type: ignore
    except ImportError:
        Base = declarative_base()


class CLAVersion(Base):
    __tablename__ = "cla_versions"

    id = Column(Integer, primary_key=True, autoincrement=True)
    version = Column(String(32), unique=True, nullable=False, index=True)
    sha256 = Column(String(64), nullable=False)
    text = Column(Text, nullable=False)
    published_at = Column(DateTime(timezone=True), nullable=False, default=datetime.datetime.utcnow)
    effective_at = Column(DateTime(timezone=True), nullable=False, default=datetime.datetime.utcnow)
    created_at = Column(DateTime(timezone=True), default=datetime.datetime.utcnow, nullable=False)


class CLASignature(Base):
    __tablename__ = "cla_signatures"

    id = Column(Integer, primary_key=True, autoincrement=True)
    hotkey = Column(String(64), nullable=False, index=True)
    coldkey = Column(String(64), nullable=False, index=True)
    cla_version = Column(String(32), nullable=False)
    cla_sha256 = Column(String(64), nullable=False)
    signature = Column(Text, nullable=False)
    nonce = Column(String(64), unique=True, nullable=False, index=True)
    issued_at = Column(DateTime(timezone=True), nullable=False)
    signed_at = Column(DateTime(timezone=True), default=datetime.datetime.utcnow, nullable=False)


class CLAGateSetting(Base):
    __tablename__ = "cla_gate_settings"

    id = Column(Integer, primary_key=True, autoincrement=True)
    mode = Column(String(16), nullable=False, default="off")  # "off", "shadow", "enforce"
    changed_by = Column(String(128), nullable=True)
    reason = Column(Text, nullable=True)
    created_at = Column(DateTime(timezone=True), default=datetime.datetime.utcnow, nullable=False)


class ReadOnlyTableError(PermissionError):
    """Raised when an UPDATE or DELETE is attempted on an append-only table."""


@event.listens_for(CLASignature, "before_update")
def _prevent_cla_signature_update(mapper, connection, target):
    raise ReadOnlyTableError("cla_signatures is append-only: updates are prohibited.")


@event.listens_for(CLASignature, "before_delete")
def _prevent_cla_signature_delete(mapper, connection, target):
    raise ReadOnlyTableError("cla_signatures is append-only: deletes are prohibited.")
