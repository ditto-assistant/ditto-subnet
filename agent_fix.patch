# ditto/miner_cli/cla.py
"""Miner CLI commands for Contributor License Agreement: 'sign' and 'status'."""

from __future__ import annotations

import hashlib
import json
import os
import sys
import time
from typing import Any
import uuid

import httpx
import typer

from apps.platform.ditto.api_server.attestation import build_cla_payload

cla_cli = typer.Typer(
    name="cla", help="Manage Contributor License Agreement execution."
)


def _get_hotkey_keypair(
    wallet_name: str = "default",
    hotkey_name: str = "default",
) -> Any:
    """Load Bittensor keypair or mock keypair in testing environments."""
    try:
        import bittensor as bt

        wallet = bt.Wallet(name=wallet_name, hotkey=hotkey_name)
        return wallet.hotkey
    except Exception:
        # Fallback mock keypair for test runs
        class MockKeypair:
            ss58_address = os.environ.get(
                "DITTO_MOCK_HOTKEY", "5GrwvaEF5zXb26Fz9rcQpDWS57CtERHpNehXCPcNoHGKutQY"
            )

            def sign(self, data: bytes | str) -> bytes:
                msg = (
                    data.decode("utf-8")
                    if isinstance(data, bytes)
                    else str(data)
                )
                return f"mock_sig_{hashlib.sha256(msg.encode()).hexdigest()[:16]}_{self.ss58_address}".encode(
                    "utf-8"
                )

        return MockKeypair()


@cla_cli.command(name="status")
def status_cmd(
    platform_url: str = typer.Option(
        "http://localhost:8000",
        "--platform-url",
        help="URL of the Ditto Platform API.",
    ),
    hotkey: str | None = typer.Option(
        None,
        "--hotkey",
        help="Hotkey SS58 address (defaults to configured wallet).",
    ),
    wallet_name: str = typer.Option("default", "--wallet.name"),
    hotkey_name: str = typer.Option("default", "--wallet.hotkey"),
) -> None:
    """Show CLA signing status for a hotkey."""
    if not hotkey:
        keypair = _get_hotkey_keypair(
            wallet_name=wallet_name, hotkey_name=hotkey_name
        )
        target_hotkey = keypair.ss58_address
    else:
        target_hotkey = hotkey

    url = f"{platform_url.rstrip('/')}/api/v1/cla/status/{target_hotkey}"
    try:
        resp = httpx.get(url, timeout=10.0)
        resp.raise_for_status()
        data = resp.json()
    except Exception as exc:
        typer.secho(
            f"Failed to query CLA status from Platform ({url}): {exc}",
            fg=typer.colors.RED,
        )
        raise typer.Exit(code=1)

    signed = data.get("signed", False)
    is_current = data.get("is_current", False)

    typer.echo(f"Hotkey:     {target_hotkey}")
    typer.echo(f"Signed:     {'Yes' if signed else 'No'}")
    typer.echo(f"Current:    {'Yes' if is_current else 'No'}")
    if signed:
        typer.echo(f"Version:    {data.get('version')}")
        typer.echo(f"SHA-256:    {data.get('sha256')}")
        typer.echo(f"Signed At:  {data.get('signed_at')}")

    if not is_current:
        typer.secho(
            "\nAction Required: You must execute the current CLA before uploading agents.\n"
            "Run 'uv run ditto cla sign' to review and sign.",
            fg=typer.colors.YELLOW,
        )


@cla_cli.command(name="sign")
def sign_cmd(
    platform_url: str = typer.Option(
        "http://localhost:8000",
        "--platform-url",
        help="URL of the Ditto Platform API.",
    ),
    netuid: int = typer.Option(118, "--netuid", help="Subnet netuid."),
    wallet_name: str = typer.Option("default", "--wallet.name"),
    hotkey_name: str = typer.Option("default", "--wallet.hotkey"),
    yes: bool = typer.Option(
        False, "--yes", "-y", help="Skip confirmation prompt."
    ),
) -> None:
    """Review and sign the currently effective Contributor License Agreement."""
    # 1. Fetch current CLA details from Platform
    curr_url = f"{platform_url.rstrip('/')}/api/v1/cla/current"
    try:
        resp = httpx.get(curr_url, timeout=10.0)
        resp.raise_for_status()
        cla_info = resp.json()
    except Exception as exc:
        typer.secho(
            f"Failed to fetch active CLA info from Platform ({curr_url}): {exc}",
            fg=typer.colors.RED,
        )
        raise typer.Exit(code=1)

    cla_version = cla_info["version"]
    expected_sha256 = cla_info["sha256"].lower()
    cla_text = cla_info.get("text") or ""

    # 2. Verify SHA-256 digest
    computed_sha256 = hashlib.sha256(cla_text.encode("utf-8")).hexdigest()
    if computed_sha256.lower() != expected_sha256:
        typer.secho(
            f"SECURITY ERROR: CLA text digest mismatch!\n"
            f"Expected SHA-256: {expected_sha256}\n"
            f"Computed SHA-256: {computed_sha256}\n"
            f"Refusing to sign mismatched text.",
            fg=typer.colors.RED,
        )
        raise typer.Exit(code=1)

    # 3. Present CLA to miner
    typer.echo(
        f"\n=== Subnet 118 Contributor License Agreement ({cla_version}) ==="
    )
    typer.echo(f"SHA-256 Digest: {expected_sha256}\n")
    if cla_text:
        typer.echo(cla_text[:1200])
        if len(cla_text) > 1200:
            typer.echo(
                f"\n... [truncated, full text {len(cla_text)} bytes] ..."
            )

    keypair = _get_hotkey_keypair(
        wallet_name=wallet_name, hotkey_name=hotkey_name
    )
    hotkey_ss58 = keypair.ss58_address

    typer.echo(
        f"\nYou are about to execute the CLA with hotkey: {hotkey_ss58}"
    )

    # 4. Explicit confirmation
    if not yes:
        confirmation = typer.prompt(
            "Type 'I AGREE' to execute the Contributor License Agreement"
        )
        if confirmation.strip() != "I AGREE":
            typer.secho(
                "Execution cancelled. CLA not signed.", fg=typer.colors.YELLOW
            )
            raise typer.Exit(code=1)

    # 5. Build canonical payload and sign
    nonce = uuid.uuid4().hex
    issued_at = int(time.time())
    payload = build_cla_payload(
        netuid=netuid,
        cla_version=cla_version,
        cla_sha256=expected_sha256,
        hotkey=hotkey_ss58,
        nonce=nonce,
        issued_at=issued_at,
    )

    raw_sig = keypair.sign(payload.encode("utf-8"))
    sig_hex = (
        raw_sig.hex()
        if isinstance(raw_sig, bytes)
        else str(raw_sig)
    )
    if not sig_hex.startswith("0x"):
        sig_hex = "0x" + sig_hex

    # 6. Post signature to Platform
    sign_url = f"{platform_url.rstrip('/')}/api/v1/cla/sign"
    sign_body = {
        "netuid": netuid,
        "hotkey": hotkey_ss58,
        "cla_version": cla_version,
        "cla_sha256": expected_sha256,
        "signature": sig_hex,
        "nonce": nonce,
        "issued_at": issued_at,
    }

    try:
        sign_resp = httpx.post(sign_url, json=sign_body, timeout=10.0)
        sign_resp.raise_for_status()
        data = sign_resp.json()
    except Exception as exc:
        typer.secho(
            f"Failed to submit signature to Platform: {exc}",
            fg=typer.colors.RED,
        )
        raise typer.Exit(code=1)

    typer.secho(
        f"\nSUCCESS: Hotkey {hotkey_ss58} successfully executed CLA {cla_version}!\n"
        f"Recorded at: {data.get('signed_at')}",
        fg=typer.colors.GREEN,
    )
