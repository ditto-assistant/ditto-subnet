+from __future__ import annotations
+
+from datetime import datetime, timezone
+from sqlalchemy import Column, DateTime, Integer, String, Text, event
+from apps.platform.ditto.db.base import Base
+
+
+class CLAVersion(Base):
+    __tablename__ = "cla_versions"
+
+    id = Column(Integer, primary_key=True, autoincrement=True)
+    version = Column(String(32), unique=True, nullable=False, index=True)
+    sha256 = Column(String(64), nullable=False)
+    text = Column(Text, nullable=True)
+    published_at = Column(DateTime(timezone=True), nullable=False, default=lambda: datetime.now(timezone.utc))
+    effective_at = Column(DateTime(timezone=True), nullable=False, default=lambda: datetime.now(timezone.utc))
+    created_at = Column(DateTime(timezone=True), nullable=False, default=lambda: datetime.now(timezone.utc))
+
+
+class CLASignature(Base):
+    """
+    Append-only record of a CLA signature by a miner hotkey.
+    Rows are strictly immutable and cannot be updated or deleted.
+    """
+    __tablename__ = "cla_signatures"
+
+    id = Column(Integer, primary_key=True, autoincrement=True)
+    hotkey = Column(String(64), nullable=False, index=True)
+    coldkey = Column(String(64), nullable=True, index=True)
+    cla_version = Column(String(32), nullable=False, index=True)
+    cla_sha256 = Column(String(64), nullable=False)
+    signature = Column(String(256), nullable=False)
+    nonce = Column(String(64), unique=True, nullable=False, index=True)
+    issued_at = Column(DateTime(timezone=True), nullable=False)
+    signed_at = Column(DateTime(timezone=True), nullable=False, default=lambda: datetime.now(timezone.utc))
+
+
+# Enforce append-only invariants at the ORM layer
+@event.listens_for(CLASignature, "before_update")
+def _cla_signature_before_update(mapper, connection, target):
+    raise PermissionError("cla_signatures table is append-only: updates are not allowed")
+
+
+@event.listens_for(CLASignature, "before_delete")
+def _cla_signature_before_delete(mapper, connection, target):
+    raise PermissionError("cla_signatures table is append-only: deletes are not allowed")
+
+
+class CLAGateSetting(Base):
+    """
+    Audit log and state for the CLA submission gate mode.
+    Modes:
+      - 'off': gate check skipped.
+      - 'shadow': log and count unsigned uploads, but accept them.
+      - 'enforce': reject submissions missing a valid signature for the effective CLA.
+    """
+    __tablename__ = "cla_gate_settings"
+
+    id = Column(Integer, primary_key=True, autoincrement=True)
+    mode = Column(String(32), nullable=False, default="off")
+    changed_at = Column(DateTime(timezone=True), nullable=False, default=lambda: datetime.now(timezone.utc))
+    changed_by = Column(String(128), nullable=True, default="system")
+    note = Column(Text, nullable=True)
+
+
+class CLAShadowUploadLog(Base):
+    """
+    Append-only tracking for unsigned uploads observed during 'shadow' mode.
+    """
+    __tablename__ = "cla_shadow_upload_logs"
+
+    id = Column(Integer, primary_key=True, autoincrement=True)
+    hotkey = Column(String(64), nullable=False, index=True)
+    cla_version = Column(String(32), nullable=False)
+    recorded_at = Column(DateTime(timezone=True), nullable=False, default=lambda: datetime.now(timezone.utc))
+
+
+__all__ = [
+    "CLAVersion",
+    "CLASignature",
+    "CLAGateSetting",
+    "CLAShadowUploadLog",
+]
