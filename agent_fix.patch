### 5. CLA API Endpoints
`apps/platform/ditto/api_server/endpoints/cla.py`
```python
"""API routes for CLA version queries, signing submissions, and public status."""

from fastapi import APIRouter, Depends, HTTPException, status
from pydantic import BaseModel
from sqlalchemy.orm import Session
from typing import Optional

from apps.platform.ditto.api_server.db import get_db
from apps.platform.ditto.api_server.cla.service import (
    get_current_cla_version,
    get_hotkey_cla_status,
    verify_and_record_cla_signature,
)

router = APIRouter(prefix="/api/v1/cla", tags=["cla"])


class CLASignRequest(BaseModel):
    netuid: int
    hotkey: str
    cla_version: str
    cla_sha256: str
    nonce: str
    issued_at: int
    signature: str


@router.get("/current")
def get_current_version(db: Session = Depends(get_db)):
    curr = get_current_cla_version(db)
    if not curr:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail="No effective CLA version found.",
        )
    return {
        "version": curr.version,
        "sha256": curr.sha256,
        "published_at": curr.published_at.isoformat(),
        "effective_at": curr.effective_at.isoformat(),
    }


@router.get("/status/{hotkey}")
def get_status(hotkey: str, db: Session = Depends(get_db)):
    return get_hotkey_cla_status(db, hotkey)


@router.post("/sign", status_code=status.HTTP_201_CREATED)
def submit_cla_signature(req: CLASignRequest, db: Session = Depends(get_db)):
    try:
        record = verify_and_record_cla_signature(
            db=db,
            netuid=req.netuid,
            hotkey=req.hotkey,
            cla_version=req.cla_version,
            cla_sha256=req.cla_sha256,
            nonce=req.nonce,
            issued_at=req.issued_at,
            signature=req.signature,
        )
        return {
            "status": "success",
            "id": record.id,
            "hotkey": record.hotkey,
            "cla_version": record.cla_version,
            "signed_at": record.signed_at.isoformat(),
        }
    except ValueError as e:
        raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail=str(e))
