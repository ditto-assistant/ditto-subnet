def check_bounty_pr_cla_status(github_username: str, db: Session) -> dict:
    """Evaluates whether a pull request author has satisfied the CLA requirement."""
    hotkey = resolve_github_user_to_hotkey(github_username, db)
    if not hotkey:
        return {
            "status": "fail",
            "reason": f"GitHub user @{github_username} is not linked to any hotkey.",
        }

    status = get_hotkey_cla_status(db, hotkey)
    if not status["is_current"]:
        return {
            "status": "fail",
            "hotkey": hotkey,
            "reason": (
                f"Hotkey {hotkey} has not signed the current CLA version "
                f"({status.get('current_cla_version')})."
            ),
        }

    return {
        "status": "pass",
        "hotkey": hotkey,
        "cla_version": status["signed_version"],
        "signed_at": status["signed_at"],
    }
