def test_upload_gate_modes():
    unsigned_hotkey = Keypair.create_from_mnemonic(Keypair.generate_mnemonic()).ss58_address

    # 1. Mode: OFF -> Allowed
    client.post("/api/v1/cla/gate/setting", json={"mode": "off"})
    resp = client.post("/api/v1/upload/check", json={"hotkey": unsigned_hotkey})
    assert resp.status_code == 200

    # 2. Mode: SHADOW -> Allowed but recorded
    client.post("/api/v1/cla/gate/setting", json={"mode": "shadow"})
    resp = client.post("/api/v1/upload/check", json={"hotkey": unsigned_hotkey})
    assert resp.status_code == 200

    # 3. Mode: ENFORCE -> Refused for unsigned hotkey
    client.post("/api/v1/cla/gate/setting", json={"mode": "enforce"})
    resp = client.post("/api/v1/upload/check", json={"hotkey": unsigned_hotkey})
    assert resp.status_code == 403
    assert "uv run ditto cla sign" in resp.json()["detail"]


