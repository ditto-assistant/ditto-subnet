    app.include_router(cla_router)
    app.include_router(upload_router)
    client = TestClient(app)

    yield {"client": client, "db": db}
    db.close()


def test_public_status_endpoint(test_env):
    client = test_env["client"]
    resp = client.get(f"/api/v1/cla/status/{HOTKEY}")
    assert resp.status_code == 200
    data = resp.json()
    assert data["signed"] is False
    assert data["is_current"] is False


def test_sign_flow_valid_and_rejected_on_stale_or_replay(test_env):
    client = test_env["client"]
    now = int(time.time())

    # 1. Stale issued_at
    payload_stale = {
        "netuid": 118,
        "hotkey": HOTKEY,
        "cla_version": "v1",
        "cla_sha256": SAMPLE_DIGEST,
        "signature": f"mock_sig_valid_{HOTKEY}",
        "nonce": "n_stale",
        "issued_at": now - 1000,
    }
    r = client.post("/api/v1/cla/sign", json=payload_stale)
    assert r.status_code == 400
    assert "freshness window" in r.text

    # 2. Wrong signer
    payload_wrong_signer = {
        "netuid": 118,
        "hotkey": HOTKEY,
        "cla_version": "v1",
        "cla_sha256": SAMPLE_DIGEST,
        "signature": "0xbadbadbad",
        "nonce": "n_wrong_signer",
        "issued_at": now,
    }
    r = client.post("/api/v1/cla/sign", json=payload_wrong_signer)
    assert r.status_code == 401

    # 3. Valid signature
    payload_valid = {
        "netuid": 118,
        "hotkey": HOTKEY,
        "cla_version": "v1",
        "cla_sha256": SAMPLE_DIGEST,
        "signature": f"mock_sig_123_{HOTKEY}",
        "nonce": "n_unique_1",
        "issued_at": now,
    }
    r = client.post("/api/v1/cla/sign", json=payload_valid)
    assert r.status_code == 201
    assert r.json()["status"] == "success"

    # 4. Replay nonce
    r_replay = client.post("/api/v1/cla/sign", json=payload_valid)
    assert r_replay.status_code == 409

    # 5. Check status is now signed and current
    st = client.get(f"/api/v1/cla/status/{HOTKEY}").json()
    assert st["signed"] is True
    assert st["is_current"] is True
    assert st["version"] == "v1"
    assert st["sha256"] == SAMPLE_DIGEST


def test_upload_gate_modes(test_env):
    client = test_env["client"]
    db = test_env["db"]
    unsigned_hotkey = "5FHneW46xGXgs5mUiveU4sbTyGBzmstUspZC92UhjJM694ty"

    # --- Mode 1: OFF ---
    db.add(CLAGateSettingHistory(mode="off", changed_by="admin"))
    db.commit()
    r = client.post(
        "/api/v1/upload/check", json={"hotkey": unsigned_hotkey}
    )
    assert r.status_code == 200

    # --- Mode 2: SHADOW ---
    db.add(CLAGateSettingHistory(mode="shadow", changed_by="admin"))
    db.commit()
    r = client.post(
        "/api/v1/upload/check", json={"hotkey": unsigned_hotkey}
    )
    assert r.status_code == 200
    shadow_count = (
        db.query(CLAShadowUploadLog)
        .filter(CLAShadowUploadLog.hotkey == unsigned_hotkey)
        .count()
    )
    assert shadow_count == 1

    # --- Mode 3: ENFORCE ---
    db.add(CLAGateSettingHistory(mode="enforce", changed_by="admin"))
    db.commit()

    # Unsigned hotkey rejected
    r_enforce = client.post(
        "/api/v1/upload/check", json={"hotkey": unsigned_hotkey}
    )
    assert r_enforce.status_code == 403
    assert "ditto cla sign" in r_enforce.text

    # Outdated version hotkey rejected
    outdated_hotkey = "5DAAnrj7VHTznn2AWBemMuyBwZWs6FNFjdyVXUeYum3PTXFy"
    db.add(
        CLASignature(
            hotkey=outdated_hotkey,
            coldkey="cold_outdated",
            cla_version="v0",
            cla_sha256="outdated_digest",
            signature="0xsig",
            nonce="n_outdated",
            issued_at=int(time.time()),
            signed_at=datetime.now(timezone.utc),
        )
    )
    db.commit()

    r_outdated = client.post(
        "/api/v1/upload/check", json={"hotkey": outdated_hotkey}
    )
    assert r_outdated.status_code == 403
    assert "ditto cla sign" in r_outdated.text

    # Signed current hotkey accepted
    db.add(
        CLASignature(
            hotkey=unsigned_hotkey,
            coldkey="cold_now_signed",
            cla_version="v1",
            cla_sha256=SAMPLE_DIGEST,
            signature=f"mock_sig_{unsigned_hotkey}",
            nonce="n_now_signed",
            issued_at=int(time.time()),
            signed_at=datetime.now(timezone.utc),
        )
    )
    db.commit()

    r_signed = client.post(
        "/api/v1/upload/check", json={"hotkey": unsigned_hotkey}
    )
    assert r_signed.status_code == 200
