### 8. Backroom MCP Inspection Tool: `apps/platform/ditto/backroom/cla_tool.py`

```python
"""Backroom MCP tool for inspecting CLA gate rollout, history, and miner adoption."""

from __future__ import annotations

from typing import Any
from sqlalchemy import desc
from sqlalchemy.orm import Session

from apps.platform.ditto.api_server.cla_service import (
    _shadow_upload_hotkeys,
    get_cla_gate_mode,
    get_current_cla_version,
)
from apps.platform.ditto.models.cla import CLAGateSetting, CLASignature


def get_cla_gate_status_report(db: Session, active_hotkeys: list[str] | None = None) -> dict[str, Any]:
    """Generates a complete report of CLA gate mode, audit history, and adoption metrics."""
    current_mode = get_cla_gate_mode(db)
    current_version = get_current_cla_version(db)

    # Fetch history of gate setting changes
    history_records = db.query(CLAGateSetting).order_by(desc(CLAGateSetting.id)).all()
    history = [
        {
            "mode": r.mode,
            "changed_by": r.changed_by,
            "reason": r.reason,
            "created_at": r.created_at.isoformat() if r.created_at else None,
        }
        for r in history_records
    ]

    # Active hotkeys evaluation
    if active_hotkeys is None:
        # Default to distinct hotkeys recorded in signatures or shadow attempts
        sig_hotkeys = {s[0] for s in db.query(CLASignature.hotkey).distinct().all()}
        all_hotkeys = list(sig_hotkeys | _shadow_upload_hotkeys)
    else:
        all_hotkeys = active_hotkeys

    signed_count = 0
    if current_version:
        signed_hotkeys = {
            s[0]
            for s in db.query(CLASignature.hotkey)
            .filter(
                CLASignature.cla_version == current_version.version,
                CLASignature.cla_sha256 == current_version.sha256,
            )
            .distinct()
            .all()
        }
        signed_count = sum(1 for hk in all_hotkeys if hk in signed_hotkeys)

    total_active = len(all_hotkeys)
    unsigned_count = total_active - signed_count
    adoption_pct = (signed_count / total_active * 100.0) if total_active > 0 else 0.0

    return {
        "gate_mode": current_mode,
        "current_cla_version": current_version.version if current_version else None,
        "current_cla_sha256": current_version.sha256 if current_version else None,
        "history": history,
        "adoption": {
            "total_active_hotkeys": total_active,
            "signed_active_hotkeys": signed_count,
            "unsigned_active_hotkeys": unsigned_count,
            "adoption_percentage": round(adoption_pct, 2),
            "shadow_upload_attempts_count": len(_shadow_upload_hotkeys),
        },
    }
