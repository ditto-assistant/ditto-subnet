"""Interface sketch for GitHub bounty PR contributor CLA validation (#2871)."""

from typing import Dict, Any, Optional
from sqlalchemy.orm import Session
from apps.platform.ditto.api_server.cla.service import get_hotkey_cla_status


def resolve_github_user_hotkey(github_username: str) -> Optional[str]:
