def test_cla_signature_append_only(db_session):
    """Verify that CLASignature rows cannot be modified or deleted."""
    ver = CLAVersion(
        version="v1",
        sha256="abcd" * 16,
        published_at=datetime.now(timezone.utc),
        effective_at=datetime.now(timezone.utc),
    )
    db_session.add(ver)
    db_session.commit()

    sig = CLASignature(
        hotkey="5GrwvaEF5zXb26Fz9rcQpDWS57CtERHpNehXCPcNoHGKutQY",
        coldkey="5FHneW46xGXgs5mUiveU4sbTyGBzmstUspZC92UhjJM694ty",
        cla_version="v1",
        cla_sha256="abcd" * 16,
        signature="0xmock",
        nonce="nonce-1",
        issued_at=datetime.now(timezone.utc),
    )
    db_session.add(sig)
    db_session.commit()

    # Attempt UPDATE
    sig.signature = "0xchanged"
    with pytest.raises(ValueError, match="append-only: updates are prohibited"):
        db_session.commit()

    db_session.rollback()

    # Attempt DELETE
    db_session.delete(sig)
    with pytest.raises(ValueError, match="append-only: deletes are prohibited"):
        db_session.commit()


def test_signature_verification_rules(db_session):
    """Test wrong signer, replayed nonce, stale issued_at, and digest mismatch."""
    text = b"Sample legal fixture"
    sha = hashlib.sha256(text).hexdigest()

    curr = CLAVersion(
        version="v1",
        sha256=sha,
        published_at=datetime.now(timezone.utc),
        effective_at=datetime.now(timezone.utc),
    )
    db_session.add(curr)
    db_session.commit()

    hotkey = "5GrwvaEF5zXb26Fz9rcQpDWS57CtERHpNehXCPcNoHGKutQY"
    netuid = 118
    nonce = str(uuid.uuid4())
    issued_at = int(time.time())

    # 1. Digest mismatch
    with pytest.raises(ValueError, match="digest mismatch"):
        verify_and_record_cla_signature(
            db_session, netuid, hotkey, "v1", "00" * 32, nonce, issued_at, f"0x_{hotkey}"
        )

    # 2. Outdated version
    with pytest.raises(ValueError, match="Version mismatch"):
        verify_and_record_cla_signature(
            db_session, netuid, hotkey, "v0", sha, nonce, issued_at, f"0x_{hotkey}"
        )

    # 3. Stale issued_at
    with pytest.raises(ValueError, match="freshness window"):
        stale_ts = issued_at - 600
        verify_and_record_cla_signature(
            db_session, netuid, hotkey, "v1", sha, nonce, stale_ts, f"0x_{hotkey}"
        )

    # 4. Wrong signature
    with pytest.raises(ValueError, match="verification failed"):
        verify_and_record_cla_signature(
            db_session, netuid, hotkey, "v1", sha, nonce, issued_at, "0x_wrong_signer"
        )

    # 5. Successful recording
    sig = verify_and_record_cla_signature(
        db_session, netuid, hotkey, "v1", sha, nonce, issued_at, f"0x_{hotkey}"
    )
    assert sig.hotkey == hotkey

    # 6. Replayed nonce
    with pytest.raises(ValueError, match="already been used"):
        verify_and_record_cla_signature(
            db_session, netuid, hotkey, "v1", sha, nonce, issued_at, f"0x_{hotkey}"
        )


def test_upload_gate_modes(db_session):
    """Test gate transitions: off -> shadow -> enforce."""
    text = b"Fixture"
    sha = hashlib.sha256(text).hexdigest()
    curr = CLAVersion(
        version="v1",
        sha256=sha,
        published_at=datetime.now(timezone.utc),
        effective_at=datetime.now(timezone.utc),
    )
    db_session.add(curr)
    db_session.commit()

    hotkey = "5GrwvaEF5zXb26Fz9rcQpDWS57CtERHpNehXCPcNoHGKutQY"

    # Default 'off' mode: unsigned hotkey allowed
    allowed, _ = check_upload_cla_gate(db_session, hotkey)
    assert allowed is True

    # 'shadow' mode: unsigned hotkey allowed with warning logged
    set_gate_mode(db_session, "shadow")
    allowed, _ = check_upload_cla_gate(db_session, hotkey)
    assert allowed is True

    # 'enforce' mode: unsigned hotkey rejected
    set_gate_mode(db_session, "enforce")
    allowed, err = check_upload_cla_gate(db_session, hotkey)
    assert allowed is False
    assert "uv run ditto cla sign" in err

    # Hotkey signs current version: allowed in enforce mode
    verify_and_record_cla_signature(
        db_session, 118, hotkey, "v1", sha, str(uuid.uuid4()), int(time.time()), f"0x_{hotkey}"
    )
    allowed, _ = check_upload_cla_gate(db_session, hotkey)
    assert allowed is True

    # New CLA version published: hotkey must re-sign
    new_sha = hashlib.sha256(b"v2 text").hexdigest()
    v2 = CLAVersion(
        version="v2",
        sha256=new_sha,
        published_at=datetime.now(timezone.utc),
        effective_at=datetime.now(timezone.utc),
    )
    db_session.add(v2)
    db_session.commit()

    allowed, err = check_upload_cla_gate(db_session, hotkey)
    assert allowed is False
    assert "signature required for current version" in err


