+"""Endpoints for Contributor License Agreement (CLA) registry and signatures."""
+
+from __future__ import annotations
+
+from datetime import datetime, timezone
+from typing import Optional
+import hashlib
+from fastapi import APIRouter, Depends, HTTPException, Query, status
+from pydantic import BaseModel, Field
+from sqlalchemy import select
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from ditto.api_server.attestation import verify_signature
+from ditto.api_server.cla_gate import (
+    get_effective_cla_version,
+    get_hotkey_cla_signature,
+    get_cla_gate_mode,
+)
+from ditto.api_server.state import ServerState
+from ditto.cla import build_cla_message, compute_cla_sha256
+from ditto.core.config import settings
+from ditto.db.models import CLASignature, CLAVersionRegistry
+
+router = APIRouter(prefix="/api/v1/cla", tags=["cla"])
+
+
+class CLAVersionResponse(BaseModel):
+    version: str
+    sha256: str
+    content: str
+    published_at: datetime
+    effective_at: datetime
+
+
+class CLASignRequest(BaseModel):
+    hotkey: str
+    cla_version: str
+    cla_sha256: str
+    nonce: str
+    issued_at: datetime
+    signature: str
+
+
+class CLASignResponse(BaseModel):
+    success: bool
+    message: str
+    hotkey: str
+    cla_version: str
+    cla_sha256: str
+    signed_at: datetime
+
+
+class CLAStatusResponse(BaseModel):
+    hotkey: str
+    signed: bool
+    is_current: bool
+    cla_version: Optional[str] = None
+    cla_sha256: Optional[str] = None
+    signature: Optional[str] = None
+    signed_at: Optional[datetime] = None
+    current_effective_version: Optional[str] = None
+
+
+async def get_db_session() -> AsyncSession:
+    async with ServerState.get_session() as session:
+        yield session
+
+
+@router.get("/current", response_model=CLAVersionResponse)
+async def get_current_cla(session: AsyncSession = Depends(get_db_session)) -> CLAVersionResponse:
+    """Return the currently effective CLA version and text."""
+    cla_entry = await get_effective_cla_version(session)
+    if not cla_entry:
+        # If none found in DB, try to auto-populate from file docs/legal/CLA-v1.md if present
+        try:
+            import os
+            from pathlib import Path
+            # Look for docs/legal/CLA-v1.md
+            possible_paths = [
+                Path(os.getcwd()) / "docs" / "legal" / f"CLA-{settings.CLA_CURRENT_VERSION}.md",
+                Path(__file__).parents[5] / "docs" / "legal" / f"CLA-{settings.CLA_CURRENT_VERSION}.md",
+            ]
+            for p in possible_paths:
+                if p.is_file():
+                    text = p.read_text(encoding="utf-8")
+                    digest = compute_cla_sha256(text)
+                    now = datetime.now(timezone.utc)
+                    cla_entry = CLAVersionRegistry(
+                        version=settings.CLA_CURRENT_VERSION,
+                        sha256=digest,
+                        content=text,
+                        published_at=now,
+                        effective_at=now,
+                    )
+                    session.add(cla_entry)
+                    await session.commit()
+                    break
+        except Exception:
+            pass
+
+    if not cla_entry:
+        raise HTTPException(
+            status_code=status.HTTP_404_NOT_FOUND,
+            detail="No effective CLA version found.",
+        )
+    return CLAVersionResponse(
+        version=cla_entry.version,
+        sha256=cla_entry.sha256,
+        content=cla_entry.content,
+        published_at=cla_entry.published_at,
+        effective_at=cla_entry.effective_at,
+    )
+
+
+@router.get("/status/{hotkey}", response_model=CLAStatusResponse)
+async def get_cla_status(
+    hotkey: str, session: AsyncSession = Depends(get_db_session)
+) -> CLAStatusResponse:
+    """Public read endpoint returning a hotkey's CLA status."""
+    effective_cla = await get_effective_cla_version(session)
+    current_ver = effective_cla.version if effective_cla else None
+
+    sig = await get_hotkey_cla_signature(session, hotkey)
+    if not sig:
+        return CLAStatusResponse(
+            hotkey=hotkey,
+            signed=False,
+            is_current=False,
+            current_effective_version=current_ver,
+        )
+
+    is_current = bool(
+        effective_cla
+        and sig.cla_version == effective_cla.version
+        and sig.cla_sha256 == effective_cla.sha256
+    )
+
+    return CLAStatusResponse(
+        hotkey=hotkey,
+        signed=True,
+        is_current=is_current,
+        cla_version=sig.cla_version,
+        cla_sha256=sig.cla_sha256,
+        signature=sig.signature,
+        signed_at=sig.signed_at,
+        current_effective_version=current_ver,
+    )
+
+
+@router.post("/sign", response_model=CLASignResponse)
+async def sign_cla(
+    req: CLASignRequest, session: AsyncSession = Depends(get_db_session)
+) -> CLASignResponse:
+    """Submit a hotkey signature for the CLA."""
+    # 1. Fetch CLA registry version
+    result = await session.execute(
+        select(CLAVersionRegistry).where(CLAVersionRegistry.version == req.cla_version)
+    )
+    cla_entry = result.scalars().first()
+    if not cla_entry:
+        raise HTTPException(
+            status_code=status.HTTP_404_NOT_FOUND,
+            detail=f"CLA version {req.cla_version} not found.",
+        )
+
+    # Check digest match
+    if cla_entry.sha256 != req.cla_sha256:
+        raise HTTPException(
+            status_code=status.HTTP_400_BAD_REQUEST,
+            detail=f"CLA digest mismatch: expected {cla_entry.sha256}, got {req.cla_sha256}",
+        )
+
+    # 2. Check nonce uniqueness in cla_signatures
+    existing_nonce = await session.execute(
+        select(CLASignature).where(CLASignature.nonce == req.nonce)
+    )
+    if existing_nonce.scalars().first():
+        raise HTTPException(
+            status_code=status.HTTP_409_CONFLICT,
+            detail="Nonce already used",
+        )
+
+    # 3. Build expected message
+    # ditto-cla:v1:<netuid>:<cla_version>:<cla_sha256>:<hotkey>:<nonce>:<issued_at>
+    expected_message = build_cla_message(
+        netuid=settings.NETUID,
+        cla_version=req.cla_version,
+        cla_sha256=req.cla_sha256,
+        hotkey=req.hotkey,
+        nonce=req.nonce,
+        issued_at=req.issued_at,
+    )
+
+    # 4. Verify signature & freshness window
+    try:
+        is_valid = verify_signature(
+            signer=req.hotkey,
+            message=expected_message,
+            signature=req.signature,
+            nonce=req.nonce,
+            issued_at=req.issued_at,
+        )
+    except ValueError as e:
+        raise HTTPException(
+            status_code=status.HTTP_400_BAD_REQUEST,
+            detail=f"Signature verification failed: {e}",
+        )
+
+    if not is_valid:
+        raise HTTPException(
+            status_code=status.HTTP_400_BAD_REQUEST,
+            detail="Invalid signature for CLA message",
+        )
+
+    # 5. Resolve coldkey from subtensor or fallback to hotkey
+    coldkey = req.hotkey
+    subtensor = ServerState.get_subtensor()
+    if subtensor:
+        try:
+            coldkey = subtensor.get_hotkey_owner(req.hotkey) or req.hotkey
+        except Exception:
+            coldkey = req.hotkey
+
+    # 6. Insert append-only record
+    signed_record = CLASignature(
+        hotkey=req.hotkey,
+        coldkey=coldkey,
+        cla_version=req.cla_version,
+        cla_sha256=req.cla_sha256,
+        signature=req.signature,
+        nonce=req.nonce,
+        issued_at=req.issued_at,
+        signed_at=datetime.now(timezone.utc),
+    )
+    session.add(signed_record)
+    await session.commit()
+    await session.refresh(signed_record)
+
+    return CLASignResponse(
+        success=True,
+        message=f"CLA {req.cla_version} successfully signed for {req.hotkey}",
+        hotkey=req.hotkey,
+        cla_version=req.cla_version,
+        cla_sha256=req.cla_sha256,
+        signed_at=signed_record.signed_at,
+    )
