### 6. Submission Gate: `apps/platform/ditto/api_server/endpoints/upload.py`

```python
import logging
from fastapi import APIRouter, Depends, HTTPException, status
from pydantic import BaseModel
from sqlalchemy.orm import Session

from apps.platform.ditto.db.models import (
    CLAVersion,
    CLASignature,
    CLAGateSetting,
    CLAShadowLog,
)
from apps.platform.ditto.db.session import get_db

logger = logging.getLogger(__name__)

router = APIRouter(prefix="/api/v1/upload", tags=["upload"])


class UploadCheckRequest(BaseModel):
    hotkey: str
    artifact_hash: str


class UploadAgentRequest(BaseModel):
    hotkey: str
    artifact_hash: str
    payload: dict = {}


def verify_cla_submission_gate(hotkey: str, endpoint_name: str, db: Session) -> None:
    """
    Submission gate for upload endpoints.
    Modes:
      - off: No check performed.
      - shadow: Unsigned uploads are logged & counted, but accepted.
      - enforce: Refuses hotkeys without valid signature for currently effective CLA version.
    """
    setting = db.query(CLAGateSetting).filter(CLAGateSetting.id == 1).first()
    mode = setting.mode if setting else "off"

    if mode == "off":
        return

    current_cla = db.query(CLAVersion).filter(CLAVersion.is_current == True).order_by(CLAVersion.effective_at.desc()).first()
    if not current_cla:
        # No CLA active on platform; bypass
        return

    # Check whether hotkey has signed this exact version
    sig = (
        db.query(CLASignature)
        .filter(
            CLASignature.hotkey == hotkey,
            CLASignature.cla_version == current_cla.version,
        )
        .first()
    )

    is_signed = sig is not None

    if mode == "shadow":
        if not is_signed:
            logger.warning(
                "CLA Gate [SHADOW]: Hotkey %s has not signed current CLA version %s on %s. Permitting upload.",
                hotkey,
                current_cla.version,
                endpoint_name,
            )
            shadow_entry = CLAShadowLog(hotkey=hotkey, endpoint=endpoint_name)
            db.add(shadow_entry)
            db.commit()
        return

    if mode == "enforce":
        if not is_signed:
            logger.warning(
                "CLA Gate [ENFORCE]: Rejected unsigned upload from hotkey %s (required CLA: %s).",
                hotkey,
                current_cla.version,
            )
            raise HTTPException(
                status_code=status.HTTP_403_FORBIDDEN,
                detail=f"CLA not signed for current version ({current_cla.version}). Run `ditto cla sign` to sign the Contributor License Agreement.",
            )


@router.post("/check")
def upload_check(request: UploadCheckRequest, db: Session = Depends(get_db)):
    verify_cla_submission_gate(request.hotkey, "upload/check", db)
    return {"status": "ok", "ready_for_upload": True}


@router.post("/agent")
def upload_agent(request: UploadAgentRequest, db: Session = Depends(get_db)):
    verify_cla_submission_gate(request.hotkey, "upload/agent", db)
    # Proceed with agent registration/upload flow
    return {
        "status": "success",
        "agent_id": f"agent-{request.artifact_hash[:12]}",
        "hotkey": request.hotkey,
    }
