### 8. Backroom MCP Tool for Gate Setting and Adoption Stats

#### `apps/platform/ditto/backroom/tools/cla_tool.py`

```python
from datetime import datetime, timezone
from typing import Dict, Any, List
from sqlalchemy.orm import Session
from sqlalchemy import func

from apps.platform.ditto.models.cla import CLAVersion, CLASignature, CLAGateSetting, CLAShadowLog
from apps.platform.ditto.api_server.services.cla_service import (
    get_current_effective_cla,
    get_cla_gate_mode,
)


def get_cla_gate_status_and_adoption(db: Session, active_hotkeys: List[str] = None) -> Dict[str, Any]:
    """MCP tool for operators to monitor CLA gate configuration, history, and miner adoption."""
    current_mode = get_cla_gate_mode(db)
    current_cla = get_current_effective_cla(db)
    current_version = current_cla.version if current_cla else None

    # History of setting changes
    history_rows = (
        db.query(CLAGateSetting)
        .order_by(CLAGateSetting.changed_at.desc())
        .limit(20)
        .all()
    )
    history = [
        {
            "mode": h.mode,
            "changed_at": h.changed_at.isoformat(),
            "changed_by": h.changed_by,
            "reason": h.reason,
        }
        for h in history_rows
    ]

    # Total distinct hotkeys that have signed current CLA
    total_signed = 0
    if current_version:
        total_signed = (
            db.query(func.count(func.distinct(CLASignature.hotkey)))
            .filter(CLASignature.cla_version == current_version)
            .scalar()
            or 0
        )

    # Active miner stats (if active list provided from metagraph)
    active_signed = 0
    active_unsigned = 0
    if active_hotkeys and current_version:
        signed_active_set = set(
            row[0]
            for row in db.query(CLASignature.hotkey)
            .filter(
                CLASignature.hotkey.in_(active_hotkeys),
                CLASignature.cla_version == current_version,
            )
            .all()
        )
        active_signed = len(signed_active_set)
        active_unsigned = len(active_hotkeys) - active_signed

    shadow_events_count = 0
    if current_version:
        shadow_events_count = (
            db.query(func.count(CLAShadowLog.id))
            .filter(CLAShadowLog.cla_version == current_version)
            .scalar()
            or 0
        )

    return {
        "gate_mode": current_mode,
        "current_cla_version": current_version,
        "current_cla_sha256": current_cla.sha256 if current_cla else None,
        "history": history,
        "adoption": {
            "total_signed_hotkeys": total_signed,
            "active_hotkeys_total": len(active_hotkeys) if active_hotkeys else None,
            "active_signed_hotkeys": active_signed,
            "active_unsigned_hotkeys": active_unsigned,
            "shadow_mode_unsigned_uploads": shadow_events_count,
        },
    }
```

