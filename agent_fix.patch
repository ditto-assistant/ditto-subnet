"""CLA upload gating logic supporting 'off', 'shadow', and 'enforce' modes."""

from __future__ import annotations

import logging
from fastapi import HTTPException, status
from sqlalchemy.orm import Session

from apps.platform.ditto.api_server.endpoints.cla import get_current_cla_version
from apps.platform.ditto.db.models.cla import CLAGateSetting, CLASignature

logger = logging.getLogger("ditto.cla_gate")


def get_current_gate_mode(db: Session) -> str:
    setting = (
        db.query(CLAGateSetting)
        .order_by(CLAGateSetting.changed_at.desc())
        .first()
    )
    return setting.mode.lower() if setting else "off"


def verify_hotkey_cla_submission(hotkey: str, db: Session) -> None:
    """Gate upload submissions by CLA status.

    Modes:
      - 'off': No verification or blocking.
      - 'shadow': Verify and log missing/outdated CLA, but permit upload.
      - 'enforce': Reject with HTTP 403 if CLA is not signed for current version.
    """
    mode = get_current_gate_mode(db)
    if mode == "off":
        return

    current_cla = get_current_cla_version(db)
    if not current_cla:
        # If no CLA version is effective yet, allow
        return

    signed_record = (
        db.query(CLASignature)
        .filter(
            CLASignature.hotkey == hotkey,
            CLASignature.cla_version == current_cla.version,
        )
        .first()
    )

    if signed_record is None:
        msg = (
            f"Hotkey '{hotkey}' has not signed the current CLA (v{current_cla.version}). "
            "Please run 'uv run ditto cla sign' before submitting."
        )
        if mode == "shadow":
            logger.warning("[CLA-GATE-SHADOW] Unsigned upload detected: %s", msg)
            return
        elif mode == "enforce":
            raise HTTPException(
                status_code=status.HTTP_403_FORBIDDEN,
                detail=msg,
            )
