"""Tests for CLA signing, public read status, and upload gate modes (off, shadow, enforce)."""

from datetime import datetime, timezone
import hashlib
import time
import pytest
from fastapi import FastAPI
from fastapi.testclient import TestClient
from sqlalchemy import create_engine
from sqlalchemy.orm import sessionmaker

from apps.platform.ditto.api_server.attestation import build_cla_payload
