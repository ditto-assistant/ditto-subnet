import sys
import httpx


def check_cla_before_upload(hotkey_address: str, api_url: str) -> None:
    """
    Checks CLA status before packaging or issuing payment steps.
    Aborts immediately if the currently effective CLA has not been signed.
    """
    client = httpx.Client(base_url=api_url, timeout=10.0)
    try:
        resp = client.get(f"/api/v1/cla/status/{hotkey_address}")
        if resp.status_code == 200:
            status = resp.json()
            if not status.get("is_current"):
                print(
                    "\n[!] Contributor License Agreement (CLA) requirement check failed.\n"
                    "You have not signed the currently effective CLA version.\n"
                    "Run `uv run ditto cla sign` before uploading.",
                    file=sys.stderr,
                )
                sys.exit(1)
    except httpx.RequestError:
        # If platform cannot be reached, standard upload error handling will report connection issue
        pass
