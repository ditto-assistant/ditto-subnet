from __future__ import annotations

from datetime import datetime, timezone, timedelta
import logging
from typing import Optional
from fastapi import APIRouter, Depends, HTTPException, Query, status
from pydantic import BaseModel, Field
from sqlalchemy.orm import Session

from ditto.cla_protocol import build_cla_message_bytes
from apps.platform.ditto.api_server.attestation import verify_signature, get_hotkey_owner
from apps.platform.ditto.db.models import (
    ClaVersion,
    ClaSignature,
    ClaGateSettingHistory,
    ClaGateMode,
)
from apps.platform.ditto.db.session import get_db

logger = logging.getLogger(__name__)
router = APIRouter(prefix="/api/v1/cla", tags=["cla"])

MAX_FRESHNESS_SECONDS = 300  # 5 minutes window


class ClaCurrentResponse(BaseModel):
    version: str
    sha256: str
    published_at: datetime
    effective_at: datetime
    text_url: Optional[str] = None


class ClaSignRequest(BaseModel):
    netuid: int
    hotkey: str
    cla_version: str
    cla_sha256: str
    nonce: str
    issued_at: int
    signature: str


class ClaSignResponse(BaseModel):
    status: str
    hotkey: str
    coldkey: str
    cla_version: str
    signed_at: datetime


class ClaStatusResponse(BaseModel):
    hotkey: str
    signed: bool
    is_current: bool
    version: Optional[str] = None
    digest: Optional[str] = None
    signed_at: Optional[datetime] = None
    signature: Optional[str] = None


def get_effective_cla_version(db: Session) -> Optional[ClaVersion]:
    now = datetime.now(timezone.utc)
    return (
        db.query(ClaVersion)
        .filter(ClaVersion.effective_at <= now)
        .order_by(ClaVersion.effective_at.desc(), ClaVersion.id.desc())
        .first()
    )


def get_current_gate_mode(db: Session) -> ClaGateMode:
    latest = (
        db.query(ClaGateSettingHistory)
        .order_by(ClaGateSettingHistory.created_at.desc(), ClaGateSettingHistory.id.desc())
        .first()
    )
    if not latest:
        return ClaGateMode.OFF
    return ClaGateMode(latest.mode)


@router.get("/current", response_model=ClaCurrentResponse)
def get_current_cla(db: Session = Depends(get_db)):
    current = get_effective_cla_version(db)
    if not current:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail="No currently effective CLA version registered.",
        )
    return ClaCurrentResponse(
        version=current.version,
        sha256=current.sha256,
        published_at=current.published_at,
        effective_at=current.effective_at,
        text_url=f"/api/v1/cla/text/{current.version}",
    )


@router.get("/status", response_model=ClaStatusResponse)
def get_cla_status(hotkey: str = Query(..., description="SS58 hotkey address"), db: Session = Depends(get_db)):
    effective_ver = get_effective_cla_version(db)
    latest_sig = (
        db.query(ClaSignature)
        .filter(ClaSignature.hotkey == hotkey)
        .order_by(ClaSignature.signed_at.desc(), ClaSignature.id.desc())
        .first()
    )

    if not latest_sig:
        return ClaStatusResponse(hotkey=hotkey, signed=False, is_current=False)

    is_current = bool(effective_ver and latest_sig.cla_version == effective_ver.version)
    return ClaStatusResponse(
        hotkey=hotkey,
        signed=True,
        is_current=is_current,
        version=latest_sig.cla_version,
        digest=latest_sig.cla_sha256,
        signed_at=latest_sig.signed_at,
        signature=latest_sig.signature,
    )


@router.post("/sign", response_model=ClaSignResponse)
def submit_cla_signature(req: ClaSignRequest, db: Session = Depends(get_db)):
    # 1. Verify CLA version exists and matches digest
    cla_record = db.query(ClaVersion).filter(ClaVersion.version == req.cla_version).first()
    if not cla_record:
        raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail=f"Unknown CLA version: {req.cla_version}")
    if cla_record.sha256.lower() != req.cla_sha256.lower():
        raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail="Digest does not match official CLA registry.")

    # 2. Verify nonce uniqueness
    existing_nonce = db.query(ClaSignature).filter(ClaSignature.nonce == req.nonce).first()
    if existing_nonce:
        raise HTTPException(status_code=status.HTTP_409_CONFLICT, detail="Replayed nonce.")

    # 3. Check issued_at freshness
    now_ts = int(datetime.now(timezone.utc).timestamp())
    if abs(now_ts - req.issued_at) > MAX_FRESHNESS_SECONDS:
        raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail="Stale or invalid issued_at timestamp.")

    # 4. Verify cryptographic signature
    message_bytes = build_cla_message_bytes(
        netuid=req.netuid,
        cla_version=req.cla_version,
        cla_sha256=req.cla_sha256,
        hotkey=req.hotkey,
        nonce=req.nonce,
        issued_at=req.issued_at,
    )
    if not verify_signature(message=message_bytes, signature=req.signature, hotkey=req.hotkey):
        raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail="Invalid cryptographic signature.")

    # 5. Resolve coldkey owner at finalized block
    coldkey = get_hotkey_owner(req.hotkey)
    if not coldkey:
        coldkey = req.hotkey  # Fallback if unlinked or local dev

    # 6. Append-only storage
    signed_at = datetime.now(timezone.utc)
    sig_record = ClaSignature(
        hotkey=req.hotkey,
        coldkey=coldkey,
        cla_version=req.cla_version,
        cla_sha256=req.cla_sha256,
        signature=req.signature,
        nonce=req.nonce,
        issued_at=datetime.fromtimestamp(req.issued_at, tz=timezone.utc),
        signed_at=signed_at,
    )
    db.add(sig_record)
    db.commit()

    return ClaSignResponse(
        status="ok",
        hotkey=req.hotkey,
        coldkey=coldkey,
        cla_version=req.cla_version,
        signed_at=signed_at,
    )
