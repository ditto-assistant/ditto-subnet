### 5. CLA Platform Service & Public Endpoints

```python
# apps/platform/ditto/api_server/cla.py
import hashlib
import time
from datetime import datetime, timezone
from typing import Optional
from fastapi import APIRouter, Depends, HTTPException, status
from pydantic import BaseModel
from sqlalchemy.orm import Session

from .models import CLAVersion, CLASignature, CLAGateSetting
from .attestation import build_cla_message, verify_signature, resolve_hotkey_owner

FRESHNESS_WINDOW_SECONDS = 300  # 5 minutes


class CLASignRequest(BaseModel):
    hotkey: str
    cla_version: str
    cla_sha256: str
    signature: str
    nonce: str
    issued_at: int
    netuid: int = 118


class CLASignResponse(BaseModel):
    status: str
    hotkey: str
    coldkey: Optional[str]
    cla_version: str
    cla_sha256: str
    signed_at: str
    signature: str


class CLAStatusResponse(BaseModel):
    hotkey: str
    signed: bool
    is_current: bool
    version: Optional[str]
    digest: Optional[str]
    signed_at: Optional[str]
    signature: Optional[str]
    coldkey: Optional[str]


class CLACurrentResponse(BaseModel):
    version: str
    sha256: str
    published_at: str
    effective_at: str
    text: Optional[str]


router = APIRouter(prefix="/api/v1/cla", tags=["cla"])


def get_effective_cla(db: Session) -> Optional[CLAVersion]:
    now = datetime.now(timezone.utc)
    return (
        db.query(CLAVersion)
        .filter(CLAVersion.effective_at <= now)
        .order_by(CLAVersion.effective_at.desc(), CLAVersion.id.desc())
        .first()
    )


@router.get("/current", response_model=CLACurrentResponse)
def get_current_cla(db: Session = Depends()):
    current = get_effective_cla(db)
    if not current:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail="No active CLA version configured")
    return CLACurrentResponse(
        version=current.version,
        sha256=current.sha256,
        published_at=current.published_at.isoformat(),
        effective_at=current.effective_at.isoformat(),
        text=current.text,
    )


@router.get("/status/{hotkey}", response_model=CLAStatusResponse)
def get_cla_status(hotkey: str, db: Session = Depends()):
    current = get_effective_cla(db)
    sig = (
        db.query(CLASignature)
        .filter(CLASignature.hotkey == hotkey)
        .order_by(CLASignature.id.desc())
        .first()
    )

    if not sig:
        return CLAStatusResponse(
            hotkey=hotkey,
            signed=False,
            is_current=False,
            version=None,
            digest=None,
            signed_at=None,
            signature=None,
            coldkey=None,
        )

    is_current = bool(current and sig.cla_version == current.version and sig.cla_sha256 == current.sha256)
    return CLAStatusResponse(
        hotkey=hotkey,
        signed=True,
        is_current=is_current,
        version=sig.cla_version,
        digest=sig.cla_sha256,
        signed_at=sig.signed_at.isoformat(),
        signature=sig.signature,
        coldkey=sig.coldkey,
    )


@router.post("/sign", response_model=CLASignResponse)
def sign_cla(req: CLASignRequest, db: Session = Depends(), subtensor=None):
    # 1. Freshness window validation
    now_ts = int(time.time())
    if abs(now_ts - req.issued_at) > FRESHNESS_WINDOW_SECONDS:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="Stale or invalid issued_at timestamp (outside freshness window)",
        )

    # 2. Nonce replay prevention
    existing_nonce = db.query(CLASignature).filter(CLASignature.nonce == req.nonce).first()
    if existing_nonce:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="Nonce already used (replayed nonce)",
        )

    # 3. CLA version and digest validation against registry
    cla_ver = db.query(CLAVersion).filter(CLAVersion.version == req.cla_version).first()
    if not cla_ver:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail=f"CLA version {req.cla_version} is not recognized",
        )
    if cla_ver.sha256.lower() != req.cla_sha256.lower():
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="CLA SHA-256 digest does not match registry",
        )

    # 4. Signature verification
    expected_message = build_cla_message(
        netuid=req.netuid,
        cla_version=req.cla_version,
        cla_sha256=req.cla_sha256,
        hotkey=req.hotkey,
        nonce=req.nonce,
        issued_at=req.issued_at,
    )
    if not verify_signature(expected_message, req.signature, req.hotkey):
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail="Invalid signature or wrong signer for hotkey",
        )

    # 5. Coldkey resolution & append-only insertion
    coldkey = resolve_hotkey_owner(req.hotkey, subtensor)
    signed_row = CLASignature(
        hotkey=req.hotkey,
        coldkey=coldkey,
        cla_version=req.cla_version,
        cla_sha256=req.cla_sha256,
        signature=req.signature,
        nonce=req.nonce,
        issued_at=req.issued_at,
        signed_at=datetime.now(timezone.utc),
    )
    db.add(signed_row)
    db.commit()
    db.refresh(signed_row)

    return CLASignResponse(
        status="success",
        hotkey=signed_row.hotkey,
        coldkey=signed_row.coldkey,
        cla_version=signed_row.cla_version,
        cla_sha256=signed_row.cla_sha256,
        signed_at=signed_row.signed_at.isoformat(),
        signature=signed_row.signature,
    )
