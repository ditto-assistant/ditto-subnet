# apps/platform/ditto/api_server/endpoints/upload.py
"""Upload verification and submission gate with CLA checks."""

from __future__ import annotations

import logging
from typing import Any

from fastapi import APIRouter, Depends, HTTPException, status
from pydantic import BaseModel, Field
from sqlalchemy.orm import Session

from apps.platform.ditto.api_server.endpoints.cla import (
    get_active_cla_version,
    get_current_gate_mode,
    get_db,
)
from apps.platform.ditto.db.models.cla import (
    CLAShadowUploadLog,
    CLASignature,
)

logger = logging.getLogger(__name__)

router = APIRouter(prefix="/api/v1/upload", tags=["upload"])


class UploadCheckRequest(BaseModel):
    hotkey: str = Field(..., min_length=1)
    agent_name: str | None = None
    artifact_hash: str | None = None


class UploadAgentRequest(BaseModel):
    hotkey: str = Field(..., min_length=1)
    agent_name: str
    artifact_hash: str
    metadata: dict[str, Any] = Field(default_factory=dict)


def verify_cla_submission_gate(
    hotkey: str, endpoint: str, db: Session
) -> None:
    """Gate upload submissions by enforcing valid signature on current effective CLA.

    Modes:
      - 'off': accept unconditionally.
      - 'shadow': log & count unsigned uploads, accept upload.
      - 'enforce': refuse unsigned/outdated hotkeys with 403 Forbidden.
    """
    mode = get_current_gate_mode(db)
    if mode == "off":
        return

    current_cla = get_active_cla_version(db)
    if not current_cla:
        return

    valid_signature = (
        db.query(CLASignature)
        .filter(
            CLASignature.hotkey == hotkey,
            CLASignature.cla_version == current_cla.version,
            CLASignature.cla_sha256 == current_cla.sha256,
        )
        .first()
    )

    if valid_signature is not None:
        return

    # Hotkey has not signed current CLA
    if mode == "shadow":
        logger.warning(
            f"[CLA SHADOW] Hotkey '{hotkey}' has not signed CLA '{current_cla.version}', "
            f"allowing upload on endpoint '{endpoint}'."
        )
        log_entry = CLAShadowUploadLog(hotkey=hotkey, endpoint=endpoint)
        db.add(log_entry)
        db.commit()
        return

    if mode == "enforce":
        logger.info(
            f"[CLA ENFORCE] Rejected upload from hotkey '{hotkey}': current CLA '{current_cla.version}' not signed."
        )
        raise HTTPException(
            status_code=status.HTTP_403_FORBIDDEN,
            detail=(
                f"Submission rejected: hotkey '{hotkey}' has not signed the currently effective "
                f"Contributor License Agreement ({current_cla.version}). "
                f"Please run 'ditto cla sign' to execute the agreement."
            ),
        )


@router.post("/check")
def check_upload(req: UploadCheckRequest, db: Session = Depends(get_db)) -> Any:
    """Pre-upload validation gate."""
    verify_cla_submission_gate(
        hotkey=req.hotkey, endpoint="/api/v1/upload/check", db=db
    )
    return {"status": "ok", "allowed": True, "hotkey": req.hotkey}


@router.post("/agent")
def upload_agent(req: UploadAgentRequest, db: Session = Depends(get_db)) -> Any:
    """Upload miner agent artifact."""
    verify_cla_submission_gate(
        hotkey=req.hotkey, endpoint="/api/v1/upload/agent", db=db
    )
    return {
        "status": "success",
        "agent_name": req.agent_name,
        "artifact_hash": req.artifact_hash,
    }
