### 9. Backroom MCP Tool for Operators

In `apps/backroom/tools/cla_tool.py`:
```python
"""Backroom MCP tool for inspecting CLA gate mode and adoption."""

from sqlalchemy import desc, func, select
from ditto.db.session import async_session_factory
from ditto.db.models.cla import CLAGateSettingAudit, CLASignature, CLAVersion
from ditto.services.cla_service import CLAService


async def get_cla_gate_report() -> dict:
    """Return CLA gate status, history, and hotkey signing statistics."""
    async with async_session_factory() as session:
        # Gate mode
        mode = await CLAService.get_gate_mode(session)

        # Gate history
        hist_stmt = (
            select(CLAGateSettingAudit)
            .order_by(desc(CLAGateSettingAudit.changed_at))
            .limit(20)
        )
        hist_res = await session.execute(hist_stmt)
        history = [
            {
                "mode": h.mode,
                "changed_by": h.changed_by,
                "changed_at": h.changed_at.isoformat(),
                "reason": h.reason,
            }
            for h in hist_res.scalars().all()
        ]

        # Current CLA
        effective = await CLAService.get_effective_cla_version(session)
        eff_version = effective.version if effective else None

        # Count hotkeys signed to current effective CLA
        signed_hotkeys_count = 0
        if effective:
            signed_stmt = (
                select(func.count(func.distinct(CLASignature.hotkey)))
                .where(CLASignature.cla_version == effective.version)
                .where(CLASignature.cla_sha256 == effective.sha256)
            )
            count_res = await session.execute(signed_stmt)
            signed_hotkeys_count = count_res.scalar() or 0

        # Total unique hotkeys that have signed any CLA
        total_signed_stmt = select(func.count(func.distinct(CLASignature.hotkey)))
        total_res = await session.execute(total_signed_stmt)
        total_signed_hotkeys = total_res.scalar() or 0

        return {
            "mode": mode,
            "effective_cla_version": eff_version,
            "signed_current_hotkeys": signed_hotkeys_count,
            "total_signed_hotkeys": total_signed_hotkeys,
            "mode_history": history,
        }
```

