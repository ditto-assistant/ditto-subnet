### 6. Submission Gate Integration in Upload Endpoints

`apps/platform/ditto/api_server/endpoints/upload.py` (Gate logic):
```python
import logging
from fastapi import APIRouter, Depends, HTTPException, status
from sqlalchemy.orm import Session
from apps.platform.ditto.api_server.database import get_db
from apps.platform.ditto.api_server.cla import (
    get_cla_gate_mode,
    get_hotkey_cla_status,
)

logger = logging.getLogger(__name__)
upload_router = APIRouter(prefix="/api/v1/upload", tags=["upload"])


def enforce_cla_gate(hotkey: str, db: Session) -> None:
    mode = get_cla_gate_mode(db)
    if mode == "off":
        return

    status = get_hotkey_cla_status(db, hotkey)
    if not status["is_current"]:
        if mode == "shadow":
            logger.warning(
                "CLA shadow gate: hotkey %s uploaded without signing current CLA version %s.",
                hotkey,
                status.get("current_cla_version"),
            )
            return
        elif mode == "enforce":
            raise HTTPException(
                status_code=status.HTTP_403_FORBIDDEN,
                detail=(
                    "Contributor License Agreement (CLA) signature required for the current "
                    "version. Please execute 'uv run ditto cla sign' before uploading."
                ),
            )


@upload_router.post("/check")
def upload_check(payload: dict, db: Session = Depends(get_db)):
    hotkey = payload.get("hotkey")
    if not hotkey:
        raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail="Missing hotkey")
    enforce_cla_gate(hotkey=hotkey, db=db)
    return {"status": "ok"}


@upload_router.post("/agent")
def upload_agent(payload: dict, db: Session = Depends(get_db)):
    hotkey = payload.get("hotkey")
    if not hotkey:
        raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail="Missing hotkey")
    enforce_cla_gate(hotkey=hotkey, db=db)
    return {"status": "success", "agent_id": payload.get("agent_id", "test-agent")}
