"""Interface sketch for PR author CLA verification on bounty contributions (#2871 / #2054)."""

from __future__ import annotations

from dataclasses import dataclass
from typing import Protocol


@dataclass(frozen=True)
class PRCLACheckResult:
    github_user: str
    hotkey: str | None
    cla_signed: bool
    cla_version: str | None
    is_current: bool
    check_passed: bool
    message: str


class HotkeyResolverProtocol(Protocol):
    def resolve_hotkey_from_github(self, github_user: str) -> str | None:
        """Resolve a bounty contributor's GitHub username to their linked hotkey (#2871)."""
        ...


class BountyPRCLAChecker:
    """Checks whether the author of a GitHub PR has signed the current CLA."""

    def __init__(self, resolver: HotkeyResolverProtocol, cla_status_checker) -> None:  # type: ignore[no-untyped-def]
        self.resolver = resolver
        self.cla_status_checker = cla_status_checker

    def check_pr_author(self, github_user: str) -> PRCLACheckResult:
        hotkey = self.resolver.resolve_hotkey_from_github(github_user)
        if not hotkey:
            return PRCLACheckResult(
                github_user=github_user,
                hotkey=None,
                cla_signed=False,
                cla_version=None,
                is_current=False,
                check_passed=False,
                message=f"GitHub account @{github_user} is not linked to any Subnet 118 hotkey.",
            )

        status = self.cla_status_checker(hotkey)
        if not status.get("is_current", False):
            return PRCLACheckResult(
                github_user=github_user,
                hotkey=hotkey,
                cla_signed=status.get("signed", False),
                cla_version=status.get("version"),
                is_current=False,
                check_passed=False,
                message=f"Linked hotkey {hotkey} has not signed the current CLA version. Run 'ditto cla sign'.",
            )

        return PRCLACheckResult(
            github_user=github_user,
            hotkey=hotkey,
            cla_signed=True,
            cla_version=status.get("version"),
            is_current=True,
            check_passed=True,
            message=f"CLA signed for version {status.get('version')}.",
        )
