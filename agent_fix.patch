+
+
+@pytest.mark.asyncio
+async def test_cla_signature_append_only_prevent_update_delete(test_session: AsyncSession):
+    """Verify that CLASignature prevents updates and deletes (append-only)."""
+    now = datetime.now(timezone.utc)
+    sig = CLASignature(
+        hotkey="5GrwvaEF5zXb26Fz9rcQpDWS57CtERHpNehXCPcNoHGKutQY",
+        coldkey="5GrwvaEF5zXb26Fz9rcQpDWS57CtERHpNehXCPcNoHGKutQY",
+        cla_version="v1",
+        cla_sha256="abc123sha",
+        signature="0x1234",
+        nonce="nonce-1",
+        issued_at=now,
+        signed_at=now,
+    )
+    test_session.add(sig)
+    await test_session.commit()
+    await test_session.refresh(sig)
+
+    # Attempting to update should raise ValueError
+    sig.signature = "0x5678"
+    with pytest.raises(ValueError, match="append-only"):
+        await test_session.commit()
+
+    await test_session.rollback()
+
+    # Attempting to delete should raise ValueError
+    await test_session.delete(sig)
+    with pytest.raises(ValueError, match="append-only"):
+        await test_session.commit()
+
+
+@pytest.mark.asyncio
+async def test_cla_endpoints_and_gate(test_engine):
+    """Test /api/v1/cla/current, /sign, /status, and gate verification modes."""
+    session_factory = async_sessionmaker(test_engine, expire_on_commit=False, class_=AsyncSession)
+    ServerState._session_factory = session_factory
+
+    keypair = Keypair.create_from_mnemonic(Keypair.generate_mnemonic())
+    hotkey = keypair.ss58_address
+    other_keypair = Keypair.create_from_mnemonic(Keypair.generate_mnemonic())
+
+    cla_text = "# Test CLA\nTerms here."
+    cla_hash = compute_cla_sha256(cla_text)
+    now = datetime.now(timezone.utc)
+
+    # Preload CLA version into database
+    async with session_factory() as session:
+        entry = CLAVersionRegistry(
+            version="v1",
+            sha256=cla_hash,
+            content=cla_text,
+            published_at=now,
+            effective_at=now,
+        )
+        session.add(entry)
+        await session.commit()
+
+    transport = ASGITransport(app=app)
+    async with AsyncClient(transport=transport, base_url="http://test") as client:
+        # 1. GET /api/v1/cla/current
+        resp = await client.get("/api/v1/cla/current")
+        assert resp.status_code == 200
+        current_cla = resp.json()
+        assert current_cla["version"] == "v1"
+        assert current_cla["sha256"] == cla_hash
+
+        # 2. Check status for unsigned hotkey
+        status_resp = await client.get(f"/api/v1/cla/status/{hotkey}")
+        assert status_resp.status_code == 200
+        assert status_resp.json()["signed"] is False
+        assert status_resp.json()["is_current"] is False
+
+        # 3. Digest mismatch during signing
+        nonce = str(uuid.uuid4())
+        issued_at = datetime.now(timezone.utc)
+        msg = build_cla_message(
+            netuid=settings.NETUID,
+            cla_version="v1",
+            cla_sha256="wronghash",
+            hotkey=hotkey,
+            nonce=nonce,
+            issued_at=issued_at,
+        )
+        sig = f"0x{keypair.sign(msg.encode('utf-8')).hex()}"
+        mismatch_resp = await client.post(
+            "/api/v1/cla/sign",
+            json={
+                "hotkey": hotkey,
+                "cla_version": "v1",
+                "cla_sha256": "wronghash",
+                "nonce": nonce,
+                "issued_at": issued_at.isoformat(),
+                "signature": sig,
+            },
+        )
+        assert mismatch_resp.status_code == 400
+        assert "digest mismatch" in mismatch_resp.json()["detail"]
+
+        # 4. Wrong signer
+        msg_valid = build_cla_message(
+            netuid=settings.NETUID,
+            cla_version="v1",
+            cla_sha256=cla_hash,
+            hotkey=hotkey,
+            nonce=nonce,
+            issued_at=issued_at,
+        )
+        sig_wrong = f"0x{other_keypair.sign(msg_valid.encode('utf-8')).hex()}"
+        wrong_resp = await client.post(
+            "/api/v1/cla/sign",
+            json={
+                "hotkey": hotkey,
+                "cla_version": "v1",
+                "cla_sha256": cla_hash,
+                "nonce": nonce,
+                "issued_at": issued_at.isoformat(),
+                "signature": sig_wrong,
+            },
+        )
+        assert wrong_resp.status_code == 400
+
+        # 5. Stale issued_at
+        stale_issued = (datetime.now(timezone.utc) - timedelta(minutes=15))
+        stale_nonce = str(uuid.uuid4())
+        msg_stale = build_cla_message(
+            netuid=settings.NETUID,
+            cla_version="v1",
+            cla_sha256=cla_hash,
+            hotkey=hotkey,
+            nonce=stale_nonce,
+            issued_at=stale_issued,
+        )
+        sig_stale = f"0x{keypair.sign(msg_stale.encode('utf-8')).hex()}"
+        stale_resp = await client.post(
+            "/api/v1/cla/sign",
+            json={
+                "hotkey": hotkey,
+                "cla_version": "v1",
+                "cla_sha256": cla_hash,
+                "nonce": stale_nonce,
+                "issued_at": stale_issued.isoformat(),
+                "signature": sig_stale,
+            },
+        )
+        assert stale_resp.status_code == 400
+        assert "Timestamp out of bounds" in stale_resp.json()["detail"]
+
+        # 6. Valid sign
+        valid_nonce = str(uuid.uuid4())
+        valid_issued = datetime.now(timezone.utc)
+        msg_valid = build_cla_message(
+            netuid=settings.NETUID,
+            cla_version="v1",
+            cla_sha256=cla_hash,
+            hotkey=hotkey,
+            nonce=valid_nonce,
+            issued_at=valid_issued,
+        )
+        sig_valid = f"0x{keypair.sign(msg_valid.encode('utf-8')).hex()}"
+        sign_resp = await client.post(
+            "/api/v1/cla/sign",
