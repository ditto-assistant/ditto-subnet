    @app.get("/api/v1/cla/current")
    def get_current():
        return {
            "version": "v1",
            "sha256": good_digest,
            "published_at": "2025-01-01T00:00:00Z",
            "effective_at": "2025-01-01T00:00:00Z",
            "text": good_text,
        }

    @app.post("/api/v1/cla/sign")
    def sign_cla(payload: dict):
        return {
            "status": "success",
            "signed_at": "2025-05-01T12:00:00Z",
            "cla_version": payload["cla_version"],
        }

    @app.get("/api/v1/cla/status/{hotkey}")
    def get_status(hotkey: str):
        return {
            "hotkey": hotkey,
            "signed": True,
            "is_current": True,
            "version": "v1",
            "sha256": good_digest,
            "signed_at": "2025-05-01T12:00:00Z",
        }

    client = TestClient(app)
    monkeypatch.setattr("httpx.get", client.get)
    monkeypatch.setattr("httpx.post", client.post)

    # 1. Sign
    sign_result = runner.invoke(
        cla_cli, ["sign", "--platform-url", "http://test", "-y"]
    )
    assert sign_result.exit_code == 0
    assert "SUCCESS" in sign_result.output

    # 2. Status
    status_result = runner.invoke(
        cla_cli, ["status", "--platform-url", "http://test"]
    )
    assert status_result.exit_code == 0
    assert "Signed:     Yes" in status_result.output
    assert "Current:    Yes" in status_result.output
