    __table_args__ = (
        Index("ix_cla_signatures_hotkey_version", "hotkey", "cla_version"),
    )


# Enforce append-only invariants at ORM level
@event.listens_for(ClaSignature, "before_update")
def _prevent_cla_signature_update(mapper, connection, target):
