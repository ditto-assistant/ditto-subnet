"""Interface sketch for GitHub PR CLA check (stretch goal #2054 / #2871)."""

from typing import TypedDict
from sqlalchemy.orm import Session
from apps.platform.ditto.api_server.endpoints.cla import get_cla_status


class GithubClaCheckResult(TypedDict):
    github_username: str
    hotkey: str | None
    cla_status: str  # 'pass' | 'fail' | 'unlinked'
    current_version: str | None
    signed_version: str | None
    reason: str


def check_github_pr_author_cla(
    db: Session,
    github_username: str,
    resolve_hotkey_from_github_fn=None,
) -> GithubClaCheckResult:
    """
    Resolves GitHub author -> linked hotkey -> CLA signature status.
    Returns status suitable for reporting to the GitHub Check Run API.
    """
    if resolve_hotkey_from_github_fn is None:
        return {
            "github_username": github_username,
            "hotkey": None,
            "cla_status": "unlinked",
            "current_version": None,
            "signed_version": None,
            "reason": f"GitHub user @{github_username} is not linked to any miner hotkey.",
        }

    hotkey = resolve_hotkey_from_github_fn(db, github_username)
    if not hotkey:
        return {
            "github_username": github_username,
            "hotkey": None,
            "cla_status": "unlinked",
            "current_version": None,
            "signed_version": None,
            "reason": f"No hotkey associated with GitHub username @{github_username}.",
        }

    status_resp = get_cla_status(hotkey=hotkey, db=db)
    if status_resp.is_current:
        return {
            "github_username": github_username,
            "hotkey": hotkey,
            "cla_status": "pass",
            "current_version": status_resp.current_version,
            "signed_version": status_resp.signed_version,
            "reason": f"Valid CLA signature found for {status_resp.current_version}.",
        }

    return {
        "github_username": github_username,
        "hotkey": hotkey,
        "cla_status": "fail",
        "current_version": status_resp.current_version,
        "signed_version": status_resp.signed_version,
        "reason": f"Hotkey {hotkey} has not signed the currently effective CLA ({status_resp.current_version}).",
    }
