"""Miner CLI commands for Contributor License Agreement management."""

from __future__ import annotations

import os
import sys
import uuid
from datetime import datetime, timezone
from pathlib import Path
import httpx
import typer
from rich.console import Console

from ditto.cla_protocol import compute_sha256, build_cla_message_bytes

app = typer.Typer(name="cla", help="Manage Contributor License Agreement (CLA) signatures.")
console = Console()


def _get_platform_url() -> str:
    return os.environ.get("DITTO_PLATFORM_URL", "https://platform.ditto.network").rstrip("/")


def _get_keypair(wallet_name: str, hotkey_name: str):
    import bittensor as bt
    wallet = bt.wallet(name=wallet_name, hotkey=hotkey_name)
    return wallet.hotkey


@app.command("status")
def status_cmd(
    wallet: str = typer.Option("default", "--wallet", "-w", help="Bittensor wallet name"),
    hotkey: str = typer.Option("default", "--hotkey", "-k", help="Bittensor hotkey name"),
):
    """Check whether your hotkey has signed the current CLA."""
    keypair = _get_keypair(wallet, hotkey)
    hotkey_ss58 = keypair.ss58_address
    platform_url = _get_platform_url()

    console.print(f"[dim]Checking CLA status for hotkey {hotkey_ss58}...[/dim]")
    try:
        resp = httpx.get(f"{platform_url}/api/v1/cla/status", params={"hotkey": hotkey_ss58}, timeout=10.0)
        resp.raise_for_status()
        data = resp.json()
    except Exception as exc:
        console.print(f"[red]Error fetching CLA status: {exc}[/red]")
        raise typer.Exit(1)

    if not data.get("signed"):
        console.print(f"[yellow]No CLA signed for hotkey {hotkey_ss58}.[/yellow]")
        console.print("Run [bold cyan]ditto cla sign[/bold cyan] before uploading agents.")
        return

    is_current = data.get("is_current", False)
    if is_current:
        console.print(f"[green]✓ Current CLA ({data.get('version')}) is signed.[/green]")
    else:
        console.print(f"[yellow]! Signed version ({data.get('version')}) is outdated. Current CLA required.[/yellow]")

    console.print(f"Digest:    {data.get('digest')}")
    console.print(f"Signed at: {data.get('signed_at')}")


@app.command("sign")
def sign_cmd(
    wallet: str = typer.Option("default", "--wallet", "-w", help="Bittensor wallet name"),
    hotkey: str = typer.Option("default", "--hotkey", "-k", help="Bittensor hotkey name"),
    cla_file: Path = typer.Option(None, "--cla-path", help="Local path to CLA file (defaults to docs/legal/CLA-v1.md)"),
    netuid: int = typer.Option(118, "--netuid", help="Subnet netuid"),
):
    """Review and sign the Contributor License Agreement with your hotkey."""
    platform_url = _get_platform_url()

    # 1. Fetch current CLA expectations from Platform
    try:
        resp = httpx.get(f"{platform_url}/api/v1/cla/current", timeout=10.0)
        resp.raise_for_status()
        current_cla = resp.json()
    except Exception as exc:
        console.print(f"[red]Failed to retrieve current CLA info from platform: {exc}[/red]")
        raise typer.Exit(1)

    expected_version = current_cla["version"]
    expected_sha256 = current_cla["sha256"]

    # 2. Load CLA text from file or local default
    path = cla_file or Path(f"docs/legal/CLA-{expected_version}.md")
    if not path.exists():
        console.print(f"[red]CLA file not found at {path}. Please provide valid --cla-path.[/red]")
        raise typer.Exit(1)

    cla_text = path.read_text(encoding="utf-8")
    computed_sha256 = compute_sha256(cla_text)

    # 3. Refuse on digest mismatch
    if computed_sha256.lower() != expected_sha256.lower():
        console.print(f"[bold red]Refusing to sign: CLA digest mismatch![/bold red]")
        console.print(f"Expected: {expected_sha256}")
        console.print(f"Computed: {computed_sha256}")
        raise typer.Exit(1)

    console.print(f"[bold]Ditto Contributor License Agreement ({expected_version})[/bold]")
    console.print(f"SHA-256 Digest: [cyan]{computed_sha256}[/cyan]\n")
    console.print(cla_text[:600] + ("\n..." if len(cla_text) > 600 else ""))
    console.print("\n[yellow]By signing, you agree to license submitted contributions under the CLA.[/yellow]")

    confirm = typer.prompt("Type 'I AGREE' to confirm and sign")
    if confirm.strip() != "I AGREE":
        console.print("[red]Signing aborted.[/red]")
        raise typer.Exit(1)

    # 4. Sign payload
    keypair = _get_keypair(wallet, hotkey)
    nonce = uuid.uuid4().hex
    issued_at = int(datetime.now(timezone.utc).timestamp())

    msg_bytes = build_cla_message_bytes(
        netuid=netuid,
        cla_version=expected_version,
        cla_sha256=computed_sha256,
        hotkey=keypair.ss58_address,
        nonce=nonce,
        issued_at=issued_at,
    )

    signature = "0x" + keypair.sign(msg_bytes).hex()

    # 5. Submit to Platform
    payload = {
        "netuid": netuid,
        "hotkey": keypair.ss58_address,
        "cla_version": expected_version,
        "cla_sha256": computed_sha256,
        "nonce": nonce,
        "issued_at": issued_at,
        "signature": signature,
    }

    try:
        sub_resp = httpx.post(f"{platform_url}/api/v1/cla/sign", json=payload, timeout=10.0)
        sub_resp.raise_for_status()
    except Exception as exc:
        console.print(f"[red]Failed to submit signature: {exc}[/red]")
        raise typer.Exit(1)

    console.print(f"[bold green]✓ Successfully signed CLA {expected_version} for hotkey {keypair.ss58_address}![/bold green]")
```

In `ditto/miner_cli/main.py` register the subcommand:
```python
from ditto.miner_cli.cla_cli import app as cla_app
app.add_typer(cla_app, name="cla")
```

In `ditto upload` (`ditto/miner_cli/upload.py`), check status before packing/payment:
```python
def ensure_cla_signed(hotkey_ss58: str, platform_url: str) -> None:
    resp = httpx.get(f"{platform_url}/api/v1/cla/status", params={"hotkey": hotkey_ss58})
    if resp.status_code == 200:
        data = resp.json()
        if not data.get("is_current"):
            console.print("[bold red]Current CLA has not been signed for this hotkey.[/bold red]")
            console.print("Run [bold cyan]uv run ditto cla sign[/bold cyan] before uploading.")
            raise typer.Exit(1)
```

