### 2. Database Models and Append-Only Constraints

#### `apps/platform/ditto/db/models/cla.py`
```python
"""Database models for CLA version registry, append-only signatures, and gate settings."""

from __future__ import annotations

from datetime import datetime, timezone
from typing import Any

from sqlalchemy import BigInteger, DateTime, Integer, String, Text, event
from sqlalchemy.orm import DeclarativeBase, Mapped, mapped_column


class Base(DeclarativeBase):
    pass


class ReadOnlyTableError(Exception):
    """Raised when an update or delete is attempted on an append-only table."""


class CLAVersion(Base):
    """Registry of versioned CLAs with authoritative digests and activation windows."""

    __tablename__ = "cla_versions"

    id: Mapped[int] = mapped_column(Integer, primary_key=True, autoincrement=True)
    version: Mapped[str] = mapped_column(String(32), unique=True, index=True, nullable=False)
    sha256: Mapped[str] = mapped_column(String(64), nullable=False)
    text: Mapped[str] = mapped_column(Text, nullable=False)
    published_at: Mapped[datetime] = mapped_column(
        DateTime(timezone=True),
        default=lambda: datetime.now(timezone.utc),
        nullable=False,
    )
    effective_at: Mapped[datetime] = mapped_column(
        DateTime(timezone=True),
        default=lambda: datetime.now(timezone.utc),
        nullable=False,
    )
    created_at: Mapped[datetime] = mapped_column(
        DateTime(timezone=True),
        default=lambda: datetime.now(timezone.utc),
        nullable=False,
    )


class CLASignature(Base):
    """Append-only table of hotkey CLA signatures. Rows must never be updated or deleted."""

    __tablename__ = "cla_signatures"

    id: Mapped[int] = mapped_column(Integer, primary_key=True, autoincrement=True)
    hotkey: Mapped[str] = mapped_column(String(64), index=True, nullable=False)
    coldkey: Mapped[str | None] = mapped_column(String(64), nullable=True)
    cla_version: Mapped[str] = mapped_column(String(32), index=True, nullable=False)
    cla_sha256: Mapped[str] = mapped_column(String(64), nullable=False)
    signature: Mapped[str] = mapped_column(String(256), nullable=False)
    nonce: Mapped[str] = mapped_column(String(64), unique=True, index=True, nullable=False)
    issued_at: Mapped[int] = mapped_column(BigInteger, nullable=False)
    signed_at: Mapped[datetime] = mapped_column(
        DateTime(timezone=True),
        default=lambda: datetime.now(timezone.utc),
        nullable=False,
    )


# Enforce append-only semantics at the ORM layer in addition to DB triggers
@event.listens_for(CLASignature, "before_update")
def _prevent_signature_update(mapper: Any, connection: Any, target: Any) -> None:
    raise ReadOnlyTableError("cla_signatures is append-only: updates are prohibited.")


@event.listens_for(CLASignature, "before_delete")
def _prevent_signature_delete(mapper: Any, connection: Any, target: Any) -> None:
    raise ReadOnlyTableError("cla_signatures is append-only: deletes are prohibited.")


class CLAGateSetting(Base):
    """Platform gate settings mode history: off | shadow | enforce."""

    __tablename__ = "cla_gate_settings"

    id: Mapped[int] = mapped_column(Integer, primary_key=True, autoincrement=True)
    mode: Mapped[str] = mapped_column(String(16), nullable=False, default="off")
    changed_by: Mapped[str | None] = mapped_column(String(128), nullable=True)
    reason: Mapped[str | None] = mapped_column(String(255), nullable=True)
    created_at: Mapped[datetime] = mapped_column(
        DateTime(timezone=True),
        default=lambda: datetime.now(timezone.utc),
        nullable=False,
    )


class CLAShadowLog(Base):
    """Log of upload attempts made while gate is in shadow mode without a valid signature."""

    __tablename__ = "cla_shadow_logs"

    id: Mapped[int] = mapped_column(Integer, primary_key=True, autoincrement=True)
    hotkey: Mapped[str] = mapped_column(String(64), index=True, nullable=False)
    endpoint: Mapped[str] = mapped_column(String(64), nullable=False)
    created_at: Mapped[datetime] = mapped_column(
        DateTime(timezone=True),
        default=lambda: datetime.now(timezone.utc),
        nullable=False,
    )
