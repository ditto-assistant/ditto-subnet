In `tests/test_cla.py`:
```python
import pytest
from datetime import datetime, timezone, timedelta
from ditto.cla_common import build_cla_sign_payload, compute_cla_sha256
from ditto.db.models.cla import CLAVersion, CLASignature, CLAGateSettingAudit
from ditto.services.cla_service import CLAService


@pytest.mark.asyncio
async def test_append_only_cla_signature(db_session):
    sig = CLASignature(
        hotkey="hk_test_1",
        coldkey="ck_test_1",
        cla_version="v1",
        cla_sha256="abc",
        signature="0x123",
        nonce="nonce_1",
        issued_at=1000,
        signed_at=datetime.now(timezone.utc),
    )
    db_session.add(sig)
    await db_session.commit()

    # Attempt update
    sig.signature = "0x456"
    with pytest.raises(RuntimeError, match="append-only"):
        await db_session.commit()
    await db_session.rollback()

    # Attempt delete
    with pytest.raises(RuntimeError, match="append-only"):
        await db_session.delete(sig)
        await db_session.commit()
    await db_session.rollback()


@pytest.mark.asyncio
async def test_gate_modes_and_upload_check(db_session):
    now = datetime.now(timezone.utc)
    content = "# Test CLA\n"
    digest = compute_cla_sha256(content)

    v1 = CLAVersion(
        version="v1",
        sha256=digest,
        content=content,
        published_at=now,
        effective_at=now - timedelta(hours=1),
    )
    db_session.add(v1)
    await db_session.commit()

    # 1. Mode: off -> unsigned passes
    await CLAService.set_gate_mode(db_session, "off", "admin")
    allowed, err = await CLAService.check_upload_gate(db_session, "hk_unsigned")
    assert allowed is True

    # 2. Mode: shadow -> unsigned passes with log
    await CLAService.set_gate_mode(db_session, "shadow", "admin")
    allowed, err = await CLAService.check_upload_gate(db_session, "hk_unsigned")
    assert allowed is True

    # 3. Mode: enforce -> unsigned fails
    await CLAService.set_gate_mode(db_session, "enforce", "admin")
    allowed, err = await CLAService.check_upload_gate(db_session, "hk_unsigned")
    assert allowed is False
    assert "Run `ditto cla sign`" in err

    # 4. Outdated version signature
    sig_old = CLASignature(
        hotkey="hk_old",
        coldkey="ck_old",
        cla_version="v0",
        cla_sha256="old_digest",
        signature="0xsig",
        nonce="nonce_old",
        issued_at=100,
        signed_at=now,
    )
    db_session.add(sig_old)
    await db_session.commit()
    allowed, err = await CLAService.check_upload_gate(db_session, "hk_old")
    assert allowed is False

    # 5. Correct signed hotkey
    sig_valid = CLASignature(
        hotkey="hk_valid",
        coldkey="ck_valid",
        cla_version="v1",
        cla_sha256=digest,
        signature="0xsig",
        nonce="nonce_valid",
        issued_at=100,
        signed_at=now,
    )
    db_session.add(sig_valid)
    await db_session.commit()
    allowed, err = await CLAService.check_upload_gate(db_session, "hk_valid")
    assert allowed is True
    assert err is None
