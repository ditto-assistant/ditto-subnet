### 7. Backroom MCP Tool for Gate Status & Adoption Metrics
`apps/platform/ditto/api_server/mcp/cla_tools.py`
```python
"""Backroom MCP tool for inspecting CLA gate status, history, and adoption metrics."""

from typing import Dict, Any, List
from sqlalchemy.orm import Session
from apps.platform.ditto.api_server.models.cla import (
    CLAGateSettingHistory,
    CLASignature,
    CLAVersion,
)
from apps.platform.ditto.api_server.cla.service import get_gate_mode, get_current_cla_version


def get_cla_gate_metrics(db: Session, active_hotkeys: List[str]) -> Dict[str, Any]:
    """Exposes gate configuration history and hotkey adoption statistics to Backroom MCP."""
    mode = get_gate_mode(db)
    history_rows = (
        db.query(CLAGateSettingHistory)
        .order_by(CLAGateSettingHistory.changed_at.desc())
        .limit(50)
        .all()
    )
    history = [
        {
            "mode": h.mode,
            "changed_by": h.changed_by,
            "reason": h.reason,
            "changed_at": h.changed_at.isoformat(),
        }
        for h in history_rows
    ]

    curr_version = get_current_cla_version(db)
    active_set = set(active_hotkeys)

    signed_active_count = 0
    if curr_version and active_set:
        signed_active = (
            db.query(CLASignature.hotkey)
            .filter(
                CLASignature.cla_version == curr_version.version,
                CLASignature.hotkey.in_(active_set),
            )
            .distinct()
            .all()
        )
        signed_active_count = len(signed_active)

    unsigned_active_count = max(0, len(active_set) - signed_active_count)

    return {
        "gate_mode": mode,
        "effective_cla_version": curr_version.version if curr_version else None,
        "history": history,
        "adoption": {
            "total_active_hotkeys": len(active_set),
            "signed_active_hotkeys": signed_active_count,
            "unsigned_active_hotkeys": unsigned_active_count,
            "adoption_rate": (
                (signed_active_count / len(active_set)) if active_set else 1.0
            ),
        },
    }
