+    nonce = Column(String(64), unique=True, nullable=False)
+    issued_at = Column(BigInteger, nullable=False)
+    signed_at = Column(DateTime(timezone=True), server_default=func.now(), nullable=False)
+
+
+class CLAGateSettingsHistory(Base):
+    """Audit history for CLA gate mode settings ('off', 'shadow', 'enforce')."""
+
+    __tablename__ = "cla_gate_settings_history"
+
+    id = Column(Integer, primary_key=True, autoincrement=True)
+    mode = Column(String(16), nullable=False)
+    changed_by = Column(String(128), nullable=True)
+    reason = Column(Text, nullable=True)
+    changed_at = Column(DateTime(timezone=True), server_default=func.now(), nullable=False)
+
+
+# Enforce append-only rules at the SQLAlchemy ORM layer
+class AppendOnlyViolationError(PermissionError):
+    """Raised when an update or delete is attempted on an append-only table."""
+
+
+@event.listens_for(CLASignature, "before_update")
+def _prevent_cla_signature_update(mapper, connection, target):
+    raise AppendOnlyViolationError("Updates are prohibited on append-only table cla_signatures")
+
+
+@event.listens_for(CLASignature, "before_delete")
+def _prevent_cla_signature_delete(mapper, connection, target):
+    raise AppendOnlyViolationError("Deletions are prohibited on append-only table cla_signatures")
