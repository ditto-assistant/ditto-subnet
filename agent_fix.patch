"""Byte-for-byte mirrored payload builders for CLA signatures."""

def build_cla_sign_payload(
    netuid: int,
    cla_version: str,
    cla_sha256: str,
    hotkey: str,
    nonce: str,
    issued_at: int,
) -> bytes:
    """Build canonical payload for signing the Contributor License Agreement.
    
    Format:
    ditto-cla:v1:<netuid>:<cla_version>:<cla_sha256>:<hotkey>:<nonce>:<issued_at>
    """
    return f"ditto-cla:v1:{netuid}:{cla_version}:{cla_sha256.lower()}:{hotkey}:{nonce}:{issued_at}".encode("utf-8")
