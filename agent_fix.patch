#### `apps/platform/ditto/api_server/cla/bounty_check.py`
```python
"""Interface sketch for GitHub PR CLA check (Bounty PRs, #2871 follow-up)."""

from dataclasses import dataclass
from typing import Optional
from sqlalchemy.orm import Session

from apps.platform.ditto.api_server.cla_service import (
    check_hotkey_cla_signature,
    get_effective_cla_version,
)


@dataclass
class GitHubPRCLACheckResult:
    passed: bool
    github_username: str
    hotkey: Optional[str]
    cla_version: str
    status_description: str


def check_github_pr_cla_status(
    github_username: str,
    hotkey_resolver,
    db: Session,
) -> GitHubPRCLACheckResult:
    """Resolves PR Author -> linked hotkey -> current CLA signature."""
    effective_cla = get_effective_cla_version(db)
    linked_hotkey = hotkey_resolver(github_username)

    if not linked_hotkey:
        return GitHubPRCLACheckResult(
            passed=False,
            github_username=github_username,
            hotkey=None,
            cla_version=effective_cla.version,
            status_description=f"GitHub user @{github_username} has no linked hotkey.",
        )

    sig = check_hotkey_cla_signature(
        db, linked_hotkey, effective_cla.version, effective_cla.sha256
    )

    if sig is not None:
        return GitHubPRCLACheckResult(
            passed=True,
            github_username=github_username,
            hotkey=linked_hotkey,
            cla_version=effective_cla.version,
            status_description=f"CLA {effective_cla.version} signed by {linked_hotkey}.",
        )

    return GitHubPRCLACheckResult(
        passed=False,
        github_username=github_username,
        hotkey=linked_hotkey,
        cla_version=effective_cla.version,
        status_description=(
            f"Hotkey {linked_hotkey} has not signed CLA {effective_cla.version}. "
            "Run 'uv run ditto cla sign'."
        ),
    )
