### 8. Backroom MCP Read Tool (Adoption Telemetry & History)

```python
# apps/platform/ditto/backroom/tools.py
from datetime import datetime, timezone
from typing import Any, Dict
from sqlalchemy.orm import Session
from ..api_server.models import CLAVersion, CLASignature, CLAGateSetting, CLAUploadLog


def read_cla_gate_status(db: Session) -> Dict[str, Any]:
    """MCP tool for operators: inspect gate mode, audit history, and miner adoption."""
    # 1. Current mode & setting
    current_setting = db.query(CLAGateSetting).order_by(CLAGateSetting.id.desc()).first()
    mode = current_setting.mode if current_setting else "off"

    # 2. History of mode updates
    all_settings = db.query(CLAGateSetting).order_by(CLAGateSetting.id.asc()).all()
    history = [
        {
            "id": s.id,
            "mode": s.mode,
            "changed_by": s.changed_by,
            "reason": s.reason,
            "created_at": s.created_at.isoformat(),
        }
        for s in all_settings
    ]

    # 3. Active version
    now = datetime.now(timezone.utc)
    current_ver = (
        db.query(CLAVersion)
        .filter(CLAVersion.effective_at <= now)
        .order_by(CLAVersion.effective_at.desc(), CLAVersion.id.desc())
        .first()
    )
    effective_ver_str = current_ver.version if current_ver else None

    # 4. Adoption metrics
    total_signatures = db.query(CLASignature).count()
    if effective_ver_str:
        signed_hotkeys_query = (
            db.query(CLASignature.hotkey)
            .filter(CLASignature.cla_version == effective_ver_str)
            .distinct()
        )
        signed_hotkeys_count = signed_hotkeys_query.count()
    else:
        signed_hotkeys_count = 0

    # Active hotkeys observed in recent upload attempts
    observed_hotkeys = db.query(CLAUploadLog.hotkey).distinct().count()
    unsigned_shadow_count = (
        db.query(CLAUploadLog)
        .filter(CLAUploadLog.status == "unsigned_allowed")
        .count()
    )

    return {
        "current_mode": mode,
        "effective_cla_version": effective_ver_str,
        "history": history,
        "adoption": {
            "total_signatures_recorded": total_signatures,
            "unique_hotkeys_signed_effective": signed_hotkeys_count,
            "total_active_upload_hotkeys": observed_hotkeys,
            "unsigned_shadow_upload_events": unsigned_shadow_count,
        },
    }
