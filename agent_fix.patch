    CLASignature,
    CLAVersion,
)

SAMPLE_CLA_TEXT = (
    "# Subnet 118 CLA v1\nFixture placeholder text for testing."
)
SAMPLE_DIGEST = hashlib.sha256(SAMPLE_CLA_TEXT.encode("utf-8")).hexdigest()
HOTKEY = "5GrwvaEF5zXb26Fz9rcQpDWS57CtERHpNehXCPcNoHGKutQY"


@pytest.fixture
def test_env():
    engine = create_engine("sqlite:///:memory:")
