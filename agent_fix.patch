def test_cla_signature_append_only_mutation_prevention(db_session):
    """Prove there is no update or delete path on CLASignature."""
    sig = CLASignature(
        hotkey="5GrwvaEF5zXb26Fz9rcQpDWS57CtERHpNehXCPcNoHGKutQY",
        coldkey="5GrwvaEF5zXb26Fz9rcQpDWS57CtERHpNehXCPcNoHGKutQY",
        cla_version="1",
        cla_sha256="e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
        signature="deadbeef",
        nonce="nonce123",
        issued_at=datetime.datetime.now(datetime.timezone.utc),
    )
    db_session.add(sig)
    db_session.commit()

    # Attempt UPDATE
    sig.signature = "modified"
    with pytest.raises(PermissionError, match="append-only: updates are strictly forbidden"):
        db_session.commit()

    db_session.rollback()

    # Attempt DELETE
    db_session.delete(sig)
    with pytest.raises(PermissionError, match="append-only: deletes are strictly forbidden"):
        db_session.commit()


def test_signature_validation_and_failures():
    """Covers wrong signer, stale issued_at, digest mismatch, and correct signature."""
    kp = Keypair.create_from_mnemonic(Keypair.generate_mnemonic())
    wrong_kp = Keypair.create_from_mnemonic(Keypair.generate_mnemonic())
    cla_ver = "1"
    cla_sha = "abc1234"
    nonce = "nonce_1"
    now = int(datetime.datetime.now(datetime.timezone.utc).timestamp())

    msg = build_cla_sign_message(118, cla_ver, cla_sha, kp.ss58_address, nonce, now)
    valid_sig = kp.sign(msg.encode("utf-8")).hex()

    # 1. Valid signature
    ok, err = verify_cla_signature(118, cla_ver, cla_sha, kp.ss58_address, nonce, now, valid_sig, current_time=now)
    assert ok is True
    assert err is None

    # 2. Wrong signer
    wrong_sig = wrong_kp.sign(msg.encode("utf-8")).hex()
    ok, err = verify_cla_signature(118, cla_ver, cla_sha, kp.ss58_address, nonce, now, wrong_sig, current_time=now)
    assert ok is False
    assert "Invalid cryptographic signature" in err

    # 3. Stale issued_at (> 300 seconds)
    stale_time = now - 400
    ok, err = verify_cla_signature(118, cla_ver, cla_sha, kp.ss58_address, nonce, stale_time, valid_sig, current_time=now)
    assert ok is False
    assert "skew > 300s" in err


def test_upload_gate_modes(db_session):
    """Test gate modes: off, shadow, and enforce."""
    hotkey = "5GrwvaEF5zXb26Fz9rcQpDWS57CtERHpNehXCPcNoHGKutQY"

    # 1. Mode: OFF -> succeeds even without signature
    setting = CLAGateSetting(mode="off")
    db_session.add(setting)
    db_session.commit()
    verify_hotkey_cla_submission(hotkey, db_session)

    # 2. Mode: SHADOW -> logs warning, does not raise
    setting2 = CLAGateSetting(mode="shadow")
    db_session.add(setting2)
    db_session.commit()
    verify_hotkey_cla_submission(hotkey, db_session)

    # 3. Mode: ENFORCE -> unsigned raises 403
    setting3 = CLAGateSetting(mode="enforce")
    db_session.add(setting3)
    db_session.commit()
    with pytest.raises(HTTPException) as exc_info:
        verify_hotkey_cla_submission(hotkey, db_session)
    assert exc_info.value.status_code == 403
    assert "ditto cla sign" in exc_info.value.detail

    # Outdated signature -> raises 403 under enforce
    old_sig = CLASignature(
        hotkey=hotkey,
        coldkey=hotkey,
        cla_version="0",  # outdated
        cla_sha256="old",
        signature="sig",
        nonce="n1",
        issued_at=datetime.datetime.now(datetime.timezone.utc),
    )
    db_session.add(old_sig)
    db_session.commit()
    with pytest.raises(HTTPException):
        verify_hotkey_cla_submission(hotkey, db_session)

    # Current signature -> passes under enforce
    cur_sig = CLASignature(
        hotkey=hotkey,
        coldkey=hotkey,
        cla_version="1",  # current
        cla_sha256="e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
