### 4. Attestation and Mirrored Action Builder: `apps/platform/ditto/api_server/attestation.py`

```python
"""Attestation helpers for cryptographic signature verification and owner resolution."""

import time
from typing import Any
from substrateinterface import Keypair

OWNER_LINK_FRESHNESS_WINDOW_SECONDS: int = 300  # 5 minutes freshness window


def build_cla_message(
    netuid: int,
    cla_version: str,
    cla_sha256: str,
    hotkey: str,
    nonce: str,
    issued_at: int,
) -> str:
    """Byte-for-byte mirrored signed action message builder for CLA execution."""
    return f"ditto-cla:v1:{netuid}:{cla_version}:{cla_sha256}:{hotkey}:{nonce}:{issued_at}"


def verify_signature(hotkey: str, message: str | bytes, signature: str | bytes) -> bool:
    """Verifies sr25519 signature of message signed by hotkey."""
    try:
        msg_bytes = message.encode("utf-8") if isinstance(message, str) else message
        if isinstance(signature, str):
            sig_hex = signature[2:] if signature.startswith("0x") else signature
            sig_bytes = bytes.fromhex(sig_hex)
        else:
            sig_bytes = signature

        kp = Keypair(ss58_address=hotkey)
        return kp.verify(data=msg_bytes, signature=sig_bytes)
    except Exception:
        return False


def resolve_coldkey_owner(hotkey: str, subtensor: Any = None) -> str:
    """Resolves coldkey = Owner(hotkey) at a finalized block on Substrate/Bittensor."""
    if subtensor is not None:
        try:
            if hasattr(subtensor, "get_hotkey_owner"):
                owner = subtensor.get_hotkey_owner(hotkey)
                if owner:
                    return str(owner)
        except Exception:
            pass
        try:
            if hasattr(subtensor, "substrate"):
                query_res = subtensor.substrate.query("SubtensorModule", "Owner", [hotkey])
                if query_res and getattr(query_res, "value", None):
                    return str(query_res.value)
        except Exception:
            pass
    # Fallback when local/mocked or subtensor is unavailable
    return hotkey
