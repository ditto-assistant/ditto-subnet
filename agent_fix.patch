### 7. Miner CLI Implementation: `ditto/miner_cli/cla.py`

```python
"""CLI commands for miner CLA signing and status checking."""

import hashlib
import sys
import time
import uuid
import click
import httpx
from substrateinterface import Keypair

try:
    from bittensor_wallet import Wallet
except ImportError:
    Wallet = None


def build_cla_message(
    netuid: int,
    cla_version: str,
    cla_sha256: str,
    hotkey: str,
    nonce: str,
    issued_at: int,
) -> str:
    return f"ditto-cla:v1:{netuid}:{cla_version}:{cla_sha256}:{hotkey}:{nonce}:{issued_at}"


def load_miner_keypair(wallet_name: str, hotkey_name: str):
    """Loads miner hotkey keypair using bittensor_wallet or test keypair."""
    if Wallet is not None:
        wallet = Wallet(name=wallet_name, hotkey=hotkey_name)
        return wallet.hotkey
    raise RuntimeError("bittensor_wallet package is required to sign with a wallet.")


@click.group(name="cla")
def cla_cli():
    """Contributor License Agreement commands."""
    pass


@cla_cli.command(name="sign")
@click.option("--wallet-name", default="default", help="Name of miner wallet.")
@click.option("--hotkey-name", default="default", help="Name of miner hotkey.")
@click.option("--platform-url", envvar="DITTO_PLATFORM_URL", default="http://localhost:8000", help="Platform API base URL.")
@click.option("--netuid", default=118, type=int, help="Network UID.")
@click.option("--yes", "-y", is_flag=True, help="Bypass interactive confirmation.")
def sign_cmd(wallet_name: str, hotkey_name: str, platform_url: str, netuid: int, yes: bool):
    """View and sign the currently effective CLA using your miner hotkey."""
    api_url = platform_url.rstrip("/")
    try:
        resp = httpx.get(f"{api_url}/api/v1/cla/current", timeout=10.0)
        resp.raise_for_status()
        cla_data = resp.json()
    except Exception as exc:
        click.echo(f"Error fetching active CLA from platform: {exc}", err=True)
        sys.exit(1)

    cla_version = cla_data["version"]
    expected_sha256 = cla_data["sha256"].lower()
    cla_text = cla_data["text"]

    # Recompute SHA-256 and refuse on mismatch
    computed_sha256 = hashlib.sha256(cla_text.encode("utf-8")).hexdigest().lower()
    if computed_sha256 != expected_sha256:
        click.echo(
            f"ERROR: SHA-256 digest mismatch!\n"
            f"  Platform reported: {expected_sha256}\n"
            f"  Downloaded text:   {computed_sha256}\n"
            "Refusing to sign.",
            err=True,
        )
        sys.exit(1)

    click.echo("=" * 60)
    click.echo(f"Ditto Contributor License Agreement ({cla_version})")
    click.echo(f"Digest (SHA-256): {computed_sha256}")
    click.echo("=" * 60)
    click.echo(cla_text)
    click.echo("=" * 60)

    if not yes:
        confirmation = click.prompt("Type 'I AGREE' to confirm and sign with your hotkey", type=str)
        if confirmation.strip() != "I AGREE":
            click.echo("Confirmation aborted. CLA was not signed.")
            sys.exit(1)

    try:
        keypair = load_miner_keypair(wallet_name, hotkey_name)
    except Exception as exc:
        click.echo(f"Failed to load hotkey keypair: {exc}", err=True)
        sys.exit(1)

    hotkey_ss58 = keypair.ss58_address
    nonce = uuid.uuid4().hex
    issued_at = int(time.time())

    msg = build_cla_message(
        netuid=netuid,
        cla_version=cla_version,
        cla_sha256=computed_sha256,
        hotkey=hotkey_ss58,
        nonce=nonce,
        issued_at=issued_at,
    )

    sig_bytes = keypair.sign(msg.encode("utf-8"))
    signature = f"0x{sig_bytes.hex()}"

    payload = {
        "netuid": netuid,
        "hotkey": hotkey_ss58,
        "cla_version": cla_version,
        "cla_sha256": computed_sha256,
        "nonce": nonce,
        "issued_at": issued_at,
        "signature": signature,
    }

    try:
        submit_resp = httpx.post(f"{api_url}/api/v1/cla/sign", json=payload, timeout=15.0)
        submit_resp.raise_for_status()
        res = submit_resp.json()
        click.echo(f"Successfully signed CLA {cla_version} for hotkey {hotkey_ss58} at {res['signed_at']}.")
    except httpx.HTTPStatusError as exc:
        click.echo(f"Platform rejected signature: {exc.response.text}", err=True)
        sys.exit(1)
    except Exception as exc:
        click.echo(f"Error submitting signature: {exc}", err=True)
        sys.exit(1)


@cla_cli.command(name="status")
@click.option("--wallet-name", default="default", help="Name of miner wallet.")
@click.option("--hotkey-name", default="default", help="Name of miner hotkey.")
@click.option("--hotkey", default=None, help="Direct ss58 hotkey address.")
@click.option("--platform-url", envvar="DITTO_PLATFORM_URL", default="http://localhost:8000", help="Platform API base URL.")
def status_cmd(wallet_name: str, hotkey_name: str, hotkey: str | None, platform_url: str):
    """Check the CLA signing status for a hotkey."""
    api_url = platform_url.rstrip("/")
    hotkey_ss58 = hotkey
    if not hotkey_ss58:
        try:
            keypair = load_miner_keypair(wallet_name, hotkey_name)
            hotkey_ss58 = keypair.ss58_address
        except Exception as exc:
            click.echo(f"Could not resolve hotkey: {exc}", err=True)
            sys.exit(1)

    try:
        resp = httpx.get(f"{api_url}/api/v1/cla/status/{hotkey_ss58}", timeout=10.0)
        resp.raise_for_status()
        status_data = resp.json()
    except Exception as exc:
        click.echo(f"Failed to query CLA status: {exc}", err=True)
        sys.exit(1)

    click.echo(f"Hotkey:          {status_data['hotkey']}")
    click.echo(f"Current Version: {status_data.get('current_version') or 'None'}")
    click.echo(f"Signed Version:  {status_data.get('signed_version') or 'None'}")
    click.echo(f"Is Current:      {'YES' if status_data.get('is_current') else 'NO'}")
    click.echo(f"Signed At:       {status_data.get('signed_at') or 'N/A'}")
    click.echo(f"Digest:          {status_data.get('cla_sha256') or 'N/A'}")
    click.echo(f"Signature:       {status_data.get('signature') or 'N/A'}")
