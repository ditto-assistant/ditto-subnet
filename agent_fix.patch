### 5. API Endpoints

#### `apps/platform/ditto/api_server/endpoints/cla.py`
```python
"""FastAPI endpoints for CLA registry, status, signing, and gate management."""

from __future__ import annotations

from datetime import datetime
from typing import Any

from fastapi import APIRouter, Depends, HTTPException, status
from pydantic import BaseModel, Field
from sqlalchemy.orm import Session

from ditto.api_server.cla import (
    get_current_cla_version,
    get_current_gate_mode,
    get_latest_hotkey_signature,
    verify_and_store_signature,
)
from ditto.api_server.deps import get_db
from ditto.db.models.cla import CLAVersion

router = APIRouter(prefix="/api/v1/cla", tags=["cla"])


class CLAVersionResponse(BaseModel):
    version: str
    sha256: str
    text: str
    published_at: datetime
    effective_at: datetime


class CLASignRequest(BaseModel):
    netuid: int = Field(default=118)
    cla_version: str
    cla_sha256: str
    hotkey: str
    nonce: str
    issued_at: int
    signature: str


class CLASignResponse(BaseModel):
    status: str
    hotkey: str
    cla_version: str
    signed_at: datetime
    signature: str


class CLAStatusResponse(BaseModel):
    hotkey: str
    signed: bool
    is_current: bool
    cla_version: str | None = None
    cla_sha256: str | None = None
    signed_at: datetime | None = None
    signature: str | None = None
    effective_version: str | None = None
    effective_sha256: str | None = None
    gate_mode: str = "off"


@router.get("/current", response_model=CLAVersionResponse)
def get_effective_cla(db: Session = Depends(get_db)) -> Any:
    current = get_current_cla_version(db)
    if not current:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail="No effective CLA version found.",
        )
    return CLAVersionResponse(
        version=current.version,
        sha256=current.sha256,
        text=current.text,
        published_at=current.published_at,
        effective_at=current.effective_at,
    )


@router.post("/sign", response_model=CLASignResponse, status_code=status.HTTP_201_CREATED)
def sign_cla(request: CLASignRequest, db: Session = Depends(get_db)) -> Any:
    sig = verify_and_store_signature(
        db,
        netuid=request.netuid,
        cla_version=request.cla_version,
        cla_sha256=request.cla_sha256,
        hotkey=request.hotkey,
        nonce=request.nonce,
        issued_at=request.issued_at,
        signature=request.signature,
    )
    return CLASignResponse(
        status="signed",
        hotkey=sig.hotkey,
        cla_version=sig.cla_version,
        signed_at=sig.signed_at,
        signature=sig.signature,
    )


@router.get("/status/{hotkey}", response_model=CLAStatusResponse)
def get_cla_status(hotkey: str, db: Session = Depends(get_db)) -> Any:
    current = get_current_cla_version(db)
    gate_mode = get_current_gate_mode(db)

    if not current:
        return CLAStatusResponse(
            hotkey=hotkey,
            signed=False,
            is_current=True,
            gate_mode=gate_mode,
        )

    sig = get_latest_hotkey_signature(db, hotkey=hotkey, version=current.version)
    is_current = sig is not None and sig.cla_sha256.lower() == current.sha256.lower()

    if sig:
        return CLAStatusResponse(
            hotkey=hotkey,
            signed=True,
            is_current=is_current,
            cla_version=sig.cla_version,
            cla_sha256=sig.cla_sha256,
            signed_at=sig.signed_at,
            signature=sig.signature,
            effective_version=current.version,
            effective_sha256=current.sha256,
            gate_mode=gate_mode,
        )

    return CLAStatusResponse(
        hotkey=hotkey,
        signed=False,
        is_current=False,
        effective_version=current.version,
        effective_sha256=current.sha256,
        gate_mode=gate_mode,
    )
```

