def test_upload_gate_modes(db_session: Session, miner_keypair: Keypair) -> None:
    hotkey = miner_keypair.ss58_address

    # 1. Gate Mode: OFF -> unsigned upload succeeds
    set_gate_mode(db_session, "off")
    check_cla_gate(hotkey, "/upload/check", db_session)

    # 2. Gate Mode: SHADOW -> unsigned upload succeeds, logs shadow event
    set_gate_mode(db_session, "shadow")
    check_cla_gate(hotkey, "/upload/check", db_session)
    shadow_log = db_session.scalars(select(CLAShadowLog).where(CLAShadowLog.hotkey == hotkey)).first()
    assert shadow_log is not None
    assert shadow_log.endpoint == "/upload/check"

    # 3. Gate Mode: ENFORCE -> unsigned upload raises 403
    set_gate_mode(db_session, "enforce")
    with pytest.raises(HTTPException) as exc:
        check_cla_gate(hotkey, "/upload/check", db_session)
    assert exc.value.status_code == 403
    assert "ditto cla sign" in exc.value.detail

    # Sign CLA
    nonce = secrets.token_hex(16)
    issued_at = int(time.time())
    msg = build_cla_signature_message(118, "v1", FIXTURE_CLA_DIGEST, hotkey, nonce, issued_at)
    signature = f"0x{miner_keypair.sign(msg.encode('utf-8')).hex()}"
    verify_and_store_signature(
        db_session,
        netuid=118,
        cla_version="v1",
        cla_sha256=FIXTURE_CLA_DIGEST,
        hotkey=hotkey,
        nonce=nonce,
        issued_at=issued_at,
        signature=signature,
    )

    # In ENFORCE mode, signed hotkey succeeds
    check_cla_gate(hotkey, "/upload/check", db_session)

    # 4. Outdated version check: bump CLA to v2
    v2_text = FIXTURE_CLA_TEXT + "\nVersion 2 updates."
    v2_digest = hashlib.sha256(v2_text.encode("utf-8")).hexdigest()
    v2 = CLAVersion(
        version="v2",
        sha256=v2_digest,
        text=v2_text,
        published_at=datetime.now(timezone.utc),
        effective_at=datetime.now(timezone.utc),
    )
    db_session.add(v2)
    db_session.commit()

    # Now hotkey is outdated -> should raise 403 until re-signed
    with pytest.raises(HTTPException) as exc:
        check_cla_gate(hotkey, "/upload/check", db_session)
    assert exc.value.status_code == 403
    assert "(v2)" in exc.value.detail


