from ditto.api_server.cla import sign_cla, get_cla_status, CLASignRequest
from ditto.api_server.endpoints.upload import verify_cla_submission_gate
from ditto.backroom.tools import read_cla_gate_status


@pytest.fixture
def db_session():
    engine = create_engine("sqlite:///:memory:")
    Base.metadata.create_all(engine)
    Session = sessionmaker(bind=engine)
    session = Session()

    # Seed CLA v1
    sample_text = "# Test CLA Text\nAll rights granted under MIT."
    cla_v1 = CLAVersion(
        version="v1",
        sha256=hashlib.sha256(sample_text.encode("utf-8")).hexdigest(),
        text=sample_text,
        published_at=datetime.now(timezone.utc),
        effective_at=datetime.now(timezone.utc),
    )
    session.add(cla_v1)
    session.commit()
    yield session
    session.close()


def test_append_only_guarantee(db_session):
    """Prove there is no update or delete path for cla_signatures."""
    sig = CLASignature(
        hotkey="5GrwvaEF5zXb26Fz9rcQpDWS57CtERHpNehXCPcNoHGKutQY",
        coldkey="5GrwvaEF5zXb26Fz9rcQpDWS57CtERHpNehXCPcNoHGKutQY",
        cla_version="v1",
        cla_sha256="abc",
        signature="0x123",
        nonce="nonce-1",
        issued_at=int(time.time()),
    )
    db_session.add(sig)
    db_session.commit()

    with pytest.raises(PermissionError):
        sig.signature = "0x999"
        db_session.commit()

    db_session.rollback()

    with pytest.raises(PermissionError):
        db_session.delete(sig)
        db_session.commit()


def test_signing_valid_and_status(db_session):
    keypair = Keypair.create_from_uri("//Alice")
    hotkey = keypair.ss58_address
    cla_ver = db_session.query(CLAVersion).first()

    nonce = "nonce-100"
    issued_at = int(time.time())
    msg = build_cla_message(118, cla_ver.version, cla_ver.sha256, hotkey, nonce, issued_at)
    signature = f"0x{keypair.sign(msg.encode('utf-8')).hex()}"

    req = CLASignRequest(
        hotkey=hotkey,
        cla_version=cla_ver.version,
        cla_sha256=cla_ver.sha256,
        signature=signature,
        nonce=nonce,
        issued_at=issued_at,
        netuid=118,
    )
    res = sign_cla(req, db=db_session)
    assert res.status == "success"

    status_res = get_cla_status(hotkey, db=db_session)
    assert status_res.signed is True
    assert status_res.is_current is True
    assert status_res.version == "v1"


def test_replayed_nonce_rejected(db_session):
    keypair = Keypair.create_from_uri("//Alice")
