"""Database models for Contributor License Agreement (CLA) registry and signatures."""

from __future__ import annotations

import datetime
from sqlalchemy import (
    Column,
    DateTime,
    ForeignKey,
    Index,
    Integer,
    String,
    event,
)
from sqlalchemy.orm import declarative_base, relationship

Base = declarative_base()


class CLAVersion(Base):
    """Registry of published CLA versions."""

    __tablename__ = "cla_versions"

    version = Column(String(32), primary_key=True)
    sha256 = Column(String(64), nullable=False)
    published_at = Column(
        DateTime(timezone=True),
        nullable=False,
        default=lambda: datetime.datetime.now(datetime.timezone.utc),
    )
    effective_at = Column(
        DateTime(timezone=True),
        nullable=False,
        default=lambda: datetime.datetime.now(datetime.timezone.utc),
    )

    signatures = relationship("CLASignature", back_populates="cla_version_rel")


class CLASignature(Base):
    """Append-only store of cryptographic signatures of the CLA."""

    __tablename__ = "cla_signatures"

    id = Column(Integer, primary_key=True, autoincrement=True)
    hotkey = Column(String(64), nullable=False, index=True)
    coldkey = Column(String(64), nullable=False, index=True)
    cla_version = Column(
        String(32),
        ForeignKey("cla_versions.version"),
        nullable=False,
        index=True,
    )
    cla_sha256 = Column(String(64), nullable=False)
    signature = Column(String(256), nullable=False)
    nonce = Column(String(64), nullable=False, unique=True, index=True)
    issued_at = Column(DateTime(timezone=True), nullable=False)
    signed_at = Column(
        DateTime(timezone=True),
        nullable=False,
        default=lambda: datetime.datetime.now(datetime.timezone.utc),
    )

    cla_version_rel = relationship("CLAVersion", back_populates="signatures")

    __table_args__ = (
        Index("ix_cla_signatures_hotkey_version", "hotkey", "cla_version"),
    )


class CLAGateSetting(Base):
    """Platform gate mode settings and history: 'off', 'shadow', or 'enforce'."""

    __tablename__ = "cla_gate_settings"

    id = Column(Integer, primary_key=True, autoincrement=True)
    mode = Column(String(16), nullable=False, default="off")  # off | shadow | enforce
    changed_at = Column(
        DateTime(timezone=True),
        nullable=False,
        default=lambda: datetime.datetime.now(datetime.timezone.utc),
    )
    changed_by = Column(String(64), nullable=True)


# --- Strict ORM-level append-only enforcement for CLASignature ---
@event.listens_for(CLASignature, "before_update")
def receive_cla_signature_before_update(mapper, connection, target):
    raise PermissionError("CLASignature table is append-only: updates are strictly forbidden.")


@event.listens_for(CLASignature, "before_delete")
def receive_cla_signature_before_delete(mapper, connection, target):
    raise PermissionError("CLASignature table is append-only: deletes are strictly forbidden.")
