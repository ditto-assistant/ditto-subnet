+"""Backroom MCP tool for inspecting CLA gate configuration and adoption."""
+from __future__ import annotations
+
+from typing import Any, Dict, List
+from sqlalchemy import select, func, distinct
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from ditto.api_server.models import (
+    CLAVersion,
+    CLASignature,
+    CLAGateSettingsHistory,
+)
+
+
+async def get_cla_gate_status(session: AsyncSession, active_hotkeys: List[str] | None = None) -> Dict[str, Any]:
+    """
+    Inspect the CLA gate configuration, audit history, and miner adoption counts.
+
+    active_hotkeys: Optional list of currently active subnet hotkeys to measure adoption against.
+    """
+    # Fetch latest gate mode
+    mode_stmt = select(CLAGateSettingsHistory).order_by(CLAGateSettingsHistory.changed_at.desc()).limit(1)
+    mode_res = await session.execute(mode_stmt)
+    latest_setting = mode_res.scalar_one_or_none()
+    current_mode = latest_setting.mode if latest_setting else "off"
+
+    # Fetch gate mode history
+    hist_stmt = select(CLAGateSettingsHistory).order_by(CLAGateSettingsHistory.changed_at.desc()).limit(50)
+    hist_res = await session.execute(hist_stmt)
+    history_rows = hist_res.scalars().all()
+    history = [
+        {
+            "mode": h.mode,
+            "changed_by": h.changed_by,
+            "reason": h.reason,
+            "changed_at": h.changed_at.isoformat() if h.changed_at else None,
+        }
+        for h in history_rows
+    ]
+
+    # Fetch current effective CLA version
+    cla_stmt = select(CLAVersion).order_by(CLAVersion.effective_at.desc()).limit(1)
+    cla_res = await session.execute(cla_stmt)
+    current_cla = cla_res.scalar_one_or_none()
+    current_cla_version = current_cla.version if current_cla else None
+
+    # Calculate adoption
+    total_signed_stmt = select(func.count(distinct(CLASignature.hotkey)))
+    if current_cla_version:
+        total_signed_stmt = total_signed_stmt.where(CLASignature.cla_version == current_cla_version)
+    total_signed_res = await session.execute(total_signed_stmt)
+    total_signed_hotkeys = total_signed_res.scalar() or 0
+
+    adoption_stats: Dict[str, Any] = {
+        "current_cla_version": current_cla_version,
+        "total_signers_for_current_cla": total_signed_hotkeys,
+    }
+
+    if active_hotkeys is not None:
+        active_set = set(active_hotkeys)
+        if active_set and current_cla_version:
+            signed_active_stmt = (
+                select(CLASignature.hotkey)
+                .where(CLASignature.cla_version == current_cla_version)
+                .where(CLASignature.hotkey.in_(active_set))
+            )
+            signed_res = await session.execute(signed_active_stmt)
+            signed_active_set = set(signed_res.scalars().all())
+        else:
+            signed_active_set = set()
+
+        unsigned_active_set = active_set - signed_active_set
+        total_active = len(active_set)
+        signed_count = len(signed_active_set)
+        unsigned_count = len(unsigned_active_set)
+        adoption_ratio = (signed_count / total_active) if total_active > 0 else 0.0
+
+        adoption_stats.update(
+            {
+                "total_active_hotkeys": total_active,
+                "signed_active_hotkeys": signed_count,
+                "unsigned_active_hotkeys": unsigned_count,
+                "adoption_percentage": round(adoption_ratio * 100, 2),
+                "signed_hotkeys": sorted(list(signed_active_set)),
+                "unsigned_hotkeys": sorted(list(unsigned_active_set)),
+            }
+        )
+
+    return {
+        "gate_mode": current_mode,
+        "effective_cla": current_cla_version,
+        "adoption": adoption_stats,
+        "history": history,
+    }
