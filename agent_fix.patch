    """
    Downloads current CLA text, validates SHA-256 digest, requests typed confirmation,
    signs with hotkey sr25519, and submits to Platform.
    """
    client = httpx.Client(base_url=api_url, timeout=15.0)

    try:
        resp = client.get("/api/v1/cla/current")
        resp.raise_for_status()
        cla_info = resp.json()
    except Exception as e:
        print(f"Error fetching current CLA from platform: {e}", file=sys.stderr)
        sys.exit(1)

    cla_version = cla_info["version"]
    expected_sha256 = cla_info["sha256"].lower()
    cla_text = cla_info["text"]

    # Recompute and verify digest
    computed_sha256 = hashlib.sha256(cla_text.encode("utf-8")).hexdigest().lower()
    if computed_sha256 != expected_sha256:
        print(
            f"ERROR: SHA-256 digest mismatch! Expected {expected_sha256}, got {computed_sha256}. "
            "Refusing to sign.",
            file=sys.stderr,
        )
        sys.exit(1)

    print("=" * 60)
    print(f"Ditto Contributor License Agreement (CLA) - {cla_version}")
    print(f"SHA-256 Digest: {computed_sha256}")
    print(f"Published At:   {cla_info['published_at']}")
    print("=" * 60)
    print("\n--- Summary of CLA Text ---")
    preview = cla_text[:500] + ("\n..." if len(cla_text) > 500 else "")
    print(preview)
    print("=" * 60)

    if not non_interactive:
        confirmation = input(
            "Type 'I AGREE' to confirm and sign this agreement with your hotkey: "
        ).strip()
        if confirmation != "I AGREE":
            print("Aborted: Confirmation not given. CLA not signed.", file=sys.stderr)
            sys.exit(1)

    hotkey_address = wallet.hotkey.ss58_address
    nonce = uuid.uuid4().hex
    issued_at = int(time.time())

    msg = build_cla_message(
        netuid=netuid,
        cla_version=cla_version,
        cla_sha256=computed_sha256,
        hotkey=hotkey_address,
        nonce=nonce,
        issued_at=issued_at,
    )

    signature_bytes = wallet.hotkey.sign(msg)
    sig_hex = "0x" + signature_bytes.hex() if isinstance(signature_bytes, bytes) else str(signature_bytes)

    payload = {
        "hotkey": hotkey_address,
        "cla_version": cla_version,
        "cla_sha256": computed_sha256,
        "nonce": nonce,
        "issued_at": issued_at,
        "signature": sig_hex,
        "netuid": netuid,
    }

    try:
        sign_resp = client.post("/api/v1/cla/sign", json=payload)
        sign_resp.raise_for_status()
        result = sign_resp.json()
        print("\n CLA successfully signed and registered with Platform.")
        print(f"Hotkey:     {result['hotkey']}")
        print(f"Coldkey:    {result['coldkey']}")
        print(f"Version:    {result['cla_version']}")
        print(f"Signed At:  {result['signed_at']}")
    except Exception as e:
        print(f"Error submitting signed CLA to platform: {e}", file=sys.stderr)
        sys.exit(1)


def status_cla_command(
    wallet=None,
    hotkey_address: Optional[str] = None,
    api_url: str = DEFAULT_API_URL,
) -> None:
    """Shows CLA status for the specified hotkey."""
    target_hotkey = hotkey_address or (wallet.hotkey.ss58_address if wallet else None)
    if not target_hotkey:
        print("Error: No hotkey specified.", file=sys.stderr)
        sys.exit(1)

    client = httpx.Client(base_url=api_url, timeout=10.0)
    try:
        resp = client.get(f"/api/v1/cla/status/{target_hotkey}")
        resp.raise_for_status()
        data = resp.json()

        print("=" * 50)
        print("Ditto CLA Status")
        print("=" * 50)
        print(f"Hotkey:     {data['hotkey']}")
        print(f"Signed:     {'Yes' if data['signed'] else 'No'}")
        print(f"Current:    {'Yes' if data['is_current'] else 'No'}")
        if data["signed"]:
            print(f"Version:    {data['version']}")
            print(f"Digest:     {data['digest']}")
            print(f"Signed At:  {data['signed_at']}")
        else:
            print("Action:     Run `uv run ditto cla sign` to sign the current CLA.")
        print("=" * 50)
    except Exception as e:
        print(f"Error fetching CLA status: {e}", file=sys.stderr)
        sys.exit(1)
