"""CLI commands for CLA signing and status inspection."""

from __future__ import annotations

import hashlib
import time
import uuid
import requests
import typer

from ditto.miner_cli.attestation import build_cla_message  # or shared builder

app = typer.Typer(help="Manage and execute Contributor License Agreement (CLA) signatures.")


@app.command("sign")
def sign_cla_command(
    platform_url: str = typer.Option("http://localhost:8000", help="Platform API base URL"),
    netuid: int = typer.Option(118, help="Subnet NetUID"),
    wallet_name: str = typer.Option("default", help="Bittensor wallet name"),
    hotkey_name: str = typer.Option("default", help="Bittensor hotkey name"),
    yes: bool = typer.Option(False, "--yes", "-y", help="Skip confirmation prompt"),
) -> None:
    """Download, review, and sign the currently effective CLA using hotkey."""
    import bittensor as bt

    # 1. Fetch current CLA from platform
    resp = requests.get(f"{platform_url.rstrip('/')}/api/v1/cla/current", timeout=10)
    if resp.status_code != 200:
        typer.secho(f"Failed to fetch current CLA from platform: {resp.text}", fg=typer.colors.RED)
        raise typer.Exit(code=1)

    cla_data = resp.json()
    version = cla_data["version"]
    expected_sha256 = cla_data["sha256"]
    cla_text = cla_data["text"]

    # 2. Recompute and verify digest
    computed_sha256 = hashlib.sha256(cla_text.encode("utf-8")).hexdigest()
    if computed_sha256.lower() != expected_sha256.lower():
        typer.secho(
            f"Digest mismatch! Expected {expected_sha256}, got {computed_sha256}. Refusing to sign.",
            fg=typer.colors.RED,
            bold=True,
        )
        raise typer.Exit(code=1)

    # 3. Present CLA and require confirmation
    typer.echo("\n" + "=" * 60)
    typer.echo(f"Ditto Contributor License Agreement ({version})")
    typer.echo(f"SHA-256 Digest: {computed_sha256}")
    typer.echo("=" * 60 + "\n")
    typer.echo(cla_text[:500] + ("\n..." if len(cla_text) > 500 else ""))
    typer.echo("\n" + "=" * 60)

    if not yes:
        confirmation = typer.prompt("Type 'I AGREE' to confirm and execute the CLA signature")
        if confirmation.strip() != "I AGREE":
            typer.secho("Signature cancelled by user.", fg=typer.colors.YELLOW)
            raise typer.Exit(code=0)

    # 4. Sign payload
    wallet = bt.wallet(name=wallet_name, hotkey=hotkey_name)
    hotkey_ss58 = wallet.hotkey.ss58_address
    nonce = uuid.uuid4().hex
    issued_at = int(time.time())

    msg = build_cla_message(
        netuid=netuid,
        cla_version=version,
        cla_sha256=computed_sha256,
        hotkey=hotkey_ss58,
        nonce=nonce,
        issued_at=issued_at,
    )
    signature_bytes = wallet.hotkey.sign(msg.encode("utf-8"))
    signature = f"0x{signature_bytes.hex()}"

    # 5. Transmit to platform
    submit_resp = requests.post(
        f"{platform_url.rstrip('/')}/api/v1/cla/sign",
        json={
            "netuid": netuid,
            "hotkey": hotkey_ss58,
            "cla_version": version,
            "cla_sha256": computed_sha256,
            "signature": signature,
            "nonce": nonce,
            "issued_at": issued_at,
        },
        timeout=10,
    )

    if submit_resp.status_code != 200:
        typer.secho(f"Failed to record signature on platform: {submit_resp.text}", fg=typer.colors.RED)
        raise typer.Exit(code=1)

    typer.secho(f"Successfully signed CLA {version} for hotkey {hotkey_ss58}!", fg=typer.colors.GREEN, bold=True)


@app.command("status")
def status_cla_command(
    platform_url: str = typer.Option("http://localhost:8000", help="Platform API base URL"),
    wallet_name: str = typer.Option("default", help="Bittensor wallet name"),
    hotkey_name: str = typer.Option("default", help="Bittensor hotkey name"),
    hotkey: str = typer.Option(None, help="Explicit SS58 hotkey to inspect"),
) -> None:
    """Inspect CLA signature status for a hotkey."""
    if not hotkey:
        import bittensor as bt
        wallet = bt.wallet(name=wallet_name, hotkey=hotkey_name)
        hotkey = wallet.hotkey.ss58_address

    resp = requests.get(f"{platform_url.rstrip('/')}/api/v1/cla/status/{hotkey}", timeout=10)
    if resp.status_code != 200:
        typer.secho(f"Failed to fetch status: {resp.text}", fg=typer.colors.RED)
        raise typer.Exit(code=1)

    data = resp.json()
    typer.echo(f"Hotkey:        {data['hotkey']}")
    typer.echo(f"Signed:        {'Yes' if data['signed'] else 'No'}")
    typer.echo(f"Version:       {data.get('version') or 'None'}")
    typer.echo(f"Current:       {'Yes' if data.get('is_current') else 'No'}")
    typer.echo(f"Signed At:     {data.get('signed_at') or 'N/A'}")
    typer.echo(f"Digest:        {data.get('digest') or 'N/A'}")
    typer.echo(f"Signature:     {data.get('signature') or 'N/A'}")
