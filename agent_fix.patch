### 8. Backroom MCP Read Tool: `apps/platform/ditto/backroom/tools/cla.py`

```python
"""Backroom MCP tool for inspecting CLA gate mode, history, and miner adoption metrics."""

from datetime import datetime, timezone
from typing import Any
from sqlalchemy.orm import Session
from sqlalchemy import func

from apps.platform.ditto.db.cla_models import (
    ClaGateSetting,
    ClaVersion,
    ClaSignature,
    ClaShadowUploadLog,
)


def get_cla_gate_status(db: Session, active_hotkeys: list[str] | None = None) -> dict[str, Any]:
    """
    Backroom MCP read tool reporting:
    - Current platform CLA gate setting ('off', 'shadow', 'enforce')
    - Setting history
    - Current CLA version and digest
    - Active hotkey adoption counts and percentage
    - Shadow mode unsigned upload count
    """
    now = datetime.now(timezone.utc)

    # 1. Gate mode and history
    history_records = (
        db.query(ClaGateSetting)
        .order_by(ClaGateSetting.id.desc())
        .all()
    )
    current_mode = history_records[0].mode if history_records else "off"

    history_list = [
        {
            "id": h.id,
            "mode": h.mode,
            "changed_at": h.changed_at.isoformat(),
            "changed_by": h.changed_by,
            "reason": h.reason,
        }
        for h in history_records
    ]

    # 2. Currently effective CLA version
    current_cla = (
        db.query(ClaVersion)
        .filter(ClaVersion.effective_at <= now)
        .order_by(ClaVersion.effective_at.desc())
        .first()
    )
    current_version = current_cla.version if current_cla else None
    current_sha256 = current_cla.sha256 if current_cla else None

    # 3. Signed hotkeys count for current CLA
    signed_hotkeys_query = db.query(ClaSignature.hotkey).distinct()
    if current_version and current_sha256:
        signed_hotkeys_query = signed_hotkeys_query.filter(
            ClaSignature.cla_version == current_version,
            ClaSignature.cla_sha256 == current_sha256,
        )
    signed_hotkeys_set = {row[0] for row in signed_hotkeys_query.all()}

    # 4. Adoption metrics across active hotkeys
    if active_hotkeys is not None:
        total_active = len(active_hotkeys)
        signed_active = len(set(active_hotkeys) & signed_hotkeys_set)
        unsigned_active = total_active - signed_active
    else:
        # Default to all registered hotkeys seen in platform if active list not supplied
        all_known_hotkeys = {row[0] for row in db.query(ClaSignature.hotkey).distinct().all()}
        total_active = len(all_known_hotkeys)
        signed_active = len(signed_hotkeys_set)
        unsigned_active = total_active - signed_active

    adoption_pct = (signed_active / total_active * 100.0) if total_active > 0 else 0.0

    # 5. Shadow upload count
    shadow_upload_count = db.query(func.count(ClaShadowUploadLog.id)).scalar() or 0

    return {
        "current_gate_mode": current_mode,
        "history": history_list,
        "current_cla_version": current_version,
        "current_cla_sha256": current_sha256,
        "total_active_hotkeys": total_active,
        "signed_active_hotkeys": signed_active,
        "unsigned_active_hotkeys": unsigned_active,
        "adoption_percentage": round(adoption_pct, 2),
        "shadow_mode_unsigned_uploads_count": shadow_upload_count,
    }


def set_cla_gate_mode(
    db: Session,
    mode: str,
    changed_by: str = "operator",
    reason: str | None = None,
) -> dict[str, Any]:
    """Operator MCP tool to transition the gate mode ('off', 'shadow', 'enforce')."""
    valid_modes = {"off", "shadow", "enforce"}
    normalized_mode = mode.lower().strip()
    if normalized_mode not in valid_modes:
        raise ValueError(f"Invalid mode: {mode}. Must be one of {valid_modes}")

    new_setting = ClaGateSetting(
        mode=normalized_mode,
        changed_at=datetime.now(timezone.utc),
        changed_by=changed_by,
        reason=reason,
    )
    db.add(new_setting)
    db.commit()
    db.refresh(new_setting)

    return {
        "id": new_setting.id,
        "mode": new_setting.mode,
        "changed_at": new_setting.changed_at.isoformat(),
        "changed_by": new_setting.changed_by,
        "reason": new_setting.reason,
    }
