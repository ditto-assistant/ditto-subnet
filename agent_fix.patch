### 7. Backroom MCP Adoption & Setting Tool

`apps/platform/ditto/api_server/backroom/cla_tools.py`:
```python
from typing import Any, Dict
from sqlalchemy.orm import Session
from sqlalchemy import distinct

from apps.platform.ditto.api_server.cla_service import (
    get_current_effective_cla,
    get_current_gate_mode,
)
from apps.platform.ditto.api_server.models.cla import ClaGateHistory, ClaSignature


def get_cla_gate_status_report(db: Session, active_hotkeys: list[str] | None = None) -> Dict[str, Any]:
    """
    Backroom MCP tool for operators:
    Reads current gate setting, change history, and adoption counts among active hotkeys.
    """
    mode = get_current_gate_mode(db)
    effective_cla = get_current_effective_cla(db)
    
    history_records = (
        db.query(ClaGateHistory)
        .order_by(ClaGateHistory.changed_at.desc(), ClaGateHistory.id.desc())
        .limit(20)
        .all()
    )
    
    # If explicit active hotkeys list is not supplied, use known distinct signers or active miners
    if active_hotkeys is None:
        raw_hotkeys = db.query(distinct(ClaSignature.hotkey)).all()
        active_hotkeys = [h[0] for h in raw_hotkeys]

    signed_active = 0
    unsigned_active = 0

    if effective_cla:
        for hotkey in active_hotkeys:
            has_signed = (
                db.query(ClaSignature)
                .filter(
                    ClaSignature.hotkey == hotkey,
                    ClaSignature.cla_version == effective_cla.version,
                    ClaSignature.cla_sha256 == effective_cla.sha256,
                )
                .first()
                is not None
            )
            if has_signed:
                signed_active += 1
            else:
                unsigned_active += 1
    else:
        unsigned_active = len(active_hotkeys)

    total_active = len(active_hotkeys)
    adoption_pct = (signed_active / total_active * 100.0) if total_active > 0 else 0.0

    return {
        "gate_mode": mode,
        "effective_cla": {
            "version": effective_cla.version if effective_cla else None,
            "sha256": effective_cla.sha256 if effective_cla else None,
            "effective_at": effective_cla.effective_at.isoformat() if effective_cla else None,
        },
        "adoption": {
            "total_active_hotkeys": total_active,
            "signed_hotkeys": signed_active,
            "unsigned_hotkeys": unsigned_active,
            "adoption_percent": round(adoption_pct, 2),
        },
        "history": [
            {
                "id": h.id,
                "mode": h.mode,
                "changed_by": h.changed_by,
                "reason": h.reason,
                "changed_at": h.changed_at.isoformat(),
            }
            for h in history_records
        ],
    }
