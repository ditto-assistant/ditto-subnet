async def check_cla_gate(hotkey: str, db: AsyncSession | Session):
    gate_mode = await get_cla_gate_mode(db) # "off", "shadow", "enforce"
    if gate_mode == "off":
        return

    effective_cla = await get_effective_cla_version(db)
    if not effective_cla:
        return

    is_signed = await has_signed_cla(db, hotkey, effective_cla.version)
    if not is_signed:
        if gate_mode == "shadow":
            logger.warning(
                "CLA shadow gate: hotkey %s has not signed effective CLA version %s",
                hotkey,
                effective_cla.version,
            )
            await record_shadow_unsigned_upload(db, hotkey, effective_cla.version)
            return
        elif gate_mode == "enforce":
            raise HTTPException(
                status_code=403,
                detail=(
                    f"Contributor License Agreement (CLA) signature required for version {effective_cla.version}. "
                    "Please run 'ditto cla sign' before submitting."
                ),
            )
```
