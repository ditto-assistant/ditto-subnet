"""Backroom MCP tool for inspecting CLA gate mode, audit history, and miner adoption."""

from __future__ import annotations

from typing import Any

from sqlalchemy import distinct, func, select
from sqlalchemy.orm import Session

from ditto.api_server.cla import get_current_cla_version, get_current_gate_mode
from ditto.db.models.cla import CLAGateSetting, CLAShadowLog, CLASignature


def get_cla_gate_report(db: Session, active_hotkeys: list[str] | None = None) -> dict[str, Any]:
    """MCP tool implementation to read gate status, history, and adoption metrics."""
    effective_cla = get_current_cla_version(db)
    mode = get_current_gate_mode(db)

    # Fetch settings audit history
    history_entries = db.scalars(
        select(CLAGateSetting).order_by(CLAGateSetting.created_at.desc())
    ).all()
    history = [
        {
            "id": h.id,
            "mode": h.mode,
            "changed_by": h.changed_by,
            "reason": h.reason,
            "created_at": h.created_at.isoformat(),
        }
        for h in history_entries
    ]

    effective_ver = effective_cla.version if effective_cla else None

    # Distinct hotkeys signed for current effective version
    signed_hotkeys_query = select(func.count(distinct(CLASignature.hotkey)))
    if effective_ver:
        signed_hotkeys_query = signed_hotkeys_query.where(CLASignature.cla_version == effective_ver)
    signed_count = db.scalar(signed_hotkeys_query) or 0

    # Total shadow mode unsigned upload triggers
    shadow_events_count = db.scalar(select(func.count(CLAShadowLog.id))) or 0

    adoption: dict[str, Any] = {
        "effective_cla_version": effective_ver,
        "effective_cla_sha256": effective_cla.sha256 if effective_cla else None,
        "signed_hotkeys_count": signed_count,
        "shadow_unsigned_events_count": shadow_events_count,
    }

    if active_hotkeys is not None:
        active_set = set(active_hotkeys)
        signed_active_set = set(
            db.scalars(
                select(CLASignature.hotkey).where(
                    CLASignature.cla_version == effective_ver,
                    CLASignature.hotkey.in_(list(active_set)),
                )
            ).all()
        )
        adoption["total_active_hotkeys"] = len(active_set)
        adoption["active_signed_count"] = len(signed_active_set)
        adoption["active_unsigned_count"] = len(active_set - signed_active_set)
        adoption["active_adoption_pct"] = (
            round((len(signed_active_set) / len(active_set)) * 100, 2) if active_set else 100.0
        )

    return {
        "gate_mode": mode,
        "history": history,
        "adoption": adoption,
    }
```

