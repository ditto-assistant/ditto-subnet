# apps/platform/ditto/db/models/cla.py
"""Database models for CLA version registry, append-only signatures, and gate settings."""

from __future__ import annotations

from datetime import datetime, timezone

from sqlalchemy import (
    Column,
    DateTime,
    ForeignKey,
    Index,
    Integer,
    String,
    Text,
    event,
)
from sqlalchemy.orm import declarative_base, relationship

Base = declarative_base()


class AppendOnlyViolationError(RuntimeError):
    """Raised when an update or delete operation is attempted on an append-only table."""


class CLAVersion(Base):
    """Registry of Contributor License Agreement versions and their expected SHA-256 digests."""

    __tablename__ = "cla_versions"

    version = Column(String(32), primary_key=True)  # e.g., "v1"
    sha256 = Column(String(64), nullable=False)
    published_at = Column(
        DateTime(timezone=True),
        nullable=False,
        default=lambda: datetime.now(timezone.utc),
    )
    effective_at = Column(
        DateTime(timezone=True),
        nullable=False,
        default=lambda: datetime.now(timezone.utc),
    )
    text = Column(Text, nullable=True)

    signatures = relationship("CLASignature", back_populates="version_rel")


class CLASignature(Base):
    """Append-only table of miner hotkey CLA signatures.

    Rows are never updated or deleted.
    """

    __tablename__ = "cla_signatures"

    id = Column(Integer, primary_key=True, autoincrement=True)
    hotkey = Column(String(64), nullable=False, index=True)
    coldkey = Column(String(64), nullable=False, index=True)
    cla_version = Column(
        String(32), ForeignKey("cla_versions.version"), nullable=False, index=True
    )
    cla_sha256 = Column(String(64), nullable=False)
    signature = Column(String(256), nullable=False)
    nonce = Column(String(64), nullable=False, unique=True, index=True)
    issued_at = Column(Integer, nullable=False)
    signed_at = Column(
        DateTime(timezone=True),
        nullable=False,
        default=lambda: datetime.now(timezone.utc),
    )

    version_rel = relationship("CLAVersion", back_populates="signatures")

    __table_args__ = (
        Index("ix_cla_signatures_hotkey_version", "hotkey", "cla_version"),
    )


# Enforce append-only invariant at SQLAlchemy ORM layer
@event.listens_for(CLASignature, "before_update")
def _prevent_cla_signature_update(mapper, connection, target) -> None:
    raise AppendOnlyViolationError(
        "CLASignature rows are append-only and cannot be updated."
    )


@event.listens_for(CLASignature, "before_delete")
def _prevent_cla_signature_delete(mapper, connection, target) -> None:
    raise AppendOnlyViolationError(
        "CLASignature rows are append-only and cannot be deleted."
    )


class CLAGateSettingHistory(Base):
    """History of Platform CLA upload gate modes: 'off', 'shadow', 'enforce'."""

    __tablename__ = "cla_gate_settings_history"

    id = Column(Integer, primary_key=True, autoincrement=True)
    mode = Column(String(16), nullable=False, default="off")
    changed_at = Column(
        DateTime(timezone=True),
        nullable=False,
        default=lambda: datetime.now(timezone.utc),
    )
    changed_by = Column(String(64), nullable=False, default="system")
    notes = Column(Text, nullable=True)


class CLAShadowUploadLog(Base):
    """Log of unsigned upload attempts observed while CLA gate is in 'shadow' mode."""

    __tablename__ = "cla_shadow_upload_logs"

    id = Column(Integer, primary_key=True, autoincrement=True)
    hotkey = Column(String(64), nullable=False, index=True)
    endpoint = Column(String(64), nullable=False)
    recorded_at = Column(
        DateTime(timezone=True),
        nullable=False,
        default=lambda: datetime.now(timezone.utc),
    )
