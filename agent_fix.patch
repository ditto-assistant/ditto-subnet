"""API endpoints for CLA registration, status checks, and gate settings."""

from datetime import datetime, timezone
import time
from typing import Optional
from fastapi import APIRouter, Depends, HTTPException, Query, status
from pydantic import BaseModel, Field
from sqlalchemy.orm import Session

from apps.platform.ditto.api_server.database import get_db
from apps.platform.ditto.api_server.cla_service import (
    DEFAULT_NETUID,
    FRESHNESS_WINDOW_SECONDS,
    build_cla_signing_message,
    ensure_cla_v1_registered,
    get_current_gate_mode,
    get_effective_cla_version,
    resolve_coldkey,
    verify_cla_signature,
)
from apps.platform.ditto.api_server.models.cla import (
    CLAGateMode,
    CLAGateSetting,
    CLASignature,
    CLAVersion,
)

router = APIRouter(prefix="/api/v1/cla", tags=["CLA"])


class CLACurrentResponse(BaseModel):
    version: str
    sha256: str
    published_at: datetime
    effective_at: datetime
    text: str


class CLASignRequest(BaseModel):
    hotkey: str
    cla_version: str
    cla_sha256: str
    nonce: str
    issued_at: int
    signature: str
    netuid: int = Field(default=DEFAULT_NETUID)


class CLASignResponse(BaseModel):
    status: str
    hotkey: str
    coldkey: str
    cla_version: str
    cla_sha256: str
    signed_at: datetime


class CLAStatusResponse(BaseModel):
    hotkey: str
    signed: bool
    version: Optional[str] = None
    digest: Optional[str] = None
    signed_at: Optional[datetime] = None
    signature: Optional[str] = None
    is_current: bool = False


class CLAGateSettingUpdate(BaseModel):
    mode: CLAGateMode
    updated_by: Optional[str] = "operator"
    notes: Optional[str] = None


@router.get("/current", response_model=CLACurrentResponse)
def get_current_cla(db: Session = Depends(get_db)):
    """Returns the currently effective CLA text, version, and digest."""
    cla = get_effective_cla_version(db)
    return CLACurrentResponse(
        version=cla.version,
        sha256=cla.sha256,
        published_at=cla.published_at,
        effective_at=cla.effective_at,
        text=cla.text,
    )


@router.post("/sign", response_model=CLASignResponse)
def sign_cla(req: CLASignRequest, db: Session = Depends(get_db)):
    """Verifies and appends a miner's CLA signature."""
    now = int(time.time())
    if abs(now - req.issued_at) > FRESHNESS_WINDOW_SECONDS:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="issued_at is outside the allowed freshness window.",
        )

    # Check nonce uniqueness
    existing_nonce = (
        db.query(CLASignature).filter(CLASignature.nonce == req.nonce).first()
    )
    if existing_nonce:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="Nonce has already been used.",
        )

    # Check version and digest existence
    cla_record = (
        db.query(CLAVersion).filter(CLAVersion.version == req.cla_version).first()
    )
    if not cla_record or cla_record.sha256.lower() != req.cla_sha256.lower():
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="Unknown CLA version or SHA-256 digest mismatch.",
        )

    # Reconstruct message and verify sr25519 signature
    expected_message = build_cla_signing_message(
        netuid=req.netuid,
        cla_version=req.cla_version,
        cla_sha256=req.cla_sha256,
        hotkey=req.hotkey,
        nonce=req.nonce,
        issued_at=req.issued_at,
    )

    if not verify_cla_signature(expected_message, req.signature, req.hotkey):
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="Invalid signature or wrong signer for given hotkey.",
        )

    coldkey = resolve_coldkey(req.hotkey)
    sig_record = CLASignature(
        hotkey=req.hotkey,
        coldkey=coldkey,
        cla_version=req.cla_version,
        cla_sha256=req.cla_sha256,
        signature=req.signature,
        nonce=req.nonce,
        issued_at=req.issued_at,
    )
    db.add(sig_record)
    db.commit()
    db.refresh(sig_record)

    return CLASignResponse(
        status="ok",
        hotkey=sig_record.hotkey,
        coldkey=sig_record.coldkey,
        cla_version=sig_record.cla_version,
        cla_sha256=sig_record.cla_sha256,
        signed_at=sig_record.signed_at,
    )


@router.get("/status/{hotkey}", response_model=CLAStatusResponse)
def get_cla_status_by_path(hotkey: str, db: Session = Depends(get_db)):
    """Public read endpoint returning a hotkey's CLA status."""
    effective = get_effective_cla_version(db)
    latest_sig = (
        db.query(CLASignature)
        .filter(CLASignature.hotkey == hotkey)
        .order_by(CLASignature.signed_at.desc(), CLASignature.id.desc())
        .first()
    )

    if not latest_sig:
        return CLAStatusResponse(hotkey=hotkey, signed=False)

    is_current = (
        latest_sig.cla_version == effective.version
        and latest_sig.cla_sha256.lower() == effective.sha256.lower()
    )

    return CLAStatusResponse(
        hotkey=hotkey,
        signed=True,
        version=latest_sig.cla_version,
        digest=latest_sig.cla_sha256,
        signed_at=latest_sig.signed_at,
        signature=latest_sig.signature,
        is_current=is_current,
    )


@router.get("/status", response_model=CLAStatusResponse)
def get_cla_status_by_query(
    hotkey: str = Query(...), db: Session = Depends(get_db)
):
    return get_cla_status_by_path(hotkey=hotkey, db=db)


@router.get("/gate")
def get_gate_mode(db: Session = Depends(get_db)):
    mode = get_current_gate_mode(db)
    return {"mode": mode.value}


@router.post("/gate")
def set_gate_mode(update: CLAGateSettingUpdate, db: Session = Depends(get_db)):
    setting = CLAGateSetting(
        mode=update.mode,
        updated_by=update.updated_by,
        notes=update.notes,
    )
    db.add(setting)
    db.commit()
    db.refresh(setting)
    return {"status": "ok", "mode": setting.mode.value, "updated_at": setting.updated_at}
