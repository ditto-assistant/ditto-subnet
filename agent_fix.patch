"""Backroom MCP tool for inspecting CLA gate status, history, and miner adoption."""

from __future__ import annotations

from typing import Any, Dict, List
from sqlalchemy import distinct, func
from sqlalchemy.orm import Session

from apps.platform.ditto.api_server.endpoints.cla import (
    get_current_gate_mode,
    get_effective_cla_version,
)
from apps.platform.ditto.db.models import (
    ClaGateSettingHistory,
    ClaSignature,
    ClaGateMode,
)


def get_cla_gate_report(db: Session, active_hotkeys: List[str]) -> Dict[str, Any]:
    """
    MCP tool implementation:
    Reports gate setting, change history, and active hotkey adoption numbers.
    """
    current_mode = get_current_gate_mode(db)
    effective_cla = get_effective_cla_version(db)
    effective_version = effective_cla.version if effective_cla else None

    # History
    history_records = (
        db.query(ClaGateSettingHistory)
        .order_by(ClaGateSettingHistory.created_at.desc())
        .limit(20)
        .all()
    )
    history = [
        {
            "mode": h.mode.value if isinstance(h.mode, ClaGateMode) else str(h.mode),
            "changed_by": h.changed_by,
            "reason": h.reason,
            "created_at": h.created_at.isoformat(),
        }
        for h in history_records
    ]

    # Adoption counts among active hotkeys
    total_active = len(active_hotkeys)
    signed_count = 0
    unsigned_count = total_active

    if effective_version and active_hotkeys:
        signed_hotkeys_query = (
            db.query(distinct(ClaSignature.hotkey))
            .filter(
                ClaSignature.cla_version == effective_version,
                ClaSignature.hotkey.in_(active_hotkeys),
            )
            .all()
        )
        signed_count = len(signed_hotkeys_query)
        unsigned_count = max(0, total_active - signed_count)

    return {
        "gate_mode": current_mode.value,
        "effective_cla_version": effective_version,
        "active_hotkeys_count": total_active,
        "signed_active_count": signed_count,
        "unsigned_active_count": unsigned_count,
        "adoption_rate": (signed_count / total_active) if total_active > 0 else 0.0,
        "history": history,
    }
