# apps/platform/ditto/api_server/cla.py
import hashlib
import logging
import os
import time
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

from fastapi import APIRouter, Depends, HTTPException, Query, status
from pydantic import BaseModel, Field
from sqlalchemy.orm import Session

from apps.platform.ditto.api_server.attestation import verify_signature
from apps.platform.ditto.db.models.cla import CLAGateSetting, CLASignature, CLAVersion

logger = logging.getLogger(__name__)
router = APIRouter(prefix="/api/v1/cla", tags=["cla"])

FRESHNESS_WINDOW_SECONDS = 300
_shadow_unsigned_counter = 0


def get_cla_shadow_unsigned_count() -> int:
    return _shadow_unsigned_counter


def increment_cla_shadow_count() -> None:
    global _shadow_unsigned_counter
    _shadow_unsigned_counter += 1


def reset_cla_shadow_count() -> None:
    global _shadow_unsigned_counter
    _shadow_unsigned_counter = 0


def build_cla_signature_payload(
    netuid: int,
    cla_version: str,
    cla_sha256: str,
    hotkey: str,
    nonce: str,
    issued_at: int,
) -> str:
    return f"ditto-cla:v1:{netuid}:{cla_version}:{cla_sha256}:{hotkey}:{nonce}:{issued_at}"


def get_current_effective_cla_version(db: Session) -> CLAVersion | None:
    now = datetime.now(timezone.utc)
    return (
        db.query(CLAVersion)
        .filter(CLAVersion.effective_at <= now)
        .order_by(CLAVersion.effective_at.desc(), CLAVersion.id.desc())
        .first()
    )


def get_cla_gate_mode(db: Session) -> str:
    env_mode = os.getenv("DITTO_CLA_GATE_MODE")
    if env_mode in ("off", "shadow", "enforce"):
        return env_mode

    setting = (
        db.query(CLAGateSetting)
        .order_by(CLAGateSetting.id.desc())
        .first()
    )
    if setting and setting.mode in ("off", "shadow", "enforce"):
        return setting.mode.lower()
    return "off"


def set_cla_gate_mode(
    db: Session,
    mode: str,
    updated_by: str = "system",
    notes: str | None = None,
) -> CLAGateSetting:
    mode = mode.lower()
    if mode not in ("off", "shadow", "enforce"):
        raise ValueError(f"Invalid mode '{mode}'. Must be 'off', 'shadow', or 'enforce'.")
    setting = CLAGateSetting(
        mode=mode,
        updated_by=updated_by,
        notes=notes,
        created_at=datetime.now(timezone.utc),
    )
    db.add(setting)
    db.commit()
    db.refresh(setting)
    return setting


def register_cla_version(
    db: Session,
    version: str,
    text: str,
    published_at: datetime | None = None,
    effective_at: datetime | None = None,
) -> CLAVersion:
    now = datetime.now(timezone.utc)
    published_at = published_at or now
    effective_at = effective_at or now
    sha256_hash = hashlib.sha256(text.encode("utf-8")).hexdigest()

    existing = db.query(CLAVersion).filter(CLAVersion.version == version).first()
    if existing:
        existing.sha256 = sha256_hash
        existing.text = text
        existing.published_at = published_at
        existing.effective_at = effective_at
        db.commit()
        db.refresh(existing)
        return existing

    record = CLAVersion(
        version=version,
        sha256=sha256_hash,
        text=text,
        published_at=published_at,
        effective_at=effective_at,
        created_at=now,
    )
    db.add(record)
    db.commit()
    db.refresh(record)
    return record


def verify_hotkey_cla_gate(db: Session, hotkey: str) -> tuple[bool, str]:
    mode = get_cla_gate_mode(db)
    if mode == "off":
        return True, ""

    current = get_current_effective_cla_version(db)
    if not current:
        return True, ""

    sig = (
        db.query(CLASignature)
        .filter(
            CLASignature.hotkey == hotkey,
            CLASignature.cla_version == current.version,
            CLASignature.cla_sha256 == current.sha256,
        )
        .first()
    )
    if sig:
        return True, ""

    if mode == "shadow":
        increment_cla_shadow_count()
        logger.warning(
            "CLA shadow gate: hotkey %s uploaded without signing current CLA (%s)",
            hotkey,
            current.version,
        )
        return True, ""

    if mode == "enforce":
        msg = (
            f"Hotkey {hotkey} has not signed the currently effective Contributor License Agreement "
            f"({current.version}). Run `uv run ditto cla sign` to sign before uploading."
        )
        return False, msg

    return True, ""


# Pydantic Schemas
class CLACurrentResponse(BaseModel):
    version: str
    sha256: str
    text: str
    published_at: datetime
    effective_at: datetime


class CLASignRequest(BaseModel):
    hotkey: str
    cla_version: str
    cla_sha256: str
    signature: str
    nonce: str
    issued_at: int
    netuid: int = 118


class CLASignResponse(BaseModel):
    status: str
    hotkey: str
    cla_version: str
    cla_sha256: str
    signed_at: datetime


class CLAStatusResponse(BaseModel):
    hotkey: str
    signed: bool
    is_current: bool
    version: str | None = None
    cla_version: str | None = None
    digest: str | None = None
    cla_sha256: str | None = None
    signed_at: datetime | None = None
    signature: str | None = None


# Endpoints
@router.get("/current", response_model=CLACurrentResponse)
def get_current_cla(db: Session = Depends(lambda: None)):
    from apps.platform.ditto.db.session import get_db

    # Fallback to resolver if dependency injection is evaluated
    effective = get_current_effective_cla_version(db)
    if not effective:
        doc_path = Path("docs/legal/CLA-v1.md")
        text = doc_path.read_text(encoding="utf-8") if doc_path.exists() else "# CLA v1 fixture"
        effective = register_cla_version(db, version="v1", text=text)

    return CLACurrentResponse(
        version=effective.version,
        sha256=effective.sha256,
        text=effective.text or "",
        published_at=effective.published_at,
        effective_at=effective.effective_at,
    )


@router.post("/sign", response_model=CLASignResponse)
def sign_cla(req: CLASignRequest, db: Session = Depends(lambda: None)):
    current = db.query(CLAVersion).filter(CLAVersion.version == req.cla_version).first()
    if not current:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail=f"CLA version {req.cla_version} is not registered",
        )

    if req.cla_sha256.lower() != current.sha256.lower():
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail=f"Digest mismatch for CLA version {req.cla_version}",
        )

    # Freshness window check
    now_ts = int(time.time())
    if abs(now_ts - req.issued_at) > FRESHNESS_WINDOW_SECONDS:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="Stale or invalid issued_at timestamp",
        )

    # Nonce uniqueness check
    nonce_exists = db.query(CLASignature).filter(CLASignature.nonce == req.nonce).first()
    if nonce_exists:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="Nonce already used",
        )

    expected_payload = build_cla_signature_payload(
        netuid=req.netuid,
        cla_version=req.cla_version,
        cla_sha256=req.cla_sha256,
        hotkey=req.hotkey,
        nonce=req.nonce,
        issued_at=req.issued_at,
    )

    if not verify_signature(expected_payload, req.signature, req.hotkey):
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="Invalid signature or wrong signer",
        )

    signed_at = datetime.now(timezone.utc)
    sig_row = CLASignature(
        hotkey=req.hotkey,
        coldkey=None,
        cla_version=req.cla_version,
        cla_sha256=req.cla_sha256,
        signature=req.signature,
        nonce=req.nonce,
        issued_at=req.issued_at,
        signed_at=signed_at,
    )
    db.add(sig_row)
    db.commit()
    db.refresh(sig_row)

    return CLASignResponse(
        status="success",
        hotkey=req.hotkey,
        cla_version=req.cla_version,
        cla_sha256=req.cla_sha256,
        signed_at=signed_at,
    )


@router.get("/status/{hotkey}", response_model=CLAStatusResponse)
def get_cla_status(hotkey: str, db: Session = Depends(lambda: None)):
    latest_sig = (
        db.query(CLASignature)
        .filter(CLASignature.hotkey == hotkey)
        .order_by(CLASignature.signed_at.desc(), CLASignature.id.desc())
        .first()
    )

    if not latest_sig:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail=f"No CLA signature found for hotkey {hotkey}",
        )

    effective = get_current_effective_cla_version(db)
    is_current = bool(
        effective
        and latest_sig.cla_version == effective.version
        and latest_sig.cla_sha256.lower() == effective.sha256.lower()
    )

    return CLAStatusResponse(
        hotkey=hotkey,
        signed=True,
        is_current=is_current,
        version=latest_sig.cla_version,
        cla_version=latest_sig.cla_version,
        digest=latest_sig.cla_sha256,
        cla_sha256=latest_sig.cla_sha256,
        signed_at=latest_sig.signed_at,
        signature=latest_sig.signature,
    )
