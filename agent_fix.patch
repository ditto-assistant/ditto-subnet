        default=lambda: datetime.now(timezone.utc),
        nullable=False,
    )


# Append-only enforcement: prevent update and delete operations on CLASignature
@event.listens_for(CLASignature, "before_update")
def _prevent_cla_signature_update(mapper, connection, target):
    raise PermissionError("CLASignature table is append-only. Updates are prohibited.")


@event.listens_for(CLASignature, "before_delete")
def _prevent_cla_signature_delete(mapper, connection, target):
    raise PermissionError("CLASignature table is append-only. Deletions are prohibited.")


class CLAGateSettingHistory(Base):
