```python
from typing import Any, Dict, Optional
from fastapi import APIRouter, Depends, status
from pydantic import BaseModel, Field
from sqlalchemy.orm import Session

from apps.platform.ditto.api_server.db import get_db
from apps.platform.ditto.api_server.cla_service import (
    evaluate_hotkey_cla_status,
    get_current_effective_cla,
    verify_and_store_signature,
)
from apps.platform.ditto.api_server.models.cla import ClaSignature

router = APIRouter(prefix="/api/v1/cla", tags=["cla"])


class ClaSignRequest(BaseModel):
    netuid: int = Field(default=118, description="Target netuid")
    hotkey: str = Field(..., description="SS58 hotkey address")
    cla_version: str = Field(..., description="CLA version identifier, e.g. v1")
    cla_sha256: str = Field(..., description="SHA-256 digest of CLA text")
    nonce: str = Field(..., description="Unique nonce")
    issued_at: int = Field(..., description="Unix timestamp of signing")
    signature: str = Field(..., description="Hex signature 0x...")


@router.get("/current")
def get_current_cla(db: Session = Depends(get_db)) -> Dict[str, Any]:
    """Returns currently effective CLA version and digest."""
    effective = get_current_effective_cla(db)
    if not effective:
        return {
            "version": None,
            "sha256": None,
            "published_at": None,
            "effective_at": None,
        }
    return {
        "version": effective.version,
        "sha256": effective.sha256,
        "published_at": effective.published_at.isoformat(),
        "effective_at": effective.effective_at.isoformat(),
    }


@router.get("/status/{hotkey}")
def get_hotkey_cla_status(hotkey: str, db: Session = Depends(get_db)) -> Dict[str, Any]:
    """Public read endpoint returning hotkey's CLA status: version, digest, signed_at, signature."""
    is_current, latest_sig, effective = evaluate_hotkey_cla_status(db, hotkey)
    return {
        "hotkey": hotkey,
        "has_signed": latest_sig is not None,
        "is_current": is_current,
        "version": latest_sig.cla_version if latest_sig else None,
        "sha256": latest_sig.cla_sha256 if latest_sig else None,
        "signed_at": latest_sig.signed_at.isoformat() if latest_sig else None,
        "signature": latest_sig.signature if latest_sig else None,
        "effective_version": effective.version if effective else None,
    }


@router.post("/sign", status_code=status.HTTP_201_CREATED)
def submit_cla_signature(req: ClaSignRequest, db: Session = Depends(get_db)) -> Dict[str, Any]:
    """Verifies and stores a hotkey's CLA signature."""
    row = verify_and_store_signature(
        db=db,
        netuid=req.netuid,
        hotkey=req.hotkey,
        cla_version=req.cla_version,
        cla_sha256=req.cla_sha256,
        nonce=req.nonce,
        issued_at=req.issued_at,
        signature=req.signature,
    )
    return {
        "status": "signed",
        "hotkey": row.hotkey,
        "coldkey": row.coldkey,
        "cla_version": row.cla_version,
        "cla_sha256": row.cla_sha256,
        "signed_at": row.signed_at.isoformat(),
    }
