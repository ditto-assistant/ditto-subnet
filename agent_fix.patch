### 5. Platform API Endpoints & Verification Service

#### `apps/platform/ditto/api_server/services/cla_service.py`

```python
import hashlib
import time
from datetime import datetime, timezone
from typing import Optional, Tuple
from sqlalchemy.orm import Session
from fastapi import HTTPException, status

from apps.platform.ditto.models.cla import CLAVersion, CLASignature, CLAGateSetting, CLAShadowLog
from apps.platform.ditto.api_server.cla_payload import build_cla_sign_payload
from apps.platform.ditto.api_server.attestation import verify_signature

FRESHNESS_WINDOW_SECONDS = 600  # 10 minutes


def get_current_effective_cla(db: Session) -> Optional[CLAVersion]:
    """Return the latest effective CLA version."""
    now = datetime.now(timezone.utc)
    return (
        db.query(CLAVersion)
        .filter(CLAVersion.effective_at <= now)
        .order_by(CLAVersion.effective_at.desc(), CLAVersion.published_at.desc())
        .first()
    )


def get_cla_gate_mode(db: Session) -> str:
    """Return the current gate mode ('off', 'shadow', 'enforce'). Defaults to 'off'."""
    setting = db.query(CLAGateSetting).order_by(CLAGateSetting.id.desc()).first()
    return setting.mode if setting else "off"


def resolve_coldkey_for_hotkey(hotkey: str) -> str:
    """Resolve Owner(hotkey) coldkey from subtensor or linked state."""
    try:
        from apps.platform.ditto.api_server.subtensor import get_subtensor_client
        client = get_subtensor_client()
        return client.get_hotkey_owner(hotkey) or hotkey
    except Exception:
        return f"cold_{hotkey[:8]}"


def verify_and_store_signature(
    db: Session,
    netuid: int,
    cla_version: str,
    cla_sha256: str,
    hotkey: str,
    nonce: str,
    issued_at: int,
    signature_hex: str,
) -> CLASignature:
    cla = db.query(CLAVersion).filter(CLAVersion.version == cla_version).first()
    if not cla:
        raise HTTPException(status_code=400, detail=f"Unknown CLA version: {cla_version}")

    if cla.sha256.lower() != cla_sha256.lower():
        raise HTTPException(
            status_code=400,
            detail=f"CLA digest mismatch. Expected {cla.sha256}, got {cla_sha256}",
        )

    # 1. Freshness window check
    now_ts = int(time.time())
    if abs(now_ts - issued_at) > FRESHNESS_WINDOW_SECONDS:
        raise HTTPException(
            status_code=400,
            detail=f"Stale issued_at timestamp (diff: {abs(now_ts - issued_at)}s, window: {FRESHNESS_WINDOW_SECONDS}s)",
        )

    # 2. Nonce uniqueness check
    existing_nonce = db.query(CLASignature).filter(CLASignature.nonce == nonce).first()
    if existing_nonce:
        raise HTTPException(status_code=400, detail="Replayed nonce: nonce has already been used")

    # 3. Payload verification
    payload = build_cla_sign_payload(netuid, cla_version, cla_sha256, hotkey, nonce, issued_at)
    is_valid = verify_signature(
        message=payload,
        signature=signature_hex,
        ss58_address=hotkey,
    )
    if not is_valid:
        raise HTTPException(status_code=400, detail="Invalid cryptographic signature for hotkey")

    # 4. Resolve coldkey
    coldkey = resolve_coldkey_for_hotkey(hotkey)

    # 5. Append-only storage
    sig_entry = CLASignature(
        hotkey=hotkey,
        coldkey=coldkey,
        cla_version=cla_version,
        cla_sha256=cla_sha256.lower(),
        signature=signature_hex,
        nonce=nonce,
        issued_at=issued_at,
        signed_at=datetime.now(timezone.utc),
    )
    db.add(sig_entry)
    db.commit()
    db.refresh(sig_entry)
    return sig_entry


def verify_hotkey_gate(db: Session, hotkey: str) -> None:
    """Gate verification for uploads."""
    mode = get_cla_gate_mode(db)
    if mode == "off":
        return

    current_cla = get_current_effective_cla(db)
    if not current_cla:
        return

    latest_sig = (
        db.query(CLASignature)
        .filter(CLASignature.hotkey == hotkey, CLASignature.cla_version == current_cla.version)
        .order_by(CLASignature.id.desc())
        .first()
    )

    if latest_sig:
        return

    if mode == "shadow":
        shadow_entry = CLAShadowLog(hotkey=hotkey, cla_version=current_cla.version)
        db.add(shadow_entry)
        db.commit()
        return

    if mode == "enforce":
        raise HTTPException(
            status_code=status.HTTP_403_FORBIDDEN,
            detail=(
                f"CLA signature required for version {current_cla.version}. "
                f"Please run 'uv run ditto cla sign' before submitting."
            ),
        )
```

