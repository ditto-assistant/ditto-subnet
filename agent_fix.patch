"""API endpoints for CLA version retrieval, signing, status, and gate status."""

from __future__ import annotations

import datetime
from fastapi import APIRouter, Depends, HTTPException, Query, status
from pydantic import BaseModel, Field
from sqlalchemy.orm import Session

from apps.platform.ditto.api_server.attestation import (
    resolve_coldkey_for_hotkey,
    verify_cla_signature,
)
from apps.platform.ditto.db.models.cla import CLAGateSetting, CLASignature, CLAVersion
from apps.platform.ditto.db.session import get_db

router = APIRouter(prefix="/api/v1/cla", tags=["cla"])


class CLAVersionResponse(BaseModel):
    version: str
    sha256: str
    published_at: datetime.datetime
    effective_at: datetime.datetime


class CLASignRequest(BaseModel):
    netuid: int = Field(default=118)
    cla_version: str
    cla_sha256: str
    hotkey: str
    nonce: str
    issued_at: int
    signature: str


class CLASignResponse(BaseModel):
    status: str
    hotkey: str
    coldkey: str
    cla_version: str
    signed_at: datetime.datetime


class CLAStatusResponse(BaseModel):
    hotkey: str
    signed: bool
    current_version: str | None
    is_current: bool
    version: str | None = None
    sha256: str | None = None
    signed_at: datetime.datetime | None = None
    signature: str | None = None


def get_current_cla_version(db: Session) -> CLAVersion | None:
    now = datetime.datetime.now(datetime.timezone.utc)
    return (
        db.query(CLAVersion)
        .filter(CLAVersion.effective_at <= now)
        .order_by(CLAVersion.effective_at.desc())
        .first()
    )


@router.get("/current", response_model=CLAVersionResponse)
def get_current_version(db: Session = Depends(get_db)):
    """Fetch the currently effective CLA version and digest."""
    current = get_current_cla_version(db)
    if not current:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail="No effective CLA version configured.",
        )
    return current


@router.get("/status/{hotkey}", response_model=CLAStatusResponse)
@router.get("/status", response_model=CLAStatusResponse)
def get_cla_status(
    hotkey: str | None = None,
    hotkey_query: str | None = Query(default=None, alias="hotkey"),
    db: Session = Depends(get_db),
):
    """Public read endpoint returning a hotkey's CLA status."""
    hk = hotkey or hotkey_query
    if not hk:
        raise HTTPException(status_code=400, detail="Missing hotkey parameter.")

    current_cla = get_current_cla_version(db)
    current_ver = current_cla.version if current_cla else None

    # Get latest signature for this hotkey
    latest_sig = (
        db.query(CLASignature)
        .filter(CLASignature.hotkey == hk)
        .order_by(CLASignature.signed_at.desc())
        .first()
    )

    if not latest_sig:
        return CLAStatusResponse(
            hotkey=hk,
            signed=False,
            current_version=current_ver,
            is_current=False,
        )

    is_current = bool(current_ver and latest_sig.cla_version == current_ver)
    return CLAStatusResponse(
        hotkey=hk,
        signed=True,
        current_version=current_ver,
        is_current=is_current,
        version=latest_sig.cla_version,
        sha256=latest_sig.cla_sha256,
        signed_at=latest_sig.signed_at,
        signature=latest_sig.signature,
    )


@router.post("/sign", response_model=CLASignResponse)
def submit_cla_signature(req: CLASignRequest, db: Session = Depends(get_db)):
    """Submit a hotkey signature for the CLA."""
    current_cla = get_current_cla_version(db)
    if not current_cla or current_cla.version != req.cla_version:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail=f"Version '{req.cla_version}' is not the currently effective CLA version.",
        )

    if current_cla.sha256.lower() != req.cla_sha256.lower():
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="Provided CLA SHA-256 digest does not match platform registry.",
        )

    # Check nonce replay
    existing_nonce = (
        db.query(CLASignature).filter(CLASignature.nonce == req.nonce).first()
    )
    if existing_nonce:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="Nonce already used. Please generate a new nonce.",
        )

    valid, err_msg = verify_cla_signature(
        netuid=req.netuid,
        cla_version=req.cla_version,
        cla_sha256=req.cla_sha256,
        hotkey=req.hotkey,
        nonce=req.nonce,
        issued_at=req.issued_at,
        signature=req.signature,
    )
    if not valid:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail=f"Signature verification failed: {err_msg}",
        )

    coldkey = resolve_coldkey_for_hotkey(req.hotkey)
    sig_record = CLASignature(
        hotkey=req.hotkey,
        coldkey=coldkey,
        cla_version=req.cla_version,
        cla_sha256=req.cla_sha256,
        signature=req.signature,
        nonce=req.nonce,
        issued_at=datetime.datetime.fromtimestamp(req.issued_at, tz=datetime.timezone.utc),
        signed_at=datetime.datetime.now(datetime.timezone.utc),
    )
    db.add(sig_record)
    db.commit()
    db.refresh(sig_record)

    return CLASignResponse(
        status="ok",
        hotkey=sig_record.hotkey,
        coldkey=sig_record.coldkey,
        cla_version=sig_record.cla_version,
        signed_at=sig_record.signed_at,
    )
