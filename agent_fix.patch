def check_cla_upload_gate(hotkey: str, db: Session) -> None:
    """
    Enforces the CLA submission gate depending on platform mode (off, shadow, enforce).
    """
    from apps.platform.ditto.api_server.endpoints.cla import (
        get_current_gate_mode,
        get_effective_cla_version,
    )
    from apps.platform.ditto.db.models import ClaSignature, ClaGateMode

