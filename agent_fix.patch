### 8. CLI Commands: `ditto cla sign` and `ditto cla status`

In `ditto/miner_cli/cla.py`:
```python
"""CLI subcommands for Contributor License Agreement."""

import secrets
import sys
import time
import httpx
import typer
from rich.console import Console
from rich.panel import Panel

from ditto.cla_common import build_cla_sign_payload, compute_cla_sha256
from ditto.miner_cli.wallet import get_keypair

app = typer.Typer(name="cla", help="Manage Contributor License Agreement (CLA) signatures.")
console = Console()


@app.command("sign")
def cla_sign(
    platform_url: str = typer.Option("http://localhost:8000", "--platform-url", envvar="PLATFORM_URL"),
    wallet_name: str = typer.Option(..., "--wallet-name", help="Bittensor wallet name"),
    hotkey_name: str = typer.Option("default", "--hotkey-name", help="Hotkey name"),
    netuid: int = typer.Option(118, "--netuid", help="Subnet netuid"),
    yes: bool = typer.Option(False, "--yes", "-y", help="Skip confirmation prompt"),
):
    """Review and sign the Contributor License Agreement with your hotkey."""
    keypair = get_keypair(wallet_name, hotkey_name)
    hotkey = keypair.ss58_address

    # 1. Fetch current CLA from platform
    try:
        resp = httpx.get(f"{platform_url.rstrip('/')}/api/v1/cla/current", timeout=10.0)
        resp.raise_for_status()
        data = resp.json()
    except Exception as e:
        console.print(f"[red]Failed to fetch current CLA from platform: {e}[/red]")
        sys.exit(1)

    cla_version = data["version"]
    remote_sha256 = data["sha256"].lower()
    content = data["content"]

    # 2. Recompute SHA-256 and verify
    local_sha256 = compute_cla_sha256(content).lower()
    if local_sha256 != remote_sha256:
        console.print("[bold red]Digest mismatch! The CLA content retrieved does not match its claimed SHA-256.[/bold red]")
        console.print(f"Claimed:  {remote_sha256}")
        console.print(f"Computed: {local_sha256}")
        sys.exit(1)

    console.print(Panel(content, title=f"SN118 CLA {cla_version}", subtitle=f"SHA-256: {local_sha256}"))

    if not yes:
        confirm = typer.prompt("Type 'I AGREE' to execute this agreement with your hotkey")
        if confirm.strip() != "I AGREE":
            console.print("[yellow]Agreement signing cancelled.[/yellow]")
            sys.exit(1)

    nonce = secrets.token_hex(16)
    issued_at = int(time.time())

    payload = build_cla_sign_payload(
        netuid=netuid,
        cla_version=cla_version,
        cla_sha256=local_sha256,
        hotkey=hotkey,
        nonce=nonce,
        issued_at=issued_at,
    )

    signature_bytes = keypair.sign(payload.encode("utf-8"))
    signature = f"0x{signature_bytes.hex()}"

    # Submit to platform
    req_body = {
        "hotkey": hotkey,
        "cla_version": cla_version,
        "cla_sha256": local_sha256,
        "nonce": nonce,
        "issued_at": issued_at,
        "signature": signature,
    }

    try:
        post_resp = httpx.post(f"{platform_url.rstrip('/')}/api/v1/cla/sign", json=req_body, timeout=10.0)
        post_resp.raise_for_status()
        console.print(f"[bold green]Successfully signed CLA {cla_version} for hotkey {hotkey}![/bold green]")
    except httpx.HTTPStatusError as e:
        console.print(f"[red]Platform rejected signature: {e.response.text}[/red]")
        sys.exit(1)
    except Exception as e:
        console.print(f"[red]Error contacting platform: {e}[/red]")
        sys.exit(1)


@app.command("status")
def cla_status(
    platform_url: str = typer.Option("http://localhost:8000", "--platform-url", envvar="PLATFORM_URL"),
    hotkey: str = typer.Option(..., "--hotkey", help="Hotkey SS58 address"),
):
    """Inspect CLA signature status for a hotkey."""
    try:
        resp = httpx.get(
            f"{platform_url.rstrip('/')}/api/v1/cla/status",
            params={"hotkey": hotkey},
            timeout=10.0,
        )
        resp.raise_for_status()
        data = resp.json()
    except Exception as e:
        console.print(f"[red]Failed to get CLA status: {e}[/red]")
        sys.exit(1)

    console.print(f"Hotkey: [cyan]{data['hotkey']}[/cyan]")
    console.print(f"Current Effective CLA: [bold]{data.get('current_effective_version') or 'None'}[/bold]")
    is_current = data.get("has_signed_current", False)
    status_str = "[bold green]YES[/bold green]" if is_current else "[bold red]NO[/bold red]"
    console.print(f"Signed Current CLA: {status_str}")
    if data.get("signed_version"):
        console.print(f"Last Signed Version: {data['signed_version']}")
        console.print(f"Signed Digest: {data['cla_sha256']}")
        console.print(f"Signed At: {data['signed_at']}")
```

Register this subcommand in the main CLI entry point (`ditto/miner_cli/main.py`):
