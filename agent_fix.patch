def test_append_only_signature_table(db_session):
    """Verify that ClaSignature records cannot be modified or deleted."""
    sig = ClaSignature(
        hotkey="5Hotkey111",
        coldkey="5Cold111",
        cla_version="v1",
        cla_sha256="abcd1234abcd1234abcd1234abcd1234abcd1234abcd1234abcd1234abcd1234",
        signature="0xvalidsig",
        nonce="nonce-1",
        issued_at=datetime.now(timezone.utc),
    )
    db_session.add(sig)
    db_session.commit()

    # Attempt update
    sig.signature = "0xnew_sig"
    with pytest.raises(AppendOnlyViolationError):
        db_session.commit()
    db_session.rollback()

    # Attempt delete
    db_session.delete(sig)
    with pytest.raises(AppendOnlyViolationError):
        db_session.commit()
    db_session.rollback()


def test_cla_signature_validation(db_session):
    text = "Fixture CLA text content"
    digest = compute_sha256(text)

    # Register version
    v1 = ClaVersion(version="v1", sha256=digest)
    db_session.add(v1)
    db_session.commit()

    now_ts = int(datetime.now(timezone.utc).timestamp())
    req = ClaSignRequest(
        netuid=118,
        hotkey="5Hotkey111",
        cla_version="v1",
        cla_sha256=digest,
        nonce="nonce-test-1",
        issued_at=now_ts,
        signature="valid_signature",
    )

    # Valid sign
    res = submit_cla_signature(req, db=db_session)
    assert res.status == "ok"
    assert res.coldkey == "cold_5Hotkey111"

    # Replayed nonce
    with pytest.raises(HTTPException) as exc:
        submit_cla_signature(req, db=db_session)
    assert exc.value.status_code == 409

    # Stale issued_at
    req_stale = req.model_copy(update={"nonce": "nonce-2", "issued_at": now_ts - 500})
    with pytest.raises(HTTPException) as exc:
        submit_cla_signature(req_stale, db=db_session)
    assert exc.value.status_code == 400

    # Digest mismatch
    req_bad_digest = req.model_copy(update={"nonce": "nonce-3", "cla_sha256": "bad" * 16})
    with pytest.raises(HTTPException) as exc:
        submit_cla_signature(req_bad_digest, db=db_session)
    assert exc.value.status_code == 400


def test_upload_gate_modes(db_session):
    digest = compute_sha256("CLA v1")
    v1 = ClaVersion(version="v1", sha256=digest)
    db_session.add(v1)
    db_session.commit()

    hotkey = "5HotkeyUnsigned"

    # 1. Mode OFF -> allowed
    db_session.add(ClaGateSettingHistory(mode=ClaGateMode.OFF))
    db_session.commit()
    check_cla_upload_gate(hotkey, db_session)

    # 2. Mode SHADOW -> allowed (logged)
    db_session.add(ClaGateSettingHistory(mode=ClaGateMode.SHADOW))
    db_session.commit()
    check_cla_upload_gate(hotkey, db_session)

    # 3. Mode ENFORCE -> denied for unsigned
    db_session.add(ClaGateSettingHistory(mode=ClaGateMode.ENFORCE))
    db_session.commit()
    with pytest.raises(HTTPException) as exc:
        check_cla_upload_gate(hotkey, db_session)
    assert exc.value.status_code == 403

    # Sign version and verify access granted
    db_session.add(
        ClaSignature(
            hotkey=hotkey,
            coldkey="cold",
            cla_version="v1",
            cla_sha256=digest,
            signature="valid",
            nonce="nonce-ok",
            issued_at=datetime.now(timezone.utc),
        )
    )
    db_session.commit()
    check_cla_upload_gate(hotkey, db_session)


def test_backroom_mcp_tool_report(db_session):
    v1 = ClaVersion(version="v1", sha256="abcd" * 16)
    db_session.add(v1)
    db_session.add(ClaGateSettingHistory(mode=ClaGateMode.SHADOW, changed_by="admin", reason="testing"))
    db_session.add(
        ClaSignature(
