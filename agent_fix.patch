### 7. Backroom Read Tool: `apps/platform/ditto/backroom/tools.py`

```python
from typing import Any, Dict
from sqlalchemy.orm import Session
from sqlalchemy import func

from apps.platform.ditto.db.models import (
    CLAVersion,
    CLASignature,
    CLAGateSetting,
    CLAGateSettingHistory,
    CLAShadowLog,
)


def get_cla_gate_status(db: Session) -> Dict[str, Any]:
    """
    Backroom MCP tool: Returns current CLA gate setting, configuration history,
    active hotkey adoption counts, and shadow-mode counters.
    """
    setting = db.query(CLAGateSetting).filter(CLAGateSetting.id == 1).first()
    current_mode = setting.mode if setting else "off"

    current_cla = db.query(CLAVersion).filter(CLAVersion.is_current == True).order_by(CLAVersion.effective_at.desc()).first()
    current_version = current_cla.version if current_cla else None

    # History entries
    history_rows = (
        db.query(CLAGateSettingHistory)
        .order_by(CLAGateSettingHistory.changed_at.desc())
        .limit(50)
        .all()
    )
    history = [
        {
            "mode": h.mode,
            "changed_by": h.changed_by,
            "reason": h.reason,
            "changed_at": h.changed_at.isoformat(),
        }
        for h in history_rows
    ]

    # Distinct hotkeys that have signed current CLA
    signed_hotkeys_count = 0
    if current_version:
        signed_hotkeys_count = (
            db.query(func.count(func.distinct(CLASignature.hotkey)))
            .filter(CLASignature.cla_version == current_version)
            .scalar()
            or 0
        )

    # Distinct hotkeys seen in shadow uploads
    unsigned_shadow_hotkeys_count = (
        db.query(func.count(func.distinct(CLAShadowLog.hotkey))).scalar() or 0
    )

    # Distinct total hotkeys observed across signatures and shadow logs
    total_distinct_hotkeys = (
        db.query(func.count(func.distinct(CLASignature.hotkey))).scalar() or 0
    ) + unsigned_shadow_hotkeys_count

    shadow_logs_count = db.query(func.count(CLAShadowLog.id)).scalar() or 0

    adoption_pct = (
        round((signed_hotkeys_count / total_distinct_hotkeys) * 100, 2)
        if total_distinct_hotkeys > 0
        else 0.0
    )

    return {
        "gate_mode": current_mode,
        "current_cla_version": current_version,
        "current_cla_sha256": current_cla.sha256 if current_cla else None,
        "history": history,
        "adoption": {
            "signed_active_hotkeys": signed_hotkeys_count,
            "unsigned_active_hotkeys": unsigned_shadow_hotkeys_count,
            "total_observed_hotkeys": total_distinct_hotkeys,
            "signed_percentage": adoption_pct,
        },
        "shadow_mode_unsigned_events_count": shadow_logs_count,
    }
