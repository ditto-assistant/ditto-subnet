```python
"""Interface sketch for GitHub bounty PR CLA checks (Issue #2871)."""

from __future__ import annotations

from typing import Protocol
from sqlalchemy.orm import Session
from apps.platform.ditto.api_server.endpoints.cla import get_current_cla_version
from apps.platform.ditto.db.models.cla import CLASignature


class GitHubHotkeyResolver(Protocol):
    """Resolves a GitHub username to linked hotkeys (Issue #2871)."""
    def resolve_hotkey(self, github_username: str) -> str | None:
        ...


def check_pr_author_cla_status(
    github_username: str,
    resolver: GitHubHotkeyResolver,
    db: Session,
) -> dict[str, Any]:
    """Check whether a bounty PR contributor has signed the current CLA."""
    hotkey = resolver.resolve_hotkey(github_username)
    if not hotkey:
        return {
            "status": "fail",
            "reason": f"GitHub user '{github_username}' has not linked a hotkey. See #2871.",
        }

    current_cla = get_current_cla_version(db)
    if not current_cla:
        return {"status": "pass", "reason": "No active CLA required."}

    sig = (
        db.query(CLASignature)
        .filter(
            CLASignature.hotkey == hotkey,
            CLASignature.cla_version == current_cla.version,
        )
        .first()
    )
    if sig:
        return {
            "status": "pass",
            "hotkey": hotkey,
            "cla_version": current_cla.version,
        }
    return {
        "status": "fail",
        "hotkey": hotkey,
        "reason": f"Hotkey {hotkey} must sign CLA v{current_cla.version} via 'uv run ditto cla sign'.",
    }
