+def enforce_cla_gate(db: Session, hotkey: str) -> None:
+    """
+    Validates that the miner hotkey has signed the currently effective CLA.
+    Rollout modes:
+      - 'off': allow upload.
+      - 'shadow': log and track unsigned uploads, but permit them.
+      - 'enforce': raise HTTP 403 telling miner to run `ditto cla sign`.
+    """
+    latest_setting = (
+        db.query(CLAGateSetting)
+        .order_by(CLAGateSetting.id.desc())
+        .first()
+    )
+    mode = latest_setting.mode if latest_setting else "off"
+    if mode == "off":
+        return
+
+    now = datetime.now(timezone.utc)
+    effective_cla = (
+        db.query(CLAVersion)
+        .filter(CLAVersion.effective_at <= now)
+        .order_by(CLAVersion.effective_at.desc(), CLAVersion.id.desc())
+        .first()
+    )
+    if not effective_cla:
+        return
+
+    has_signature = (
+        db.query(CLASignature)
+        .filter(
+            CLASignature.hotkey == hotkey,
+            CLASignature.cla_version == effective_cla.version,
+            CLASignature.cla_sha256 == effective_cla.sha256,
+        )
+        .first()
+        is not None
+    )
+
+    if not has_signature:
+        if mode == "shadow":
+            logger.warning(
+                "CLA shadow gate: hotkey %s has not signed effective CLA version %s (%s)",
+                hotkey,
+                effective_cla.version,
+                effective_cla.sha256,
+            )
+            db.add(CLAShadowUploadLog(hotkey=hotkey, cla_version=effective_cla.version))
+            db.commit()
+            return
+        elif mode == "enforce":
+            raise HTTPException(
+                status_code=status.HTTP_403_FORBIDDEN,
+                detail=(
+                    f"CLA signature required: hotkey {hotkey} has not signed the currently effective "
+                    f"Contributor License Agreement ({effective_cla.version}). Please run `uv run ditto cla sign`."
+                ),
+            )
+
