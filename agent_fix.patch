from datetime import datetime, timezone
from sqlalchemy import Column, Integer, String, Text, DateTime, func, event
from apps.platform.ditto.api_server.db import Base


class ReadOnlyRecordError(RuntimeError):
    """Raised when an update or delete is attempted on an append-only table."""
    pass


class ClaVersion(Base):
    """Registry of published CLA versions and their digests."""
    __tablename__ = "cla_versions"

    id = Column(Integer, primary_key=True, autoincrement=True)
    version = Column(String(32), unique=True, nullable=False, index=True)
    sha256 = Column(String(64), nullable=False)
    text = Column(Text, nullable=True)
    published_at = Column(DateTime(timezone=True), nullable=False, default=lambda: datetime.now(timezone.utc))
    effective_at = Column(DateTime(timezone=True), nullable=False, default=lambda: datetime.now(timezone.utc))


class ClaSignature(Base):
    """
    Append-only log of hotkey CLA signatures.
    Rows are strictly immutable once inserted.
    """
    __tablename__ = "cla_signatures"

    id = Column(Integer, primary_key=True, autoincrement=True)
    hotkey = Column(String(64), nullable=False, index=True)
    coldkey = Column(String(64), nullable=True)
    cla_version = Column(String(32), nullable=False)
    cla_sha256 = Column(String(64), nullable=False)
    signature = Column(Text, nullable=False)
    nonce = Column(String(128), unique=True, nullable=False, index=True)
    issued_at = Column(Integer, nullable=False)
    signed_at = Column(DateTime(timezone=True), nullable=False, default=lambda: datetime.now(timezone.utc))


@event.listens_for(ClaSignature, "before_update")
def _prevent_cla_signature_update(mapper, connection, target):
    raise ReadOnlyRecordError("cla_signatures rows are append-only and cannot be updated.")


@event.listens_for(ClaSignature, "before_delete")
def _prevent_cla_signature_delete(mapper, connection, target):
    raise ReadOnlyRecordError("cla_signatures rows are append-only and cannot be deleted.")


class ClaGateHistory(Base):
    """Audit log of gate mode transitions (off -> shadow -> enforce)."""
    __tablename__ = "cla_gate_history"

    id = Column(Integer, primary_key=True, autoincrement=True)
    mode = Column(String(32), nullable=False, default="off")  # "off" | "shadow" | "enforce"
    changed_by = Column(String(64), nullable=True)
    reason = Column(Text, nullable=True)
    changed_at = Column(DateTime(timezone=True), nullable=False, default=lambda: datetime.now(timezone.utc))
