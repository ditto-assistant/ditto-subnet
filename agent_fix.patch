### 8. Backroom MCP Tool

`apps/backroom/tools/cla_tool.py`:
```python
from typing import Any, Dict
from sqlalchemy.orm import Session
from sqlalchemy import desc, func
from apps.platform.ditto.api_server.models import (
    CLAGateSettingHistory,
    CLASignature,
    CLAVersion,
)
from apps.platform.ditto.api_server.cla import get_current_effective_cla


def get_cla_gate_status_and_adoption(db: Session, active_hotkeys: list[str]) -> Dict[str, Any]:
    """MCP tool for operators to monitor CLA gate configuration and miner adoption."""
    # 1. Gate mode & setting history
    history_records = (
        db.query(CLAGateSettingHistory)
        .order_by(desc(CLAGateSettingHistory.id))
        .limit(20)
        .all()
    )
    current_mode = history_records[0].mode if history_records else "off"

    history_list = [
        {
            "id": h.id,
            "mode": h.mode,
            "changed_at": h.changed_at.isoformat(),
            "changed_by": h.changed_by,
            "reason": h.reason,
        }
        for h in history_records
    ]

    # 2. Adoption metrics for current version
    current_cla = get_current_effective_cla(db)
    current_version = current_cla.version if current_cla else None

    signed_hotkeys_set = set()
    if current_version:
        rows = (
            db.query(CLASignature.hotkey)
            .filter(CLASignature.cla_version == current_version)
            .distinct()
            .all()
        )
        signed_hotkeys_set = {r[0] for r in rows}

    total_active = len(active_hotkeys)
    signed_count = sum(1 for h in active_hotkeys if h in signed_hotkeys_set)
    unsigned_count = total_active - signed_count
    adoption_rate = (signed_count / total_active * 100.0) if total_active > 0 else 0.0

    return {
        "current_gate_mode": current_mode,
        "current_cla_version": current_version,
        "history": history_list,
        "adoption": {
            "total_active_hotkeys": total_active,
            "signed_active_hotkeys": signed_count,
            "unsigned_active_hotkeys": unsigned_count,
            "adoption_rate_pct": round(adoption_rate, 2),
        },
    }
