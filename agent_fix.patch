### 4. Message Builders and Signature Attestation

#### `apps/platform/ditto/api_server/cla_service.py`
```python
"""Service layer for CLA verification, registration, coldkey resolution, and gate checks."""

import hashlib
import logging
import os
from pathlib import Path
import time
from typing import Any, Optional
from fastapi import HTTPException, status
from sqlalchemy.orm import Session
from substrateinterface import Keypair

from apps.platform.ditto.api_server.models.cla import (
    CLAGateMode,
    CLAGateSetting,
    CLASignature,
    CLAVersion,
)

logger = logging.getLogger(__name__)

FRESHNESS_WINDOW_SECONDS = 300  # 5 minutes
DEFAULT_NETUID = int(os.getenv("NETUID", "118"))


def build_cla_signing_message(
    netuid: int,
    cla_version: str,
    cla_sha256: str,
    hotkey: str,
    nonce: str,
    issued_at: int,
) -> str:
    """Byte-for-byte mirrored signing message builder."""
    return f"ditto-cla:v1:{netuid}:{cla_version}:{cla_sha256}:{hotkey}:{nonce}:{issued_at}"


def verify_cla_signature(
    message: str,
    signature: str,
    hotkey: str,
) -> bool:
    """Verifies sr25519 signature against hotkey ss58 address."""
    try:
        sig_bytes = (
            bytes.fromhex(signature[2:] if signature.startswith("0x") else signature)
        )
        keypair = Keypair(ss58_address=hotkey)
        return keypair.verify(message.encode("utf-8"), sig_bytes)
    except Exception as e:
        logger.warning(f"Signature verification failed for hotkey {hotkey}: {e}")
        return False


def resolve_coldkey(hotkey: str, subtensor: Any = None) -> str:
    """Resolves Owner(hotkey) at finalized block via Subtensor or falls back cleanly."""
    if subtensor is not None:
        try:
            owner = subtensor.get_hotkey_owner(hotkey)
            if owner:
                return str(owner)
        except Exception as e:
            logger.warning(f"Failed to query Owner({hotkey}) from subtensor: {e}")
    return hotkey


def ensure_cla_v1_registered(db: Session) -> CLAVersion:
    """Seeds CLA v1 from docs/legal/CLA-v1.md if not present."""
    existing = db.query(CLAVersion).filter(CLAVersion.version == "v1").first()
    if existing:
        return existing

    cla_path = Path("docs/legal/CLA-v1.md")
    if cla_path.is_file():
        content = cla_path.read_text(encoding="utf-8")
    else:
        content = (
            "# Contributor License Agreement (CLA) - v1\n\n"
            "<!-- PLACEHOLDER FIXTURE: Maintainers supply the legal text under separate review. -->\n"
            "Placeholder CLA text for SN118."
        )

    sha256_hash = hashlib.sha256(content.encode("utf-8")).hexdigest()
    record = CLAVersion(version="v1", sha256=sha256_hash, text=content)
    db.add(record)
    db.commit()
    db.refresh(record)
    return record


def get_effective_cla_version(db: Session) -> CLAVersion:
    record = (
        db.query(CLAVersion)
        .order_by(CLAVersion.effective_at.desc(), CLAVersion.id.desc())
        .first()
    )
    if not record:
        record = ensure_cla_v1_registered(db)
    return record


def get_current_gate_mode(db: Session) -> CLAGateMode:
    setting = (
        db.query(CLAGateSetting)
        .order_by(CLAGateSetting.id.desc())
        .first()
    )
    return setting.mode if setting else CLAGateMode.OFF


def check_hotkey_cla_signature(
    db: Session,
    hotkey: str,
    cla_version: str,
    cla_sha256: str,
) -> Optional[CLASignature]:
    return (
        db.query(CLASignature)
        .filter(
            CLASignature.hotkey == hotkey,
            CLASignature.cla_version == cla_version,
            CLASignature.cla_sha256 == cla_sha256,
        )
        .order_by(CLASignature.signed_at.desc())
        .first()
    )


def evaluate_submission_gate(db: Session, hotkey: str) -> None:
    """Enforces submission gate based on current mode."""
    mode = get_current_gate_mode(db)
    if mode == CLAGateMode.OFF:
        return

    effective_cla = get_effective_cla_version(db)
    sig = check_hotkey_cla_signature(
        db, hotkey, effective_cla.version, effective_cla.sha256
    )

    if sig is not None:
        return

    if mode == CLAGateMode.SHADOW:
        logger.warning(
            f"[CLA Gate - SHADOW] Hotkey {hotkey} uploaded without signing CLA {effective_cla.version} ({effective_cla.sha256})."
        )
        return

    if mode == CLAGateMode.ENFORCE:
        logger.info(
            f"[CLA Gate - ENFORCE] Refusing upload from unsigned hotkey {hotkey} for CLA {effective_cla.version}."
        )
        raise HTTPException(
            status_code=status.HTTP_403_FORBIDDEN,
            detail=(
                f"Contributor License Agreement ({effective_cla.version}) has not been signed by hotkey {hotkey}. "
                "Please run 'uv run ditto cla sign' before submitting."
            ),
        )
