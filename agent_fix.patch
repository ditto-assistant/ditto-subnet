### 7. Miner CLI Implementation: `ditto cla sign` and `ditto cla status`

```python
# ditto/miner_cli/cla.py
import hashlib
import json
import secrets
import sys
import time
from typing import Optional
import click
import requests

from .attestation import build_cla_message


def _get_keypair(wallet_name: str, hotkey_name: str):
    """Retrieve hotkey keypair from wallet."""
    try:
        from bittensor_wallet import Wallet
        wallet = Wallet(name=wallet_name, hotkey=hotkey_name)
        return wallet.hotkey
    except ImportError:
        try:
            import bittensor as bt
            wallet = bt.wallet(name=wallet_name, hotkey=hotkey_name)
            return wallet.hotkey
        except ImportError:
            from substrateinterface import Keypair
            return Keypair.create_from_uri(f"//{hotkey_name}")


@click.group(name="cla")
def cla_cli():
    """Contributor License Agreement (CLA) commands."""
    pass


@cla_cli.command(name="sign")
@click.option("--wallet-name", default="default", help="Miner wallet name")
@click.option("--hotkey-name", default="default", help="Miner hotkey name")
@click.option("--netuid", default=118, type=int, help="Subnet netuid")
@click.option("--platform-url", default="http://127.0.0.1:8000", help="Platform API base URL")
@click.option("--yes", "-y", is_flag=True, help="Skip interactive typing prompt")
def sign_cla_cmd(wallet_name: str, hotkey_name: str, netuid: int, platform_url: str, yes: bool):
    """Sign the SN118 Contributor License Agreement with your miner hotkey."""
    # 1. Fetch current CLA details from platform
    try:
        res = requests.get(f"{platform_url.rstrip('/')}/api/v1/cla/current", timeout=10)
        res.raise_for_status()
        cla_info = res.json()
    except Exception as e:
        click.echo(f"Error fetching current CLA from Platform: {e}", err=True)
        sys.exit(1)

    cla_version = cla_info["version"]
    expected_sha256 = cla_info["sha256"].lower()
    cla_text = cla_info.get("text", "")

    # 2. Recompute and verify digest
    computed_sha256 = hashlib.sha256(cla_text.encode("utf-8")).hexdigest().lower()
    if computed_sha256 != expected_sha256:
        click.echo(
            f"ERROR: CLA digest mismatch! Platform reported {expected_sha256}, "
            f"computed {computed_sha256}. Refusing to sign.",
            err=True,
        )
        sys.exit(1)

    # 3. Present CLA and ask for typed confirmation
    click.echo(f"\n--- Contributor License Agreement ({cla_version}) ---")
    click.echo(f"SHA-256 Digest: {expected_sha256}")
    click.echo(f"Effective Date: {cla_info['effective_at']}\n")
    if cla_text:
        click.echo(cla_text[:500] + ("\n..." if len(cla_text) > 500 else ""))

    if not yes:
        confirmation = click.prompt(
            "\nType 'I AGREE' to execute the CLA with your miner hotkey",
            type=str,
            default="",
        )
        if confirmation.strip() != "I AGREE":
            click.echo("Signing cancelled.")
            sys.exit(0)

    # 4. Sign canonical message with hotkey
    hotkey = _get_keypair(wallet_name, hotkey_name)
    hotkey_ss58 = hotkey.ss58_address
    nonce = secrets.token_hex(16)
    issued_at = int(time.time())

    canonical_message = build_cla_message(
        netuid=netuid,
        cla_version=cla_version,
        cla_sha256=expected_sha256,
        hotkey=hotkey_ss58,
        nonce=nonce,
        issued_at=issued_at,
    )
    sig_raw = hotkey.sign(canonical_message.encode("utf-8"))
    signature = f"0x{sig_raw.hex()}" if isinstance(sig_raw, bytes) else str(sig_raw)

    # 5. Submit to Platform
    payload = {
        "hotkey": hotkey_ss58,
        "cla_version": cla_version,
        "cla_sha256": expected_sha256,
        "signature": signature,
        "nonce": nonce,
        "issued_at": issued_at,
        "netuid": netuid,
    }

    try:
        post_res = requests.post(f"{platform_url.rstrip('/')}/api/v1/cla/sign", json=payload, timeout=10)
        post_res.raise_for_status()
        data = post_res.json()
        click.echo(f"\nSuccessfully signed CLA {cla_version} for hotkey {hotkey_ss58}!")
        click.echo(f"Signed at: {data['signed_at']}")
        click.echo(f"Coldkey (Owner): {data.get('coldkey')}")
    except Exception as e:
        click.echo(f"Failed to submit signature to Platform: {e}", err=True)
        sys.exit(1)


@cla_cli.command(name="status")
@click.option("--wallet-name", default="default", help="Miner wallet name")
@click.option("--hotkey-name", default="default", help="Miner hotkey name")
@click.option("--hotkey", default=None, help="Explicit hotkey ss58 address")
@click.option("--platform-url", default="http://127.0.0.1:8000", help="Platform API base URL")
def status_cla_cmd(wallet_name: str, hotkey_name: str, hotkey: Optional[str], platform_url: str):
    """Show CLA status: signed version, current validity, and timestamp."""
    if not hotkey:
        hk = _get_keypair(wallet_name, hotkey_name)
        hotkey_ss58 = hk.ss58_address
    else:
        hotkey_ss58 = hotkey

    try:
        res = requests.get(f"{platform_url.rstrip('/')}/api/v1/cla/status/{hotkey_ss58}", timeout=10)
        res.raise_for_status()
        status_info = res.json()
    except Exception as e:
        click.echo(f"Error fetching status from Platform: {e}", err=True)
        sys.exit(1)

    click.echo(f"\nHotkey:      {hotkey_ss58}")
    click.echo(f"Signed:      {'Yes' if status_info['signed'] else 'No'}")
    click.echo(f"Is Current:  {'Yes' if status_info['is_current'] else 'No'}")
    if status_info["signed"]:
        click.echo(f"Version:     {status_info['version']}")
        click.echo(f"Digest:      {status_info['digest']}")
        click.echo(f"Signed At:   {status_info['signed_at']}")
        click.echo(f"Signature:   {status_info['signature']}")
