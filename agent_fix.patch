+"""CLI commands for Contributor License Agreement (CLA) signing and status inspection."""
+from __future__ import annotations
+
+import hashlib
+import time
+import uuid
+import click
+import httpx
+from substrateinterface import Keypair
+
+
+def compute_cla_sha256(text: str) -> str:
+    return hashlib.sha256(text.encode("utf-8")).hexdigest()
+
+
+def build_cla_signature_message(
+    netuid: int,
+    cla_version: str,
+    cla_sha256: str,
+    hotkey: str,
+    nonce: str,
+    issued_at: int,
+) -> str:
+    """Canonical format byte-for-byte mirrored with server builder."""
+    return f"ditto-cla:v1:{netuid}:{cla_version}:{cla_sha256}:{hotkey}:{nonce}:{issued_at}"
+
+
+@click.group(name="cla")
+def cla_group():
+    """Commands for managing Contributor License Agreement (CLA) status."""
+    pass
+
+
+@cla_group.command(name="status")
+@click.option("--platform-url", default="http://127.0.0.1:8000", help="Platform API URL")
+@click.option("--hotkey", required=True, help="Hotkey SS58 address")
+def cla_status(platform_url: str, hotkey: str):
+    """Show the miner hotkey's CLA signing status."""
+    url = f"{platform_url.rstrip('/')}/api/v1/cla/status/{hotkey}"
+    try:
+        with httpx.Client(timeout=10.0) as client:
+            resp = client.get(url)
+            resp.raise_for_status()
+            data = resp.json()
+    except Exception as exc:
+        click.secho(f"Failed to fetch CLA status: {exc}", fg="red")
+        raise SystemExit(1)
+
+    click.secho(f"Hotkey: {data['hotkey']}", bold=True)
+    click.echo(f"Current CLA version: {data.get('current_version') or 'N/A'}")
+    click.echo(f"Signed: {data.get('signed')}")
+    click.echo(f"Is Current: {data.get('is_current')}")
+    if data.get("signed"):
+        click.echo(f"Signed Version: {data.get('cla_version')}")
+        click.echo(f"Signed SHA-256: {data.get('sha256')}")
+        click.echo(f"Signed At: {data.get('signed_at')}")
+        click.echo(f"Signature: {data.get('signature')}")
+    else:
+        click.secho("Not signed. Run `ditto cla sign` to sign before uploading agents.", fg="yellow")
+
+
+@cla_group.command(name="sign")
+@click.option("--platform-url", default="http://127.0.0.1:8000", help="Platform API URL")
+@click.option("--netuid", default=118, type=int, help="Ditto subnet netuid")
+@click.option("--keypair-uri", default="//Alice", help="URI or seed phrase for hotkey")
+@click.option("--yes", is_flag=True, help="Skip interactive confirmation")
+def cla_sign(platform_url: str, netuid: int, keypair_uri: str, yes: bool):
+    """Read, verify digest, and sign the current CLA with the miner hotkey."""
+    # 1. Fetch current CLA from platform
+    current_url = f"{platform_url.rstrip('/')}/api/v1/cla/current"
+    try:
+        with httpx.Client(timeout=10.0) as client:
+            resp = client.get(current_url)
+            resp.raise_for_status()
+            cla_data = resp.json()
+    except Exception as exc:
+        click.secho(f"Failed to fetch current CLA from platform: {exc}", fg="red")
+        raise SystemExit(1)
+
+    cla_version = cla_data["version"]
+    expected_sha256 = cla_data["sha256"].lower()
+    cla_content = cla_data["content"]
+
+    # 2. Recompute and verify digest
+    recomputed_sha256 = compute_cla_sha256(cla_content).lower()
+    if recomputed_sha256 != expected_sha256:
+        click.secho(
+            f"SECURITY ERROR: CLA text digest mismatch!\n"
+            f"Expected:   {expected_sha256}\n"
+            f"Calculated: {recomputed_sha256}\n"
+            "Refusing to sign.",
+            fg="red",
+            bold=True,
+        )
+        raise SystemExit(1)
+
+    # 3. Present agreement text to user
+    click.secho(f"\n=== Ditto Contributor License Agreement ({cla_version}) ===", bold=True)
+    click.echo(cla_content)
+    click.secho(f"==========================================================\n", bold=True)
+    click.echo(f"Version: {cla_version}")
+    click.echo(f"SHA-256: {recomputed_sha256}")
+
+    # 4. Require explicit confirmation
+    if not yes:
+        confirmation = click.prompt(
+            "Type 'I AGREE' to execute the CLA with your miner hotkey",
+            type=str,
+        )
+        if confirmation.strip() != "I AGREE":
+            click.secho("Signing cancelled. You must type 'I AGREE' to execute the CLA.", fg="yellow")
+            raise SystemExit(1)
+
+    # 5. Build message and sign with keypair
+    keypair = Keypair.create_from_uri(keypair_uri)
+    hotkey = keypair.ss58_address
+    nonce = str(uuid.uuid4())
+    issued_at = int(time.time())
+
+    canonical_message = build_cla_signature_message(
+        netuid=netuid,
+        cla_version=cla_version,
+        cla_sha256=recomputed_sha256,
+        hotkey=hotkey,
+        nonce=nonce,
+        issued_at=issued_at,
+    )
+    signature_bytes = keypair.sign(canonical_message.encode("utf-8"))
+    signature_hex = f"0x{signature_bytes.hex()}"
+
+    # 6. Submit signature to Platform
+    sign_url = f"{platform_url.rstrip('/')}/api/v1/cla/sign"
+    payload = {
+        "netuid": netuid,
+        "hotkey": hotkey,
+        "cla_version": cla_version,
+        "cla_sha256": recomputed_sha256,
+        "signature": signature_hex,
+        "nonce": nonce,
+        "issued_at": issued_at,
+    }
+
+    try:
+        with httpx.Client(timeout=10.0) as client:
+            resp = client.post(sign_url, json=payload)
+            resp.raise_for_status()
+            result = resp.json()
+    except httpx.HTTPStatusError as err:
+        click.secho(f"Submission rejected by platform: {err.response.text}", fg="red")
+        raise SystemExit(1)
+    except Exception as exc:
+        click.secho(f"Failed to submit signature: {exc}", fg="red")
+        raise SystemExit(1)
+
+    click.secho(
+        f"Successfully signed CLA {cla_version} for hotkey {hotkey} at {result.get('signed_at')}",
+        fg="green",
+        bold=True,
+    )
