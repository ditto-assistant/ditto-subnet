"""Backroom MCP tool for inspecting CLA gate mode, history, and miner adoption."""

from typing import Any, Dict, List
from sqlalchemy import func
from sqlalchemy.orm import Session

from apps.platform.ditto.api_server.cla_service import get_effective_cla_version
from apps.platform.ditto.api_server.models.cla import (
    CLAGateSetting,
    CLASignature,
)


def get_cla_gate_and_adoption_report(
    db: Session,
    active_hotkeys: List[str] | None = None,
) -> Dict[str, Any]:
    """Generates report on current gate setting, change history, and adoption counts."""
    # 1. Gate settings history
    history_records = (
        db.query(CLAGateSetting)
        .order_by(CLAGateSetting.id.desc())
        .limit(50)
        .all()
    )

    current_mode = history_records[0].mode.value if history_records else "off"
    history = [
        {
            "id": h.id,
            "mode": h.mode.value,
            "updated_at": h.updated_at.isoformat(),
            "updated_by": h.updated_by,
            "notes": h.notes,
        }
        for h in history_records
    ]

    effective_cla = get_effective_cla_version(db)

    # 2. Distinct active hotkeys pool
    if active_hotkeys is None:
        # Resolve from unique hotkeys recorded across signatures or platform state
        active_hotkeys = [
            row[0]
            for row in db.query(CLASignature.hotkey).distinct().all()
        ]

    total_active = len(active_hotkeys)

    # 3. Signed vs Unsigned for effective version
    signed_active = 0
    if total_active > 0:
        signed_hotkeys_set = {
            row[0]
            for row in db.query(CLASignature.hotkey)
            .filter(
                CLASignature.cla_version == effective_cla.version,
                CLASignature.cla_sha256 == effective_cla.sha256,
                CLASignature.hotkey.in_(active_hotkeys),
            )
            .distinct()
            .all()
        }
        signed_active = len(signed_hotkeys_set)

    unsigned_active = max(0, total_active - signed_active)
    adoption_rate = (
        round((signed_active / total_active) * 100, 2) if total_active > 0 else 0.0
    )

    return {
        "gate": {
            "current_mode": current_mode,
            "effective_cla_version": effective_cla.version,
            "effective_cla_sha256": effective_cla.sha256,
            "history": history,
        },
        "adoption": {
            "total_active_hotkeys": total_active,
            "signed_active_hotkeys": signed_active,
            "unsigned_active_hotkeys": unsigned_active,
            "adoption_rate_pct": adoption_rate,
        },
    }
