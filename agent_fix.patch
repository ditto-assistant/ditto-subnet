```python
"""Attestation helpers and cryptographic verification for Platform."""

from __future__ import annotations

import datetime
import secrets
from typing import Any
from bittensor_wallet import Keypair
from ditto.miner_cli.cla_sign_builder import build_cla_sign_message

# 5 minutes freshness window
FRESHNESS_WINDOW_SECONDS = 300


def verify_signature(message: str | bytes, signature: str, public_key: str) -> bool:
    """Verify an sr25519 signature given the message string/bytes and public key ss58."""
    try:
        msg_bytes = message.encode("utf-8") if isinstance(message, str) else message
        keypair = Keypair(ss58_address=public_key)
        sig_bytes = bytes.fromhex(signature) if not signature.startswith("0x") else bytes.fromhex(signature[2:])
        return bool(keypair.verify(msg_bytes, sig_bytes))
    except Exception:
        return False


def verify_cla_signature(
    netuid: int | str,
    cla_version: str,
    cla_sha256: str,
    hotkey: str,
    nonce: str,
    issued_at: int,
    signature: str,
    current_time: int | None = None,
) -> tuple[bool, str | None]:
    """Validate freshness window, reconstruct canonical payload, and verify signature."""
    now = current_time if current_time is not None else int(datetime.datetime.now(datetime.timezone.utc).timestamp())
    if abs(now - issued_at) > FRESHNESS_WINDOW_SECONDS:
        return False, f"Signature timestamp expired or from future (skew > {FRESHNESS_WINDOW_SECONDS}s)"

    expected_msg = build_cla_sign_message(
        netuid=netuid,
        cla_version=cla_version,
        cla_sha256=cla_sha256,
        hotkey=hotkey,
        nonce=nonce,
        issued_at=issued_at,
    )

    if not verify_signature(expected_msg, signature, hotkey):
        return False, "Invalid cryptographic signature for hotkey"

    return True, None


def resolve_coldkey_for_hotkey(hotkey: str, subtensor_client: Any = None) -> str:
    """Resolve Owner(hotkey) at a finalized block. Fallback to mock/hotkey if local/test."""
    if subtensor_client is not None:
        try:
            owner = subtensor_client.get_hotkey_owner(hotkey)
            if owner:
                return str(owner)
        except Exception:
            pass
    # Default fallback: hotkey acts as coldkey or mock
    return hotkey
