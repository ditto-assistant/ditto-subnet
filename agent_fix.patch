# apps/platform/ditto/api_server/endpoints/cla.py
"""Endpoints for CLA registry, status queries, signing, and gate management."""

from __future__ import annotations

from datetime import datetime, timezone
import hashlib
from typing import Any

from fastapi import APIRouter, Depends, HTTPException, Query, status
from pydantic import BaseModel, Field
from sqlalchemy.orm import Session

from apps.platform.ditto.api_server.attestation import (
    build_cla_payload,
    check_attestation_freshness,
    resolve_coldkey_for_hotkey,
    verify_signature,
)
from apps.platform.ditto.db.models.cla import (
    CLAGateSettingHistory,
    CLASignature,
    CLAVersion,
)

router = APIRouter(prefix="/api/v1/cla", tags=["cla"])


def get_db():  # type: ignore[no-untyped-def]
    """FastAPI dependency for database session."""
    raise NotImplementedError("Replaced by app database dependency")


class CLASignRequest(BaseModel):
    netuid: int = 118
    hotkey: str = Field(..., min_length=1)
    cla_version: str = Field(..., min_length=1)
    cla_sha256: str = Field(..., min_length=64, max_length=64)
    signature: str = Field(..., min_length=1)
    nonce: str = Field(..., min_length=1)
    issued_at: int


class CLASignResponse(BaseModel):
    status: str
    hotkey: str
    coldkey: str
    cla_version: str
    cla_sha256: str
    signed_at: datetime


class CLAStatusResponse(BaseModel):
    hotkey: str
    signed: bool
    is_current: bool
    version: str | None = None
    sha256: str | None = None
    signed_at: datetime | None = None
    signature: str | None = None
    coldkey: str | None = None


class CLACurrentResponse(BaseModel):
    version: str
    sha256: str
    published_at: datetime
    effective_at: datetime
    text: str | None = None


def get_active_cla_version(db: Session) -> CLAVersion | None:
    """Return the currently effective CLA version."""
    now = datetime.now(timezone.utc)
    return (
        db.query(CLAVersion)
        .filter(CLAVersion.effective_at <= now)
        .order_by(CLAVersion.effective_at.desc())
        .first()
    )


def get_current_gate_mode(db: Session) -> str:
    """Return current CLA upload gate mode ('off', 'shadow', 'enforce')."""
    setting = (
        db.query(CLAGateSettingHistory)
        .order_by(CLAGateSettingHistory.id.desc())
        .first()
    )
    return setting.mode if setting else "off"


@router.get("/current", response_model=CLACurrentResponse)
def get_current_cla(db: Session = Depends(get_db)) -> Any:
    """Get the currently effective CLA metadata and text."""
    current = get_active_cla_version(db)
    if not current:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail="No effective CLA version registered.",
        )
    return CLACurrentResponse(
        version=current.version,
        sha256=current.sha256,
        published_at=current.published_at,
        effective_at=current.effective_at,
        text=current.text,
    )


@router.get("/status/{hotkey}", response_model=CLAStatusResponse)
def get_cla_status(hotkey: str, db: Session = Depends(get_db)) -> Any:
    """Public read endpoint returning CLA signing status for a hotkey."""
    current = get_active_cla_version(db)
    current_version = current.version if current else None

    # Get the latest signature for this hotkey
    latest_sig = (
        db.query(CLASignature)
        .filter(CLASignature.hotkey == hotkey)
        .order_by(CLASignature.id.desc())
        .first()
    )

    if not latest_sig:
        return CLAStatusResponse(
            hotkey=hotkey,
            signed=False,
            is_current=False,
            version=None,
            sha256=None,
            signed_at=None,
            signature=None,
            coldkey=None,
        )

    is_current = (
        current_version is not None
        and latest_sig.cla_version == current_version
        and (current is None or latest_sig.cla_sha256 == current.sha256)
    )

    return CLAStatusResponse(
        hotkey=hotkey,
        signed=True,
        is_current=is_current,
        version=latest_sig.cla_version,
        sha256=latest_sig.cla_sha256,
        signed_at=latest_sig.signed_at,
        signature=latest_sig.signature,
        coldkey=latest_sig.coldkey,
    )


@router.post("/sign", response_model=CLASignResponse, status_code=status.HTTP_201_CREATED)
def sign_cla(req: CLASignRequest, db: Session = Depends(get_db)) -> Any:
    """Submit a hotkey signature for the CLA."""
    # 1. Freshness window check
    if not check_attestation_freshness(req.issued_at):
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="Attestation timestamp is stale or outside freshness window.",
        )

    # 2. Nonce replay check
    existing_nonce = (
        db.query(CLASignature)
        .filter(CLASignature.nonce == req.nonce)
        .first()
    )
    if existing_nonce:
        raise HTTPException(
            status_code=status.HTTP_409_CONFLICT,
            detail="Nonce has already been used.",
        )

    # 3. CLA version and digest validation
    version_row = (
        db.query(CLAVersion)
        .filter(CLAVersion.version == req.cla_version)
        .first()
    )
    if not version_row:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail=f"CLA version '{req.cla_version}' not found in registry.",
        )

    if version_row.sha256.lower() != req.cla_sha256.lower():
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="Provided CLA SHA-256 digest does not match registered digest.",
        )

    # 4. Signature verification
    expected_payload = build_cla_payload(
        netuid=req.netuid,
        cla_version=req.cla_version,
        cla_sha256=req.cla_sha256,
        hotkey=req.hotkey,
        nonce=req.nonce,
        issued_at=req.issued_at,
    )
    if not verify_signature(
        signature=req.signature,
        message=expected_payload,
        hotkey=req.hotkey,
    ):
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail="Invalid cryptographic signature for hotkey.",
        )

    # 5. Resolve coldkey owner
    coldkey = resolve_coldkey_for_hotkey(req.hotkey)

    # 6. Append-only storage
    record = CLASignature(
        hotkey=req.hotkey,
        coldkey=coldkey,
        cla_version=req.cla_version,
        cla_sha256=req.cla_sha256,
        signature=req.signature,
        nonce=req.nonce,
        issued_at=req.issued_at,
        signed_at=datetime.now(timezone.utc),
    )
    db.add(record)
    db.commit()
    db.refresh(record)

    return CLASignResponse(
        status="success",
        hotkey=record.hotkey,
        coldkey=record.coldkey,
        cla_version=record.cla_version,
        cla_sha256=record.cla_sha256,
        signed_at=record.signed_at,
    )
