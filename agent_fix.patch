    __tablename__ = "cla_gate_settings"

    id = Column(Integer, primary_key=True, autoincrement=True)
    mode = Column(String(32), nullable=False, default="off")  # "off", "shadow", "enforce"
    updated_by = Column(String(128), nullable=False, default="system")
    notes = Column(Text, nullable=True)
    created_at = Column(
        DateTime(timezone=True),
        nullable=False,
        default=lambda: datetime.now(timezone.utc),
    )


@event.listens_for(CLASignature, "before_update")
def _prevent_cla_signature_update(mapper, connection, target):
    raise RuntimeError("CLASignature rows are append-only: updates are forbidden.")


@event.listens_for(CLASignature, "before_delete")
def _prevent_cla_signature_delete(mapper, connection, target):
    raise RuntimeError("CLASignature rows are append-only: deletes are forbidden.")
