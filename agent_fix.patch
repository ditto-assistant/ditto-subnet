### 2. Database Models & SQLAlchemy Event Listeners
`apps/platform/ditto/api_server/models/cla.py`
```python
"""Database models for the Contributor License Agreement (CLA) registry and signatures."""

from datetime import datetime, timezone
import uuid
from sqlalchemy import (
    Column,
    String,
    DateTime,
    Text,
    Integer,
    ForeignKey,
    Index,
    event,
)
from sqlalchemy.orm import declarative_base

Base = declarative_base()


class CLAVersion(Base):
    """Registry of published CLA versions."""

    __tablename__ = "cla_versions"

    version = Column(String(32), primary_key=True)
    sha256 = Column(String(64), nullable=False)
    published_at = Column(
        DateTime(timezone=True),
        nullable=False,
        default=lambda: datetime.now(timezone.utc),
    )
    effective_at = Column(
        DateTime(timezone=True),
        nullable=False,
        default=lambda: datetime.now(timezone.utc),
    )


class CLASignature(Base):
    """Append-only table of hotkey CLA signatures."""

    __tablename__ = "cla_signatures"

    id = Column(String(36), primary_key=True, default=lambda: str(uuid.uuid4()))
    hotkey = Column(String(64), nullable=False, index=True)
    coldkey = Column(String(64), nullable=False, index=True)
    cla_version = Column(String(32), ForeignKey("cla_versions.version"), nullable=False)
    cla_sha256 = Column(String(64), nullable=False)
    signature = Column(Text, nullable=False)
    nonce = Column(String(64), nullable=False, unique=True, index=True)
    issued_at = Column(DateTime(timezone=True), nullable=False)
    signed_at = Column(
        DateTime(timezone=True),
        nullable=False,
        default=lambda: datetime.now(timezone.utc),
    )

    __table_args__ = (
        Index("ix_cla_signatures_hotkey_version", "hotkey", "cla_version"),
    )


@event.listens_for(CLASignature, "before_update")
def prevent_cla_signature_update(mapper, connection, target):
    raise ValueError("CLASignature is append-only: updates are prohibited.")


@event.listens_for(CLASignature, "before_delete")
def prevent_cla_signature_delete(mapper, connection, target):
    raise ValueError("CLASignature is append-only: deletes are prohibited.")


class CLAGateSettingHistory(Base):
    """Audit log of gate rollout settings (off -> shadow -> enforce)."""

    __tablename__ = "cla_gate_settings_history"

    id = Column(Integer, primary_key=True, autoincrement=True)
    mode = Column(String(16), nullable=False)  # off, shadow, enforce
    changed_by = Column(String(64), nullable=False, default="operator")
    reason = Column(String(255), nullable=True)
    changed_at = Column(
        DateTime(timezone=True),
        nullable=False,
        default=lambda: datetime.now(timezone.utc),
    )
```

