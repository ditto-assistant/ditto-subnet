### 7. Miner CLI: `ditto cla sign` and `ditto cla status`

`ditto/miner_cli/cla.py`:
```python
import hashlib
import time
import uuid
import sys
import httpx
from rich.console import Console
from rich.panel import Panel
from apps.platform.ditto.api_server.cla import build_cla_sign_message

console = Console()


def get_platform_url(config) -> str:
    return getattr(config, "platform_url", "http://localhost:8000").rstrip("/")


def get_netuid(config) -> int:
    return getattr(config, "netuid", 118)


def cla_status_cli(wallet, config):
    hotkey = wallet.hotkey.ss58_address
    url = f"{get_platform_url(config)}/api/v1/cla/status/{hotkey}"
    try:
        resp = httpx.get(url, timeout=10.0)
        resp.raise_for_status()
        data = resp.json()
    except Exception as e:
        console.print(f"[bold red]Failed to fetch CLA status:[/bold red] {e}")
        sys.exit(1)

    signed_ver = data.get("signed_version") or "None"
    is_current = data.get("is_current", False)
    signed_at = data.get("signed_at") or "N/A"
    current_ver = data.get("current_cla_version") or "Unknown"

    status_str = "[green]CURRENT[/green]" if is_current else "[yellow]OUTDATED OR UNSIGNED[/yellow]"
    console.print(
        Panel(
            f"[bold]Hotkey:[/bold] {hotkey}\n"
            f"[bold]Signed Version:[/bold] {signed_ver}\n"
            f"[bold]Current Version:[/bold] {current_ver}\n"
            f"[bold]Status:[/bold] {status_str}\n"
            f"[bold]Signed At:[/bold] {signed_at}",
            title="CLA Status",
        )
    )


def cla_sign_cli(wallet, config):
    hotkey = wallet.hotkey.ss58_address
    netuid = get_netuid(config)
    platform_url = get_platform_url(config)

    # 1. Fetch current CLA details from Platform
    try:
        resp = httpx.get(f"{platform_url}/api/v1/cla/current", timeout=10.0)
        resp.raise_for_status()
        cla_info = resp.json()
    except Exception as e:
        console.print(f"[bold red]Failed to fetch current CLA details from platform:[/bold red] {e}")
        sys.exit(1)

    cla_version = cla_info["version"]
    expected_sha256 = cla_info["sha256"]
    cla_text = cla_info.get("text") or ""

    # 2. Verify digest
    computed_sha256 = hashlib.sha256(cla_text.encode("utf-8")).hexdigest()
    if computed_sha256.lower() != expected_sha256.lower():
        console.print(
            f"[bold red]CLA Digest Mismatch![/bold red]\n"
            f"Expected SHA-256: {expected_sha256}\n"
            f"Computed SHA-256: {computed_sha256}\n"
            f"Refusing to sign mismatched text."
        )
        sys.exit(1)

    # 3. Present CLA and ask for explicit confirmation
    console.print(Panel(cla_text[:1000] + ("..." if len(cla_text) > 1000 else ""), title=f"CLA {cla_version}"))
    console.print(f"[bold cyan]CLA SHA-256:[/bold cyan] {computed_sha256}")
    console.print(f"[bold yellow]Signing as Hotkey:[/bold yellow] {hotkey}")
    
    confirm = input("Type 'I AGREE' to sign the Contributor License Agreement: ").strip()
    if confirm != "I AGREE":
        console.print("[red]Signing cancelled. You must type 'I AGREE' to confirm.[/red]")
        sys.exit(1)

    # 4. Generate nonce and issued_at
    nonce = uuid.uuid4().hex
    issued_at = int(time.time())

    # 5. Build signed-action message
    message = build_cla_sign_message(
        netuid=netuid,
        cla_version=cla_version,
        cla_sha256=computed_sha256,
        hotkey=hotkey,
        nonce=nonce,
        issued_at=issued_at,
    )

    # 6. Sign using hotkey sr25519
    signature_bytes = wallet.hotkey.sign(message.encode("utf-8"))
    signature = "0x" + signature_bytes.hex()

    # 7. Submit to platform
    payload = {
        "netuid": netuid,
        "cla_version": cla_version,
        "cla_sha256": computed_sha256,
        "hotkey": hotkey,
        "nonce": nonce,
        "issued_at": issued_at,
        "signature": signature,
    }

    try:
        sign_resp = httpx.post(f"{platform_url}/api/v1/cla/sign", json=payload, timeout=10.0)
        sign_resp.raise_for_status()
        console.print(f"[bold green]Successfully signed CLA {cla_version} for hotkey {hotkey}![/bold green]")
    except Exception as e:
        console.print(f"[bold red]Failed to submit signature to platform:[/bold red] {e}")
        sys.exit(1)
```

