### 4. Attestation & Signature Verification: `apps/platform/ditto/api_server/attestation.py`

```python
import time
from typing import Optional
from substrateinterface import Keypair
from substrateinterface.utils.ss58 import is_valid_ss58_address

# Freshness window in seconds (10 minutes)
SIGNATURE_FRESHNESS_WINDOW = 600


def build_cla_message(
    netuid: int,
    cla_version: str,
    cla_sha256: str,
    hotkey: str,
    nonce: str,
    issued_at: int,
) -> bytes:
    """Byte-for-byte mirrored builder for CLA signature payloads."""
    return f"ditto-cla:v1:{netuid}:{cla_version}:{cla_sha256}:{hotkey}:{nonce}:{issued_at}".encode("utf-8")


def verify_signature(
    message: bytes,
    signature: str,
    hotkey: str,
) -> bool:
    """Verifies an sr25519 signature from a hotkey against a message."""
    try:
        if not is_valid_ss58_address(hotkey):
            return False

        sig_hex = signature[2:] if signature.startswith("0x") else signature
        sig_bytes = bytes.fromhex(sig_hex)

        keypair = Keypair(ss58_address=hotkey)
        return bool(keypair.verify(message, sig_bytes))
    except Exception:
        return False


def verify_timestamp_freshness(
    issued_at: int,
    freshness_window: int = SIGNATURE_FRESHNESS_WINDOW,
    current_time: Optional[int] = None,
) -> bool:
    """Ensures issued_at timestamp is within freshness window."""
    now = current_time if current_time is not None else int(time.time())
    return abs(now - issued_at) <= freshness_window


def resolve_coldkey_for_hotkey(hotkey: str, subtensor_client=None) -> str:
    """
    Resolves Owner(hotkey) at finalized block.
    Falls back to coldkey lookup or mock environment mapping if chain client not configured.
    """
    if subtensor_client is not None:
        try:
            coldkey = subtensor_client.get_hotkey_owner(hotkey)
            if coldkey:
                return str(coldkey)
        except Exception:
            pass

    # Default fallback when running without a live subtensor network
    return f"coldkey-{hotkey[:8]}"
