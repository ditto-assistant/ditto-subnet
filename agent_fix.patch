# apps/platform/ditto/backroom/tools/cla.py
from datetime import datetime, timezone
from typing import Any
from sqlalchemy.orm import Session

from apps.platform.ditto.api_server.cla import (
    get_cla_gate_mode,
    get_cla_shadow_unsigned_count,
    get_current_effective_cla_version,
)
from apps.platform.ditto.db.models.cla import CLAGateSetting, CLASignature


def get_cla_gate_status(db: Session) -> dict[str, Any]:
    """
    Backroom read tool reporting CLA gate mode, audit history, and miner adoption counts.
    """
    current_mode = get_cla_gate_mode(db)
    history_records = (
        db.query(CLAGateSetting)
        .order_by(CLAGateSetting.created_at.desc(), CLAGateSetting.id.desc())
        .all()
    )
    history = [
        {
            "id": h.id,
            "mode": h.mode,
            "updated_by": h.updated_by,
            "notes": h.notes,
            "created_at": h.created_at.isoformat() if h.created_at else None,
        }
        for h in history_records
    ]

    current_cla = get_current_effective_cla_version(db)
    current_version = current_cla.version if current_cla else None
    current_sha256 = current_cla.sha256 if current_cla else None

    # Discover hotkeys known to the platform
    all_hotkeys: set[str] = set()
    for (hk,) in db.query(CLASignature.hotkey).distinct().all():
        if hk:
            all_hotkeys.add(hk)

    try:
        from apps.platform.ditto.db.models import Agent
        for (hk,) in db.query(Agent.hotkey).distinct().all():
            if hk:
                all_hotkeys.add(hk)
    except Exception:
        pass

    signed_hotkeys: set[str] = set()
    if current_version and current_sha256:
        for (hk,) in (
            db.query(CLASignature.hotkey)
            .filter(
                CLASignature.cla_version == current_version,
                CLASignature.cla_sha256 == current_sha256,
            )
            .distinct()
            .all()
        ):
            if hk:
                signed_hotkeys.add(hk)

    active_count = len(all_hotkeys)
    signed_count = len(signed_hotkeys)
    unsigned_count = max(0, active_count - signed_count)
    adoption_rate = round(signed_count / active_count, 4) if active_count > 0 else 0.0

    return {
        "gate_mode": current_mode,
        "current_mode": current_mode,
        "history": history,
        "current_cla_version": current_version,
        "current_cla_sha256": current_sha256,
        "active_hotkeys_count": active_count,
        "signed_active_hotkeys_count": signed_count,
        "unsigned_active_hotkeys_count": unsigned_count,
        "adoption_rate": adoption_rate,
        "shadow_unsigned_count": get_cla_shadow_unsigned_count(),
    }
