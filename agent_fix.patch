### 5. Signature Verification and Owner Resolution: `apps/platform/ditto/api_server/attestation.py`

```python
"""Attestation, signature verification, and owner lookup for platform API."""

from __future__ import annotations

import datetime
from substrateinterface import Keypair

# Owner freshness window: 300 seconds (5 minutes)
FRESHNESS_WINDOW_SECONDS = 300


def verify_signature(message: str | bytes, signature: str | bytes, hotkey: str) -> bool:
    """Verify an sr25519 signature from a hotkey SS58 address."""
    try:
        data = message.encode("utf-8") if isinstance(message, str) else message
        sig_bytes = (
            bytes.fromhex(signature[2:] if signature.startswith("0x") else signature)
            if isinstance(signature, str)
            else signature
        )
        keypair = Keypair(ss58_address=hotkey)
        return bool(keypair.verify(data, sig_bytes))
    except Exception:
        return False


def resolve_coldkey_for_hotkey(hotkey: str, subtensor=None) -> str:
    """Resolve Owner(hotkey) at a finalized block on Subtensor."""
    if subtensor is not None:
        try:
            owner = subtensor.get_hotkey_owner(hotkey)
            if owner:
                return str(owner)
        except Exception:
            pass
    # If not on-chain or mock fallback, default to hotkey
    return hotkey


def is_timestamp_fresh(issued_at_timestamp: float | int, max_window_seconds: int = FRESHNESS_WINDOW_SECONDS) -> bool:
    """Check that issued_at falls within the acceptable freshness window."""
    now = datetime.datetime.utcnow().timestamp()
    return abs(now - float(issued_at_timestamp)) <= max_window_seconds
