### 6. Submission Gate Integration: `apps/platform/ditto/api_server/endpoints/upload.py`

```python
"""Upload endpoint gating for CLA verification."""

from datetime import datetime, timezone
import logging
from fastapi import APIRouter, Depends, HTTPException, status
from pydantic import BaseModel
from sqlalchemy.orm import Session

from apps.platform.ditto.db.cla_models import (
    ClaVersion,
    ClaSignature,
    ClaGateSetting,
    ClaShadowUploadLog,
)

logger = logging.getLogger(__name__)

# Assume existing router and dependencies
try:
    from apps.platform.ditto.api_server.deps import get_db
except ImportError:
    def get_db():
        raise NotImplementedError


def enforce_cla_gate(db: Session, hotkey: str, endpoint_name: str) -> None:
    """
    Evaluates the CLA submission gate for the hotkey according to platform mode.
    Modes:
      - 'off': no check performed.
      - 'shadow': log and count unsigned uploads, but accept them.
      - 'enforce': refuse unsigned hotkeys with HTTP 403 directing miner to 'ditto cla sign'.
    """
    setting = db.query(ClaGateSetting).order_by(ClaGateSetting.id.desc()).first()
    mode = (setting.mode if setting else "off").lower()

    if mode == "off":
        return

    now = datetime.now(timezone.utc)
    current_cla = (
        db.query(ClaVersion)
        .filter(ClaVersion.effective_at <= now)
        .order_by(ClaVersion.effective_at.desc())
        .first()
    )
    if not current_cla:
        return

    valid_sig = (
        db.query(ClaSignature)
        .filter(
            ClaSignature.hotkey == hotkey,
            ClaSignature.cla_version == current_cla.version,
            ClaSignature.cla_sha256 == current_cla.sha256,
        )
        .first()
    )

    if valid_sig:
        return

    # Hotkey has not signed the currently effective CLA
    if mode == "shadow":
        logger.warning(
            "CLA shadow mode: unsigned upload allowed for hotkey %s on %s",
            hotkey,
            endpoint_name,
        )
        log_entry = ClaShadowUploadLog(
            hotkey=hotkey,
            endpoint=endpoint_name,
            attempted_at=now,
        )
        db.add(log_entry)
        db.commit()
        return

    if mode == "enforce":
        logger.info("CLA gate enforced: rejecting unsigned hotkey %s on %s", hotkey, endpoint_name)
        raise HTTPException(
            status_code=status.HTTP_403_FORBIDDEN,
            detail=(
                f"CLA not signed for the currently effective version ({current_cla.version}). "
                "Run `ditto cla sign` to sign the CLA before submitting."
            ),
        )


# Hook into upload endpoints:
# In POST /api/v1/upload/check:
#     enforce_cla_gate(db, request.hotkey, "/api/v1/upload/check")
# In POST /api/v1/upload/agent:
#     enforce_cla_gate(db, hotkey, "/api/v1/upload/agent")
