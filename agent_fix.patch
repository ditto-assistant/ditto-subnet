# tests/platform/test_cla_backroom.py
"""Tests for Backroom MCP tool reporting CLA gate mode, audit history, and adoption counts."""

from datetime import datetime, timezone
import pytest
from sqlalchemy import create_engine
from sqlalchemy.orm import sessionmaker

from apps.platform.ditto.backroom.cla_tool import (
    get_cla_gate_status_report,
)
from apps.platform.ditto.db.models.cla import (
    Base,
    CLAGateSettingHistory,
    CLASignature,
    CLAVersion,
)


def test_backroom_cla_tool_report():
    engine = create_engine("sqlite:///:memory:")
    Base.metadata.create_all(engine)
    Session = sessionmaker(bind=engine)
    db = Session()

    # 1. Add version
    v1 = CLAVersion(
        version="v1",
        sha256="abc123sha",
        published_at=datetime.now(timezone.utc),
        effective_at=datetime.now(timezone.utc),
    )
    db.add(v1)

    # 2. Add setting history: off -> shadow
    db.add(
        CLAGateSettingHistory(
            mode="off", changed_by="genesis", notes="initial"
        )
    )
    db.add(
        CLAGateSettingHistory(
            mode="shadow", changed_by="operator1", notes="testing adoption"
        )
    )

    # 3. Add active signatures
    db.add(
        CLASignature(
            hotkey="hotkey_signed",
            coldkey="cold_1",
            cla_version="v1",
            cla_sha256="abc123sha",
            signature="0x111",
            nonce="nonce_1",
            issued_at=1700000000,
            signed_at=datetime.now(timezone.utc),
        )
    )
    db.commit()

    active_hotkeys = ["hotkey_signed", "hotkey_unsigned_1", "hotkey_unsigned_2"]
    report = get_cla_gate_status_report(db, active_hotkeys=active_hotkeys)

    assert report["gate_mode"] == "shadow"
    assert report["current_cla_version"] == "v1"
    assert len(report["setting_history"]) == 2
    assert report["adoption"]["total_active_hotkeys"] == 3
    assert report["adoption"]["signed_active_hotkeys"] == 1
    assert report["adoption"]["unsigned_active_hotkeys"] == 2
    assert report["adoption"]["adoption_percentage"] == pytest.approx(
        33.33, rel=1e-2
    )

    db.close()
