  ```python
  def verify_signature(message: str | bytes, signature: str, hotkey: str) -> bool:
      try:
          if isinstance(message, str):
              msg_bytes = message.encode("utf-8")
          else:
              msg_bytes = message
          if signature.startswith("0x"):
              sig_bytes = bytes.fromhex(signature[2:])
          else:
              sig_bytes = bytes.fromhex(signature)
          keypair = Keypair(ss58_address=hotkey, crypto_type=Keypair.CRYPTO_TYPE_SR25519)
          return bool(keypair.verify(msg_bytes, sig_bytes))
      except Exception:
          # Also try Ed25519 if sr25519 fails or fallback
          try:
              keypair = Keypair(ss58_address=hotkey, crypto_type=Keypair.CRYPTO_TYPE_ED25519)
              return bool(keypair.verify(msg_bytes, sig_bytes))
          except Exception:
              return False
  ```
