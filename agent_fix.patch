def test_upload_gate_modes(client, db_session, signer_keypair):
    cla_v1 = register_cla_version(db_session, version="v1", text="CLA V1 Text")
    unsigned_hotkey = "5GrwvaEF5zXb26Fz9rcQpDWS57CtERHpNehXCPcNoHGKutQY"

    # Mode 1: 'off' -> unsigned upload accepted
    set_cla_gate_mode(db_session, "off")
    res_off = client.post("/api/v1/upload/check", json={"hotkey": unsigned_hotkey})
    assert res_off.status_code == 200

    # Mode 2: 'shadow' -> unsigned upload accepted, tracked
    set_cla_gate_mode(db_session, "shadow")
    res_shadow = client.post("/api/v1/upload/check", json={"hotkey": unsigned_hotkey})
    assert res_shadow.status_code == 200

    # Mode 3: 'enforce' -> unsigned upload refused with pointer to ditto cla sign
    set_cla_gate_mode(db_session, "enforce")
    res_enforce = client.post("/api/v1/upload/check", json={"hotkey": unsigned_hotkey})
    assert res_enforce.status_code == 403
    assert "ditto cla sign" in res_enforce.json()["detail"]

    # Sign v1
    now_ts = int(time.time())
    payload = build_cla_signature_payload(
        netuid=118,
        cla_version="v1",
        cla_sha256=cla_v1.sha256,
        hotkey=signer_keypair.ss58_address,
        nonce="upload_nonce_1",
        issued_at=now_ts,
    )
    sig = f"0x{signer_keypair.sign(payload.encode('utf-8')).hex()}"
    client.post(
        "/api/v1/cla/sign",
        json={
            "hotkey": signer_keypair.ss58_address,
            "cla_version": "v1",
            "cla_sha256": cla_v1.sha256,
            "signature": sig,
            "nonce": "upload_nonce_1",
            "issued_at": now_ts,
            "netuid": 118,
        },
    )

    # Signed hotkey passes enforce check
    res_signed = client.post("/api/v1/upload/check", json={"hotkey": signer_keypair.ss58_address})
    assert res_signed.status_code == 200

    # Publish v2: signed v1 is now outdated, gate refuses until re-signed
    register_cla_version(db_session, version="v2", text="CLA V2 New Terms")
    res_outdated = client.post("/api/v1/upload/check", json={"hotkey": signer_keypair.ss58_address})
    assert res_outdated.status_code == 403
    assert "ditto cla sign" in res_outdated.json()["detail"]


