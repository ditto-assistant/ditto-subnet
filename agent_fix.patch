### 7. Backroom MCP Tool

`apps/platform/ditto/backroom/tools/cla.py`
```python
"""Backroom MCP tool for inspecting CLA gate rollout setting, history, and adoption."""

from __future__ import annotations

from typing import Any
from sqlalchemy import distinct, func
from sqlalchemy.orm import Session

from apps.platform.ditto.api_server.endpoints.cla import get_current_cla_version
from apps.platform.ditto.db.models.cla import CLAGateSetting, CLASignature


def get_cla_gate_status_tool(db: Session, active_hotkeys: list[str] | None = None) -> dict[str, Any]:
    """MCP read tool returning current gate setting, change history, and miner adoption statistics."""
    # 1. Gate setting and history
    history_records = (
        db.query(CLAGateSetting)
        .order_by(CLAGateSetting.changed_at.desc())
        .all()
    )
    current_mode = history_records[0].mode if history_records else "off"

    history = [
        {
            "mode": r.mode,
            "changed_at": r.changed_at.isoformat(),
            "changed_by": r.changed_by,
        }
        for r in history_records
    ]

    # 2. CLA version info
    current_cla = get_current_cla_version(db)
    current_version_str = current_cla.version if current_cla else None

    # 3. Adoption metrics
    total_unique_signers = (
        db.query(func.count(distinct(CLASignature.hotkey))).scalar() or 0
    )
    current_version_signers = 0
    if current_version_str:
        current_version_signers = (
            db.query(func.count(distinct(CLASignature.hotkey)))
            .filter(CLASignature.cla_version == current_version_str)
            .scalar()
            or 0
        )

    # If active hotkeys on-chain are provided:
    adoption_stats: dict[str, Any] = {
        "total_historical_signers": total_unique_signers,
        "current_version_signers": current_version_signers,
    }

    if active_hotkeys is not None:
        active_set = set(active_hotkeys)
        signed_active_query = (
            db.query(CLASignature.hotkey)
            .filter(
                CLASignature.hotkey.in_(active_set),
                CLASignature.cla_version == current_version_str,
            )
            .all()
        )
        signed_active_count = len({row[0] for row in signed_active_query})
        unsigned_active_count = max(0, len(active_set) - signed_active_count)
        pct = (signed_active_count / len(active_set) * 100.0) if active_set else 0.0

        adoption_stats.update({
            "active_hotkeys_count": len(active_set),
            "signed_active_hotkeys": signed_active_count,
            "unsigned_active_hotkeys": unsigned_active_count,
            "adoption_percentage": round(pct, 2),
        })

    return {
        "current_gate_mode": current_mode,
        "current_cla_version": current_version_str,
        "history": history,
        "adoption": adoption_stats,
    }
