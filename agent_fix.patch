    op.create_index("ix_cla_signatures_hotkey", "cla_signatures", ["hotkey"])
    op.create_index("ix_cla_signatures_coldkey", "cla_signatures", ["coldkey"])
    op.create_index("ix_cla_signatures_hotkey_version", "cla_signatures", ["hotkey", "cla_version"])

    op.create_table(
        "cla_gate_settings_history",
        sa.Column("id", sa.Integer(), primary_key=True, autoincrement=True),
        sa.Column("mode", sa.String(length=16), nullable=False),
        sa.Column("changed_by", sa.String(length=64), nullable=False),
        sa.Column("reason", sa.String(length=255), nullable=True),
        sa.Column("changed_at", sa.DateTime(timezone=True), nullable=False),
    )

    # Database-level trigger to enforce append-only guarantees on PostgreSQL
    bind = op.get_bind()
    if bind.dialect.name == "postgresql":
        op.execute("""
            CREATE OR REPLACE FUNCTION prevent_cla_signature_mutation()
            RETURNS TRIGGER AS $$
            BEGIN
                RAISE EXCEPTION 'cla_signatures is append-only: updates and deletes are forbidden';
            END;
            $$ LANGUAGE plpgsql;

            CREATE TRIGGER trg_cla_signatures_prevent_mutation
            BEFORE UPDATE OR DELETE ON cla_signatures
            FOR EACH ROW
            EXECUTE FUNCTION prevent_cla_signature_mutation();
        """)


def downgrade() -> None:
    bind = op.get_bind()
    if bind.dialect.name == "postgresql":
        op.execute("DROP TRIGGER IF EXISTS trg_cla_signatures_prevent_mutation ON cla_signatures;")
        op.execute("DROP FUNCTION IF EXISTS prevent_cla_signature_mutation();")

    op.drop_table("cla_gate_settings_history")
    op.drop_table("cla_signatures")
    op.drop_table("cla_versions")
