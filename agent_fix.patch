### 9. Comprehensive Tests

#### `tests/test_cla.py`

```python
import hashlib
import time
import uuid
import pytest
from datetime import datetime, timezone, timedelta
from sqlalchemy import create_engine
from sqlalchemy.orm import sessionmaker

from apps.platform.ditto.models.base import Base
from apps.platform.ditto.models.cla import CLAVersion, CLASignature, CLAGateSetting
from apps.platform.ditto.api_server.cla_payload import build_cla_sign_payload
from apps.platform.ditto.api_server.services.cla_service import (
    verify_and_store_signature,
    verify_hotkey_gate,
)
from apps.platform.ditto.backroom.tools.cla_tool import get_cla_gate_status_and_adoption
from fastapi import HTTPException


class DummyKeypair:
    def __init__(self, ss58_address: str):
        self.ss58_address = ss58_address

    def sign(self, message: bytes) -> bytes:
        return b"mock_sig_for_" + message[:16]


@pytest.fixture
def db_session(monkeypatch):
    engine = create_engine("sqlite:///:memory:")
    Base.metadata.create_all(engine)
    Session = sessionmaker(bind=engine)
    session = Session()

    # Seed CLA fixture
    fixture_text = "# Contributor License Agreement (CLA) - v1\nFixture text."
    fixture_sha = hashlib.sha256(fixture_text.encode("utf-8")).hexdigest()

    v1 = CLAVersion(
        version="v1",
        sha256=fixture_sha,
        text=fixture_text,
        published_at=datetime.now(timezone.utc) - timedelta(days=2),
        effective_at=datetime.now(timezone.utc) - timedelta(days=1),
    )
    session.add(v1)

    gate = CLAGateSetting(mode="off", changed_by="test", reason="init")
    session.add(gate)
    session.commit()

    # Mock signature verification
    def fake_verify(message, signature, ss58_address):
        return signature.startswith("0xmock_sig_for_") and ss58_address.startswith("5")

    monkeypatch.setattr("apps.platform.ditto.api_server.services.cla_service.verify_signature", fake_verify)

    yield session
    session.close()


def test_append_only_guarantee(db_session):
    sig = CLASignature(
        hotkey="5Hotkey1",
        coldkey="5Coldkey1",
        cla_version="v1",
        cla_sha256="abc",
        signature="0x123",
        nonce="nonce_1",
        issued_at=int(time.time()),
        signed_at=datetime.now(timezone.utc),
    )
    db_session.add(sig)
    db_session.commit()

    # Update attempt must fail
    sig.cla_version = "v2"
    with pytest.raises(Exception, match="append-only"):
        db_session.commit()

    db_session.rollback()

    # Delete attempt must fail
    db_session.delete(sig)
    with pytest.raises(Exception, match="append-only"):
        db_session.commit()


def test_signature_verification_and_storage(db_session):
    hotkey = "5TestMiner111"
    cla = db_session.query(CLAVersion).filter(CLAVersion.version == "v1").first()
    nonce = uuid.uuid4().hex
    now = int(time.time())

    kp = DummyKeypair(hotkey)
    payload = build_cla_sign_payload(118, "v1", cla.sha256, hotkey, nonce, now)
    sig_hex = "0x" + kp.sign(payload).hex()

    saved = verify_and_store_signature(
        db=db_session,
        netuid=118,
        cla_version="v1",
        cla_sha256=cla.sha256,
        hotkey=hotkey,
        nonce=nonce,
        issued_at=now,
        signature_hex=sig_hex,
    )
    assert saved.hotkey == hotkey
    assert saved.cla_version == "v1"


def test_stale_timestamp_and_nonce_replay(db_session):
    hotkey = "5TestMiner111"
    cla = db_session.query(CLAVersion).filter(CLAVersion.version == "v1").first()
    nonce = uuid.uuid4().hex

    # Stale timestamp
    with pytest.raises(HTTPException, match="Stale issued_at"):
        verify_and_store_signature(
            db=db_session,
            netuid=118,
            cla_version="v1",
            cla_sha256=cla.sha256,
            hotkey=hotkey,
            nonce=nonce,
            issued_at=int(time.time()) - 2000,
            signature_hex="0xmock_sig_for_123",
        )

    # Valid save
    now = int(time.time())
    kp = DummyKeypair(hotkey)
    payload = build_cla_sign_payload(118, "v1", cla.sha256, hotkey, nonce, now)
    sig_hex = "0x" + kp.sign(payload).hex()
    verify_and_store_signature(
        db=db_session,
        netuid=118,
        cla_version="v1",
        cla_sha256=cla.sha256,
        hotkey=hotkey,
        nonce=nonce,
        issued_at=now,
        signature_hex=sig_hex,
    )

    # Replayed nonce must fail
    with pytest.raises(HTTPException, match="Replayed nonce"):
        verify_and_store_signature(
            db=db_session,
            netuid=118,
            cla_version="v1",
            cla_sha256=cla.sha256,
            hotkey=hotkey,
            nonce=nonce,
            issued_at=now,
            signature_hex=sig_hex,
        )


def test_upload_gate_modes(db_session):
    hotkey = "5UnsignedMiner"

    # Mode 1: Off -> passes
    verify_hotkey_gate(db_session, hotkey)

    # Mode 2: Shadow -> logs and passes
    db_session.add(CLAGateSetting(mode="shadow", changed_by="test"))
    db_session.commit()
    verify_hotkey_gate(db_session, hotkey)

    # Mode 3: Enforce -> refuses unsigned
    db_session.add(CLAGateSetting(mode="enforce", changed_by="test"))
    db_session.commit()
    with pytest.raises(HTTPException, match="CLA signature required"):
        verify_hotkey_gate(db_session, hotkey)

    # Sign CLA -> now passes under enforce
    cla = db_session.query(CLAVersion).filter(CLAVersion.version == "v1").first()
    now = int(time.time())
    kp = DummyKeypair(hotkey)
    nonce = uuid.uuid4().hex
    payload = build_cla_sign_payload(118, "v1", cla.sha256, hotkey, nonce, now)
    verify_and_store_signature(
        db=db_session,
        netuid=118,
        cla_version="v1",
        cla_sha256=cla.sha256,
        hotkey=hotkey,
        nonce=nonce,
        issued_at=now,
        signature_hex="0x" + kp.sign(payload).hex(),
    )
    verify_hotkey_gate(db_session, hotkey)

    # Publish v2 effective now -> hotkey must sign again
    v2 = CLAVersion(
        version="v2",
        sha256="v2hash",
        text="CLA v2 text",
        published_at=datetime.now(timezone.utc),
        effective_at=datetime.now(timezone.utc) - timedelta(minutes=1),
    )
    db_session.add(v2)
    db_session.commit()

    with pytest.raises(HTTPException, match="CLA signature required for version v2"):
        verify_hotkey_gate(db_session, hotkey)


def test_backroom_mcp_tool(db_session):
    status_report = get_cla_gate_status_and_adoption(
        db=db_session, active_hotkeys=["5Active1", "5Active2"]
    )
    assert status_report["gate_mode"] == "off"
    assert status_report["current_cla_version"] == "v1"
    assert len(status_report["history"]) >= 1
    assert status_report["adoption"]["active_hotkeys_total"] == 2
