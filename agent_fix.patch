import datetime
import hashlib
import time
from typing import Optional, List
from fastapi import APIRouter, Depends, HTTPException, status
from pydantic import BaseModel, Field
from sqlalchemy.orm import Session

from apps.platform.ditto.api_server.attestation import (
    build_cla_message,
    verify_signature,
    verify_timestamp_freshness,
    resolve_coldkey_for_hotkey,
)
from apps.platform.ditto.db.models import (
    CLAVersion,
    CLASignature,
    CLAGateSetting,
    CLAGateSettingHistory,
)
from apps.platform.ditto.db.session import get_db

router = APIRouter(prefix="/api/v1/cla", tags=["cla"])

DEFAULT_NETUID = 118


class CLAVersionResponse(BaseModel):
    version: str
    sha256: str
    published_at: datetime.datetime
    effective_at: datetime.datetime
    text: str
    is_current: bool


class CLASignRequest(BaseModel):
    hotkey: str
    cla_version: str
    cla_sha256: str
    nonce: str
    issued_at: int
    signature: str
    netuid: int = DEFAULT_NETUID


class CLASignResponse(BaseModel):
    success: bool
    hotkey: str
    coldkey: str
    cla_version: str
    signed_at: datetime.datetime


class CLAStatusResponse(BaseModel):
    hotkey: str
    signed: bool
    is_current: bool
    version: Optional[str] = None
    digest: Optional[str] = None
    signed_at: Optional[datetime.datetime] = None
    signature: Optional[str] = None


class CLAGateModeUpdate(BaseModel):
    mode: str = Field(..., regex="^(off|shadow|enforce)$")
    changed_by: Optional[str] = "admin"
    reason: Optional[str] = None


class CLANewVersionRequest(BaseModel):
    version: str
    text: str
    make_current: bool = True


@router.get("/current", response_model=CLAVersionResponse)
def get_current_cla(db: Session = Depends(get_db)):
    """Public read endpoint to fetch currently effective CLA text and digest."""
    cla = db.query(CLAVersion).filter(CLAVersion.is_current == True).order_by(CLAVersion.effective_at.desc()).first()
    if not cla:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail="No active CLA version found.")
    return CLAVersionResponse(
        version=cla.version,
        sha256=cla.sha256,
        published_at=cla.published_at,
        effective_at=cla.effective_at,
        text=cla.text,
        is_current=cla.is_current,
    )


@router.post("/sign", response_model=CLASignResponse)
def sign_cla(request: CLASignRequest, db: Session = Depends(get_db)):
    """Verifies and stores append-only signature for a CLA version."""
    cla = db.query(CLAVersion).filter(CLAVersion.version == request.cla_version).first()
    if not cla:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail="CLA version not registered.")

    if cla.sha256.lower() != request.cla_sha256.lower():
        raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail="CLA digest mismatch.")

    if not verify_timestamp_freshness(request.issued_at):
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="Timestamp is outside the freshness window.",
        )

    # Check nonce uniqueness
    existing_nonce = db.query(CLASignature).filter(CLASignature.nonce == request.nonce).first()
    if existing_nonce:
        raise HTTPException(status_code=status.HTTP_409_CONFLICT, detail="Nonce has already been used.")

    # Reconstruct message
    msg = build_cla_message(
        netuid=request.netuid,
        cla_version=request.cla_version,
        cla_sha256=request.cla_sha256,
        hotkey=request.hotkey,
        nonce=request.nonce,
        issued_at=request.issued_at,
    )

    if not verify_signature(msg, request.signature, request.hotkey):
        raise HTTPException(status_code=status.HTTP_401_UNAUTHORIZED, detail="Invalid signature.")

    coldkey = resolve_coldkey_for_hotkey(request.hotkey)

    sig_record = CLASignature(
        hotkey=request.hotkey,
        coldkey=coldkey,
        cla_version=request.cla_version,
        cla_sha256=request.cla_sha256,
        signature=request.signature,
        nonce=request.nonce,
        issued_at=request.issued_at,
    )
    db.add(sig_record)
    db.commit()
    db.refresh(sig_record)

    return CLASignResponse(
        success=True,
        hotkey=sig_record.hotkey,
        coldkey=sig_record.coldkey,
        cla_version=sig_record.cla_version,
        signed_at=sig_record.signed_at,
    )


@router.get("/status/{hotkey}", response_model=CLAStatusResponse)
def get_cla_status(hotkey: str, db: Session = Depends(get_db)):
    """Public read endpoint returning hotkey's CLA status, version, digest, signed_at, and signature."""
    current_cla = db.query(CLAVersion).filter(CLAVersion.is_current == True).order_by(CLAVersion.effective_at.desc()).first()

    # Find most recent signature for this hotkey
    latest_sig = db.query(CLASignature).filter(CLASignature.hotkey == hotkey).order_by(CLASignature.id.desc()).first()

    if not latest_sig:
        return CLAStatusResponse(
            hotkey=hotkey,
            signed=False,
            is_current=False,
            version=None,
            digest=None,
            signed_at=None,
            signature=None,
        )

    is_current = bool(current_cla and (latest_sig.cla_version == current_cla.version))

    return CLAStatusResponse(
        hotkey=hotkey,
        signed=True,
        is_current=is_current,
        version=latest_sig.cla_version,
        digest=latest_sig.cla_sha256,
        signed_at=latest_sig.signed_at,
        signature=latest_sig.signature,
    )


@router.put("/gate-mode")
def update_gate_mode(payload: CLAGateModeUpdate, db: Session = Depends(get_db)):
    """Operator endpoint to adjust CLA gate rollout mode (off, shadow, enforce)."""
    setting = db.query(CLAGateSetting).filter(CLAGateSetting.id == 1).first()
    if not setting:
        setting = CLAGateSetting(id=1, mode=payload.mode)
        db.add(setting)
    else:
        setting.mode = payload.mode

    history = CLAGateSettingHistory(
        mode=payload.mode,
        changed_by=payload.changed_by,
        reason=payload.reason,
    )
    db.add(history)
    db.commit()

    return {"mode": setting.mode, "status": "updated"}


@router.post("/version", response_model=CLAVersionResponse)
def register_cla_version(payload: CLANewVersionRequest, db: Session = Depends(get_db)):
    """Registers a new CLA version. If make_current is True, unsets previous current flags."""
    sha256 = hashlib.sha256(payload.text.encode("utf-8")).hexdigest()

    if payload.make_current:
        db.query(CLAVersion).filter(CLAVersion.is_current == True).update({"is_current": False})

    cla = CLAVersion(
        version=payload.version,
        sha256=sha256,
        text=payload.text,
        is_current=payload.make_current,
    )
    db.add(cla)
    db.commit()
    db.refresh(cla)

    return CLAVersionResponse(
        version=cla.version,
        sha256=cla.sha256,
        published_at=cla.published_at,
        effective_at=cla.effective_at,
        text=cla.text,
        is_current=cla.is_current,
    )


