 """Attestation and cryptographic signature verification utilities."""
 from __future__ import annotations

+import time
+from typing import Optional
+from substrateinterface import Keypair
+
+FRESHNESS_WINDOW_SECONDS: int = 600
+
+
+def verify_signature(message: bytes | str, signature: str, hotkey: str) -> bool:
+    """Verify an sr25519 signature for a given message and hotkey (SS58 address)."""
+    if isinstance(message, str):
+        msg_bytes = message.encode("utf-8")
+    else:
+        msg_bytes = message
+
+    clean_sig = signature.strip()
+    if clean_sig.startswith("0x") or clean_sig.startswith("0X"):
+        clean_sig = clean_sig[2:]
+
+    try:
+        sig_bytes = bytes.fromhex(clean_sig)
+    except ValueError:
+        return False
+
+    try:
+        keypair = Keypair(ss58_address=hotkey)
+        return bool(keypair.verify(msg_bytes, sig_bytes))
+    except Exception:
+        return False
+
+
+def verify_freshness(issued_at: int, freshness_window: int = FRESHNESS_WINDOW_SECONDS) -> bool:
+    """Check whether issued_at timestamp is within the freshness window."""
+    now = int(time.time())
+    return abs(now - issued_at) <= freshness_window
