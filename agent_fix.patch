### 5. Server Service and Verification

In `apps/platform/ditto/services/cla_service.py`:
```python
"""CLA registry, verification, and gate checking service."""

from datetime import datetime, timezone
import structlog
from sqlalchemy import desc, select, func
from sqlalchemy.ext.asyncio import AsyncSession

from ditto.cla_common import build_cla_sign_payload, compute_cla_sha256
from ditto.api_server.attestation import verify_signature, OwnerLinkWindowExceeded
from ditto.db.models.cla import CLAVersion, CLASignature, CLAGateSettingAudit
from ditto.config import get_settings

logger = structlog.get_logger(__name__)

CLA_EXPIRATION_SECONDS = 300  # 5 minutes


class CLAService:
    @staticmethod
    async def get_effective_cla_version(session: AsyncSession) -> CLAVersion | None:
        """Fetch the latest effective CLA version."""
        now = datetime.now(timezone.utc)
        stmt = (
            select(CLAVersion)
            .where(CLAVersion.effective_at <= now)
            .order_by(desc(CLAVersion.effective_at), desc(CLAVersion.id))
            .limit(1)
        )
        result = await session.execute(stmt)
        return result.scalars().first()

    @staticmethod
    async def get_cla_version_by_name(session: AsyncSession, version: str) -> CLAVersion | None:
        stmt = select(CLAVersion).where(CLAVersion.version == version)
        result = await session.execute(stmt)
        return result.scalars().first()

    @staticmethod
    async def get_latest_hotkey_signature(
        session: AsyncSession, hotkey: str, cla_version: str | None = None
    ) -> CLASignature | None:
        stmt = select(CLASignature).where(CLASignature.hotkey == hotkey)
        if cla_version:
            stmt = stmt.where(CLASignature.cla_version == cla_version)
        stmt = stmt.order_by(desc(CLASignature.signed_at), desc(CLASignature.id)).limit(1)
        result = await session.execute(stmt)
        return result.scalars().first()

    @staticmethod
    async def register_signature(
        session: AsyncSession,
        hotkey: str,
        cla_version: str,
        cla_sha256: str,
        nonce: str,
        issued_at: int,
        signature: str,
        coldkey_resolver,
    ) -> CLASignature:
        settings = get_settings()
        netuid = settings.subtensor_netuid

        # 1. Verify version exists and digest matches
        version_record = await CLAService.get_cla_version_by_name(session, cla_version)
        if not version_record:
            raise ValueError(f"Unknown CLA version: {cla_version}")
        if version_record.sha256.lower() != cla_sha256.lower():
            raise ValueError("CLA digest does not match registered digest.")

        # 2. Verify nonce uniqueness
        existing_nonce_stmt = select(CLASignature).where(CLASignature.nonce == nonce)
        res = await session.execute(existing_nonce_stmt)
        if res.scalars().first() is not None:
            raise ValueError("Nonce has already been used.")

        # 3. Check issued_at freshness
        now_ts = int(datetime.now(timezone.utc).timestamp())
        if abs(now_ts - issued_at) > CLA_EXPIRATION_SECONDS:
            raise ValueError("Signature payload expired or issued in the future.")

        # 4. Verify signature cryptographically
        payload = build_cla_sign_payload(
            netuid=netuid,
            cla_version=cla_version,
            cla_sha256=cla_sha256,
            hotkey=hotkey,
            nonce=nonce,
            issued_at=issued_at,
        )
        if not verify_signature(payload, signature, hotkey):
            raise ValueError("Invalid hotkey signature.")

        # 5. Resolve coldkey owner at finalized block
        coldkey = await coldkey_resolver(hotkey)
        if not coldkey:
            coldkey = hotkey  # fallback if owner resolution is unavailable

        # 6. Append signature record
        signed_at = datetime.now(timezone.utc)
        record = CLASignature(
            hotkey=hotkey,
            coldkey=coldkey,
            cla_version=cla_version,
            cla_sha256=cla_sha256,
            signature=signature,
            nonce=nonce,
            issued_at=issued_at,
            signed_at=signed_at,
        )
        session.add(record)
        await session.flush()
        return record

    @staticmethod
    async def get_gate_mode(session: AsyncSession) -> str:
        """Get the active gate mode: 'off', 'shadow', or 'enforce'."""
        stmt = (
            select(CLAGateSettingAudit)
            .order_by(desc(CLAGateSettingAudit.changed_at), desc(CLAGateSettingAudit.id))
            .limit(1)
        )
        res = await session.execute(stmt)
        audit = res.scalars().first()
        if audit:
            return audit.mode
        return get_settings().cla_gate_mode or "off"

    @staticmethod
    async def set_gate_mode(
        session: AsyncSession, mode: str, changed_by: str, reason: str | None = None
    ) -> None:
        if mode not in {"off", "shadow", "enforce"}:
            raise ValueError(f"Invalid mode: {mode}")
        audit = CLAGateSettingAudit(
            mode=mode,
            changed_by=changed_by,
            changed_at=datetime.now(timezone.utc),
            reason=reason,
        )
        session.add(audit)
        await session.flush()

    @staticmethod
    async def check_upload_gate(session: AsyncSession, hotkey: str) -> tuple[bool, str | None]:
        """Verify if hotkey is allowed to upload under current CLA gate mode.

        Returns (allowed, error_message).
        """
        gate_mode = await CLAService.get_gate_mode(session)
        if gate_mode == "off":
            return True, None

        effective = await CLAService.get_effective_cla_version(session)
        if not effective:
            return True, None  # No effective CLA published yet

        sig = await CLAService.get_latest_hotkey_signature(
            session, hotkey=hotkey, cla_version=effective.version
        )
        has_valid_sig = sig is not None and sig.cla_sha256.lower() == effective.sha256.lower()

        if has_valid_sig:
            return True, None

        msg = (
            f"Hotkey {hotkey} has not signed the current Contributor License Agreement "
            f"({effective.version}). Run `ditto cla sign` to proceed."
        )

        if gate_mode == "shadow":
            logger.warning("cla_gate_shadow_unsigned_upload", hotkey=hotkey, effective_version=effective.version)
            return True, None

        if gate_mode == "enforce":
            return False, msg

        return True, None
```

