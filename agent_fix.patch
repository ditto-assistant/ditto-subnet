```python
"""API endpoints and service methods for CLA registration, status, and gate management."""

from __future__ import annotations

import datetime
import hashlib
from pathlib import Path
from typing import Any, Optional
from fastapi import APIRouter, Depends, HTTPException, status
from pydantic import BaseModel, Field
from sqlalchemy.orm import Session

from ditto.miner_cli.cla_builder import build_cla_sign_payload
from apps.platform.ditto.api_server.attestation import (
    is_timestamp_fresh,
    resolve_coldkey_for_hotkey,
    verify_signature,
)
from apps.platform.ditto.api_server.models_cla import (
    CLAGateSetting,
    CLASignature,
    CLAVersion,
)

router = APIRouter(prefix="/api/v1/cla", tags=["cla"])

# Global shadow counts for tracking
_shadow_unsigned_counts: dict[str, int] = {}


def get_db():
    raise NotImplementedError("Injected by platform dependency injection")


# --- Helper Queries ---

def get_current_cla_version(db: Session) -> Optional[CLAVersion]:
    now = datetime.datetime.utcnow()
    return (
        db.query(CLAVersion)
        .filter(CLAVersion.effective_at <= now)
        .order_by(CLAVersion.effective_at.desc())
        .first()
    )


def get_current_gate_mode(db: Session) -> str:
    setting = db.query(CLAGateSetting).order_by(CLAGateSetting.id.desc()).first()
    return setting.mode if setting else "off"


def get_latest_hotkey_signature(hotkey: str, db: Session) -> Optional[CLASignature]:
    return (
        db.query(CLASignature)
        .filter(CLASignature.hotkey == hotkey)
        .order_by(CLASignature.id.desc())
        .first()
    )


# --- Request/Response Schemas ---

class CLAVersionResponse(BaseModel):
    version: str
    sha256: str
    published_at: datetime.datetime
    effective_at: datetime.datetime
    text: str


class CLASignRequest(BaseModel):
    netuid: int = Field(default=118)
    hotkey: str
    cla_version: str
    cla_sha256: str
    nonce: str
    issued_at: int
    signature: str


class CLASignResponse(BaseModel):
    status: str
    hotkey: str
    coldkey: str
    cla_version: str
    signed_at: datetime.datetime


class CLAStatusResponse(BaseModel):
    hotkey: str
    signed: bool
    version: Optional[str] = None
    digest: Optional[str] = None
    signed_at: Optional[datetime.datetime] = None
    signature: Optional[str] = None
    is_current: bool = False


class CLAGateSettingUpdate(BaseModel):
    mode: str
    changed_by: Optional[str] = "admin"
    reason: Optional[str] = None


class CLAGateStatusResponse(BaseModel):
    current_mode: str
    effective_version: Optional[str]
    history: list[dict[str, Any]]
    adoption: dict[str, Any]


# --- Endpoints ---

@router.get("/current", response_model=CLAVersionResponse)
def get_current_cla(db: Session = Depends(get_db)):
    """Fetch the currently effective CLA metadata and text."""
    current = get_current_cla_version(db)
    if not current:
        # Fallback to local doc if DB is empty
        path = Path("docs/legal/CLA-v1.md")
        text = path.read_text(encoding="utf-8") if path.exists() else "Ditto CLA v1"
        digest = hashlib.sha256(text.encode("utf-8")).hexdigest()
        now = datetime.datetime.utcnow()
        current = CLAVersion(
            version="v1",
            sha256=digest,
            text=text,
            published_at=now,
            effective_at=now,
        )
        db.add(current)
        db.commit()

    return CLAVersionResponse(
        version=current.version,
        sha256=current.sha256,
        published_at=current.published_at,
        effective_at=current.effective_at,
        text=current.text or "",
    )


@router.get("/status/{hotkey}", response_model=CLAStatusResponse)
def get_cla_status(hotkey: str, db: Session = Depends(get_db)):
    """Public read endpoint returning a hotkey's CLA status."""
    sig = get_latest_hotkey_signature(hotkey, db)
    current = get_current_cla_version(db)
    current_version = current.version if current else "v1"

    if not sig:
        return CLAStatusResponse(hotkey=hotkey, signed=False, is_current=False)

    is_current = sig.cla_version == current_version
    return CLAStatusResponse(
        hotkey=sig.hotkey,
        signed=True,
        version=sig.cla_version,
        digest=sig.cla_sha256,
        signed_at=sig.signed_at,
        signature=sig.signature,
        is_current=is_current,
    )


@router.post("/sign", response_model=CLASignResponse)
def submit_cla_signature(req: CLASignRequest, db: Session = Depends(get_db), subtensor: Any = None):
    """Verify and record a hotkey's signature for the CLA."""
    # 1. Version and sha256 check
    cla_ver = db.query(CLAVersion).filter(CLAVersion.version == req.cla_version).first()
    if not cla_ver:
        raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail=f"Unknown CLA version: {req.cla_version}")
    if cla_ver.sha256.lower() != req.cla_sha256.lower():
        raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail="CLA digest mismatch.")

    # 2. Freshness check on issued_at
    if not is_timestamp_fresh(req.issued_at):
        raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail="Stale issued_at timestamp.")

    # 3. Nonce uniqueness check
    existing_nonce = db.query(CLASignature).filter(CLASignature.nonce == req.nonce).first()
    if existing_nonce:
        raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail="Replayed nonce.")

    # 4. Byte-for-byte mirrored payload rebuild
    expected_payload = build_cla_sign_payload(
        netuid=req.netuid,
        cla_version=req.cla_version,
        cla_sha256=req.cla_sha256,
        hotkey=req.hotkey,
        nonce=req.nonce,
        issued_at=req.issued_at,
    )

    # 5. Verify signature
    if not verify_signature(expected_payload, req.signature, req.hotkey):
        raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail="Invalid signature or wrong signer.")

    # 6. Resolve coldkey = Owner(hotkey)
    coldkey = resolve_coldkey_for_hotkey(req.hotkey, subtensor=subtensor)

    # 7. Store append-only row
    now = datetime.datetime.utcnow()
    issued_dt = datetime.datetime.utcfromtimestamp(req.issued_at)
    record = CLASignature(
        hotkey=req.hotkey,
        coldkey=coldkey,
        cla_version=req.cla_version,
        cla_sha256=req.cla_sha256.lower(),
        signature=req.signature,
        nonce=req.nonce,
        issued_at=issued_dt,
        signed_at=now,
        created_at=now,
    )
    db.add(record)
    db.commit()

    return CLASignResponse(
        status="ok",
        hotkey=record.hotkey,
        coldkey=record.coldkey,
        cla_version=record.cla_version,
        signed_at=record.signed_at,
    )


@router.get("/gate/status", response_model=CLAGateStatusResponse)
def get_gate_status(db: Session = Depends(get_db), active_hotkeys: Optional[list[str]] = None):
    """Retrieve gate mode, historical audit trail, and adoption statistics."""
    current_mode = get_current_gate_mode(db)
    current_ver = get_current_cla_version(db)
    effective_ver = current_ver.version if current_ver else "v1"

    history_records = db.query(CLAGateSetting).order_by(CLAGateSetting.changed_at.desc()).all()
    history = [
        {
            "mode": r.mode,
            "changed_at": r.changed_at.isoformat(),
            "changed_by": r.changed_by,
            "reason": r.reason,
        }
        for r in history_records
    ]

    # Resolve active hotkeys (from parameter, signatures, or uploads)
    if active_hotkeys is None:
        signed_hotkeys = [row[0] for row in db.query(CLASignature.hotkey).distinct().all()]
        active_hotkeys = signed_hotkeys

    total_active = len(active_hotkeys)
    if total_active > 0:
        signed_active = (
            db.query(CLASignature.hotkey)
            .filter(CLASignature.hotkey.in_(active_hotkeys), CLASignature.cla_version == effective_ver)
            .distinct()
            .count()
        )
    else:
        signed_active = 0
    unsigned_active = max(0, total_active - signed_active)
    rate = (signed_active / total_active) if total_active > 0 else 1.0

    return CLAGateStatusResponse(
        current_mode=current_mode,
        effective_version=effective_ver,
        history=history,
        adoption={
            "total_active_hotkeys": total_active,
            "signed_active_hotkeys": signed_active,
            "unsigned_active_hotkeys": unsigned_active,
            "adoption_rate": rate,
            "shadow_unsigned_count": sum(_shadow_unsigned_counts.values()),
        },
    )


@router.post("/gate/setting")
def update_gate_setting(update: CLAGateSettingUpdate, db: Session = Depends(get_db)):
    """Update gate rollout mode: off -> shadow -> enforce."""
    if update.mode not in ("off", "shadow", "enforce"):
        raise HTTPException(status_code=400, detail="Mode must be 'off', 'shadow', or 'enforce'.")
    setting = CLAGateSetting(
        mode=update.mode,
        changed_at=datetime.datetime.utcnow(),
        changed_by=update.changed_by,
        reason=update.reason,
    )
    db.add(setting)
    db.commit()
    return {"status": "ok", "mode": setting.mode}


# --- Gate Submission Check Helper ---

def enforce_upload_cla_gate(hotkey: str, db: Session) -> None:
    """Enforce the CLA gate according to current mode."""
    mode = get_current_gate_mode(db)
    if mode == "off":
        return

    current = get_current_cla_version(db)
    effective_version = current.version if current else "v1"

    # Check if hotkey signed the current effective version
    sig = (
        db.query(CLASignature)
        .filter(CLASignature.hotkey == hotkey, CLASignature.cla_version == effective_version)
        .first()
    )

    if not sig:
        if mode == "shadow":
            _shadow_unsigned_counts[hotkey] = _shadow_unsigned_counts.get(hotkey, 0) + 1
            return
        elif mode == "enforce":
            raise HTTPException(
                status_code=status.HTTP_403_FORBIDDEN,
                detail=(
                    f"Hotkey {hotkey} has not signed the currently effective "
                    f"Contributor License Agreement ({effective_version}). "
                    f"Please run 'uv run ditto cla sign' before submitting."
                ),
            )
