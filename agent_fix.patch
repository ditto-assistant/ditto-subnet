### 7. Miner CLI Implementation (`ditto cla sign`, `ditto cla status`, `ditto upload` gate)

#### `ditto/miner_cli/cla.py`
```python
"""Miner CLI commands for Contributor License Agreement management."""

from __future__ import annotations

import hashlib
import secrets
import sys
import time
from typing import Any

import requests
import typer

cli = typer.Typer(name="cla", help="Manage Contributor License Agreement (CLA) signatures.")


def build_cla_signature_message(
    netuid: int,
    cla_version: str,
    cla_sha256: str,
    hotkey: str,
    nonce: str,
    issued_at: int,
) -> str:
    return f"ditto-cla:v1:{netuid}:{cla_version}:{cla_sha256}:{hotkey}:{nonce}:{issued_at}"


def fetch_current_cla(platform_url: str) -> dict[str, Any]:
    url = f"{platform_url.rstrip('/')}/api/v1/cla/current"
    resp = requests.get(url, timeout=10)
    if resp.status_code != 200:
        typer.secho(f"Failed to fetch current CLA from {url}: {resp.text}", fg=typer.colors.RED)
        raise typer.Exit(code=1)
    return resp.json()


def fetch_cla_status(platform_url: str, hotkey: str) -> dict[str, Any]:
    url = f"{platform_url.rstrip('/')}/api/v1/cla/status/{hotkey}"
    resp = requests.get(url, timeout=10)
    if resp.status_code != 200:
        typer.secho(f"Failed to query CLA status: {resp.text}", fg=typer.colors.RED)
        raise typer.Exit(code=1)
    return resp.json()


@cli.command("sign")
def sign(
    wallet_name: str = typer.Option("default", "--wallet.name", "-w", help="Bittensor wallet name"),
    hotkey_name: str = typer.Option("default", "--wallet.hotkey", "-k", help="Bittensor hotkey name"),
    netuid: int = typer.Option(118, "--netuid", help="Subnet UID"),
    platform_url: str = typer.Option("http://localhost:8000", "--platform-url", help="Platform URL"),
    yes: bool = typer.Option(False, "--yes", "-y", help="Skip confirmation prompt"),
) -> None:
    """Download current CLA, verify its digest, and sign it with the hotkey."""
    import bittensor as bt

    wallet = bt.wallet(name=wallet_name, hotkey=hotkey_name)
    hotkey_ss58 = wallet.hotkey.ss58_address

    typer.echo(f"Fetching current CLA from {platform_url}...")
    cla_data = fetch_current_cla(platform_url)
    version = cla_data["version"]
    expected_sha256 = cla_data["sha256"].lower()
    text = cla_data["text"]

    # Recompute and verify digest
    computed_sha256 = hashlib.sha256(text.encode("utf-8")).hexdigest().lower()
    if computed_sha256 != expected_sha256:
        typer.secho(
            f"REFUSING TO SIGN: CLA digest mismatch!\n"
            f"Expected: {expected_sha256}\n"
            f"Computed: {computed_sha256}",
            fg=typer.colors.RED,
            bold=True,
        )
        raise typer.Exit(code=1)

    typer.echo("\n" + "=" * 60)
    typer.echo(f"Ditto Contributor License Agreement ({version})")
    typer.echo(f"SHA-256 Digest: {computed_sha256}")
    typer.echo("=" * 60)
    typer.echo(text.strip())
    typer.echo("=" * 60 + "\n")

    if not yes:
        confirmation = typer.prompt(
            f"To sign CLA {version} with hotkey {hotkey_ss58}, type 'I AGREE'"
        )
        if confirmation.strip() != "I AGREE":
            typer.secho("Signing aborted.", fg=typer.colors.YELLOW)
            raise typer.Exit(code=1)

    nonce = secrets.token_hex(16)
    issued_at = int(time.time())
    msg_str = build_cla_signature_message(
        netuid=netuid,
        cla_version=version,
        cla_sha256=computed_sha256,
        hotkey=hotkey_ss58,
        nonce=nonce,
        issued_at=issued_at,
    )

    typer.echo("Signing message with hotkey...")
    sig_bytes = wallet.hotkey.sign(msg_str.encode("utf-8"))
    signature = f"0x{sig_bytes.hex()}" if not sig_bytes.hex().startswith("0x") else sig_bytes.hex()

    payload = {
        "netuid": netuid,
        "cla_version": version,
        "cla_sha256": computed_sha256,
        "hotkey": hotkey_ss58,
        "nonce": nonce,
        "issued_at": issued_at,
        "signature": signature,
    }

    url = f"{platform_url.rstrip('/')}/api/v1/cla/sign"
    res = requests.post(url, json=payload, timeout=15)
    if res.status_code != 201:
        typer.secho(f"Platform rejected signature ({res.status_code}): {res.text}", fg=typer.colors.RED)
        raise typer.Exit(code=1)

    typer.secho(
        f"Successfully signed CLA {version} for hotkey {hotkey_ss58}!",
        fg=typer.colors.GREEN,
        bold=True,
    )


@cli.command("status")
def status(
    wallet_name: str = typer.Option("default", "--wallet.name", "-w", help="Bittensor wallet name"),
    hotkey_name: str = typer.Option("default", "--wallet.hotkey", "-k", help="Bittensor hotkey name"),
    platform_url: str = typer.Option("http://localhost:8000", "--platform-url", help="Platform URL"),
) -> None:
    """Show CLA signing status for the configured hotkey."""
    import bittensor as bt

    wallet = bt.wallet(name=wallet_name, hotkey=hotkey_name)
    hotkey_ss58 = wallet.hotkey.ss58_address

    data = fetch_cla_status(platform_url, hotkey_ss58)
    typer.echo(f"Hotkey:            {data['hotkey']}")
    typer.echo(f"Effective Version: {data.get('effective_version') or 'N/A'}")
    typer.echo(f"Signed Version:    {data.get('cla_version') or 'None'}")
    typer.echo(f"Current?:          {'YES' if data.get('is_current') else 'NO'}")
    typer.echo(f"Signed At:         {data.get('signed_at') or 'N/A'}")
    typer.echo(f"Signature:         {data.get('signature') or 'N/A'}")
    typer.echo(f"Gate Mode:         {data.get('gate_mode')}")
