### 4. Server-Side Attestation, Payload Builder, and CLA Service
`apps/platform/ditto/api_server/cla/service.py`
```python
"""Core verification, payload creation, and query services for CLA."""

from datetime import datetime, timezone
import hashlib
import logging
from typing import Optional, Dict, Any, Tuple
from sqlalchemy.orm import Session

from apps.platform.ditto.api_server.attestation import verify_signature
from apps.platform.ditto.api_server.models.cla import (
    CLAVersion,
    CLASignature,
    CLAGateSettingHistory,
)

logger = logging.getLogger(__name__)

FRESHNESS_WINDOW_SECONDS = 300  # 5 minutes


def build_cla_signature_payload(
    netuid: int,
    cla_version: str,
    cla_sha256: str,
    hotkey: str,
    nonce: str,
    issued_at: int,
) -> str:
    """Build byte-for-byte identical canonical signing payload."""
    return f"ditto-cla:v1:{netuid}:{cla_version}:{cla_sha256}:{hotkey}:{nonce}:{issued_at}"


def get_current_cla_version(db: Session) -> Optional[CLAVersion]:
    """Retrieve the currently effective CLA version."""
    now = datetime.now(timezone.utc)
    return (
        db.query(CLAVersion)
        .filter(CLAVersion.effective_at <= now)
        .order_by(CLAVersion.effective_at.desc(), CLAVersion.published_at.desc())
        .first()
    )


def resolve_coldkey(hotkey: str) -> str:
    """Resolve Owner(hotkey) at finalized block. Defaults to hotkey in mock/local test environments."""
    try:
        from apps.platform.ditto.api_server.subtensor import get_hotkey_owner
        return get_hotkey_owner(hotkey)
    except Exception:
        return f"cold_{hotkey[:10]}"


def verify_and_record_cla_signature(
    db: Session,
    netuid: int,
    hotkey: str,
    cla_version: str,
    cla_sha256: str,
    nonce: str,
    issued_at: int,
    signature: str,
) -> CLASignature:
    """Verifies signature freshness, uniqueness, digest match and stores row."""
    current_version = get_current_cla_version(db)
    if not current_version:
        raise ValueError("No effective CLA version configured on Platform.")

    if current_version.version != cla_version:
        raise ValueError(f"Version mismatch: requested '{cla_version}', current is '{current_version.version}'.")

    if current_version.sha256.lower() != cla_sha256.lower():
        raise ValueError("SHA-256 digest mismatch with currently registered CLA version.")

    # Check nonce uniqueness
    existing_nonce = db.query(CLASignature).filter(CLASignature.nonce == nonce).first()
    if existing_nonce:
        raise ValueError(f"Nonce '{nonce}' has already been used.")

    # Freshness window check
    now_ts = int(datetime.now(timezone.utc).timestamp())
    if abs(now_ts - issued_at) > FRESHNESS_WINDOW_SECONDS:
        raise ValueError(f"issued_at timestamp {issued_at} falls outside the {FRESHNESS_WINDOW_SECONDS}s freshness window.")

    # Construct canonical payload and verify signature
    payload = build_cla_signature_payload(
        netuid=netuid,
        cla_version=cla_version,
        cla_sha256=cla_sha256,
        hotkey=hotkey,
        nonce=nonce,
        issued_at=issued_at,
    )

    if not verify_signature(message=payload.encode("utf-8"), signature=signature, hotkey=hotkey):
        raise ValueError("Cryptographic signature verification failed for hotkey.")

    coldkey = resolve_coldkey(hotkey)

    issued_at_dt = datetime.fromtimestamp(issued_at, tz=timezone.utc)
    sig_record = CLASignature(
        hotkey=hotkey,
        coldkey=coldkey,
        cla_version=cla_version,
        cla_sha256=cla_sha256,
        signature=signature,
        nonce=nonce,
        issued_at=issued_at_dt,
    )
    db.add(sig_record)
    db.commit()
    db.refresh(sig_record)
    return sig_record


def get_hotkey_cla_status(db: Session, hotkey: str) -> Dict[str, Any]:
    """Return public CLA status for hotkey."""
    current_v = get_current_cla_version(db)
    latest_sig = (
        db.query(CLASignature)
        .filter(CLASignature.hotkey == hotkey)
        .order_by(CLASignature.signed_at.desc())
        .first()
    )

    if not latest_sig:
        return {
            "hotkey": hotkey,
            "signed": False,
            "cla_version": None,
            "cla_sha256": None,
            "signed_at": None,
            "signature": None,
            "is_current": False,
        }

    is_current = bool(current_v and latest_sig.cla_version == current_v.version)
    return {
        "hotkey": hotkey,
        "signed": True,
        "cla_version": latest_sig.cla_version,
        "cla_sha256": latest_sig.cla_sha256,
        "signed_at": latest_sig.signed_at.isoformat(),
        "signature": latest_sig.signature,
        "is_current": is_current,
    }


def get_gate_mode(db: Session) -> str:
    """Retrieve current gate mode: off, shadow, enforce."""
    latest = db.query(CLAGateSettingHistory).order_by(CLAGateSettingHistory.id.desc()).first()
    return latest.mode if latest else "off"


def set_gate_mode(db: Session, mode: str, changed_by: str = "operator", reason: Optional[str] = None) -> None:
    if mode not in ("off", "shadow", "enforce"):
        raise ValueError(f"Invalid mode '{mode}'. Must be 'off', 'shadow', or 'enforce'.")
    entry = CLAGateSettingHistory(mode=mode, changed_by=changed_by, reason=reason)
    db.add(entry)
    db.commit()


def check_upload_cla_gate(db: Session, hotkey: str) -> Tuple[bool, Optional[str]]:
    """Evaluates whether upload by hotkey is permitted under active gate setting."""
    mode = get_gate_mode(db)
    if mode == "off":
        return True, None

    status = get_hotkey_cla_status(db, hotkey)
    is_valid = status["signed"] and status["is_current"]

    if not is_valid:
        msg = "Contributor License Agreement (CLA) signature required for current version. Run 'uv run ditto cla sign'."
        if mode == "shadow":
            logger.warning("[CLA SHADOW] Unsigned/outdated upload allowed from hotkey %s: %s", hotkey, msg)
            return True, None
        return False, msg

    return True, None
```

