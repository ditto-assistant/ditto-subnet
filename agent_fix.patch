+from __future__ import annotations
+
+import hashlib
+import secrets
+import sys
+import time
+from pathlib import Path
+from typing import Any
+import requests
+
+
+def compute_text_sha256(text: str) -> str:
+    return hashlib.sha256(text.encode("utf-8")).hexdigest()
+
+
+def build_cla_sign_message(
+    netuid: int,
+    cla_version: str,
+    cla_sha256: str,
+    hotkey: str,
+    nonce: str,
+    issued_at: int,
+) -> str:
+    return f"ditto-cla:v1:{netuid}:{cla_version}:{cla_sha256}:{hotkey}:{nonce}:{issued_at}"
+
+
+def get_platform_current_cla(platform_url: str) -> dict[str, Any]:
+    url = f"{platform_url.rstrip('/')}/api/v1/cla/current"
+    resp = requests.get(url, timeout=10)
+    if resp.status_code != 200:
+        raise RuntimeError(f"Failed to fetch current CLA from platform: {resp.status_code} {resp.text}")
+    return resp.json()
+
+
+def sign_cla_command(
+    keypair: Any,
+    platform_url: str = "http://localhost:8000",
+    netuid: int = 118,
+    cla_path: Path | str | None = None,
+    auto_confirm: bool = False,
+) -> dict[str, Any]:
+    """
+    Implements `uv run ditto cla sign`.
+    1. Fetches current CLA version and digest from platform registry.
+    2. Obtains and hashes CLA text.
+    3. Refuses on digest mismatch.
+    4. Prompts miner for explicit confirmation.
+    5. Signs with hotkey (sr25519) and submits to platform.
+    """
+    hotkey = keypair.ss58_address
+    platform_cla = get_platform_current_cla(platform_url)
+    reg_version = platform_cla["version"]
+    reg_sha256 = platform_cla["sha256"].lower()
+
+    cla_text = ""
+    if cla_path is not None and Path(cla_path).exists():
+        cla_text = Path(cla_path).read_text(encoding="utf-8")
+    elif platform_cla.get("text"):
+        cla_text = platform_cla["text"]
+    else:
+        # Check standard location docs/legal/CLA-v<N>.md
+        local_path = Path(f"docs/legal/CLA-{reg_version}.md")
+        if local_path.exists():
+            cla_text = local_path.read_text(encoding="utf-8")
+        else:
+            raise FileNotFoundError(
+                f"CLA text not found locally at {local_path} and not provided by server."
+            )
+
+    computed_sha256 = compute_text_sha256(cla_text).lower()
+    if computed_sha256 != reg_sha256:
+        raise ValueError(
+            f"Digest mismatch for CLA version {reg_version}!\n"
+            f"Platform registry SHA-256: {reg_sha256}\n"
+            f"Local text SHA-256:        {computed_sha256}\n"
+            f"Refusing to sign mismatched CLA text."
+        )
+
+    print(f"\n--- Ditto Contributor License Agreement ({reg_version}) ---")
+    print(f"Digest (SHA-256): {reg_sha256}")
+    print(f"Signer Hotkey:   {hotkey}")
+    print("----------------------------------------------------------\n")
+
+    if not auto_confirm:
+        print("To agree and sign with your hotkey, please type 'I AGREE':")
+        confirmation = input("> ").strip()
+        if confirmation != "I AGREE":
+            print("Signing aborted. You must type 'I AGREE' to confirm.")
+            sys.exit(1)
+
+    nonce = secrets.token_hex(16)
+    issued_at = int(time.time())
+    msg = build_cla_sign_message(
+        netuid=netuid,
+        cla_version=reg_version,
+        cla_sha256=reg_sha256,
+        hotkey=hotkey,
+        nonce=nonce,
+        issued_at=issued_at,
+    )
+
+    raw_sig = keypair.sign(msg.encode("utf-8"))
+    signature_hex = "0x" + (raw_sig.hex() if isinstance(raw_sig, bytes) else str(raw_sig))
+
+    payload = {
+        "hotkey": hotkey,
+        "cla_version": reg_version,
+        "cla_sha256": reg_sha256,
+        "signature": signature_hex,
+        "nonce": nonce,
+        "issued_at": issued_at,
+        "netuid": netuid,
+    }
+
+    resp = requests.post(
+        f"{platform_url.rstrip('/')}/api/v1/cla/sign",
+        json=payload,
+        timeout=10,
+    )
+    if resp.status_code != 200:
+        raise RuntimeError(f"Platform refused signature: {resp.status_code} {resp.text}")
+
+    result = resp.json()
+    print(f"\n[SUCCESS] Successfully signed CLA {reg_version} for hotkey {hotkey}.")
+    print(f"Signed at: {result.get('signed_at')}")
+    return result
+
+
+def status_cla_command(
+    hotkey: str,
+    platform_url: str = "http://localhost:8000",
+) -> dict[str, Any]:
+    """
+    Implements `uv run ditto cla status`.
+    Shows signed version, current status, and signed_at time.
+    """
+    url = f"{platform_url.rstrip('/')}/api/v1/cla/status/{hotkey}"
+    resp = requests.get(url, timeout=10)
+    if resp.status_code != 200:
+        raise RuntimeError(f"Failed to fetch CLA status: {resp.status_code} {resp.text}")
+
+    data = resp.json()
+    print(f"\n--- CLA Status for {hotkey} ---")
+    print(f"Signed:            {'Yes' if data.get('signed') else 'No'}")
+    print(f"Signed Version:    {data.get('version') or 'None'}")
+    print(f"Is Current:        {'Yes' if data.get('is_current') else 'No'}")
+    print(f"Effective Version: {data.get('effective_version') or 'Unknown'}")
+    print(f"Signed At:         {data.get('signed_at') or 'Never'}")
+    print(f"Digest:            {data.get('sha256') or 'None'}")
+    if data.get("signature"):
+        print(f"Signature:         {data['signature'][:18]}...{data['signature'][-8:]}")
+    print("--------------------------------\n")
+    return data
+
+
+def check_cla_before_upload(hotkey: str, platform_url: str = "http://localhost:8000") -> None:
+    """
+    Up-front verification in `ditto upload` before packaging or payment steps.
+    """
+    url = f"{platform_url.rstrip('/')}/api/v1/cla/status/{hotkey}"
+    resp = requests.get(url, timeout=10)
+    if resp.status_code == 200:
+        data = resp.json()
+        if not data.get("is_current"):
+            print("\n[WARNING / GATE] Your hotkey has not signed the currently effective Contributor License Agreement.")
+            print("Run `uv run ditto cla sign` to sign before uploading.\n")
