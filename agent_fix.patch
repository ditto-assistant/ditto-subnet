"""CLI commands for Contributor License Agreement (CLA) signing and status."""

from __future__ import annotations

import hashlib
import os
import secrets
import time
from pathlib import Path
import httpx
import typer
from rich.console import Console
from rich.markdown import Markdown
from rich.panel import Panel

from bittensor_wallet import Wallet
from ditto.miner_cli.cla_sign_builder import build_cla_sign_message

cla_app = typer.Typer(help="Manage Contributor License Agreement (CLA) signature.")
console = Console()


def compute_sha256(text: str) -> str:
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


@cla_app.command("status")
def status_cmd(
    hotkey: str = typer.Option(None, "--hotkey", "-h", help="Hotkey SS58 address or name"),
    wallet_name: str = typer.Option("default", "--wallet", "-w", help="Wallet name"),
    wallet_hotkey: str = typer.Option("default", "--wallet-hotkey", "-k", help="Wallet hotkey name"),
    platform_url: str = typer.Option(
        os.getenv("DITTO_PLATFORM_URL", "http://localhost:8000"),
        "--platform-url",
        help="Ditto Platform API base URL",
    ),
):
    """Check current CLA signature status for the hotkey."""
    if not hotkey:
        try:
            w = Wallet(name=wallet_name, hotkey=wallet_hotkey)
            hotkey = w.hotkey.ss58_address
        except Exception:
            console.print("[red]Could not determine hotkey. Please provide --hotkey.[/red]")
            raise typer.Exit(code=1)

    url = f"{platform_url.rstrip('/')}/api/v1/cla/status/{hotkey}"
    try:
        resp = httpx.get(url, timeout=10.0)
        resp.raise_for_status()
        data = resp.json()
    except Exception as exc:
        console.print(f"[red]Failed to query CLA status from {platform_url}: {exc}[/red]")
        raise typer.Exit(code=1)

    console.print(Panel(f"CLA Status for Hotkey: [bold]{hotkey}[/bold]", title="CLA Status"))
    if not data.get("signed"):
        console.print("[yellow]Status:[/yellow] [bold red]NOT SIGNED[/bold red]")
        console.print(f"Current CLA version required: [cyan]{data.get('current_version')}[/cyan]")
        console.print("Run [green]uv run ditto cla sign[/green] to sign the current agreement.")
        return

    is_current = data.get("is_current")
    console.print(f"Signed Version: [cyan]{data.get('version')}[/cyan]")
    console.print(f"Current Version: [cyan]{data.get('current_version')}[/cyan]")
    console.print(f"Signed At: {data.get('signed_at')}")
    console.print(f"Digest (SHA-256): {data.get('sha256')}")
    console.print(f"Signature: {data.get('signature')[:16]}...")

    if is_current:
        console.print("[green]✔ Status: CURRENT (Eligible for agent and bounty uploads)[/green]")
    else:
        console.print("[red]✖ Status: OUTDATED - A new CLA version must be signed.[/red]")
        console.print("Run [green]uv run ditto cla sign[/green] to update your signature.")


@cla_app.command("sign")
def sign_cmd(
    wallet_name: str = typer.Option("default", "--wallet", "-w", help="Wallet name"),
    wallet_hotkey: str = typer.Option("default", "--wallet-hotkey", "-k", help="Wallet hotkey name"),
    cla_file: Path | None = typer.Option(None, "--cla-file", help="Path to local CLA markdown text"),
    netuid: int = typer.Option(118, "--netuid", help="Subnet netuid"),
    platform_url: str = typer.Option(
        os.getenv("DITTO_PLATFORM_URL", "http://localhost:8000"),
        "--platform-url",
        help="Ditto Platform API base URL",
    ),
    yes: bool = typer.Option(False, "--yes", "-y", help="Skip explicit confirmation prompt"),
):
    """Review and sign the Contributor License Agreement with hotkey."""
    # 1. Fetch current CLA version & sha256 registry from Platform
    curr_url = f"{platform_url.rstrip('/')}/api/v1/cla/current"
    try:
        resp = httpx.get(curr_url, timeout=10.0)
        resp.raise_for_status()
        current_meta = resp.json()
    except Exception as exc:
        console.print(f"[red]Failed to fetch current CLA details from platform: {exc}[/red]")
        raise typer.Exit(code=1)

    cla_version = current_meta["version"]
    expected_sha256 = current_meta["sha256"]

    # 2. Locate or read CLA text
    cla_path = cla_file or Path(f"docs/legal/CLA-v{cla_version}.md")
    if not cla_path.is_file():
        # Fallback to general CLA.md if version-specific file is missing
        cla_path = Path("docs/legal/CLA.md")

    if not cla_path.is_file():
        console.print(f"[red]CLA file not found at {cla_path}.[/red]")
        raise typer.Exit(code=1)

    cla_text = cla_path.read_text(encoding="utf-8")
    actual_sha256 = compute_sha256(cla_text)

    # 3. Refuse on digest mismatch
    if actual_sha256.lower() != expected_sha256.lower():
        console.print(
            f"[bold red]Refusing to sign: SHA-256 digest mismatch![/bold red]\n"
            f"  Local file digest:    {actual_sha256}\n"
            f"  Platform registered: {expected_sha256}\n"
            f"Please update your repository or verify the CLA text."
        )
        raise typer.Exit(code=1)

    # 4. Display text & prompt
    console.print(Panel(Markdown(cla_text), title=f"CLA v{cla_version}"))
    console.print(f"File: [cyan]{cla_path}[/cyan] | SHA-256: [cyan]{actual_sha256}[/cyan]\n")

    if not yes:
        confirmation = typer.prompt("Type 'I AGREE' to sign this agreement with your hotkey")
        if confirmation.strip() != "I AGREE":
            console.print("[yellow]Signing aborted.[/yellow]")
            raise typer.Exit(code=0)

    # 5. Load keypair and sign
    try:
        wallet = Wallet(name=wallet_name, hotkey=wallet_hotkey)
        hotkey_kp = wallet.hotkey
    except Exception as exc:
        console.print(f"[red]Failed to load hotkey wallet: {exc}[/red]")
        raise typer.Exit(code=1)

    nonce = secrets.token_hex(16)
    issued_at = int(time.time())

    canonical_message = build_cla_sign_message(
        netuid=netuid,
        cla_version=cla_version,
        cla_sha256=actual_sha256,
        hotkey=hotkey_kp.ss58_address,
        nonce=nonce,
        issued_at=issued_at,
    )
    sig_bytes = hotkey_kp.sign(canonical_message.encode("utf-8"))
    signature_hex = sig_bytes.hex()

    # 6. Post signature to Platform
    sign_url = f"{platform_url.rstrip('/')}/api/v1/cla/sign"
    payload = {
        "netuid": netuid,
        "cla_version": cla_version,
        "cla_sha256": actual_sha256,
        "hotkey": hotkey_kp.ss58_address,
        "nonce": nonce,
        "issued_at": issued_at,
        "signature": signature_hex,
    }

    try:
        post_resp = httpx.post(sign_url, json=payload, timeout=10.0)
        post_resp.raise_for_status()
        res_data = post_resp.json()
    except httpx.HTTPStatusError as exc:
        console.print(f"[red]Platform rejected signature: {exc.response.text}[/red]")
        raise typer.Exit(code=1)
    except Exception as exc:
        console.print(f"[red]Failed to submit signature: {exc}[/red]")
        raise typer.Exit(code=1)

    console.print(
        f"[bold green]✔ Successfully signed CLA v{cla_version} for hotkey {hotkey_kp.ss58_address}![/bold green]"
    )
    console.print(f"Recorded at: {res_data.get('signed_at')}")
```

