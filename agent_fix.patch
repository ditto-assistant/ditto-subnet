    db_session.commit()

    report = get_cla_gate_report(db_session, active_hotkeys=["5H1", "5H2"])
    assert report["gate_mode"] == "shadow"
    assert report["active_hotkeys_count"] == 2
    assert report["signed_active_count"] == 1
    assert report["unsigned_active_count"] == 1
    assert report["adoption_rate"] == 0.5
    assert len(report["history"]) == 1
