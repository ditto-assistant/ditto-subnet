from fastapi import APIRouter, Depends, HTTPException, Query
from pydantic import BaseModel, Field
from sqlalchemy.orm import Session
from datetime import datetime
from typing import Optional, List

from apps.platform.ditto.api_server.db import get_db
from apps.platform.ditto.models.cla import CLAVersion, CLASignature, CLAGateSetting
from apps.platform.ditto.api_server.services.cla_service import (
    get_current_effective_cla,
    verify_and_store_signature,
    get_cla_gate_mode,
)

router = APIRouter(prefix="/api/v1/cla", tags=["cla"])


class CLACurrentResponse(BaseModel):
    version: str
    sha256: str
    published_at: datetime
    effective_at: datetime
    text: str


class CLASignRequest(BaseModel):
    netuid: int = Field(default=118)
    cla_version: str
    cla_sha256: str
    hotkey: str
    nonce: str
    issued_at: int
    signature: str


class CLASignResponse(BaseModel):
    status: str
    hotkey: str
    coldkey: str
    cla_version: str
    cla_sha256: str
    signed_at: datetime


class CLAStatusResponse(BaseModel):
    hotkey: str
    has_signed: bool
    is_current: bool
    version: Optional[str] = None
    digest: Optional[str] = None
    signed_at: Optional[datetime] = None
    signature: Optional[str] = None


@router.get("/current", response_model=CLACurrentResponse)
def get_current_cla(db: Session = Depends(get_db)):
    cla = get_current_effective_cla(db)
    if not cla:
        raise HTTPException(status_code=404, detail="No active CLA version published")
    return CLACurrentResponse(
        version=cla.version,
        sha256=cla.sha256,
        published_at=cla.published_at,
        effective_at=cla.effective_at,
        text=cla.text,
    )


@router.post("/sign", response_model=CLASignResponse)
def sign_cla(req: CLASignRequest, db: Session = Depends(get_db)):
    sig = verify_and_store_signature(
        db=db,
        netuid=req.netuid,
        cla_version=req.cla_version,
        cla_sha256=req.cla_sha256,
        hotkey=req.hotkey,
        nonce=req.nonce,
        issued_at=req.issued_at,
        signature_hex=req.signature,
    )
    return CLASignResponse(
        status="signed",
        hotkey=sig.hotkey,
        coldkey=sig.coldkey,
        cla_version=sig.cla_version,
        cla_sha256=sig.cla_sha256,
        signed_at=sig.signed_at,
    )


@router.get("/status/{hotkey}", response_model=CLAStatusResponse)
def get_hotkey_cla_status(hotkey: str, db: Session = Depends(get_db)):
    current_cla = get_current_effective_cla(db)
    sig = (
        db.query(CLASignature)
        .filter(CLASignature.hotkey == hotkey)
        .order_by(CLASignature.id.desc())
        .first()
    )

    if not sig:
        return CLAStatusResponse(
            hotkey=hotkey,
            has_signed=False,
            is_current=False,
        )

    is_current = bool(current_cla and sig.cla_version == current_cla.version)
    return CLAStatusResponse(
        hotkey=hotkey,
        has_signed=True,
        is_current=is_current,
        version=sig.cla_version,
        digest=sig.cla_sha256,
        signed_at=sig.signed_at,
        signature=sig.signature,
    )
