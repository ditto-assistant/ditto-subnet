### 9. Bounty PRs Interface Sketch

```python
# apps/platform/ditto/api_server/bounty_cla.py
from dataclasses import dataclass
from typing import Optional
from sqlalchemy.orm import Session
from .models import CLAVersion, CLASignature


@dataclass
class GitHubCLACheckResult:
    author: str
    hotkey: Optional[str]
    has_signed_current: bool
    effective_cla_version: Optional[str]


def check_github_pr_cla(
    github_username: str,
    db: Session,
    account_link_service=None,
) -> GitHubCLACheckResult:
    """Sketch interface for GitHub PR check (#2054 / #2871).
    
    Resolves: GitHub author -> Linked Hotkey -> Current CLA signature status.
    """
    hotkey = None
    if account_link_service:
        hotkey = account_link_service.get_hotkey_for_github_user(github_username)

    if not hotkey:
        return GitHubCLACheckResult(
            author=github_username,
            hotkey=None,
            has_signed_current=False,
            effective_cla_version=None,
        )

    from .cla import get_effective_cla
    current_ver = get_effective_cla(db)
    if not current_ver:
        return GitHubCLACheckResult(
            author=github_username,
            hotkey=hotkey,
            has_signed_current=True,
            effective_cla_version=None,
        )

    sig = (
        db.query(CLASignature)
        .filter(
            CLASignature.hotkey == hotkey,
            CLASignature.cla_version == current_ver.version,
        )
        .first()
    )
    return GitHubCLACheckResult(
        author=github_username,
        hotkey=hotkey,
        has_signed_current=bool(sig),
        effective_cla_version=current_ver.version,
    )
