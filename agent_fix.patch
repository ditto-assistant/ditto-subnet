### 5. CLA Platform Endpoints: `apps/platform/ditto/api_server/endpoints/cla.py`

```python
"""Public and miner-facing endpoints for CLA version inspection, status checks, and signing."""

from datetime import datetime, timezone
import time
from fastapi import APIRouter, Depends, HTTPException, status
from pydantic import BaseModel
from sqlalchemy.orm import Session

from apps.platform.ditto.api_server.attestation import (
    build_cla_message,
    verify_signature,
    resolve_coldkey_owner,
    OWNER_LINK_FRESHNESS_WINDOW_SECONDS,
)
from apps.platform.ditto.db.cla_models import ClaVersion, ClaSignature

# Assume database dependency
try:
    from apps.platform.ditto.api_server.deps import get_db
except ImportError:
    def get_db():
        raise NotImplementedError

router = APIRouter(prefix="/api/v1/cla", tags=["cla"])


class ClaVersionResponse(BaseModel):
    version: str
    sha256: str
    text: str
    published_at: datetime
    effective_at: datetime


class ClaStatusResponse(BaseModel):
    hotkey: str
    signed: bool
    is_current: bool
    current_version: str | None
    signed_version: str | None
    cla_sha256: str | None
    signed_at: datetime | None
    signature: str | None


class ClaSignRequest(BaseModel):
    netuid: int
    hotkey: str
    cla_version: str
    cla_sha256: str
    nonce: str
    issued_at: int
    signature: str


class ClaSignResponse(BaseModel):
    status: str
    hotkey: str
    cla_version: str
    signed_at: datetime


@router.get("/current", response_model=ClaVersionResponse)
def get_current_cla(db: Session = Depends(get_db)):
    """Fetch the currently effective CLA text and SHA-256 digest."""
    now = datetime.now(timezone.utc)
    cla = (
        db.query(ClaVersion)
        .filter(ClaVersion.effective_at <= now)
        .order_by(ClaVersion.effective_at.desc())
        .first()
    )
    if not cla:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail="No active CLA version found.")
    return ClaVersionResponse(
        version=cla.version,
        sha256=cla.sha256,
        text=cla.text,
        published_at=cla.published_at,
        effective_at=cla.effective_at,
    )


@router.get("/status/{hotkey}", response_model=ClaStatusResponse)
def get_cla_status(hotkey: str, db: Session = Depends(get_db)):
    """Public read endpoint returning a hotkey's CLA signing status."""
    now = datetime.now(timezone.utc)
    current_cla = (
        db.query(ClaVersion)
        .filter(ClaVersion.effective_at <= now)
        .order_by(ClaVersion.effective_at.desc())
        .first()
    )

    sig = (
        db.query(ClaSignature)
        .filter(ClaSignature.hotkey == hotkey)
        .order_by(ClaSignature.id.desc())
        .first()
    )

    if not sig:
        return ClaStatusResponse(
            hotkey=hotkey,
            signed=False,
            is_current=False,
            current_version=current_cla.version if current_cla else None,
            signed_version=None,
            cla_sha256=None,
            signed_at=None,
            signature=None,
        )

    is_current = bool(current_cla and sig.cla_version == current_cla.version and sig.cla_sha256 == current_cla.sha256)

    return ClaStatusResponse(
        hotkey=hotkey,
        signed=True,
        is_current=is_current,
        current_version=current_cla.version if current_cla else None,
        signed_version=sig.cla_version,
        cla_sha256=sig.cla_sha256,
        signed_at=sig.signed_at,
        signature=sig.signature,
    )


@router.post("/sign", response_model=ClaSignResponse)
def sign_cla(payload: ClaSignRequest, db: Session = Depends(get_db)):
    """Verify and store a signed CLA action append-only."""
    # 1. Verify CLA version exists and sha256 matches registry
    cla = db.query(ClaVersion).filter(ClaVersion.version == payload.cla_version).first()
    if not cla:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail=f"CLA version {payload.cla_version} is not recognized.",
        )
    if cla.sha256.lower() != payload.cla_sha256.lower():
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="CLA SHA-256 digest does not match the registry.",
        )

    # 2. Freshness window check on issued_at
    now_ts = int(time.time())
    if abs(now_ts - payload.issued_at) > OWNER_LINK_FRESHNESS_WINDOW_SECONDS:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="Timestamp 'issued_at' is stale or outside the freshness window.",
        )

    # 3. Nonce uniqueness check
    existing_nonce = db.query(ClaSignature).filter(ClaSignature.nonce == payload.nonce).first()
    if existing_nonce:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="Nonce has already been used.",
        )

    # 4. Mirrored message reconstruction and cryptographic verification
    expected_msg = build_cla_message(
        netuid=payload.netuid,
        cla_version=payload.cla_version,
        cla_sha256=payload.cla_sha256,
        hotkey=payload.hotkey,
        nonce=payload.nonce,
        issued_at=payload.issued_at,
    )
    if not verify_signature(payload.hotkey, expected_msg, payload.signature):
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="Invalid signature or signer does not match hotkey.",
        )

    # 5. Resolve coldkey owner
    coldkey = resolve_coldkey_owner(payload.hotkey)

    # 6. Append-only storage
    signed_at = datetime.now(timezone.utc)
    new_signature = ClaSignature(
        hotkey=payload.hotkey,
        coldkey=coldkey,
        cla_version=payload.cla_version,
        cla_sha256=payload.cla_sha256,
        signature=payload.signature,
        nonce=payload.nonce,
        issued_at=payload.issued_at,
        signed_at=signed_at,
    )
    db.add(new_signature)
    db.commit()

    return ClaSignResponse(
        status="success",
        hotkey=payload.hotkey,
        cla_version=payload.cla_version,
        signed_at=signed_at,
    )
