### 4. CLA Domain Logic & Builders

`apps/platform/ditto/api_server/cla_service.py`:
```python
import hashlib
import logging
import time
from datetime import datetime, timezone
from pathlib import Path
from typing import Optional, Tuple

from fastapi import HTTPException, status
from sqlalchemy.orm import Session

from apps.platform.ditto.api_server.attestation import verify_signature
from apps.platform.ditto.api_server.models.cla import (
    ClaGateHistory,
    ClaSignature,
    ClaVersion,
)

logger = logging.getLogger(__name__)

MAX_ISSUED_AT_DRIFT_SECONDS = 300  # 5-minute freshness window


def build_cla_sign_payload(
    netuid: int,
    cla_version: str,
    cla_sha256: str,
    hotkey: str,
    nonce: str,
    issued_at: int,
) -> str:
    """Byte-for-byte message builder mirrored with CLI."""
    return f"ditto-cla:v1:{netuid}:{cla_version}:{cla_sha256}:{hotkey}:{nonce}:{issued_at}"


def compute_cla_sha256(text: str) -> str:
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


def get_current_gate_mode(db: Session) -> str:
    latest = (
        db.query(ClaGateHistory)
        .order_by(ClaGateHistory.changed_at.desc(), ClaGateHistory.id.desc())
        .first()
    )
    return latest.mode if latest else "off"


def set_gate_mode(db: Session, mode: str, changed_by: Optional[str] = None, reason: Optional[str] = None) -> ClaGateHistory:
    if mode not in {"off", "shadow", "enforce"}:
        raise ValueError(f"Invalid mode: {mode}. Must be 'off', 'shadow', or 'enforce'.")
    entry = ClaGateHistory(
        mode=mode,
        changed_by=changed_by,
        reason=reason,
        changed_at=datetime.now(timezone.utc),
    )
    db.add(entry)
    db.commit()
    db.refresh(entry)
    return entry


def get_current_effective_cla(db: Session) -> Optional[ClaVersion]:
    now = datetime.now(timezone.utc)
    return (
        db.query(ClaVersion)
        .filter(ClaVersion.effective_at <= now)
        .order_by(ClaVersion.effective_at.desc(), ClaVersion.id.desc())
        .first()
    )


def resolve_coldkey_for_hotkey(hotkey: str) -> str:
    """Resolves owner coldkey for hotkey from chain or attestation link."""
    # Stub resolves directly or via substrate metagraph. Fallback to hotkey when standalone.
    return hotkey


def verify_and_store_signature(
    db: Session,
    netuid: int,
    hotkey: str,
    cla_version: str,
    cla_sha256: str,
    nonce: str,
    issued_at: int,
    signature: str,
) -> ClaSignature:
    # 1. Version and digest check against registry
    registered_version = (
        db.query(ClaVersion).filter(ClaVersion.version == cla_version).first()
    )
    if not registered_version:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail=f"CLA version '{cla_version}' is not registered on Platform.",
        )
    if registered_version.sha256.lower() != cla_sha256.lower():
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail=f"CLA digest mismatch. Expected '{registered_version.sha256}', received '{cla_sha256}'.",
        )

    # 2. Freshness check
    now_ts = int(time.time())
    if abs(now_ts - issued_at) > MAX_ISSUED_AT_DRIFT_SECONDS:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail=f"Issued timestamp is stale or skewed: {issued_at} (current: {now_ts}).",
        )

    # 3. Nonce uniqueness
    existing_nonce = (
        db.query(ClaSignature).filter(ClaSignature.nonce == nonce).first()
    )
    if existing_nonce:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail=f"Nonce '{nonce}' has already been used.",
        )

    # 4. Cryptographic signature check
    payload_str = build_cla_sign_payload(
        netuid=netuid,
        cla_version=cla_version,
        cla_sha256=cla_sha256,
        hotkey=hotkey,
        nonce=nonce,
        issued_at=issued_at,
    )
    payload_bytes = payload_str.encode("utf-8")

    is_valid = verify_signature(
        message=payload_bytes,
        signature=signature,
        hotkey=hotkey,
    )
    if not is_valid:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="Signature verification failed for provided hotkey.",
        )

    coldkey = resolve_coldkey_for_hotkey(hotkey)

    # 5. Append-only storage
    row = ClaSignature(
        hotkey=hotkey,
        coldkey=coldkey,
        cla_version=cla_version,
        cla_sha256=cla_sha256,
        signature=signature,
        nonce=nonce,
        issued_at=issued_at,
        signed_at=datetime.now(timezone.utc),
    )
    db.add(row)
    db.commit()
    db.refresh(row)
    return row


def evaluate_hotkey_cla_status(db: Session, hotkey: str) -> Tuple[bool, Optional[ClaSignature], Optional[ClaVersion]]:
    """Returns (is_current, latest_signature, current_effective_version)."""
    current_version = get_current_effective_cla(db)
    if not current_version:
        return False, None, None

    latest_sig = (
        db.query(ClaSignature)
        .filter(
            ClaSignature.hotkey == hotkey,
            ClaSignature.cla_version == current_version.version,
            ClaSignature.cla_sha256 == current_version.sha256,
        )
        .order_by(ClaSignature.signed_at.desc(), ClaSignature.id.desc())
        .first()
    )
    if latest_sig:
        return True, latest_sig, current_version

    # Check if signed any previous version
    any_sig = (
        db.query(ClaSignature)
        .filter(ClaSignature.hotkey == hotkey)
        .order_by(ClaSignature.signed_at.desc(), ClaSignature.id.desc())
        .first()
    )
    return False, any_sig, current_version


def enforce_cla_gate_for_hotkey(db: Session, hotkey: str) -> None:
    """Enforces upload gate depending on gate mode (off, shadow, enforce)."""
    mode = get_current_gate_mode(db)
    if mode == "off":
        return

    is_current, latest_sig, current_version = evaluate_hotkey_cla_status(db, hotkey)
    if is_current:
        return

    expected_v = current_version.version if current_version else "current"

    if mode == "shadow":
        logger.warning(
            "CLA shadow check: hotkey '%s' has not signed effective CLA version %s. Permitting upload under shadow mode.",
            hotkey,
            expected_v,
        )
        return

    if mode == "enforce":
        signed_v = latest_sig.cla_version if latest_sig else "none"
        raise HTTPException(
            status_code=status.HTTP_403_FORBIDDEN,
            detail=(
                f"CLA signature required for hotkey '{hotkey}'. Currently effective version: '{expected_v}', "
                f"signed: '{signed_v}'. Please run `uv run ditto cla sign` to proceed."
            ),
        )


# Bounty PR CLA verification sketch (#2871)
async def check_github_pr_cla_status(github_username: str, db: Session) -> dict:
    """
    Stretch interface sketch for #2871:
    Resolves PR author -> linked hotkey -> current CLA signature status.
    """
    # linked_hotkey = await resolve_github_user_to_hotkey(github_username)
    linked_hotkey = None
    if not linked_hotkey:
        return {
            "github_username": github_username,
            "status": "unlinked",
            "message": "GitHub account is not linked to any hotkey.",
        }
    is_current, sig, eff = evaluate_hotkey_cla_status(db, linked_hotkey)
    return {
        "github_username": github_username,
        "hotkey": linked_hotkey,
        "has_signed_current": is_current,
        "status": "passed" if is_current else "failed",
    }
