"""Mirrored action string builders for CLA cryptographic signing."""

from __future__ import annotations


def build_cla_sign_message(
    netuid: int | str,
    cla_version: str,
    cla_sha256: str,
    hotkey: str,
    nonce: str,
    issued_at: int | str,
) -> str:
    """Build byte-for-byte canonical message for CLA signing.

    Format:
    ditto-cla:v1:<netuid>:<cla_version>:<cla_sha256>:<hotkey>:<nonce>:<issued_at>
