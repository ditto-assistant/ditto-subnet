"""Miner CLI commands for inspecting and signing the Contributor License Agreement."""

import hashlib
import json
import os
import sys
import time
import uuid
import click
import requests
from substrateinterface import Keypair

DEFAULT_PLATFORM_URL = os.getenv("DITTO_PLATFORM_URL", "http://localhost:8000")
DEFAULT_NETUID = int(os.getenv("NETUID", "118"))


def build_cla_signing_message(
    netuid: int,
    cla_version: str,
    cla_sha256: str,
    hotkey: str,
    nonce: str,
    issued_at: int,
) -> str:
    return f"ditto-cla:v1:{netuid}:{cla_version}:{cla_sha256}:{hotkey}:{nonce}:{issued_at}"


@click.group()
def cla():
    """Manage Contributor License Agreement (CLA) signatures."""
    pass


@cla.command("status")
@click.option(
    "--hotkey",
    required=False,
    help="Hotkey SS58 address to check. Defaults to active wallet hotkey.",
)
@click.option(
    "--platform-url",
    default=DEFAULT_PLATFORM_URL,
    help="Ditto Platform API base URL.",
)
def status_cmd(hotkey: str | None, platform_url: str):
    """Check the CLA signature status for a hotkey."""
    if not hotkey:
        wallet_hotkey_path = os.path.expanduser("~/.bittensor/wallets/default/hotkeys/default")
        if os.path.exists(wallet_hotkey_path):
            try:
                with open(wallet_hotkey_path) as f:
                    data = json.load(f)
                    hotkey = data.get("ss58Address")
            except Exception:
                pass
    if not hotkey:
        click.echo("Error: --hotkey is required or default wallet hotkey must exist.", err=True)
        sys.exit(1)

    url = f"{platform_url.rstrip('/')}/api/v1/cla/status/{hotkey}"
    try:
        resp = requests.get(url, timeout=10)
        resp.raise_for_status()
    except Exception as e:
        click.echo(f"Error querying CLA status from {url}: {e}", err=True)
        sys.exit(1)

    data = resp.json()
    click.echo(f"Hotkey:        {data.get('hotkey')}")
    click.echo(f"Signed:        {'Yes' if data.get('signed') else 'No'}")
    if data.get("signed"):
        click.echo(f"Version:       {data.get('version')}")
        click.echo(f"SHA-256:       {data.get('digest')}")
        click.echo(f"Current:       {'Yes' if data.get('is_current') else 'No (re-signing required)'}")
        click.echo(f"Signed At:     {data.get('signed_at')}")
        click.echo(f"Signature:     {data.get('signature')}")
    else:
        click.echo("Run 'uv run ditto cla sign' to sign the current agreement.")


@cla.command("sign")
@click.option(
    "--wallet-name",
    default="default",
    help="Bittensor wallet name.",
)
@click.option(
    "--hotkey-name",
    default="default",
    help="Bittensor wallet hotkey name.",
)
@click.option(
    "--netuid",
    default=DEFAULT_NETUID,
    help="Subnet netuid (default 118).",
)
@click.option(
    "--platform-url",
    default=DEFAULT_PLATFORM_URL,
    help="Ditto Platform API base URL.",
)
@click.option(
    "--yes",
    is_flag=True,
    help="Automatically confirm agreement without interactive prompt.",
)
def sign_cmd(wallet_name: str, hotkey_name: str, netuid: int, platform_url: str, yes: bool):
    """View and sign the currently effective Contributor License Agreement."""
    # 1. Fetch current CLA from platform
    current_url = f"{platform_url.rstrip('/')}/api/v1/cla/current"
    try:
        resp = requests.get(current_url, timeout=10)
        resp.raise_for_status()
        cla_info = resp.json()
    except Exception as e:
        click.echo(f"Error fetching current CLA from {current_url}: {e}", err=True)
        sys.exit(1)

    cla_text = cla_info["text"]
    expected_sha256 = cla_info["sha256"].lower()
    cla_version = cla_info["version"]

    # 2. Recompute SHA-256 digest
    computed_sha256 = hashlib.sha256(cla_text.encode("utf-8")).hexdigest().lower()
    if computed_sha256 != expected_sha256:
        click.echo(
            f"Error: CLA text digest mismatch!\n"
            f"  Expected: {expected_sha256}\n"
            f"  Computed: {computed_sha256}\n"
            f"Refusing to sign.",
            err=True,
        )
        sys.exit(1)

    # 3. Present CLA and prompt
    click.echo("=" * 60)
    click.echo(f"Ditto Contributor License Agreement ({cla_version})")
    click.echo(f"SHA-256 Digest: {computed_sha256}")
    click.echo("=" * 60)
    click.echo(cla_text)
    click.echo("=" * 60)

    if not yes:
        confirmation = click.prompt(
            "Type 'I AGREE' to sign the Contributor License Agreement",
            type=str,
        )
        if confirmation.strip() != "I AGREE":
            click.echo("Signing aborted.")
            sys.exit(1)

    # 4. Load hotkey keypair
    keypair = None
    hotkey_path = os.path.expanduser(f"~/.bittensor/wallets/{wallet_name}/hotkeys/{hotkey_name}")
    if os.path.exists(hotkey_path):
        try:
            with open(hotkey_path) as f:
                content = json.load(f)
                secret_seed = content.get("secretSeed") or content.get("secretKey")
                if secret_seed:
                    keypair = Keypair.create_from_seed(secret_seed)
                elif "ss58Address" in content:
                    keypair = Keypair(ss58_address=content["ss58Address"])
        except Exception:
            pass

    if keypair is None:
        # Fallback to test / mock keypair if wallet not found locally
        keypair = Keypair.create_from_mnemonic(Keypair.generate_mnemonic())
        click.echo(f"Using ephemeral test keypair with hotkey: {keypair.ss58_address}")

    hotkey = keypair.ss58_address
    nonce = uuid.uuid4().hex
    issued_at = int(time.time())

    # 5. Build signed message and sign with sr25519
    message = build_cla_signing_message(
        netuid=netuid,
        cla_version=cla_version,
        cla_sha256=computed_sha256,
        hotkey=hotkey,
        nonce=nonce,
        issued_at=issued_at,
    )
    sig_bytes = keypair.sign(message.encode("utf-8"))
    signature = f"0x{sig_bytes.hex()}"

    # 6. Post signature to platform
    sign_url = f"{platform_url.rstrip('/')}/api/v1/cla/sign"
    payload = {
        "hotkey": hotkey,
        "cla_version": cla_version,
        "cla_sha256": computed_sha256,
        "nonce": nonce,
        "issued_at": issued_at,
        "signature": signature,
        "netuid": netuid,
    }

    try:
        sign_resp = requests.post(sign_url, json=payload, timeout=10)
        sign_resp.raise_for_status()
        res = sign_resp.json()
        click.echo("Successfully signed CLA!")
        click.echo(f"Hotkey:     {res.get('hotkey')}")
        click.echo(f"Coldkey:    {res.get('coldkey')}")
        click.echo(f"Version:    {res.get('cla_version')}")
        click.echo(f"Signed At:  {res.get('signed_at')}")
    except Exception as e:
        click.echo(f"Error submitting signature to platform: {e}", err=True)
        sys.exit(1)
