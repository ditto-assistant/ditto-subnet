@pytest.fixture
def db_session(monkeypatch):
    engine = create_engine("sqlite:///:memory:")
    Base.metadata.create_all(engine)
    Session = sessionmaker(bind=engine)
    session = Session()

    # Mock signature verification and coldkey resolution for tests
    def mock_verify_signature(message, signature, hotkey):
        return signature == "valid_sig" and hotkey == "5GrwvaEF5zXb26Fz9rcQpDWS57CtERHpNehXCPcNoHGKutQY"

    monkeypatch.setattr("apps.platform.ditto.api_server.cla.verify_signature", mock_verify_signature)
    monkeypatch.setattr("apps.platform.ditto.api_server.cla.get_hotkey_owner", lambda hk: f"coldkey_of_{hk}")

    yield session
    session.close()


def test_cla_signatures_append_only(db_session):
    """Test that CLASignature prevents any update or delete operations."""
    sig = CLASignature(
        hotkey="5GrwvaEF5zXb26Fz9rcQpDWS57CtERHpNehXCPcNoHGKutQY",
        coldkey="coldkey_1",
        cla_version="v1",
        cla_sha256="abc",
        signature="valid_sig",
        nonce="nonce-1",
        issued_at=int(time.time()),
    )
    db_session.add(sig)
    db_session.commit()

    # Test update prevention
    sig.signature = "tampered"
    with pytest.raises(PermissionError, match="append-only"):
        db_session.commit()
    db_session.rollback()

    # Test delete prevention
    db_session.delete(sig)
    with pytest.raises(PermissionError, match="append-only"):
        db_session.commit()
    db_session.rollback()


def test_upload_gate_modes_and_signing_validation(db_session):
    text = "Placeholder legal fixture for testing"
    digest = hashlib.sha256(text.encode("utf-8")).hexdigest()
    cla_v1 = CLAVersion(version="v1", sha256=digest, text=text)
    db_session.add(cla_v1)
    db_session.commit()

    valid_hotkey = "5GrwvaEF5zXb26Fz9rcQpDWS57CtERHpNehXCPcNoHGKutQY"
    invalid_hotkey = "5FHneW46xGXgs5mUiveU4sbTyGBzmstUspZC92UhjJM694ty"

    # 1. Gate mode 'off': allows unsigned
    set_cla_gate_mode(db_session, "off")
    enforce_cla_gate(valid_hotkey, db_session)

    # 2. Gate mode 'shadow': logs but does not raise
    set_cla_gate_mode(db_session, "shadow")
    enforce_cla_gate(valid_hotkey, db_session)

    # 3. Gate mode 'enforce': raises 403 on unsigned hotkey
    set_cla_gate_mode(db_session, "enforce")
    with pytest.raises(HTTPException) as exc_info:
        enforce_cla_gate(valid_hotkey, db_session)
    assert exc_info.value.status_code == 403

    # 4. Valid signature execution
    now = int(time.time())
    sig = verify_and_record_cla_signature(
        db=db_session,
        netuid=118,
        cla_version="v1",
        cla_sha256=digest,
        hotkey=valid_hotkey,
        nonce="n1",
        issued_at=now,
        signature="valid_sig",
    )
    assert sig.coldkey == f"coldkey_of_{valid_hotkey}"

    # Now enforce allows the signed hotkey
    enforce_cla_gate(valid_hotkey, db_session)

    # 5. Outdated version test: new version v2 published
    cla_v2 = CLAVersion(version="v2", sha256="deadbeef", text="V2 text")
    db_session.add(cla_v2)
    db_session.commit()
    with pytest.raises(HTTPException):
        enforce_cla_gate(valid_hotkey, db_session)

    # 6. Replayed nonce rejection
    with pytest.raises(ValueError, match="nonce has already been used"):
        verify_and_record_cla_signature(
            db=db_session,
            netuid=118,
            cla_version="v1",
            cla_sha256=digest,
            hotkey=valid_hotkey,
            nonce="n1",
            issued_at=now,
            signature="valid_sig",
        )

    # 7. Stale issued_at rejection
    with pytest.raises(ValueError, match="freshness window"):
        verify_and_record_cla_signature(
            db=db_session,
            netuid=118,
            cla_version="v1",
            cla_sha256=digest,
            hotkey=valid_hotkey,
            nonce="n2",
            issued_at=now - 500,
            signature="valid_sig",
        )

    # 8. Wrong signer rejection
    with pytest.raises(ValueError, match="Invalid cryptographic signature"):
        verify_and_record_cla_signature(
            db=db_session,
            netuid=118,
            cla_version="v1",
            cla_sha256=digest,
            hotkey=invalid_hotkey,
            nonce="n3",
            issued_at=now,
            signature="bad_sig",
        )


def test_backroom_mcp_tool(db_session):
    set_cla_gate_mode(db_session, "off", changed_by="admin", reason="initial")
    set_cla_gate_mode(db_session, "shadow", changed_by="admin", reason="rollout")

    active_hotkeys = ["hk1", "hk2", "hk3"]
    stats = get_cla_gate_status_and_adoption(db_session, active_hotkeys)

    assert stats["current_gate_mode"] == "shadow"
    assert len(stats["history"]) == 2
    assert stats["adoption"]["total_active_hotkeys"] == 3
    assert stats["adoption"]["signed_active_hotkeys"] == 0
