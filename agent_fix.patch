### 4. Canonical Message Builder & Attestation Verification

```python
# apps/platform/ditto/api_server/attestation.py
import time
from typing import Optional
from substrateinterface import Keypair


def build_cla_message(
    netuid: int,
    cla_version: str,
    cla_sha256: str,
    hotkey: str,
    nonce: str,
    issued_at: int,
) -> str:
    """Build the canonical signing message byte-for-byte mirrored between CLI and Platform."""
    return f"ditto-cla:v1:{netuid}:{cla_version}:{cla_sha256}:{hotkey}:{nonce}:{issued_at}"


def verify_signature(message: str | bytes, signature: str, hotkey: str) -> bool:
    """Verify an sr25519 signature from a Substrate ss58 hotkey address."""
    try:
        data = message.encode("utf-8") if isinstance(message, str) else message
        sig_str = signature.strip()
        if sig_str.startswith("0x"):
            sig_str = sig_str[2:]
        sig_bytes = bytes.fromhex(sig_str)
        keypair = Keypair(ss58_address=hotkey)
        return bool(keypair.verify(data, sig_bytes))
    except Exception:
        return False


def resolve_hotkey_owner(hotkey: str, subtensor_client: Optional[object] = None) -> str:
    """Resolve coldkey = Owner(hotkey) at a finalized block."""
    if subtensor_client is not None:
        try:
            owner = subtensor_client.get_hotkey_owner(hotkey)  # type: ignore[attr-defined]
            if owner:
                return str(owner)
        except Exception:
            pass
    return hotkey
