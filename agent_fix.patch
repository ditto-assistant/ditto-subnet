"""Upload endpoints with CLA gate enforcement."""

from fastapi import APIRouter, Depends, HTTPException, status
from sqlalchemy.orm import Session
from apps.platform.ditto.api_server.db import get_db
from apps.platform.ditto.api_server.cla.service import check_upload_cla_gate

router = APIRouter(prefix="/api/v1/upload", tags=["upload"])


@router.post("/check")
async def upload_check(payload: dict, db: Session = Depends(get_db)):
    hotkey = payload.get("hotkey")
    if not hotkey:
        raise HTTPException(status_code=400, detail="Missing hotkey")

    allowed, err_msg = check_upload_cla_gate(db, hotkey)
    if not allowed:
        raise HTTPException(status_code=status.HTTP_403_FORBIDDEN, detail=err_msg)

    return {"status": "ok", "can_upload": True}


@router.post("/agent")
async def upload_agent(payload: dict, db: Session = Depends(get_db)):
    hotkey = payload.get("hotkey")
    if not hotkey:
        raise HTTPException(status_code=400, detail="Missing hotkey")

    allowed, err_msg = check_upload_cla_gate(db, hotkey)
    if not allowed:
        raise HTTPException(status_code=status.HTTP_403_FORBIDDEN, detail=err_msg)

    # Continue normal agent packaging/upload validation
    return {"status": "success", "agent_id": payload.get("agent_id", "mock-agent")}
