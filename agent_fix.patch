### 6. Submission Gate in Platform Upload Endpoints

```python
# apps/platform/ditto/api_server/endpoints/upload.py
import logging
from datetime import datetime, timezone
from fastapi import APIRouter, Depends, HTTPException, status
from pydantic import BaseModel
from sqlalchemy.orm import Session

from ..models import CLAVersion, CLASignature, CLAGateSetting, CLAUploadLog

logger = logging.getLogger("ditto.cla_gate")
router = APIRouter(prefix="/api/v1/upload", tags=["upload"])


def verify_cla_submission_gate(hotkey: str, db: Session) -> None:
    """Gate check before agent or check upload.
    
    Modes:
      - off: No gate enforcement.
      - shadow: Log and count unsigned uploads, but permit them.
      - enforce: Refuse hotkey without valid signature for currently effective CLA version.
    """
    setting = db.query(CLAGateSetting).order_by(CLAGateSetting.id.desc()).first()
    mode = setting.mode if setting else "off"

    if mode == "off":
        return

    now = datetime.now(timezone.utc)
    current_ver = (
        db.query(CLAVersion)
        .filter(CLAVersion.effective_at <= now)
        .order_by(CLAVersion.effective_at.desc(), CLAVersion.id.desc())
        .first()
    )
    if not current_ver:
        return

    # Check for valid signature matching currently effective CLA version and sha256
    sig = (
        db.query(CLASignature)
        .filter(
            CLASignature.hotkey == hotkey,
            CLASignature.cla_version == current_ver.version,
            CLASignature.cla_sha256 == current_ver.sha256,
        )
        .first()
    )

    if sig:
        return

    # Hotkey has not signed the current version
    if mode == "shadow":
        log_entry = CLAUploadLog(
            hotkey=hotkey,
            mode="shadow",
            status="unsigned_allowed",
            cla_version=current_ver.version,
        )
        db.add(log_entry)
        db.commit()
        logger.warning(
            f"[CLA Gate - SHADOW] Hotkey {hotkey} uploaded without signing active CLA {current_ver.version}."
        )
        return

    if mode == "enforce":
        log_entry = CLAUploadLog(
            hotkey=hotkey,
            mode="enforce",
            status="unsigned_blocked",
            cla_version=current_ver.version,
        )
        db.add(log_entry)
        db.commit()
        raise HTTPException(
            status_code=status.HTTP_403_FORBIDDEN,
            detail=(
                f"Hotkey {hotkey} has not signed the current Contributor License Agreement "
                f"({current_ver.version}). Please run 'ditto cla sign' before submitting."
            ),
        )


class UploadCheckRequest(BaseModel):
    hotkey: str


class UploadAgentRequest(BaseModel):
    hotkey: str
    agent_name: str
    artifact_hash: str


@router.post("/check")
def upload_check(req: UploadCheckRequest, db: Session = Depends()):
    verify_cla_submission_gate(req.hotkey, db)
    return {"status": "ok", "hotkey": req.hotkey, "eligible": True}


@router.post("/agent")
def upload_agent(req: UploadAgentRequest, db: Session = Depends()):
    verify_cla_submission_gate(req.hotkey, db)
    return {
        "status": "success",
        "hotkey": req.hotkey,
        "agent_name": req.agent_name,
        "artifact_hash": req.artifact_hash,
    }
```

