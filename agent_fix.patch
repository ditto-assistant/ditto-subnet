+from __future__ import annotations
+
+from datetime import datetime, timezone
+from typing import Any, Literal
+from fastapi import APIRouter, Depends, HTTPException, Query, status
+from pydantic import BaseModel, Field
+from sqlalchemy.orm import Session
+
+from apps.platform.ditto.api_server.attestation import (
+    build_cla_sign_message,
+    is_timestamp_fresh,
+    resolve_hotkey_owner,
+    verify_signature,
+)
+from apps.platform.ditto.db.session import get_db
+from apps.platform.ditto.models.cla import CLAGateSetting, CLASignature, CLAVersion
+
+router = APIRouter(prefix="/api/v1/cla", tags=["cla"])
+
+DEFAULT_NETUID = 118
+
+
+class CLACurrentResponse(BaseModel):
+    version: str
+    sha256: str
+    text: str | None
+    published_at: datetime
+    effective_at: datetime
+
+
+class CLASignRequest(BaseModel):
+    hotkey: str = Field(..., description="SS58 miner hotkey address")
+    cla_version: str = Field(..., description="Target CLA version, e.g. 'v1'")
+    cla_sha256: str = Field(..., description="SHA-256 digest of CLA text")
+    signature: str = Field(..., description="Hex sr25519 signature")
+    nonce: str = Field(..., description="Unique nonce string")
+    issued_at: int = Field(..., description="UNIX timestamp in seconds")
+    netuid: int = Field(default=DEFAULT_NETUID, description="Subnet netuid")
+
+
+class CLASignResponse(BaseModel):
+    status: str
+    hotkey: str
+    coldkey: str | None
+    cla_version: str
+    cla_sha256: str
+    signed_at: datetime
+
+
+class CLAStatusResponse(BaseModel):
+    hotkey: str
+    signed: bool
+    version: str | None = None
+    sha256: str | None = None
+    signed_at: datetime | None = None
+    signature: str | None = None
+    is_current: bool = False
+    effective_version: str | None = None
+
+
+class CLAGateSettingUpdate(BaseModel):
+    mode: Literal["off", "shadow", "enforce"]
+    changed_by: str = "operator"
+    note: str | None = None
+
+
+class BountyCLACheckResponse(BaseModel):
+    github_username: str
+    hotkey: str | None
+    cla_signed: bool
+    cla_version: str | None
+    status: Literal["pass", "fail"]
+    message: str
+
+
+def get_effective_cla_version(db: Session) -> CLAVersion | None:
+    now = datetime.now(timezone.utc)
+    return (
+        db.query(CLAVersion)
+        .filter(CLAVersion.effective_at <= now)
+        .order_by(CLAVersion.effective_at.desc(), CLAVersion.id.desc())
+        .first()
+    )
+
+
+def get_current_gate_mode(db: Session) -> str:
+    setting = (
+        db.query(CLAGateSetting)
+        .order_by(CLAGateSetting.id.desc())
+        .first()
+    )
+    return setting.mode if setting else "off"
+
+
+@router.get("/current", response_model=CLACurrentResponse)
+def get_current_cla(db: Session = Depends(get_db)):
+    effective_cla = get_effective_cla_version(db)
+    if not effective_cla:
+        raise HTTPException(
+            status_code=status.HTTP_404_NOT_FOUND,
+            detail="No effective CLA version is currently registered",
+        )
+    return CLACurrentResponse(
+        version=effective_cla.version,
+        sha256=effective_cla.sha256,
+        text=effective_cla.text,
+        published_at=effective_cla.published_at,
+        effective_at=effective_cla.effective_at,
+    )
+
+
+@router.get("/status/{hotkey}", response_model=CLAStatusResponse)
+@router.get("/status", response_model=CLAStatusResponse)
+def get_cla_status(hotkey: str | None = None, db: Session = Depends(get_db)):
+    if not hotkey:
+        raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail="hotkey parameter is required")
+
+    effective_cla = get_effective_cla_version(db)
+    effective_ver = effective_cla.version if effective_cla else None
+    effective_sha = effective_cla.sha256 if effective_cla else None
+
+    sig = (
+        db.query(CLASignature)
+        .filter(CLASignature.hotkey == hotkey)
+        .order_by(CLASignature.id.desc())
+        .first()
+    )
+
+    if not sig:
+        return CLAStatusResponse(
+            hotkey=hotkey,
+            signed=False,
+            is_current=False,
+            effective_version=effective_ver,
+        )
+
+    is_current = (
+        effective_cla is not None
+        and sig.cla_version == effective_ver
+        and sig.cla_sha256 == effective_sha
+    )
+
+    return CLAStatusResponse(
+        hotkey=hotkey,
+        signed=True,
+        version=sig.cla_version,
+        sha256=sig.cla_sha256,
+        signed_at=sig.signed_at,
+        signature=sig.signature,
+        is_current=is_current,
+        effective_version=effective_ver,
+    )
+
+
+@router.post("/sign", response_model=CLASignResponse)
+def sign_cla(req: CLASignRequest, db: Session = Depends(get_db)):
+    # 1. Version registry validation
+    registered_ver = (
+        db.query(CLAVersion)
+        .filter(CLAVersion.version == req.cla_version)
+        .first()
+    )
+    if not registered_ver:
+        raise HTTPException(
+            status_code=status.HTTP_400_BAD_REQUEST,
+            detail=f"CLA version {req.cla_version} is not registered",
+        )
+    if registered_ver.sha256.lower() != req.cla_sha256.lower():
+        raise HTTPException(
+            status_code=status.HTTP_400_BAD_REQUEST,
+            detail=f"Digest mismatch for CLA {req.cla_version}: expected {registered_ver.sha256}, got {req.cla_sha256}",
+        )
+
+    # 2. Freshness window check
+    if not is_timestamp_fresh(req.issued_at):
+        raise HTTPException(
+            status_code=status.HTTP_400_BAD_REQUEST,
+            detail="issued_at is stale or outside the freshness window",
+        )
+
+    # 3. Nonce uniqueness check
+    existing_nonce = (
+        db.query(CLASignature)
+        .filter(CLASignature.nonce == req.nonce)
+        .first()
+    )
+    if existing_nonce:
+        raise HTTPException(
+            status_code=status.HTTP_400_BAD_REQUEST,
+            detail="Replayed nonce: this nonce has already been used",
+        )
+
+    # 4. Signature verification
+    msg = build_cla_sign_message(
+        netuid=req.netuid,
+        cla_version=req.cla_version,
+        cla_sha256=req.cla_sha256,
+        hotkey=req.hotkey,
+        nonce=req.nonce,
+        issued_at=req.issued_at,
+    )
+    if not verify_signature(msg, req.signature, req.hotkey):
+        raise HTTPException(
+            status_code=status.HTTP_400_BAD_REQUEST,
+            detail="Invalid signature or signer does not match hotkey",
+        )
+
+    # 5. Resolve Owner(hotkey) and persist append-only record
+    coldkey = resolve_hotkey_owner(req.hotkey)
+    sig_record = CLASignature(
+        hotkey=req.hotkey,
+        coldkey=coldkey,
+        cla_version=req.cla_version,
+        cla_sha256=req.cla_sha256,
+        signature=req.signature,
+        nonce=req.nonce,
+        issued_at=datetime.fromtimestamp(req.issued_at, tz=timezone.utc),
+        signed_at=datetime.now(timezone.utc),
+    )
+    db.add(sig_record)
+    db.commit()
+    db.refresh(sig_record)
+
+    return CLASignResponse(
+        status="ok",
+        hotkey=sig_record.hotkey,
+        coldkey=sig_record.coldkey,
+        cla_version=sig_record.cla_version,
+        cla_sha256=sig_record.cla_sha256,
+        signed_at=sig_record.signed_at,
+    )
+
+
+@router.post("/gate-setting", response_model=dict[str, Any])
+def update_gate_setting(payload: CLAGateSettingUpdate, db: Session = Depends(get_db)):
+    setting = CLAGateSetting(
+        mode=payload.mode,
+        changed_by=payload.changed_by,
+        note=payload.note,
+        changed_at=datetime.now(timezone.utc),
+    )
+    db.add(setting)
+    db.commit()
+    return {"status": "ok", "mode": payload.mode}
+
+
+@router.get("/check-github/{github_username}", response_model=BountyCLACheckResponse)
+def check_github_pr_cla(github_username: str, db: Session = Depends(get_db)):
+    """
+    Interface sketch for Bounty PR CLA verification (#2871 & #2054).
