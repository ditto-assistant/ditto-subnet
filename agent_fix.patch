# apps/platform/ditto/backroom/cla_tool.py
"""Backroom MCP tool for reading CLA gate setting, setting history, and miner adoption counts."""

from __future__ import annotations

from typing import Any

from sqlalchemy import distinct, func
from sqlalchemy.orm import Session

from apps.platform.ditto.api_server.endpoints.cla import (
    get_active_cla_version,
    get_current_gate_mode,
)
from apps.platform.ditto.db.models.cla import (
    CLAGateSettingHistory,
    CLAShadowUploadLog,
    CLASignature,
)


def get_cla_gate_status_report(
    db: Session, active_hotkeys: list[str] | None = None
) -> dict[str, Any]:
    """Compile the CLA upload gate status, audit history, and adoption metrics.

    Parameters
    ----------
    db : Session
        Active database session.
    active_hotkeys : list[str], optional
        Optional list of active miners from metagraph or upload records. If not provided,
        active hotkeys are gathered from shadow upload logs and signature history.
    """
    mode = get_current_gate_mode(db)
    current_cla = get_active_cla_version(db)
    current_version = current_cla.version if current_cla else None

    # Retrieve setting history
    history_rows = (
        db.query(CLAGateSettingHistory)
        .order_by(CLAGateSettingHistory.id.asc())
        .all()
    )
    history = [
        {
            "id": h.id,
            "mode": h.mode,
            "changed_at": h.changed_at.isoformat() if h.changed_at else None,
            "changed_by": h.changed_by,
            "notes": h.notes,
        }
        for h in history_rows
    ]

    # Determine universe of hotkeys to measure adoption
    if active_hotkeys is not None:
        target_hotkeys = set(active_hotkeys)
    else:
        # Fallback to distinct hotkeys observed in platform
        shadow_hotkeys = [
            row[0]
            for row in db.query(distinct(CLAShadowUploadLog.hotkey)).all()
        ]
        signed_hotkeys = [
            row[0] for row in db.query(distinct(CLASignature.hotkey)).all()
        ]
        target_hotkeys = set(shadow_hotkeys) | set(signed_hotkeys)

    total_active = len(target_hotkeys)

    # Determine signed hotkeys for current version
    if current_version and target_hotkeys:
        signed_query = (
            db.query(distinct(CLASignature.hotkey))
            .filter(
                CLASignature.cla_version == current_version,
                CLASignature.hotkey.in_(target_hotkeys),
            )
            .all()
        )
        signed_count = len(signed_query)
    else:
        signed_count = 0

    unsigned_count = max(0, total_active - signed_count)
    adoption_pct = (
        (signed_count / total_active * 100.0) if total_active > 0 else 0.0
    )

    total_all_time_signatures = db.query(
        func.count(CLASignature.id)
    ).scalar() or 0
    total_shadow_events = db.query(
        func.count(CLAShadowUploadLog.id)
    ).scalar() or 0

    return {
        "gate_mode": mode,
        "current_cla_version": current_version,
        "current_cla_sha256": current_cla.sha256 if current_cla else None,
        "setting_history": history,
        "adoption": {
            "total_active_hotkeys": total_active,
            "signed_active_hotkeys": signed_count,
            "unsigned_active_hotkeys": unsigned_count,
            "adoption_percentage": round(adoption_pct, 2),
            "total_all_time_signatures": total_all_time_signatures,
