def preflight_cla_check(hotkey_ss58: str, platform_url: str):
    """Refuse upload up front if the hotkey has not signed the current CLA."""
    status_url = f"{platform_url.rstrip('/')}/api/v1/cla/status/{hotkey_ss58}"
    try:
        resp = httpx.get(status_url, timeout=5.0)
        if resp.status_code == 200:
            data = resp.json()
            if not data.get("is_current"):
                raise RuntimeError(
                    f"Hotkey {hotkey_ss58} has not signed the currently effective CLA. "
                    "Run 'uv run ditto cla sign' before uploading."
                )
    except RuntimeError:
        raise
    except Exception:
        # Non-blocking network warning if platform endpoint unavailable in local dev
        pass
