+
+def get_cla_gate_backroom_report(db: Session, active_hotkeys: list[str] | None = None) -> dict[str, Any]:
+    """
+    Backroom MCP read tool:
+    Returns gate mode setting, change history, and adoption counts.
+    """
+    # Current setting
+    latest_setting = (
+        db.query(CLAGateSetting)
+        .order_by(CLAGateSetting.id.desc())
+        .first()
+    )
+    current_mode = latest_setting.mode if latest_setting else "off"
+
+    # History
+    history_rows = (
+        db.query(CLAGateSetting)
+        .order_by(CLAGateSetting.changed_at.desc(), CLAGateSetting.id.desc())
+        .all()
+    )
+    history = [
+        {
+            "mode": h.mode,
+            "changed_at": h.changed_at.isoformat() if h.changed_at else None,
+            "changed_by": h.changed_by,
+            "note": h.note,
+        }
+        for h in history_rows
+    ]
+
+    # Currently effective CLA
+    now = datetime.now(timezone.utc)
+    effective_cla = (
+        db.query(CLAVersion)
+        .filter(CLAVersion.effective_at <= now)
+        .order_by(CLAVersion.effective_at.desc(), CLAVersion.id.desc())
+        .first()
+    )
+    eff_version = effective_cla.version if effective_cla else None
+
+    # Adoption stats
+    if active_hotkeys is None:
+        # Distinct hotkeys recorded in signatures
+        active_hotkeys_query = db.query(distinct(CLASignature.hotkey)).all()
+        active_hotkeys = [h[0] for h in active_hotkeys_query]
+
+    signed_active = 0
+    if eff_version and active_hotkeys:
+        signed_query = (
+            db.query(distinct(CLASignature.hotkey))
+            .filter(
+                CLASignature.hotkey.in_(active_hotkeys),
+                CLASignature.cla_version == eff_version,
+            )
+            .all()
+        )
+        signed_active = len(signed_query)
+
+    total_active = len(active_hotkeys)
+    unsigned_active = max(0, total_active - signed_active)
+
+    return {
+        "current_gate_mode": current_mode,
+        "effective_cla_version": eff_version,
+        "effective_cla_sha256": effective_cla.sha256 if effective_cla else None,
+        "history": history,
+        "adoption_counts": {
+            "total_active_hotkeys": total_active,
+            "signed_active_hotkeys": signed_active,
+            "unsigned_active_hotkeys": unsigned_active,
+            "signed_percentage": (signed_active / total_active * 100.0) if total_active > 0 else 0.0,
+        },
+    }
