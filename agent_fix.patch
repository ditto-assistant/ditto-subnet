+"""Server-side CLA logic, verification, and database interactions."""
+from __future__ import annotations
+
+import hashlib
+from typing import Optional, Tuple
+from sqlalchemy import select
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from ditto.api_server.models import CLAVersion, CLASignature, CLAGateSettingsHistory
+from ditto.api_server.attestation import verify_signature, verify_freshness
+
+
+def compute_cla_sha256(text: str) -> str:
+    return hashlib.sha256(text.encode("utf-8")).hexdigest()
+
+
+def build_cla_signature_message(
+    netuid: int,
+    cla_version: str,
+    cla_sha256: str,
+    hotkey: str,
+    nonce: str,
+    issued_at: int,
+) -> str:
+    """Canonical format byte-for-byte mirrored with CLI."""
+    return f"ditto-cla:v1:{netuid}:{cla_version}:{cla_sha256}:{hotkey}:{nonce}:{issued_at}"
+
+
+async def get_current_cla_version(session: AsyncSession) -> Optional[CLAVersion]:
+    """Return the currently effective CLA version."""
+    stmt = select(CLAVersion).order_by(CLAVersion.effective_at.desc()).limit(1)
+    res = await session.execute(stmt)
+    return res.scalar_one_or_none()
+
+
+async def get_cla_gate_mode(session: AsyncSession) -> str:
+    """Return the current CLA gate mode: 'off', 'shadow', or 'enforce'."""
+    stmt = select(CLAGateSettingsHistory).order_by(CLAGateSettingsHistory.changed_at.desc()).limit(1)
+    res = await session.execute(stmt)
+    setting = res.scalar_one_or_none()
+    if not setting or setting.mode not in ("off", "shadow", "enforce"):
+        return "off"
+    return setting.mode
+
+
+async def get_hotkey_cla_signature(
+    session: AsyncSession, hotkey: str, cla_version: Optional[str] = None
+) -> Optional[CLASignature]:
+    """Return the latest signature for the given hotkey and optional cla_version."""
+    stmt = select(CLASignature).where(CLASignature.hotkey == hotkey)
+    if cla_version:
+        stmt = stmt.where(CLASignature.cla_version == cla_version)
+    stmt = stmt.order_by(CLASignature.signed_at.desc()).limit(1)
+    res = await session.execute(stmt)
+    return res.scalar_one_or_none()
+
+
+async def record_cla_signature(
+    session: AsyncSession,
+    netuid: int,
+    hotkey: str,
+    coldkey: Optional[str],
+    cla_version: str,
+    cla_sha256: str,
+    signature: str,
+    nonce: str,
+    issued_at: int,
+) -> CLASignature:
+    """Verify signature, freshness, nonce uniqueness, and insert append-only."""
+    # 1. Verify freshness window
+    if not verify_freshness(issued_at):
+        raise ValueError("Signature issued_at timestamp is outside the freshness window.")
+
+    # 2. Check nonce uniqueness
+    nonce_stmt = select(CLASignature).where(CLASignature.nonce == nonce).limit(1)
+    existing_nonce = (await session.execute(nonce_stmt)).scalar_one_or_none()
+    if existing_nonce:
+        raise ValueError(f"Nonce {nonce} has already been used.")
+
+    # 3. Verify CLA version exists and sha matches
+    v_stmt = select(CLAVersion).where(CLAVersion.version == cla_version).limit(1)
+    cla = (await session.execute(v_stmt)).scalar_one_or_none()
+    if not cla:
+        raise ValueError(f"CLA version {cla_version} is not recognized.")
+    if cla.sha256.lower() != cla_sha256.lower():
+        raise ValueError("CLA sha256 mismatch with platform registry.")
+
+    # 4. Canonical message and signature check
+    expected_message = build_cla_signature_message(
+        netuid=netuid,
+        cla_version=cla_version,
+        cla_sha256=cla_sha256,
+        hotkey=hotkey,
+        nonce=nonce,
+        issued_at=issued_at,
+    )
+    if not verify_signature(expected_message, signature, hotkey):
+        raise ValueError("Cryptographic signature verification failed.")
+
+    # 5. Insert append-only row
+    new_sig = CLASignature(
+        hotkey=hotkey,
+        coldkey=coldkey,
+        cla_version=cla_version,
+        cla_sha256=cla_sha256,
+        signature=signature,
+        nonce=nonce,
+        issued_at=issued_at,
+    )
+    session.add(new_sig)
+    await session.commit()
+    await session.refresh(new_sig)
+    return new_sig
