### 4. Message Construction and Verification Plumbing

`apps/platform/ditto/api_server/cla.py`:
```python
import hashlib
import time
from typing import Optional
from sqlalchemy.orm import Session
from sqlalchemy import desc
from apps.platform.ditto.api_server.models import CLAVersion, CLASignature, CLAGateSettingHistory
from apps.platform.ditto.api_server.attestation import verify_signature, get_hotkey_owner

MAX_ATTESTATION_AGE_SECONDS = 300  # 5 minutes freshness window


def build_cla_sign_message(
    netuid: int,
    cla_version: str,
    cla_sha256: str,
    hotkey: str,
    nonce: str,
    issued_at: int,
) -> str:
    """Byte-for-byte mirrored signed-action message format."""
    return f"ditto-cla:v1:{netuid}:{cla_version}:{cla_sha256}:{hotkey}:{nonce}:{issued_at}"


def compute_cla_sha256(text: str | bytes) -> str:
    if isinstance(text, str):
        text = text.encode("utf-8")
    return hashlib.sha256(text).hexdigest()


def get_current_effective_cla(db: Session) -> Optional[CLAVersion]:
    """Returns the most recent effective CLA version."""
    return (
        db.query(CLAVersion)
        .order_by(desc(CLAVersion.effective_at), desc(CLAVersion.id))
        .first()
    )


def get_cla_gate_mode(db: Session) -> str:
    """Returns the current CLA gate mode: 'off', 'shadow', or 'enforce'. Defaults to 'off'."""
    latest = (
        db.query(CLAGateSettingHistory)
        .order_by(desc(CLAGateSettingHistory.id))
        .first()
    )
    return latest.mode if latest else "off"


def set_cla_gate_mode(
    db: Session, mode: str, changed_by: Optional[str] = None, reason: Optional[str] = None
) -> CLAGateSettingHistory:
    if mode not in ("off", "shadow", "enforce"):
        raise ValueError(f"Invalid mode '{mode}'. Must be 'off', 'shadow', or 'enforce'.")
    record = CLAGateSettingHistory(mode=mode, changed_by=changed_by, reason=reason)
    db.add(record)
    db.commit()
    db.refresh(record)
    return record


def get_hotkey_cla_status(db: Session, hotkey: str) -> dict:
    current_cla = get_current_effective_cla(db)
    current_version = current_cla.version if current_cla else None

    latest_sig = (
        db.query(CLASignature)
        .filter(CLASignature.hotkey == hotkey)
        .order_by(desc(CLASignature.signed_at), desc(CLASignature.id))
        .first()
    )

    is_signed = latest_sig is not None
    is_current = bool(
        latest_sig and current_version and latest_sig.cla_version == current_version
    )

    return {
        "hotkey": hotkey,
        "is_signed": is_signed,
        "is_current": is_current,
        "current_cla_version": current_version,
        "signed_version": latest_sig.cla_version if latest_sig else None,
        "cla_sha256": latest_sig.cla_sha256 if latest_sig else None,
        "signature": latest_sig.signature if latest_sig else None,
        "signed_at": latest_sig.signed_at.isoformat() if latest_sig else None,
    }


def verify_and_record_cla_signature(
    db: Session,
    netuid: int,
    cla_version: str,
    cla_sha256: str,
    hotkey: str,
    nonce: str,
    issued_at: int,
    signature: str,
) -> CLASignature:
    # 1. Check version exists and SHA-256 matches
    version_row = (
        db.query(CLAVersion).filter(CLAVersion.version == cla_version).first()
    )
    if not version_row:
        raise ValueError(f"CLA version '{cla_version}' not found in registry.")
    if version_row.sha256.lower() != cla_sha256.lower():
        raise ValueError("CLA digest does not match registry SHA-256.")

    # 2. Check nonce uniqueness
    existing_nonce = (
        db.query(CLASignature).filter(CLASignature.nonce == nonce).first()
    )
    if existing_nonce:
        raise ValueError("Signature nonce has already been used.")

    # 3. Check freshness window
    current_time = int(time.time())
    if abs(current_time - issued_at) > MAX_ATTESTATION_AGE_SECONDS:
        raise ValueError("Attestation issued_at timestamp is outside the valid freshness window.")

    # 4. Verify cryptographic signature
    message = build_cla_sign_message(
        netuid=netuid,
        cla_version=cla_version,
        cla_sha256=cla_sha256,
        hotkey=hotkey,
        nonce=nonce,
        issued_at=issued_at,
    )
    if not verify_signature(message=message, signature=signature, hotkey=hotkey):
        raise ValueError("Invalid cryptographic signature for hotkey.")

    # 5. Resolve Owner(hotkey) at finalized block
    coldkey = get_hotkey_owner(hotkey)

    # 6. Store append-only signature
    cla_sig = CLASignature(
        hotkey=hotkey,
        coldkey=coldkey,
        cla_version=cla_version,
        cla_sha256=cla_sha256,
        signature=signature,
        nonce=nonce,
        issued_at=issued_at,
    )
    db.add(cla_sig)
    db.commit()
    db.refresh(cla_sig)
    return cla_sig
```

