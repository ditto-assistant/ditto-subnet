### 5. CLA Platform Service: `apps/platform/ditto/api_server/cla_service.py`

```python
"""Business logic for CLA registry, status queries, submission verification, and gate rollout."""

from __future__ import annotations

import datetime
import hashlib
import logging
from typing import Any

from sqlalchemy import desc
from sqlalchemy.orm import Session

from apps.platform.ditto.api_server.attestation import (
    build_cla_message,
    resolve_hotkey_owner,
    validate_issued_at_freshness,
    verify_signature,
)
from apps.platform.ditto.models.cla import CLAGateSetting, CLASignature, CLAVersion

logger = logging.getLogger(__name__)


def get_current_cla_version(db: Session) -> CLAVersion | None:
    now = datetime.datetime.now(datetime.timezone.utc)
    return (
        db.query(CLAVersion)
        .filter(CLAVersion.effective_at <= now)
        .order_by(desc(CLAVersion.effective_at), desc(CLAVersion.id))
        .first()
    )


def register_cla_version(
    db: Session,
    version: str,
    text: str,
    published_at: datetime.datetime | None = None,
    effective_at: datetime.datetime | None = None,
) -> CLAVersion:
    now = datetime.datetime.now(datetime.timezone.utc)
    sha256 = hashlib.sha256(text.encode("utf-8")).hexdigest()
    record = CLAVersion(
        version=version,
        sha256=sha256,
        text=text,
        published_at=published_at or now,
        effective_at=effective_at or now,
    )
    db.add(record)
    db.commit()
    db.refresh(record)
    return record


def get_hotkey_cla_signature(db: Session, hotkey: str, cla_version: str | None = None) -> CLASignature | None:
    query = db.query(CLASignature).filter(CLASignature.hotkey == hotkey)
    if cla_version:
        query = query.filter(CLASignature.cla_version == cla_version)
    return query.order_by(desc(CLASignature.signed_at), desc(CLASignature.id)).first()


def has_signed_current_cla(db: Session, hotkey: str) -> bool:
    current = get_current_cla_version(db)
    if not current:
        return True  # No current CLA configured
    sig = get_hotkey_cla_signature(db, hotkey, cla_version=current.version)
    return sig is not None and sig.cla_sha256 == current.sha256


def get_cla_gate_mode(db: Session) -> str:
    setting = db.query(CLAGateSetting).order_by(desc(CLAGateSetting.id)).first()
    if setting and setting.mode in ("off", "shadow", "enforce"):
        return setting.mode
    return "off"


def set_cla_gate_mode(db: Session, mode: str, changed_by: str | None = None, reason: str | None = None) -> CLAGateSetting:
    if mode not in ("off", "shadow", "enforce"):
        raise ValueError(f"Invalid mode '{mode}'. Must be 'off', 'shadow', or 'enforce'.")
    record = CLAGateSetting(mode=mode, changed_by=changed_by, reason=reason)
    db.add(record)
    db.commit()
    db.refresh(record)
    return record


_shadow_upload_hotkeys: set[str] = set()


def check_upload_cla_gate(hotkey: str, db: Session) -> tuple[bool, str | None]:
    mode = get_cla_gate_mode(db)
    if mode == "off":
        return True, None

    signed = has_signed_current_cla(db, hotkey)
    if not signed:
        if mode == "shadow":
            _shadow_upload_hotkeys.add(hotkey)
            logger.warning(
                f"[CLA Gate Shadow Mode] Unsigned hotkey attempted upload: {hotkey}. Allowed under shadow policy."
            )
            return True, None
        if mode == "enforce":
            err = f"Hotkey {hotkey} has not signed the current CLA. Run `ditto cla sign` to sign before uploading."
            return False, err

    return True, None


def record_cla_signature(
    db: Session,
    netuid: int,
    hotkey: str,
    cla_version: str,
    cla_sha256: str,
    signature: str,
    nonce: str,
    issued_at: int,
    subtensor: Any = None,
) -> CLASignature:
    # 1. Nonce uniqueness check
    existing_nonce = db.query(CLASignature).filter(CLASignature.nonce == nonce).first()
    if existing_nonce is not None:
        raise ValueError("Nonce has already been used.")

    # 2. Freshness check
    if not validate_issued_at_freshness(issued_at):
        raise ValueError("Signature timestamp issued_at is stale or outside the validity window.")

    # 3. CLA version and digest check
    current = get_current_cla_version(db)
    if current is None or current.version != cla_version or current.sha256.lower() != cla_sha256.lower():
        raise ValueError("CLA version or SHA-256 digest does not match the currently effective CLA.")

    # 4. Canonical message and signature verification
    msg = build_cla_message(netuid, cla_version, cla_sha256, hotkey, nonce, issued_at)
    if not verify_signature(msg, signature, hotkey):
        raise ValueError("Invalid signature for the provided hotkey.")

    # 5. Resolve coldkey
    coldkey = resolve_hotkey_owner(hotkey, subtensor=subtensor)

    # 6. Append-only persist
    issued_dt = datetime.datetime.fromtimestamp(issued_at, tz=datetime.timezone.utc)
    sig_record = CLASignature(
        hotkey=hotkey,
        coldkey=coldkey,
        cla_version=cla_version,
        cla_sha256=cla_sha256,
        signature=signature,
        nonce=nonce,
        issued_at=issued_dt,
    )
    db.add(sig_record)
    db.commit()
    db.refresh(sig_record)
    return sig_record
```

