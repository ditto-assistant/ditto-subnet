```python
"""Database models for Contributor License Agreement (CLA) registry and signatures."""

from datetime import datetime
from sqlalchemy import (
    DateTime,
    Index,
    String,
    Text,
    event,
)
from sqlalchemy.orm import Mapped, mapped_column
from ditto.db.base import Base


class CLAVersion(Base):
    """Registry of published CLA versions and their SHA-256 digests."""

    __tablename__ = "cla_versions"

    id: Mapped[int] = mapped_column(primary_key=True, autoincrement=True)
    version: Mapped[str] = mapped_column(String(32), unique=True, nullable=False, index=True)
    sha256: Mapped[str] = mapped_column(String(64), nullable=False)
    content: Mapped[str] = mapped_column(Text, nullable=False)
    published_at: Mapped[datetime] = mapped_column(DateTime(timezone=True), nullable=False)
    effective_at: Mapped[datetime] = mapped_column(DateTime(timezone=True), nullable=False)


class CLASignature(Base):
    """Append-only signatures of CLA executions by miner hotkeys."""

    __tablename__ = "cla_signatures"

    id: Mapped[int] = mapped_column(primary_key=True, autoincrement=True)
    hotkey: Mapped[str] = mapped_column(String(64), nullable=False, index=True)
    coldkey: Mapped[str] = mapped_column(String(64), nullable=False)
    cla_version: Mapped[str] = mapped_column(String(32), nullable=False)
    cla_sha256: Mapped[str] = mapped_column(String(64), nullable=False)
    signature: Mapped[str] = mapped_column(String(256), nullable=False)
    nonce: Mapped[str] = mapped_column(String(64), unique=True, nullable=False)
    issued_at: Mapped[int] = mapped_column(nullable=False)
    signed_at: Mapped[datetime] = mapped_column(DateTime(timezone=True), nullable=False)

    __table_args__ = (
        Index("ix_cla_signatures_hotkey_version", "hotkey", "cla_version"),
    )


class CLAGateSettingAudit(Base):
    """Audit log tracking changes to the CLA gate mode (off, shadow, enforce)."""

    __tablename__ = "cla_gate_settings_audit"

    id: Mapped[int] = mapped_column(primary_key=True, autoincrement=True)
    mode: Mapped[str] = mapped_column(String(32), nullable=False)
    changed_by: Mapped[str] = mapped_column(String(128), nullable=False)
    changed_at: Mapped[datetime] = mapped_column(DateTime(timezone=True), nullable=False)
    reason: Mapped[str | None] = mapped_column(Text, nullable=True)


# Append-only enforcement on CLASignature
@event.listens_for(CLASignature, "before_update")
def receive_before_update(mapper, connection, target):
    raise RuntimeError("CLASignature rows are append-only and cannot be updated.")


@event.listens_for(CLASignature, "before_delete")
def receive_before_delete(mapper, connection, target):
    raise RuntimeError("CLASignature rows are append-only and cannot be deleted.")
```

Make sure `CLAVersion`, `CLASignature`, and `CLAGateSettingAudit` are imported in `apps/platform/ditto/db/models/__init__.py`.

