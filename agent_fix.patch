+"""API endpoints for Contributor License Agreement (CLA)."""
+from __future__ import annotations
+
+from typing import Optional
+from pydantic import BaseModel
+from fastapi import APIRouter, Depends, HTTPException, status
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from ditto.api_server.db import get_db
+from ditto.api_server.models import CLAVersion
+from ditto.api_server.cla import (
+    get_current_cla_version,
+    get_hotkey_cla_signature,
+    record_cla_signature,
+)
+
+router = APIRouter(prefix="/api/v1/cla", tags=["cla"])
+
+
+class CLACurrentResponse(BaseModel):
+    version: str
+    sha256: str
+    published_at: str
+    effective_at: str
+    content: str
+
+
+class CLASignRequest(BaseModel):
+    netuid: int
+    hotkey: str
+    cla_version: str
+    cla_sha256: str
+    signature: str
+    nonce: str
+    issued_at: int
+    coldkey: Optional[str] = None
+
+
+class CLASignResponse(BaseModel):
+    status: str
+    hotkey: str
+    cla_version: str
+    signed_at: str
+
+
+class CLAStatusResponse(BaseModel):
+    hotkey: str
+    signed: bool
+    is_current: bool
+    current_version: Optional[str] = None
+    cla_version: Optional[str] = None
+    sha256: Optional[str] = None
+    signed_at: Optional[str] = None
+    signature: Optional[str] = None
+
+
+@router.get("/current", response_model=CLACurrentResponse)
+async def get_current_cla(db: AsyncSession = Depends(get_db)):
+    current = await get_current_cla_version(db)
+    if not current:
+        raise HTTPException(
+            status_code=status.HTTP_404_NOT_FOUND,
+            detail="No effective CLA version registered.",
+        )
+    return CLACurrentResponse(
+        version=current.version,
+        sha256=current.sha256,
+        published_at=current.published_at.isoformat(),
+        effective_at=current.effective_at.isoformat(),
+        content=current.content,
+    )
+
+
+@router.get("/status/{hotkey}", response_model=CLAStatusResponse)
+async def get_cla_status(hotkey: str, db: AsyncSession = Depends(get_db)):
+    current = await get_current_cla_version(db)
+    sig = await get_hotkey_cla_signature(db, hotkey=hotkey)
+
+    current_ver = current.version if current else None
+    if not sig:
+        return CLAStatusResponse(
+            hotkey=hotkey,
+            signed=False,
+            is_current=False,
+            current_version=current_ver,
+        )
+
+    is_current = bool(current_ver and sig.cla_version == current_ver)
+    return CLAStatusResponse(
+        hotkey=hotkey,
+        signed=True,
+        is_current=is_current,
+        current_version=current_ver,
+        cla_version=sig.cla_version,
+        sha256=sig.cla_sha256,
+        signed_at=sig.signed_at.isoformat() if sig.signed_at else None,
+        signature=sig.signature,
+    )
+
+
+@router.post("/sign", response_model=CLASignResponse)
+async def submit_cla_signature(payload: CLASignRequest, db: AsyncSession = Depends(get_db)):
+    try:
+        sig = await record_cla_signature(
+            session=db,
+            netuid=payload.netuid,
+            hotkey=payload.hotkey,
+            coldkey=payload.coldkey,
+            cla_version=payload.cla_version,
+            cla_sha256=payload.cla_sha256,
+            signature=payload.signature,
+            nonce=payload.nonce,
+            issued_at=payload.issued_at,
+        )
+        return CLASignResponse(
+            status="ok",
+            hotkey=sig.hotkey,
+            cla_version=sig.cla_version,
+            signed_at=sig.signed_at.isoformat(),
+        )
+    except ValueError as err:
+        raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail=str(err))
