            "issued_at": stale_ts,
            "netuid": 118,
        },
    )
    assert res_stale.status_code == 400
    assert "issued_at" in res_stale.json()["detail"]

    # 2. Wrong signer / invalid signature
    now_ts = int(time.time())
    payload = build_cla_signature_payload(
        netuid=118,
        cla_version="v1",
        cla_sha256=cla.sha256,
        hotkey=signer_keypair.ss58_address,
        nonce="n_valid",
        issued_at=now_ts,
