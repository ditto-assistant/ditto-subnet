### 9. Miner CLI Commands: `ditto cla sign` and `ditto cla status`
`ditto/miner_cli/cla.py`
```python
"""CLI commands for CLA operations: sign and status."""

import hashlib
import time
import uuid
import sys
import httpx
from rich.console import Console

from apps.platform.ditto.api_server.cla.service import build_cla_signature_payload

console = Console()


def get_cla_status_cli(api_url: str, hotkey: str) -> None:
    """Fetch and print CLA signing status for hotkey."""
    url = f"{api_url.rstrip('/')}/api/v1/cla/status/{hotkey}"
    try:
        resp = httpx.get(url, timeout=10.0)
        resp.raise_for_status()
        data = resp.json()
    except Exception as e:
        console.print(f"[bold red]Failed to fetch CLA status:[/] {e}")
        sys.exit(1)

    if not data.get("signed"):
        console.print(f"[bold yellow]Hotkey {hotkey} has NOT signed any CLA version.[/]")
        console.print("Run [bold cyan]uv run ditto cla sign[/] to sign.")
        return

    is_current = data.get("is_current")
    status_color = "green" if is_current else "red"
    console.print(f"Hotkey: [bold]{hotkey}[/]")
    console.print(f"Signed Version: [bold]{data.get('cla_version')}[/]")
    console.print(f"Status: [{status_color}]{'CURRENT' if is_current else 'OUTDATED'}[/{status_color}]")
    console.print(f"Digest: {data.get('cla_sha256')}")
    console.print(f"Signed At: {data.get('signed_at')}")

    if not is_current:
        console.print("[bold red]Action required:[/] A newer CLA is published. Run [bold cyan]uv run ditto cla sign[/].")


def sign_cla_cli(api_url: str, netuid: int, keypair, cla_path: str = "docs/legal/CLA-v1.md") -> None:
    """Read CLA text, verify server digest, seek confirmation, sign and post."""
    # 1. Fetch current CLA registry details from Platform
    url_curr = f"{api_url.rstrip('/')}/api/v1/cla/current"
    try:
        curr_resp = httpx.get(url_curr, timeout=10.0)
        curr_resp.raise_for_status()
        curr_info = curr_resp.json()
    except Exception as e:
        console.print(f"[bold red]Failed to query Platform for current CLA:[/] {e}")
        sys.exit(1)

    # 2. Read local CLA text and recompute SHA256
    try:
        with open(cla_path, "rb") as f:
            content = f.read()
    except Exception as e:
        console.print(f"[bold red]Could not read CLA text from '{cla_path}':[/] {e}")
        sys.exit(1)

    local_digest = hashlib.sha256(content).hexdigest()
    if local_digest.lower() != curr_info["sha256"].lower():
        console.print("[bold red]ERROR: SHA-256 digest mismatch![/]")
        console.print(f"Local file digest:  {local_digest}")
        console.print(f"Platform expected: {curr_info['sha256']}")
        console.print("Refusing to sign mismatched text.")
        sys.exit(1)

    # 3. Present CLA and require explicit typed confirmation
    console.print(f"\n[bold]Contributor License Agreement ({curr_info['version']})[/]")
    console.print(f"File: {cla_path}")
    console.print(f"SHA-256: [cyan]{local_digest}[/]\n")
    console.print("[yellow]By typing 'I AGREE', you agree to license your submissions under SN118 MIT terms.[/]")

    confirmation = input("Type 'I AGREE' to confirm: ").strip()
    if confirmation != "I AGREE":
        console.print("[red]Signing cancelled.[/]")
        sys.exit(1)

    # 4. Construct payload and sign with hotkey (sr25519)
    hotkey = keypair.ss58_address
    nonce = str(uuid.uuid4())
    issued_at = int(time.time())

    payload = build_cla_signature_payload(
        netuid=netuid,
        cla_version=curr_info["version"],
        cla_sha256=local_digest,
        hotkey=hotkey,
        nonce=nonce,
        issued_at=issued_at,
    )

    signature = "0x" + keypair.sign(payload.encode("utf-8")).hex()

    # 5. Submit to Platform
    sign_url = f"{api_url.rstrip('/')}/api/v1/cla/sign"
    body = {
        "netuid": netuid,
        "hotkey": hotkey,
        "cla_version": curr_info["version"],
        "cla_sha256": local_digest,
        "nonce": nonce,
        "issued_at": issued_at,
        "signature": signature,
    }

    try:
        submit_resp = httpx.post(sign_url, json=body, timeout=15.0)
        submit_resp.raise_for_status()
    except Exception as e:
        console.print(f"[bold red]Failed to submit signature to Platform:[/] {e}")
        sys.exit(1)

    console.print(f"[bold green]Successfully signed CLA {curr_info['version']} for {hotkey}![/]")
