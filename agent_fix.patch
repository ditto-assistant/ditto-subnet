### 4. Wire Format & Signing Payload Builder

In `ditto/cla_common.py`:
```python
"""Shared payload builders and constants for CLA signatures."""

import hashlib


def build_cla_sign_payload(
    netuid: int,
    cla_version: str,
    cla_sha256: str,
    hotkey: str,
    nonce: str,
    issued_at: int,
) -> str:
    """Build canonical colon-separated signature payload for CLA."""
    return f"ditto-cla:v1:{netuid}:{cla_version}:{cla_sha256}:{hotkey}:{nonce}:{issued_at}"


def compute_cla_sha256(content: str) -> str:
    """Compute normalized SHA-256 hex digest of CLA markdown content."""
    # Normalize CRLF to LF
    normalized = content.replace("\r\n", "\n").encode("utf-8")
    return hashlib.sha256(normalized).hexdigest()
```

