         "cla_version": version,
         "cla_sha256": sha256,
         "signature": sig_hex,
         "nonce": nonce,
         "issued_at": issued_at
     }
     ```
   - Print success:
     `f"Successfully signed CLA {version} with hotkey {hotkey}!"`

