### 4. Attestation & Signature Verification: `apps/platform/ditto/api_server/attestation.py`

```python
"""Signature builder and verification logic for platform attestations and CLA signing."""

from __future__ import annotations

import datetime
import logging
from typing import Any

logger = logging.getLogger(__name__)

FRESHNESS_WINDOW_SECONDS = 600  # 10 minutes


def build_cla_message(
    netuid: int,
    cla_version: str,
    cla_sha256: str,
    hotkey: str,
    nonce: str,
    issued_at: int | str,
) -> str:
    """Byte-for-byte canonical builder for CLA signing payload."""
    return f"ditto-cla:v1:{netuid}:{cla_version}:{cla_sha256}:{hotkey}:{nonce}:{issued_at}"


def verify_signature(message: bytes | str, signature: str, hotkey: str) -> bool:
    """Verifies an sr25519 signature from a hotkey SS58 address."""
    msg_bytes = message.encode("utf-8") if isinstance(message, str) else message
    sig_hex = signature.strip()
    if sig_hex.startswith("0x"):
        sig_hex = sig_hex[2:]

    # Try substrate-interface Keypair
    try:
        from substrateinterface import Keypair  # type: ignore
        keypair = Keypair(ss58_address=hotkey)
        return bool(keypair.verify(msg_bytes, bytes.fromhex(sig_hex)))
    except Exception as exc:
        logger.debug(f"substrate-interface verify failed: {exc}")

    # Fallback to nacl / ed25519 / bittensor if available
    try:
        import bittensor as bt  # type: ignore
        kp = bt.Keypair(ss58_address=hotkey)
        return bool(kp.verify(msg_bytes, bytes.fromhex(sig_hex)))
    except Exception as exc:
        logger.debug(f"bittensor verify failed: {exc}")

    return False


def resolve_hotkey_owner(hotkey: str, subtensor: Any = None) -> str:
    """Resolves owner coldkey for a hotkey."""
    if subtensor is not None:
        try:
            owner = subtensor.get_hotkey_owner(hotkey)
            if owner:
                return str(owner)
        except Exception as exc:
            logger.warning(f"Failed to resolve coldkey via subtensor: {exc}")

    # Fallback default (in tests or detached mode, coldkey maps to hotkey)
    return hotkey


def validate_issued_at_freshness(issued_at: datetime.datetime | int, now: datetime.datetime | None = None) -> bool:
    """Ensures issued_at is within the allowed freshness window."""
    if now is None:
        now = datetime.datetime.now(datetime.timezone.utc)

    if isinstance(issued_at, int):
        issued_dt = datetime.datetime.fromtimestamp(issued_at, tz=datetime.timezone.utc)
    else:
        issued_dt = issued_at if issued_at.tzinfo else issued_at.replace(tzinfo=datetime.timezone.utc)

    delta = abs((now - issued_dt).total_seconds())
    return delta <= FRESHNESS_WINDOW_SECONDS
```

