# ditto/miner_cli/cla.py
import hashlib
import json
import secrets
import time
from pathlib import Path
from typing import Optional

import typer

app = typer.Typer(help="Manage SN118 Contributor License Agreement (CLA) signatures.")


def build_cla_signature_payload(
    netuid: int,
    cla_version: str,
    cla_sha256: str,
    hotkey: str,
    nonce: str,
    issued_at: int,
) -> str:
    return f"ditto-cla:v1:{netuid}:{cla_version}:{cla_sha256}:{hotkey}:{nonce}:{issued_at}"


def _get_keypair(wallet_name: str = "default", hotkey_name: str = "default"):
    try:
        import bittensor as bt
        wallet = bt.wallet(name=wallet_name, hotkey=hotkey_name)
        return wallet.hotkey
    except Exception:
        from substrateinterface import Keypair, KeypairType
        return Keypair.create_from_mnemonic(
            Keypair.generate_mnemonic(),
            crypto_type=KeypairType.SR25519,
        )


@app.command("sign")
def sign_cla_command(
    wallet_name: str = typer.Option("default", "--wallet-name", help="Bittensor wallet name"),
    hotkey_name: str = typer.Option("default", "--hotkey-name", help="Bittensor hotkey name"),
    netuid: int = typer.Option(118, "--netuid", help="Subnet netuid"),
    platform_url: str = typer.Option("http://localhost:8000", "--platform-url", help="Platform API base URL"),
    cla_path: Optional[Path] = typer.Option(None, "--cla-path", help="Local CLA markdown file path"),
    skip_confirm: bool = typer.Option(False, "--yes", "-y", help="Skip confirmation prompt"),
) -> None:
    """Download current CLA, verify checksum, confirm, sign with hotkey, and submit to Platform."""
    import httpx

    current_resp = httpx.get(f"{platform_url}/api/v1/cla/current")
    if current_resp.status_code != 200:
        typer.secho(f"Failed to fetch current CLA from platform: {current_resp.text}", fg=typer.colors.RED)
        raise typer.Exit(code=1)

    cla_data = current_resp.json()
    version = cla_data["version"]
    expected_digest = cla_data["sha256"].lower()
    cla_text = cla_data.get("text", "")

    file_to_check = cla_path or Path(f"docs/legal/CLA-{version}.md")
    if file_to_check.exists():
        file_text = file_to_check.read_text(encoding="utf-8")
        computed_digest = hashlib.sha256(file_text.encode("utf-8")).hexdigest().lower()
        if computed_digest != expected_digest:
            typer.secho(
                f"Digest mismatch! File {file_to_check} digest {computed_digest} != expected {expected_digest}",
                fg=typer.colors.RED,
            )
            raise typer.Exit(code=1)
        cla_text = file_text
    else:
        computed_digest = hashlib.sha256(cla_text.encode("utf-8")).hexdigest().lower()
        if computed_digest != expected_digest:
            typer.secho(
                f"Digest mismatch on platform text! {computed_digest} != {expected_digest}",
                fg=typer.colors.RED,
            )
            raise typer.Exit(code=1)

    typer.echo(f"\n--- Contributor License Agreement ({version}) ---")
    typer.echo(f"Digest: {expected_digest}\n")
    typer.echo(cla_text[:400] + ("\n..." if len(cla_text) > 400 else ""))
    typer.echo("\nBy signing, you warrant IP grants and commercial usage permissions under the CLA.")

    if not skip_confirm:
        confirmation = typer.prompt("Type 'I AGREE' to execute the agreement")
        if confirmation.strip() != "I AGREE":
            typer.secho("Aborted. Typed confirmation did not match 'I AGREE'.", fg=typer.colors.YELLOW)
            raise typer.Exit(code=1)

    keypair = _get_keypair(wallet_name, hotkey_name)
    hotkey = keypair.ss58_address
    nonce = secrets.token_hex(16)
    issued_at = int(time.time())

    payload = build_cla_signature_payload(
        netuid=netuid,
        cla_version=version,
        cla_sha256=expected_digest,
        hotkey=hotkey,
        nonce=nonce,
        issued_at=issued_at,
    )
    sig_raw = keypair.sign(payload.encode("utf-8"))
    signature = f"0x{sig_raw.hex()}" if isinstance(sig_raw, bytes) else str(sig_raw)

    post_resp = httpx.post(
        f"{platform_url}/api/v1/cla/sign",
        json={
            "hotkey": hotkey,
            "cla_version": version,
            "cla_sha256": expected_digest,
            "signature": signature,
            "nonce": nonce,
            "issued_at": issued_at,
            "netuid": netuid,
        },
    )
    if post_resp.status_code != 200:
        typer.secho(f"Platform rejected signature: {post_resp.text}", fg=typer.colors.RED)
        raise typer.Exit(code=1)

    typer.secho(f"Successfully signed CLA {version} for hotkey {hotkey}.", fg=typer.colors.GREEN)


@app.command("status")
def status_cla_command(
    wallet_name: str = typer.Option("default", "--wallet-name", help="Bittensor wallet name"),
    hotkey_name: str = typer.Option("default", "--hotkey-name", help="Bittensor hotkey name"),
    hotkey: Optional[str] = typer.Option(None, "--hotkey", help="Explicit SS58 hotkey address"),
    platform_url: str = typer.Option("http://localhost:8000", "--platform-url", help="Platform API base URL"),
) -> None:
    """Check whether a hotkey has signed the current CLA and show signature details."""
    import httpx

    if not hotkey:
        keypair = _get_keypair(wallet_name, hotkey_name)
        hotkey = keypair.ss58_address

    resp = httpx.get(f"{platform_url}/api/v1/cla/status/{hotkey}")
    if resp.status_code == 404:
        typer.echo(f"Hotkey:         {hotkey}")
        typer.secho("Status:         UNSIGNED", fg=typer.colors.YELLOW)
        typer.echo("Run `uv run ditto cla sign` to sign the CLA.")
        return

    if resp.status_code != 200:
        typer.secho(f"Failed to query status: {resp.text}", fg=typer.colors.RED)
        raise typer.Exit(code=1)

    data = resp.json()
    typer.echo(f"Hotkey:         {hotkey}")
    typer.echo(f"Signed Version: {data.get('version') or data.get('cla_version')}")
    is_current = data.get("is_current", False)
    current_status = "CURRENT" if is_current else "OUTDATED (Re-sign required)"
    color = typer.colors.GREEN if is_current else typer.colors.RED
    typer.secho(f"Current Status: {current_status}", fg=color)
    typer.echo(f"Signed At:      {data.get('signed_at')}")
    typer.echo(f"Digest:         {data.get('digest') or data.get('cla_sha256')}")
    typer.echo(f"Signature:      {data.get('signature')}")
