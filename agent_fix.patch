def check_cla_before_upload(hotkey: str, platform_url: str):
    """Verifies that the hotkey has signed the current CLA before packaging/paying."""
    resp = requests.get(f"{platform_url.rstrip('/')}/api/v1/cla/status/{hotkey}", timeout=10)
    if resp.status_code == 200:
        data = resp.json()
        if not data.get("is_current"):
            raise RuntimeError(
                f"Contributor License Agreement is not signed for hotkey '{hotkey}'. "
                f"Please run `uv run ditto cla sign` before uploading."
            )
