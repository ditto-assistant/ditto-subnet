    return None


def evaluate_bounty_pr_cla(
    db: Session,
    github_username: str,
) -> Dict[str, Any]:
    """Evaluates whether a PR author meets CLA requirements.

    GitHub Actions check workflow calls this endpoint to set PR commit status.
    """
    hotkey = resolve_github_user_hotkey(github_username)
    if not hotkey:
        return {
            "allowed": False,
            "reason": f"GitHub user '{github_username}' has not linked a hotkey (#2871).",
            "status": "missing_link",
        }

    cla_status = get_hotkey_cla_status(db, hotkey)
    if not cla_status["is_current"]:
        return {
            "allowed": False,
            "hotkey": hotkey,
            "reason": "Linked hotkey has not signed the current CLA version.",
            "status": "cla_unsigned",
        }

    return {
        "allowed": True,
        "hotkey": hotkey,
        "cla_version": cla_status["cla_version"],
        "status": "pass",
    }
