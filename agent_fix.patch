"""Tests for CLA migrations, append-only invariants, signature verification, and upload gate modes."""

import datetime
import hashlib
import uuid
import pytest
from sqlalchemy import create_engine, text
from sqlalchemy.orm import sessionmaker

from apps.platform.ditto.api_server.attestation import build_cla_message
from apps.platform.ditto.api_server.cla_service import (
    check_upload_cla_gate,
    get_cla_gate_mode,
    record_cla_signature,
    register_cla_version,
    set_cla_gate_mode,
)
from apps.platform.ditto.backroom.cla_tool import get_cla_gate_status_report
from apps.platform.ditto.models.cla import Base, CLASignature, ReadOnlyTableError


@pytest.fixture
def db_session():
    engine = create_engine("sqlite:///:memory:")
    Base.metadata.create_all(engine)

    # Attach SQLite append-only triggers for direct SQL queries
    with engine.connect() as conn:
        conn.execute(
            text(
                """
                CREATE TRIGGER prevent_cla_signatures_update
                BEFORE UPDATE ON cla_signatures
                BEGIN
                    SELECT RAISE(FAIL, 'cla_signatures table is append-only: updates not allowed');
                END;
                """
            )
        )
        conn.execute(
            text(
                """
                CREATE TRIGGER prevent_cla_signatures_delete
                BEFORE DELETE ON cla_signatures
                BEGIN
                    SELECT RAISE(FAIL, 'cla_signatures table is append-only: deletes not allowed');
                END;
                """
            )
        )
        conn.commit()

    Session = sessionmaker(bind=engine)
    session = Session()
    yield session
    session.close()


def test_append_only_signature_table(db_session):
    """Proves cla_signatures forbids update and delete via ORM and SQL."""
    sig = CLASignature(
        hotkey="5GrwvaEF5zXb26Fz9rcQpDWS57CtERHpNehXCPcNoHGKutQY",
        coldkey="5GrwvaEF5zXb26Fz9rcQpDWS57CtERHpNehXCPcNoHGKutQY",
        cla_version="v1",
        cla_sha256="abc123",
        signature="0x1234",
        nonce="nonce-1",
        issued_at=datetime.datetime.now(datetime.timezone.utc),
    )
    db_session.add(sig)
    db_session.commit()

    # ORM update attempt
    sig.cla_version = "v2"
    with pytest.raises(ReadOnlyTableError):
        db_session.commit()
    db_session.rollback()

    # ORM delete attempt
    with pytest.raises(ReadOnlyTableError):
        db_session.delete(sig)
        db_session.commit()
    db_session.rollback()

    # Raw SQL update attempt
    with pytest.raises(Exception):
        db_session.execute(text("UPDATE cla_signatures SET cla_version = 'v2' WHERE id = 1"))
        db_session.commit()
    db_session.rollback()

    # Raw SQL delete attempt
    with pytest.raises(Exception):
        db_session.execute(text("DELETE FROM cla_signatures WHERE id = 1"))
        db_session.commit()
    db_session.rollback()


def test_upload_gate_modes(db_session):
    """Verifies behavior across off, shadow, and enforce modes."""
    hotkey = "5TestHotkey"
    cla_text = "Placeholder CLA text for testing."
    register_cla_version(db_session, "v1", cla_text)

    # 1. Mode: off -> unsigned hotkey permitted
    set_cla_gate_mode(db_session, "off")
    allowed, err = check_upload_cla_gate(hotkey, db_session)
    assert allowed is True
    assert err is None

    # 2. Mode: shadow -> unsigned hotkey permitted but logged
    set_cla_gate_mode(db_session, "shadow")
    allowed, err = check_upload_cla_gate(hotkey, db_session)
    assert allowed is True
    assert err is None

    # 3. Mode: enforce -> unsigned hotkey rejected with instruction
    set_cla_gate_mode(db_session, "enforce")
    allowed, err = check_upload_cla_gate(hotkey, db_session)
    assert allowed is False
    assert "ditto cla sign" in err

    # 4. Mode: enforce -> signed hotkey accepted
    cla_sha256 = hashlib.sha256(cla_text.encode("utf-8")).hexdigest()
    sig = CLASignature(
        hotkey=hotkey,
        coldkey=hotkey,
        cla_version="v1",
        cla_sha256=cla_sha256,
        signature="0xsig",
        nonce="nonce-valid",
        issued_at=datetime.datetime.now(datetime.timezone.utc),
    )
    db_session.add(sig)
    db_session.commit()

    allowed, err = check_upload_cla_gate(hotkey, db_session)
    assert allowed is True
    assert err is None


def test_re-signing_required_on_new_version(db_session):
    """Publishing a new CLA version invalidates previous version signatures."""
    hotkey = "5TestHotkey"
    register_cla_version(db_session, "v1", "CLA v1")
    set_cla_gate_mode(db_session, "enforce")

    # Sign v1
    v1_hash = hashlib.sha256("CLA v1".encode("utf-8")).hexdigest()
    db_session.add(
        CLASignature(
            hotkey=hotkey,
            coldkey=hotkey,
            cla_version="v1",
            cla_sha256=v1_hash,
            signature="0xsig",
            nonce="nonce-v1",
            issued_at=datetime.datetime.now(datetime.timezone.utc),
        )
    )
    db_session.commit()

    assert check_upload_cla_gate(hotkey, db_session)[0] is True

    # Publish v2
    register_cla_version(db_session, "v2", "CLA v2")

    # Gate must now reject until v2 is signed
    allowed, err = check_upload_cla_gate(hotkey, db_session)
    assert allowed is False
    assert "ditto cla sign" in err


def test_signature_validation_guards(db_session, monkeypatch):
    """Checks nonce replaying, stale issued_at, digest mismatch, and signer validation."""
    hotkey = "5SignerHotkey"
    cla_text = "CLA Content"
    version_rec = register_cla_version(db_session, "v1", cla_text)

    # Mock signature verification
    monkeypatch.setattr(
        "apps.platform.ditto.api_server.cla_service.verify_signature",
        lambda msg, sig, hk: sig == "0xvalidsig" and hk == hotkey,
    )

    now_ts = int(datetime.datetime.now(datetime.timezone.utc).timestamp())
    nonce = str(uuid.uuid4())

    # Successful signing
    record_cla_signature(
        db_session,
        netuid=118,
        hotkey=hotkey,
        cla_version="v1",
        cla_sha256=version_rec.sha256,
        signature="0xvalidsig",
        nonce=nonce,
        issued_at=now_ts,
    )

    # Replayed nonce rejection
    with pytest.raises(ValueError, match="Nonce has already been used"):
        record_cla_signature(
            db_session,
            netuid=118,
            hotkey=hotkey,
            cla_version="v1",
            cla_sha256=version_rec.sha256,
            signature="0xvalidsig",
            nonce=nonce,
            issued_at=now_ts,
        )

    # Stale timestamp rejection (> 10 minutes)
    with pytest.raises(ValueError, match="stale or outside the validity window"):
        record_cla_signature(
            db_session,
            netuid=118,
            hotkey=hotkey,
            cla_version="v1",
            cla_sha256=version_rec.sha256,
            signature="0xvalidsig",
            nonce=str(uuid.uuid4()),
            issued_at=now_ts - 1000,
        )

    # Wrong signer / bad signature rejection
    with pytest.raises(ValueError, match="Invalid signature"):
        record_cla_signature(
            db_session,
            netuid=118,
            hotkey=hotkey,
            cla_version="v1",
            cla_sha256=version_rec.sha256,
            signature="0xbadsig",
            nonce=str(uuid.uuid4()),
            issued_at=now_ts,
        )


