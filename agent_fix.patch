+    # 3. Stale issued_at
+    stale_nonce = str(uuid.uuid4())
+    stale_time = int(time.time()) - 3600
+    stale_msg = build_cla_signature_message(netuid, "v1", digest, alice.ss58_address, stale_nonce, stale_time)
+    stale_sig = f"0x{alice.sign(stale_msg.encode('utf-8')).hex()}"
+    with pytest.raises(ValueError, match="freshness window"):
+        await record_cla_signature(
+            session=db_session,
+            netuid=netuid,
+            hotkey=alice.ss58_address,
+            coldkey=None,
+            cla_version="v1",
+            cla_sha256=digest,
+            signature=stale_sig,
+            nonce=stale_nonce,
+            issued_at=stale_time,
+        )
+
+    # 4. Wrong signer (Bob signs message containing Alice's hotkey)
+    bob_nonce = str(uuid.uuid4())
+    msg_for_alice = build_cla_signature_message(netuid, "v1", digest, alice.ss58_address, bob_nonce, issued_at)
+    bob_sig = f"0x{bob.sign(msg_for_alice.encode('utf-8')).hex()}"
+    with pytest.raises(ValueError, match="verification failed"):
+        await record_cla_signature(
+            session=db_session,
+            netuid=netuid,
+            hotkey=alice.ss58_address,
+            coldkey=None,
+            cla_version="v1",
+            cla_sha256=digest,
+            signature=bob_sig,
+            nonce=bob_nonce,
+            issued_at=issued_at,
+        )
+
+
+@pytest.mark.asyncio
+async def test_upload_gate_modes(db_session: AsyncSession):
+    """Test submission gate across modes: off, shadow, and enforce."""
+    cla_text = "Test CLA v1 content"
+    digest = hashlib.sha256(cla_text.encode("utf-8")).hexdigest()
+    cla_v = CLAVersion(
+        version="v1",
+        sha256=digest,
+        content=cla_text,
+        published_at=datetime.now(timezone.utc),
+        effective_at=datetime.now(timezone.utc),
+    )
+    db_session.add(cla_v)
+    await db_session.commit()
+
+    alice = Keypair.create_from_uri("//Alice").ss58_address
+    bob = Keypair.create_from_uri("//Bob").ss58_address
+
+    # Mode: off -> Alice (unsigned) passes
+    db_session.add(CLAGateSettingsHistory(mode="off"))
+    await db_session.commit()
+    await verify_cla_submission_gate(alice, db_session)
+
+    # Mode: shadow -> Alice (unsigned) passes with warning log
+    db_session.add(CLAGateSettingsHistory(mode="shadow"))
+    await db_session.commit()
+    await verify_cla_submission_gate(alice, db_session)
+
+    # Mode: enforce -> Alice (unsigned) fails with 403
+    db_session.add(CLAGateSettingsHistory(mode="enforce"))
+    await db_session.commit()
+    with pytest.raises(HTTPException) as exc:
+        await verify_cla_submission_gate(alice, db_session)
+    assert exc.value.status_code == 403
+    assert "ditto cla sign" in exc.value.detail
+
+    # Bob signs v1 -> Bob passes under enforce
+    nonce = str(uuid.uuid4())
+    bob_pair = Keypair.create_from_uri("//Bob")
+    msg = build_cla_signature_message(118, "v1", digest, bob, nonce, int(time.time()))
+    sig = f"0x{bob_pair.sign(msg.encode('utf-8')).hex()}"
+    await record_cla_signature(
+        session=db_session,
+        netuid=118,
+        hotkey=bob,
+        coldkey=None,
+        cla_version="v1",
+        cla_sha256=digest,
+        signature=sig,
+        nonce=nonce,
+        issued_at=int(time.time()),
+    )
+    await verify_cla_submission_gate(bob, db_session)
+
+    # Re-signing: New CLA v2 is published -> Bob signed v1 but not v2 -> Bob fails under enforce
+    v2_text = "Test CLA v2 content"
+    v2_digest = hashlib.sha256(v2_text.encode("utf-8")).hexdigest()
+    cla_v2 = CLAVersion(
+        version="v2",
+        sha256=v2_digest,
+        content=v2_text,
+        published_at=datetime.now(timezone.utc),
+        effective_at=datetime.now(timezone.utc),
+    )
+    db_session.add(cla_v2)
+    await db_session.commit()
+
+    with pytest.raises(HTTPException) as exc_v2:
+        await verify_cla_submission_gate(bob, db_session)
+    assert exc_v2.value.status_code == 403
+    assert "v2" in exc_v2.value.detail
+
+
+@pytest.mark.asyncio
+async def test_backroom_cla_gate_tool(db_session: AsyncSession):
+    """Test Backroom MCP read tool reporting gate status, history, and adoption."""
