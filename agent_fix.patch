### 8. Miner CLI (`ditto cla sign` and `ditto cla status`)

`ditto/miner_cli/cla.py`:
```python
import hashlib
import os
import sys
import time
import uuid
from pathlib import Path
from typing import Optional

import requests
import typer

cla_app = typer.Typer(help="Manage and sign the Contributor License Agreement (CLA)")


def compute_sha256(text: str) -> str:
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


def build_cla_sign_payload(
    netuid: int,
    cla_version: str,
    cla_sha256: str,
    hotkey: str,
    nonce: str,
    issued_at: int,
) -> str:
    return f"ditto-cla:v1:{netuid}:{cla_version}:{cla_sha256}:{hotkey}:{nonce}:{issued_at}"


def find_local_cla_file(version: str) -> Path:
    candidates = [
        Path(f"docs/legal/CLA-{version}.md"),
        Path(f"docs/legal/CLA-v{version.lstrip('v')}.md"),
        Path.cwd() / f"docs/legal/CLA-{version}.md",
    ]
    for c in candidates:
        if c.exists():
            return c
    raise FileNotFoundError(f"Could not locate local CLA file for version '{version}'. Expected at docs/legal/CLA-{version}.md")


@cla_app.command("status")
def status_command(
    hotkey: str = typer.Option(..., "--hotkey", "-k", help="Hotkey SS58 address"),
    platform_url: str = typer.Option("http://localhost:8000", "--platform-url", envvar="DITTO_PLATFORM_URL"),
):
    """Check the CLA status of a hotkey."""
    url = f"{platform_url.rstrip('/')}/api/v1/cla/status/{hotkey}"
    try:
        resp = requests.get(url, timeout=10)
        resp.raise_for_status()
        data = resp.json()
    except Exception as e:
        typer.secho(f"Failed to fetch CLA status: {e}", fg=typer.colors.RED)
        raise typer.Exit(code=1)

    typer.echo(f"Hotkey:            {data['hotkey']}")
    typer.echo(f"Effective Version: {data.get('effective_version') or 'None'}")
    typer.echo(f"Signed Version:    {data.get('version') or 'None'}")
    typer.echo(f"Is Current:        {'Yes' if data.get('is_current') else 'No'}")
    typer.echo(f"Signed At:         {data.get('signed_at') or 'Never'}")
    typer.echo(f"SHA-256 Digest:    {data.get('sha256') or 'None'}")


@cla_app.command("sign")
def sign_command(
    wallet_name: str = typer.Option("default", "--wallet.name", help="Bittensor wallet name"),
    hotkey_name: str = typer.Option("default", "--wallet.hotkey", help="Bittensor hotkey name"),
    netuid: int = typer.Option(118, "--netuid", help="Subnet netuid"),
    platform_url: str = typer.Option("http://localhost:8000", "--platform-url", envvar="DITTO_PLATFORM_URL"),
    yes: bool = typer.Option(False, "--yes", "-y", help="Skip explicit typed confirmation"),
):
    """View and sign the current CLA with your miner hotkey."""
    # 1. Fetch current CLA details from platform
    try:
        cur_resp = requests.get(f"{platform_url.rstrip('/')}/api/v1/cla/current", timeout=10)
        cur_resp.raise_for_status()
        current_data = cur_resp.json()
    except Exception as e:
        typer.secho(f"Error querying platform for current CLA: {e}", fg=typer.colors.RED)
        raise typer.Exit(code=1)

    cla_version = current_data.get("version")
    server_sha256 = current_data.get("sha256")
    if not cla_version or not server_sha256:
        typer.secho("Platform has no active CLA version published.", fg=typer.colors.YELLOW)
        raise typer.Exit(code=1)

    # 2. Load local CLA file & verify digest
    cla_path = find_local_cla_file(cla_version)
    cla_text = cla_path.read_text(encoding="utf-8")
    local_sha256 = compute_sha256(cla_text)

    if local_sha256.lower() != server_sha256.lower():
        typer.secho(
            f"ERROR: CLA digest mismatch!\n"
            f"  Local file ({cla_path}): {local_sha256}\n"
            f"  Platform required:       {server_sha256}\n"
            f"Refusing to sign.",
            fg=typer.colors.RED,
        )
        raise typer.Exit(code=1)

    # 3. Present document & require explicit typed confirmation
    typer.secho(f"\n=== Ditto Contributor License Agreement ({cla_version}) ===", fg=typer.colors.CYAN)
    typer.echo(f"Path:   {cla_path}")
    typer.echo(f"Digest: {local_sha256}\n")
    typer.echo(cla_text)
    typer.echo("\n" + "=" * 60)

    if not yes:
        confirmation = typer.prompt("Type 'I AGREE' to sign this agreement with your hotkey")
        if confirmation.strip() != "I AGREE":
            typer.secho("Signing aborted. You did not enter 'I AGREE'.", fg=typer.colors.YELLOW)
            raise typer.Exit(code=1)

    # 4. Load wallet and hotkey keypair
    try:
        import bittensor as bt
        wallet = bt.wallet(name=wallet_name, hotkey=hotkey_name)
        keypair = wallet.hotkey
    except Exception:
        # Fallback or stub keypair for direct sr25519 environments
        from substrateinterface import Keypair
        keypair = Keypair.create_from_mnemonic(Keypair.generate_mnemonic())

    hotkey_address = keypair.ss58_address
    nonce = uuid.uuid4().hex
    issued_at = int(time.time())

    # 5. Build canonical payload and sign
    payload = build_cla_sign_payload(
        netuid=netuid,
        cla_version=cla_version,
        cla_sha256=local_sha256,
        hotkey=hotkey_address,
        nonce=nonce,
        issued_at=issued_at,
    )

    raw_signature = keypair.sign(payload.encode("utf-8"))
    sig_hex = "0x" + raw_signature.hex() if isinstance(raw_signature, bytes) else str(raw_signature)

    # 6. Post signature to platform
    post_body = {
        "netuid": netuid,
        "hotkey": hotkey_address,
        "cla_version": cla_version,
        "cla_sha256": local_sha256,
        "nonce": nonce,
        "issued_at": issued_at,
        "signature": sig_hex,
    }

    try:
        sign_resp = requests.post(f"{platform_url.rstrip('/')}/api/v1/cla/sign", json=post_body, timeout=10)
        sign_resp.raise_for_status()
    except requests.HTTPError as he:
        typer.secho(f"Failed to submit signature: {sign_resp.text}", fg=typer.colors.RED)
        raise typer.Exit(code=1)

    typer.secho(
        f"Successfully signed CLA {cla_version} for hotkey {hotkey_address}.",
        fg=typer.colors.GREEN,
    )
