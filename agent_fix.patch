    if mode == ClaGateMode.OFF:
        return

    effective = get_effective_cla_version(db)
    if not effective:
        return

    has_signed = (
        db.query(ClaSignature)
        .filter(
            ClaSignature.hotkey == hotkey,
            ClaSignature.cla_version == effective.version,
        )
        .first()
    )

    if not has_signed:
        if mode == ClaGateMode.SHADOW:
            logger.warning(
                f"[CLA-SHADOW] Upload received from hotkey {hotkey} without active CLA ({effective.version}) signature."
            )
            return
        elif mode == ClaGateMode.ENFORCE:
            raise HTTPException(
                status_code=status.HTTP_403_FORBIDDEN,
                detail=(
                    f"Hotkey {hotkey} has not signed the current Contributor License Agreement "
                    f"({effective.version}). Run `ditto cla sign` to sign before submitting."
                ),
            )
