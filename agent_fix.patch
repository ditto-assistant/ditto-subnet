+@router.get("/cla-gate")
+async def get_cla_gate_tool(
+    db: AsyncSession = Depends(get_db_session),
+    _admin: User = Depends(require_admin_or_secret),
+) -> Dict[str, Any]:
+    """Backroom tool: inspect CLA gate mode, effective version, adoption stats, and history."""
+    effective_cla = await get_effective_cla_version(db)
+    current_version = effective_cla.version if effective_cla else None
+
+    # Unique hotkeys signed
+    signed_hotkeys_stmt = select(func.count(func.distinct(CLASignature.hotkey)))
+    if current_version:
+        signed_hotkeys_stmt = signed_hotkeys_stmt.where(CLASignature.cla_version == current_version)
+    signed_count = (await db.execute(signed_hotkeys_stmt)).scalar() or 0
+
+    # Total active hotkeys in subtensor metagraph if available
+    subtensor = ServerState.get_subtensor()
+    total_miners = 0
+    unsigned_active_count = 0
+    if subtensor:
+        try:
+            metagraph = subtensor.metagraph(netuid=settings.NETUID)
+            all_hotkeys = set(metagraph.hotkeys)
+            total_miners = len(all_hotkeys)
+            # Find which active hotkeys have signed
+            signed_res = await db.execute(
+                select(CLASignature.hotkey).where(
+                    CLASignature.cla_version == current_version
+                    if current_version
+                    else True
+                )
+            )
+            signed_set = set(signed_res.scalars().all())
+            unsigned_active_count = len(all_hotkeys - signed_set)
+        except Exception:
+            pass
+
+    # History of setting changes
+    audit_stmt = (
+        select(CLAGateSettingAudit)
+        .order_by(CLAGateSettingAudit.created_at.desc())
+        .limit(20)
+    )
+    audit_res = await db.execute(audit_stmt)
+    history = [
+        {
+            "mode": r.mode,
+            "changed_by": r.changed_by,
+            "created_at": r.created_at.isoformat(),
+        }
+        for r in audit_res.scalars().all()
+    ]
+
+    return {
+        "current_mode": get_cla_gate_mode(),
+        "effective_version": current_version,
+        "effective_sha256": effective_cla.sha256 if effective_cla else None,
+        "signed_hotkeys_count": signed_count,
+        "total_active_hotkeys": total_miners,
+        "unsigned_active_hotkeys_count": unsigned_active_count,
+        "history": history,
+    }
+
+
+class SetCLAGateRequest(BaseModel):
+    mode: str
+
+
+@router.post("/cla-gate")
+async def set_cla_gate_tool(
+    body: SetCLAGateRequest,
+    db: AsyncSession = Depends(get_db_session),
+    _admin: User = Depends(require_admin_or_secret),
+) -> Dict[str, Any]:
+    """Backroom tool: update CLA gate mode ('off', 'shadow', 'enforce')."""
+    mode = body.mode.lower()
+    if mode not in ("off", "shadow", "enforce"):
+        raise HTTPException(
+            status_code=status.HTTP_400_BAD_REQUEST,
+            detail="Mode must be 'off', 'shadow', or 'enforce'",
+        )
+
+    set_cla_gate_mode(mode)
+
+    # Log audit
+    audit_entry = CLAGateSettingAudit(
+        mode=mode,
+        changed_by=str(_admin.username if _admin else "admin_secret"),
+    )
+    db.add(audit_entry)
+    try:
+        await db.commit()
+    except Exception:
+        await db.rollback()
+
+    return {
+        "status": "success",
+        "mode": mode,
+    }
