### 4. Platform API Server Logic and Message Builders

#### `apps/platform/ditto/api_server/cla.py`
```python
"""Server-side CLA logic: message construction, attestation verification, and gate check."""

from __future__ import annotations

from datetime import datetime, timezone
import hashlib
import logging
import time

from fastapi import HTTPException, status
from sqlalchemy import desc, select
from sqlalchemy.orm import Session

from ditto.api_server.attestation import verify_signature
from ditto.db.models.cla import CLAGateSetting, CLAShadowLog, CLASignature, CLAVersion

logger = logging.getLogger(__name__)

FRESHNESS_WINDOW_SECONDS = 300  # 5 minutes window matching owner-link attestation


def build_cla_signature_message(
    netuid: int,
    cla_version: str,
    cla_sha256: str,
    hotkey: str,
    nonce: str,
    issued_at: int,
) -> str:
    """Byte-for-byte mirrored message builder."""
    return f"ditto-cla:v1:{netuid}:{cla_version}:{cla_sha256}:{hotkey}:{nonce}:{issued_at}"


def compute_sha256(text: str) -> str:
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


def get_current_cla_version(db: Session) -> CLAVersion | None:
    now = datetime.now(timezone.utc)
    return db.scalars(
        select(CLAVersion)
        .where(CLAVersion.effective_at <= now)
        .order_by(desc(CLAVersion.effective_at), desc(CLAVersion.id))
    ).first()


def get_current_gate_mode(db: Session) -> str:
    setting = db.scalars(
        select(CLAGateSetting).order_by(desc(CLAGateSetting.id))
    ).first()
    return setting.mode if setting else "off"


def set_gate_mode(db: Session, mode: str, changed_by: str = "operator", reason: str = "") -> CLAGateSetting:
    mode = mode.lower()
    if mode not in {"off", "shadow", "enforce"}:
        raise ValueError(f"Invalid mode: {mode}. Must be 'off', 'shadow', or 'enforce'.")
    entry = CLAGateSetting(mode=mode, changed_by=changed_by, reason=reason)
    db.add(entry)
    db.commit()
    db.refresh(entry)
    return entry


def get_latest_hotkey_signature(db: Session, hotkey: str, version: str) -> CLASignature | None:
    return db.scalars(
        select(CLASignature)
        .where(CLASignature.hotkey == hotkey, CLASignature.cla_version == version)
        .order_by(desc(CLASignature.signed_at), desc(CLASignature.id))
    ).first()


def resolve_coldkey(hotkey: str) -> str | None:
    """Resolve Owner(hotkey) at finalized block via subtensor if available."""
    try:
        import bittensor as bt
        sub = bt.subtensor()
        return sub.get_hotkey_owner(hotkey)
    except Exception:
        return None


def verify_and_store_signature(
    db: Session,
    *,
    netuid: int,
    cla_version: str,
    cla_sha256: str,
    hotkey: str,
    nonce: str,
    issued_at: int,
    signature: str,
    coldkey: str | None = None,
) -> CLASignature:
    now_ts = int(time.time())
    if abs(now_ts - issued_at) > FRESHNESS_WINDOW_SECONDS:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail=f"Signature issued_at timestamp {issued_at} is outside freshness window ({FRESHNESS_WINDOW_SECONDS}s).",
        )

    # Check nonce uniqueness
    existing_nonce = db.scalars(select(CLASignature).where(CLASignature.nonce == nonce)).first()
    if existing_nonce is not None:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail=f"Nonce '{nonce}' has already been used.",
        )

    # Check registry match
    version_row = db.scalars(select(CLAVersion).where(CLAVersion.version == cla_version)).first()
    if not version_row:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail=f"CLA version '{cla_version}' not found in registry.",
        )
    if version_row.sha256.lower() != cla_sha256.lower():
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail=f"CLA digest mismatch: registered {version_row.sha256}, provided {cla_sha256}.",
        )

    # Reconstruct message and verify sr25519 signature
    expected_message = build_cla_signature_message(
        netuid=netuid,
        cla_version=cla_version,
        cla_sha256=cla_sha256,
        hotkey=hotkey,
        nonce=nonce,
        issued_at=issued_at,
    )
    if not verify_signature(message=expected_message, signature=signature, ss58_address=hotkey):
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail="Signature verification failed: invalid hotkey signature.",
        )

    if coldkey is None:
        coldkey = resolve_coldkey(hotkey)

    sig_record = CLASignature(
        hotkey=hotkey,
        coldkey=coldkey,
        cla_version=cla_version,
        cla_sha256=cla_sha256,
        signature=signature,
        nonce=nonce,
        issued_at=issued_at,
        signed_at=datetime.now(timezone.utc),
    )
    db.add(sig_record)
    db.commit()
    db.refresh(sig_record)
    return sig_record


def check_cla_gate(hotkey: str, endpoint: str, db: Session) -> None:
    """Enforce or monitor hotkey CLA signature based on platform gate setting."""
    mode = get_current_gate_mode(db)
    if mode == "off":
        return

    effective_cla = get_current_cla_version(db)
    if not effective_cla:
        return

    sig = get_latest_hotkey_signature(db, hotkey=hotkey, version=effective_cla.version)
    has_signed = sig is not None and sig.cla_sha256.lower() == effective_cla.sha256.lower()

    if not has_signed:
        if mode == "shadow":
            logger.warning(
                "CLA shadow mode: hotkey %s uploaded agent to %s without signing current CLA %s",
                hotkey,
                endpoint,
                effective_cla.version,
            )
            shadow_entry = CLAShadowLog(hotkey=hotkey, endpoint=endpoint)
            db.add(shadow_entry)
            db.commit()
            return

        if mode == "enforce":
            raise HTTPException(
                status_code=status.HTTP_403_FORBIDDEN,
                detail=(
                    f"Hotkey '{hotkey}' has not signed the current Contributor License Agreement "
                    f"({effective_cla.version}). Run 'uv run ditto cla sign' to execute the agreement."
                ),
            )
```

