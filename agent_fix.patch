+"""Common message format and verification helpers for CLA signing."""
+
+from __future__ import annotations
+
+import hashlib
+from datetime import datetime, timezone
+
+
+def compute_cla_sha256(cla_text: str | bytes) -> str:
+    """Compute sha256 hex digest for CLA text."""
+    if isinstance(cla_text, str):
+        raw = cla_text.encode("utf-8")
+    else:
+        raw = cla_text
+    return hashlib.sha256(raw).hexdigest()
+
+
+def build_cla_message(
+    *,
+    netuid: int,
+    cla_version: str,
+    cla_sha256: str,
+    hotkey: str,
+    nonce: str,
+    issued_at: datetime | str,
+) -> str:
+    """Format: ditto-cla:v1:<netuid>:<cla_version>:<cla_sha256>:<hotkey>:<nonce>:<issued_at>"""
+    if isinstance(issued_at, datetime):
+        if issued_at.tzinfo is None:
+            issued_at = issued_at.replace(tzinfo=timezone.utc)
+        issued_at_str = issued_at.isoformat()
+    else:
+        issued_at_str = str(issued_at)
+
+    return f"ditto-cla:v1:{netuid}:{cla_version}:{cla_sha256}:{hotkey}:{nonce}:{issued_at_str}"
+
+
+def parse_cla_message(message: str) -> dict[str, str]:
+    """Parse CLA sign message back into constituent fields."""
+    parts = message.split(":")
+    if len(parts) < 8 or parts[0] != "ditto-cla" or parts[1] != "v1":
+        raise ValueError(f"Invalid CLA message format: {message}")
+
+    # Format: ditto-cla : v1 : netuid : cla_version : cla_sha256 : hotkey : nonce : issued_at...
+    # Note: issued_at may contain colons if ISO format includes time timezone
+    netuid = parts[2]
+    cla_version = parts[3]
+    cla_sha256 = parts[4]
+    hotkey = parts[5]
+    nonce = parts[6]
+    issued_at = ":".join(parts[7:])
+    return {
+        "netuid": netuid,
+        "cla_version": cla_version,
+        "cla_sha256": cla_sha256,
+        "hotkey": hotkey,
+        "nonce": nonce,
+        "issued_at": issued_at,
+    }
