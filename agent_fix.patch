    effective_at = Column(DateTime(timezone=True), nullable=False)
    created_at = Column(
        DateTime(timezone=True),
        nullable=False,
        default=lambda: datetime.now(timezone.utc),
    )


class CLASignature(Base):
    __tablename__ = "cla_signatures"

    id = Column(Integer, primary_key=True, autoincrement=True)
    hotkey = Column(String(64), nullable=False, index=True)
    coldkey = Column(String(64), nullable=True)
    cla_version = Column(String(32), nullable=False, index=True)
    cla_sha256 = Column(String(64), nullable=False)
    signature = Column(Text, nullable=False)
    nonce = Column(String(64), nullable=False, unique=True, index=True)
    issued_at = Column(Integer, nullable=False)
