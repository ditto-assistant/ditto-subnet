"""Miner CLI upload integration ensuring CLA check precedes packaging or payments."""

import sys
import httpx
from rich.console import Console

console = Console()


def preflight_cla_check(api_url: str, hotkey: str) -> None:
    """Pre-flight validation before initiating agent packaging or escrow steps."""
    check_url = f"{api_url.rstrip('/')}/api/v1/upload/check"
    try:
        resp = httpx.post(check_url, json={"hotkey": hotkey}, timeout=10.0)
        if resp.status_code == 403:
            detail = resp.json().get("detail", "CLA signature required.")
            console.print(f"[bold red]Upload rejected:[/] {detail}")
            console.print("Run [bold cyan]uv run ditto cla sign[/] to sign the agreement before uploading.")
            sys.exit(1)
        resp.raise_for_status()
    except httpx.HTTPStatusError:
        raise
    except Exception as e:
        console.print(f"[bold red]Unable to verify CLA status with platform:[/] {e}")
        sys.exit(1)
