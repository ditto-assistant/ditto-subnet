# Ditto Subnet environment reference
#
# Copy this file to .env and uncomment the settings needed by the process you
# are running. Never commit mnemonics, API keys, or access tokens.

# --- Miner CLI ---

# DITTO_NETWORK=finney
# DITTO_SUBTENSOR_CHAIN_ENDPOINT=ws://<subtensor-host>:9944
# DITTO_LOCAL_API_URL=http://127.0.0.1:8000
# WALLET_NAME=default
# HOTKEY_NAME=default

# --- Validator chain settings ---

# Compose hardcodes SN118. For local testing, explicitly replace both the
# platform URL and chain target; do not reuse the production .env.
SUBTENSOR_NETWORK=finney
# Gradual rollout: screened archives are preferred while legacy source builds
# remain available. Set to 1 only after platform image coverage is complete.

# --- Validator worker ---

VALIDATOR_PLATFORM_API_URL=https://platform-api.heyditto.ai/
VALIDATOR_HOTKEY=<validator-ss58-address>
# How many concurrent full-run slots this host ADVERTISES. Leave unset to take
# the compose default, which is the production value -- this file is an example,
# and the fleet runs the compose default, not this one.
# The platform decides how many of these advertised slots actually receive
# tickets (its validator-slot cap defaults to 2 and is changed from backroom),
# so raising this alone does not raise concurrency. Lower it only if your host
# has less than the documented 16 GB RAM / 80 GB disk.
VALIDATOR_BENCHMARK_CAPACITY=8
# Bound embedding-heavy memory phases independently from hosted inference.
# Keep at 1 unless the validator's local Ollama has been qualified for more.
VALIDATOR_BENCHMARK_MEMORY_CAPACITY=1

# Load the validator signing key from wallet files.
VALIDATOR_WALLET_NAME=<coldkey-name>
VALIDATOR_WALLET_HOTKEY=<hotkey-name>

# Weight path (Pylon). The root docker-compose.yml fixes the subnet to SN118 and
# derives Pylon's network, wallet, hotkey, and identity from the validator
# settings above, so you set only the token here. One PYLON_TOKEN guards both
# the open-access reads and the identity write. See docs/VALIDATOR.md, "First
# deployment".
PYLON_TOKEN=<random-token>       # generate with: openssl rand -base64 32

# --- Validator observability: shared W&B telemetry ---
# Aggregate scoring stats publish to the shared heyditto/ditto-sn118 project so
# miners and researchers can watch the subnet. WANDB_API_KEY is a single
# read+write key the Ditto team gives trusted validators confidentially; paste it
# below and NEVER commit it. Set WANDB_MODE=disabled to opt out.
WANDB_MODE=online
WANDB_PROJECT=ditto-sn118
WANDB_ENTITY=heyditto
WANDB_API_KEY=<shared key provided confidentially by the Ditto team>
# WANDB_RUN_NAME: leave unset. Each validator auto-names its run
# validator-<hotkey8>, so many validators sharing this one project never
# collide. Only set this to override that per-hotkey default.
# WANDB_RUN_NAME=<optional-run-name>
# VALIDATOR_LOG_LEVEL=INFO

# --- Validator automatic updates (optional, disabled by default) ---
# Set this only after the supervised full-stack `migrate` or `adopt` command.
# It replaces the whole digest-pinned production stack, waits for active work
# to drain, and never force-stops a benchmark.
# Read docs/FULL-STACK-UPDATES.md before installing its timer.
VALIDATOR_STACK_AUTO_UPDATE=false
# VALIDATOR_AUTO_UPDATE_DRAIN_TIMEOUT_SECONDS=4800
# VALIDATOR_AUTO_UPDATE_READY_TIMEOUT_SECONDS=180
# VALIDATOR_AUTO_UPDATE_CHECK_SECONDS=5

# --- Bounded v6 inference transition ---
# Keep the existing frozen v6 relay credential only until v7 is activated and
# all v6 tickets have drained. V7 never consumes this credential: it requires a
# ticket-scoped platform inference session. A separately announced cleanup
# release removes these variables and the relay from validator hosts.
RELAY_PROVIDER=chutes
# Required by the scorer's explicitly gated legacy profile during the bounded
# v6 drain. Remove this together with RELAY_API_KEY after v7 enforcement.
RELAY_ENABLE_DEPRECATED_CHUTES=1
RELAY_API_KEY=cpk-...

# Optional. Shared secret the validator presents to the scorer's inference
# control plane (v7 session prepare/activate/cancel). The stack supplies a
# working default, so leave this unset unless you want a per-host secret; if
# you set it, recreate BOTH dittobench-api and ditto-subnet, or every v7 ticket
# fails with `inference control plane unavailable`.
# DITTOBENCH_BROKER_CONTROL_TOKEN=<random-token>

# Optional. The exact proxy_url the platform mints in the ticket grant exchange.
# The broker byte-compares an activation's proxy_url against this and rejects
# on any mismatch, so override it only when pointing a validator at a
# non-production platform (then it must be that platform's public base URL
# joined to /api/v1/inference/chat/completions, https, no trailing slash on
# the base, no query or fragment). Leaving it unset uses the production value
# baked into the stack.
#
# Must move in lockstep with the platform's DITTO_INFERENCE_PUBLIC_BASE_URL —
# the broker compares byte-for-byte, so a one-sided change 401s every v7
# activation. Note there is no trailing slash on the base: a trailing slash
# would produce "//api/..." and fail the broker's exact-path check.
# DITTOBENCH_PLATFORM_INFERENCE_PROXY_URL=https://dittobench.ai/api/v1/inference/chat/completions
# DITTOBENCH_EMBEDDING_UPSTREAM_URL=https://dittobench.ai/api/v1/inference/embeddings

# The platform mints ticket exchange/proxy URLs from its own inference
# hostname. Set this when that differs from VALIDATOR_PLATFORM_API_URL, or the
# validator refuses every ticket with "exchange URL is not the platform".
# Must move together with the platform's DITTO_INFERENCE_PUBLIC_BASE_URL and
# the scorer's DITTOBENCH_PLATFORM_INFERENCE_PROXY_URL above.
# Defaults to https://dittobench.ai in docker-compose.yml, which is what
# production mints. Uncomment only to point at another environment.
# VALIDATOR_PLATFORM_INFERENCE_BASE_URL=https://dittobench.ai

# v7/v8 require platform-issued ticket inference and fail closed without it.
DITTOBENCH_REQUIRE_TICKET_INFERENCE=true
VALIDATOR_INFERENCE_PROXY_REQUIRED=true

# Optional Pylon service setting.
# PYLON_METRICS_TOKEN=<random-token>
