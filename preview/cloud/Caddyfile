{
  email preview@dittobench.ai
}

dashboard.{$PREVIEW_BASE_DOMAIN} {
  handle /api/* {
    request_body {
      max_size 32MiB
    }
    reverse_proxy platform:8000
  }
  handle {
    reverse_proxy dashboard:80
  }

  handle_errors 413 {
    header Content-Type application/json
    header Connection close
    header X-Request-ID {err.id}
    respond `{"error_code":3004,"message":"request body exceeds 32MiB","request_id":"{err.id}"}` 413 {
      close
    }
  }
}

platform.{$PREVIEW_BASE_DOMAIN} {
  handle /__preview/health {
    header Content-Type application/json
    respond `{"status":"ok","sha":"{$PREVIEW_SHA}","profile":"{$PREVIEW_PROFILE}"}` 200
  }
  request_body {
    max_size 32MiB
  }
  reverse_proxy platform:8000

  handle_errors 413 {
    header Content-Type application/json
    header Connection close
    header X-Request-ID {err.id}
    respond `{"error_code":3004,"message":"request body exceeds 32MiB","request_id":"{err.id}"}` 413 {
      close
    }
  }
}

backroom.{$PREVIEW_BASE_DOMAIN} {
  reverse_proxy backroom:3000
}
