        "type": "object"
      }
    },
    "properties": {
      "claims": {
        "items": {
          "$ref": "#/$defs/NameClaimResponse"
        },
        "type": "array"
      },
      "endorsement_threshold": {
        "minimum": 1,
        "type": "integer"
      },
      "generated_at": {
        "format": "date-time",
        "type": "string"
      }
    },
    "required": [
      "generated_at",
      "endorsement_threshold",
      "claims"
    ],
    "type": "object"
  },
  "name_claim.NameClaimProof": {
