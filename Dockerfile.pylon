# syntax=docker/dockerfile:1

ARG PYLON_BASE_IMAGE=docker.io/backenddevelopersltd/bittensor-pylon@sha256:d7389e6132dac49cb1acad68184fd6c3759592e2e494afdb732fd8f7a3f6349a
FROM ${PYLON_BASE_IMAGE}

# The base image's system and Certifi stores trust a root with compromised
# intermediate CA keys, and its AnyIO uses IDNA 2003 for TLS hostname checks.
# Pin the Debian security updates and wheels rather than resolving mutable
# versions during the validator-stack build. The content-addressed Debian
# snapshot retains this package when the security suite publishes a newer one.
ADD --checksum=sha256:c10585ac22c7f617a73d394eea29ba71d0356f350ae973b19043d1b017f80f54 \
  https://snapshot.debian.org/file/5f7c51c2ab8fb7a6d49f2cd774e6ac19a692414d \
  /tmp/ca-certificates_20250419+deb13u1_all.deb
ADD --checksum=sha256:db46824c60fee46aff3cc0be3e5f736bc606cae669b1fb17516a41e8073251a9 https://snapshot.debian.org/file/23b8a33dc62caec5673405e9f3c205bbf4e990b1 /tmp/libbrotli1.deb
ADD --checksum=sha256:ef145c247787d6f40dcdefd5b417502484827cde0d555998c17fd5b27ec1e1dd https://snapshot.debian.org/file/5a70387ff0f86c1336fe17ce0c6adb1620d20a6c /tmp/perl.deb
ADD --checksum=sha256:b795464137a0f4d443fc9284f4b93e883fb83883cb533adf300ac660807a352a https://snapshot.debian.org/file/e08e47a606c27af0d1f47901b1d75beec5282bbb /tmp/perl-base.deb
ADD --checksum=sha256:4c46cdd8f3135aa1c95f07e817f8e5d9be590687441ac1c27e3a8c49400f35ce https://snapshot.debian.org/file/c2434b7c6d75e490cbf036fce4d99970f50ce44f /tmp/perl-modules.deb
ADD --checksum=sha256:e44777ff47ad248d1debd57e1f96ab5e89061a341008ae39880ba3b5fc15f273 https://snapshot.debian.org/file/af4cd0adb0e67e6e30e04a39ff617d94cc05fc77 /tmp/libperl.deb
ADD --checksum=sha256:235ba2cb2ea677f4acaf402b027e76d305342870f6d80d822d7ee9713e2f0ff5 https://snapshot.debian.org/file/55e3db6fe5ef3dee1e75082087a5aaeb0511e720 /tmp/linux-libc-dev.deb
RUN for spec in ca-certificates=20250419+deb13u1 libbrotli1=1.1.0-2+deb13u1 \
        perl=5.40.1-6+deb13u1 perl-base=5.40.1-6+deb13u1 \
        perl-modules-5.40=5.40.1-6+deb13u1 libperl5.40=5.40.1-6+deb13u1 \
        linux-libc-dev=6.12.115-2; do \
        package="${spec%%=*}"; target="${spec#*=}"; \
        installed="$(dpkg-query -W -f='${Version}' "$package")" || exit 1; \
        if dpkg --compare-versions "$installed" gt "$target"; then \
          echo "refusing to downgrade $package from $installed to $target" >&2; exit 1; \
        fi; \
    done \
    && DEBIAN_FRONTEND=noninteractive dpkg -i /tmp/ca-certificates_20250419+deb13u1_all.deb \
       /tmp/libbrotli1.deb /tmp/perl-base.deb /tmp/perl-modules.deb /tmp/libperl.deb /tmp/perl.deb /tmp/linux-libc-dev.deb \
    && test -z "$(dpkg --audit)" \
    && rm /tmp/ca-certificates_20250419+deb13u1_all.deb /tmp/libbrotli1.deb \
       /tmp/perl-base.deb /tmp/perl-modules.deb /tmp/libperl.deb /tmp/perl.deb /tmp/linux-libc-dev.deb

# The base uv embeds an affected Rust zip crate. Preserve both uv and uvx
# with the upstream x86-64 release that removed that dependency.
ADD --checksum=sha256:287491da03f2a785c70fa75b13e1f849918c2f2b5415fe84876b8214eeb792f9 \
  https://github.com/astral-sh/uv/releases/download/0.13.7/uv-x86_64-unknown-linux-musl.tar.gz \
  /tmp/uv.tar.gz
RUN tar -xzf /tmp/uv.tar.gz --strip-components=1 -C /usr/bin \
      uv-x86_64-unknown-linux-musl/uv uv-x86_64-unknown-linux-musl/uvx \
    && rm /tmp/uv.tar.gz

ADD --checksum=sha256:e9b54de76e530bb6cf0ccd036787103acb58fd42ba930ea8bf948ddbaa2f61d1 \
  https://files.pythonhosted.org/packages/32/d1/a3652fe2c19134d0d15922177821d863cbd7e842d53a21bbe7e8e3a1b5ac/certifi-2026.10.23-py3-none-any.whl \
  /tmp/certifi-2026.10.23-py3-none-any.whl
ADD --checksum=sha256:9f505dda5ac9f0c8309b5e8bd445a8c2bf7246f3ce950121e45ea15bc41d1494 \
  https://files.pythonhosted.org/packages/da/35/f2287558c17e29fafc8ef3daf819bb9834061cfa43bff8014f7df7f63bdc/anyio-4.14.2-py3-none-any.whl \
  /tmp/anyio-4.14.2-py3-none-any.whl

# Pylon 2.3.2 pins bittensor-wallet 4.0.1, whose Rust keyfile parser rejects
# legacy-valid hotkeys where cryptoType is a JSON integer. Install the reviewed
# upstream release whose value-based parser accepts that numeric field.
ADD --checksum=sha256:443b1fd0f497331719f23d854362ad7573314aae9fc955f1371bdafc66286875 \
  https://files.pythonhosted.org/packages/38/94/06fad3225a24c4c3aff3e059353f17928c384fb5802612ddbfef108fd886/bittensor_wallet-4.1.1-cp313-cp313-manylinux_2_28_x86_64.whl \
  /tmp/bittensor_wallet-4.1.1-cp313-cp313-manylinux_2_28_x86_64.whl

# v1.0.1 predicts reveal epochs with the retired tempo+1/netuid formula.
# Pin the stateful implementation and adapt both TurboBT's call and Pylon's
# persisted-task expiry; merely upgrading the wheel leaves an incompatible API.
#
# Reveal timing that this pin produces, and what to verify after a rollout:
# TurboBT still passes block_time=12 and drand v2 adds SECURITY_BLOCK_OFFSET=3,
# so every commit made in epoch N encrypts for a pulse at boundary(N+1) + 3.
# That deliberately misses Subtensor's lookahead reveal at the boundary block
# itself and lands the vector in fold N+2, uniformly for every committer. The
# margin is 36 s of wall clock over the commit-to-boundary span: if real block
# time times drand ingestion lag exceeds it, an early-phase committer's pulse
# is on-chain by boundary(N+1) and its weights enter fold N+1 while later
# committers enter N+2. The validator therefore commits at one fixed late
# phase (ditto/validator/worker.py _WEIGHT_COMMIT_OFFSET_BLOCKS, a fleet
# constant rather than an operator setting), and post-deploy verification
# must confirm through get_validator_weight_diagnostics that each managed
# validator's implied_reveal_block equals next_epoch_block + 3, not the
# boundary itself.
ADD --checksum=sha256:3d1c96a56bfedd7ce534414761b6067a3ee41c317b7034f3ee24c753170bed10 \
  https://files.pythonhosted.org/packages/de/e6/cfd0a3d0a8d78f9355af6d28125406f42e7ccd25ffebcc3c71e6321be9d0/bittensor_drand-2.0.0-cp313-cp313-manylinux_2_17_x86_64.manylinux2014_x86_64.whl \
  /tmp/bittensor_drand-2.0.0-cp313-cp313-manylinux_2_17_x86_64.manylinux2014_x86_64.whl
COPY services/pylon/ditto_pylon_epoch.py services/pylon/patch_epoch_schedule.py services/pylon/patch_receipts.py services/pylon/ditto_pylon_receipts.py services/pylon/ditto_pylon_receipt_api.py services/pylon/ditto_pylon_treasury.py services/pylon/receipt_migration.py /tmp/pylon-epoch/
COPY packages/ditto-screening-protocol /tmp/ditto-screening-protocol

# TurboBT is supplied as an immutable named Git context by the release
# workflow. Installing it into Pylon's existing virtualenv preserves the
# reviewed Pylon service image while replacing only the faulty RPC adapter.
COPY --from=turbobt . /tmp/turbobt
RUN /app/pylon_service/.venv/bin/python /tmp/pylon-epoch/patch_epoch_schedule.py --dependencies /tmp/turbobt/pyproject.toml \
    && uv pip install \
      --python /app/pylon_service/.venv/bin/python \
      --no-deps \
      /tmp/certifi-2026.10.23-py3-none-any.whl \
      /tmp/anyio-4.14.2-py3-none-any.whl \
    && uv pip install \
      --python /app/pylon_service/.venv/bin/python \
      --no-deps \
      /tmp/bittensor_wallet-4.1.1-cp313-cp313-manylinux_2_28_x86_64.whl \
    && PDM_BUILD_SCM_VERSION=1.3.1 uv pip install \
      --python /app/pylon_service/.venv/bin/python \
      --no-deps \
      /tmp/turbobt \
    && uv pip install \
      --python /app/pylon_service/.venv/bin/python \
      --no-deps \
      /tmp/bittensor_drand-2.0.0-cp313-cp313-manylinux_2_17_x86_64.manylinux2014_x86_64.whl \
    && /app/pylon_service/.venv/bin/python /tmp/pylon-epoch/patch_epoch_schedule.py \
    && /app/pylon_service/.venv/bin/python /tmp/pylon-epoch/patch_receipts.py \
    && uv pip install --python /app/pylon_service/.venv/bin/python --no-deps /tmp/ditto-screening-protocol \
    && uv pip check --python /app/pylon_service/.venv/bin/python \
    && rm -rf \
      /tmp/certifi-2026.10.23-py3-none-any.whl \
      /tmp/anyio-4.14.2-py3-none-any.whl \
      /tmp/bittensor_wallet-4.1.1-cp313-cp313-manylinux_2_28_x86_64.whl \
      /tmp/bittensor_drand-2.0.0-cp313-cp313-manylinux_2_17_x86_64.manylinux2014_x86_64.whl \
      /tmp/pylon-epoch \
      /tmp/ditto-screening-protocol \
      /tmp/turbobt

LABEL io.heyditto.validator.pylon-base-version="2.3.2" \
      io.heyditto.validator.epoch-schedule="subtensor-stateful-epochs-v1" \
      io.heyditto.validator.weight-receipts="1"
