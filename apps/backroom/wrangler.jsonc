{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ditto-subnet-backroom",
  "compatibility_date": "2026-07-11",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "main": "./src/server.ts",
  "workers_dev": false,
  // The Worker service is deployed first; Terraform owns the production
  // custom-domain attachment in infra/terraform/stacks/cloudflare-dittobench.
  "vars": {
    "GOOGLE_REDIRECT_URI": "https://backroom.dittobench.ai/auth/callback",
    "DITTO_PLATFORM_API_BASE_URL": "https://platform-api.heyditto.ai",
  },
  // OAuth grants, registered MCP clients, and issued tokens for the /mcp
  // endpoint. Terraform owns the namespace in the cloudflare-dittobench stack
  // and exports its id; `scripts/inject-oauth-kv.mjs` binds it from the prod
  // BACKROOM_OAUTH_KV_ID variable immediately before `wrangler deploy`.
  //
  // The placeholder is deliberate and must stay committed. This repository is
  // public and this namespace holds live operator grants and tokens, so the id
  // is supplied at deploy time like the Cloudflare account id and API token.
  // Because the placeholder is not a valid namespace id, a deploy that skips
  // the injection step fails at Cloudflare instead of shipping a Worker whose
  // OAuth provider has nowhere to persist a grant, and a local
  // `wrangler dev --remote` cannot reach production state.
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "OAUTH_KV_NAMESPACE_ID_INJECTED_AT_DEPLOY",
    },
  ],
  // Purges expired OAuth grants and tokens. Hourly is well inside the 7-day
  // refresh-token TTL, so a missed run never strands a live connection.
  "triggers": {
    "crons": ["17 * * * *"],
  },
  // Fail closed before publishing a version that cannot authenticate an
  // operator or call Platform. Values live only in Cloudflare's encrypted
  // Worker bindings; scripts/bootstrap-worker-secrets.sh installs them from
  // Google's downloaded OAuth JSON plus the existing GCP Platform secret.
  "secrets": {
    "required": [
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "SESSION_SECRET",
      "BACKROOM_ADMIN_EMAILS",
      "DITTO_ADMIN_API_TOKEN",
    ],
  },
  "observability": {
    "enabled": true,
  },
}
