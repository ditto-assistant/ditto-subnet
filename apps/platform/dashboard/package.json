{
  "name": "ditto-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "typecheck": "tsc -p . --noEmit",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "dependencies": {
    "@tanstack/solid-query": "5.100.11",
    "solid-js": "1.9.14"
  },
  "devDependencies": {
    "@solidjs/testing-library": "0.8.10",
    "@testing-library/jest-dom": "7.0.0",
    "@types/node": "24.10.14",
    "jsdom": "30.0.1",
    "oxlint": "1.76.0",
    "prettier": "3.8.0",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vite-plugin-solid": "2.11.14",
    "vitest": "4.1.10"
  }
}
